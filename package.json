{
  "name": "sikh-university",
  "version": "1.0.0",
  "private": true,
  "description": "Local dev entry point for the Sikhi University Worker (API + D1/R2/KV bindings). See CONTRIBUTING.md.",
  "scripts": {
    "dev": "wrangler dev --local",
    "dev:frontend": "cd web && npm run dev",
    "db:seed": "wrangler d1 execute sikh-university --local --file=./schema.sql",
    "db:seed:remote": "wrangler d1 execute sikh-university --remote --file=./schema.sql",
    "db:migrate": "wrangler d1 execute sikh-university --local --file=./migrations/0001_mfa_flags.sql",
    "db:migrate:remote": "wrangler d1 execute sikh-university --remote --file=./migrations/0001_mfa_flags.sql",
    "deploy": "wrangler deploy",
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "^4.1.0",
    "wrangler": "^4.128.0"
  }
}
