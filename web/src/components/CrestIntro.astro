<div id="university-intro" hidden aria-label="Sikhi University introduction">
  <video muted playsinline preload="none" aria-label="Animated Sikhi University crest"></video>
  <button type="button">Skip intro ↗</button>
</div>
<style>
  #university-intro[hidden] { display:none; }
  #university-intro { position:fixed; inset:0; z-index:1000; background:#fff; display:grid; place-items:center; }
  video { width:min(68vw,62.4svh,576px); height:auto; object-fit:contain; }
  button { position:absolute; right:max(24px,env(safe-area-inset-right)); bottom:max(24px,env(safe-area-inset-bottom)); background:#fff; border:1px solid #9c927e; color:#16335c; min-height:44px; padding:10px 18px; font:14px 'Inter',sans-serif; }

</style>
<script>
  const intro = document.getElementById('university-intro');
  const video = intro?.querySelector('video');
  const replay = document.getElementById('replay-intro');
  const motion = matchMedia('(prefers-reduced-motion: reduce)');
  const connection = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
  let timeout: ReturnType<typeof setTimeout>;
  const INTRO_MS = 3000;
  let shownAt: number | null = null;
  let active = false;
  let manual = false;
  function readyForCrest() {
    document.documentElement.dataset.introReady = 'true';
    window.dispatchEvent(new Event('su:intro-ready'));
  }
  function dismiss() {
    active = false;
    if (intro) intro.hidden = true;
    video?.pause();
    clearTimeout(timeout);
    readyForCrest();
    if (replay) { replay.textContent = 'Replay intro'; replay.removeAttribute('aria-busy'); }
    if (manual) replay?.focus({ preventScroll:true });
  }
  function playIntro(explicit = false) {
    if (!intro || !video || active) return;
    manual = explicit;
    active = true;
    shownAt = null;
    if (replay) { replay.textContent = 'Loading intro…'; replay.setAttribute('aria-busy','true'); }
    if (!video.getAttribute('src')) video.src = '/assets/brand/intro-2026.mp4';
    video.currentTime = 0;
    // Loading never blocks the page. Give slow connections time to buffer.
    timeout = setTimeout(dismiss, 8000);
    video.play().catch(dismiss);
  }
  video?.addEventListener('playing', () => {
    if (!active || !intro || shownAt !== null) return;
    shownAt = performance.now();
    intro.hidden = false;
    clearTimeout(timeout);
    // One wall-clock deadline: buffering/resume must never extend the intro.
    timeout = setTimeout(dismiss, INTRO_MS);
    try { sessionStorage.setItem('su-crest-intro-2026', 'seen'); } catch {}
  });
  video?.addEventListener('ended', dismiss);
  video?.addEventListener('error', dismiss);
  intro?.querySelector('button')?.addEventListener('click', dismiss);
  document.addEventListener('keydown', event => { if (active && event.key === 'Escape') dismiss(); });
  motion.addEventListener('change', () => { if (motion.matches) dismiss(); });
  replay?.addEventListener('click', () => playIntro(true));
  window.addEventListener('pagehide', dismiss, { once:true });
  let seen = false;
  try { seen = sessionStorage.getItem('su-crest-intro-2026') === 'seen'; } catch {}
  const navigation = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
  if ((!seen || navigation?.type === 'reload') && !motion.matches && !connection?.saveData) playIntro();
  else readyForCrest();
</script>
