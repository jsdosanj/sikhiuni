---
// Shared premium hero for a department landing page. The photograph, accent,
// tagline and stance all come from the department record, so each hero reads
// as its own school. A page may pass extra markup via the default slot — its
// bespoke "signature" module sits directly under the hero.
import type { Department } from '../../lib/departments';
import { coursesInDepartment, departmentTopics } from '../../lib/departments';
import { gurmukhiHtml } from '../../lib/gurmukhi';

interface Props { d: Department }
const { d } = Astro.props;
const courses = coursesInDepartment(d);
const topics = departmentTopics(d);
const levels = [...new Set(courses.map((c) => Math.floor(c.level / 100) * 100))].sort((a, b) => a - b);
const levelSpan = levels.length ? `${levels[0]}–${levels[levels.length - 1]}` : '';
---
<header class="dept-hero dept-grain">
  <img class="dept-hero-img" src={d.image.src} alt="" aria-hidden="true" fetchpriority="high" />
  <div class="dept-hero-scrim" aria-hidden="true"></div>

  <a class="dept-back wrap" href="/departments">Sikhi University &middot; Departments</a>

  <div class="dept-hero-in wrap">
    <p class="dept-eyebrow">School within Sikhi University</p>
    <h1 class="dept-h1">{d.name}</h1>
    <p class="dept-tagline">{d.tagline}</p>
    <p class="dept-stance" set:html={gurmukhiHtml(d.stance)} />
    <div class="dept-hero-meta">
      <span class="dept-chip"><b>{courses.length}</b> courses</span>
      <span class="dept-chip"><b>{topics.length}</b> subject{topics.length === 1 ? '' : 's'}</span>
      <span class="dept-chip"><b>{levelSpan}</b> level</span>
    </div>
    <a class="dept-hero-cta" href="#catalogue">
      Explore the department
      <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M6 13l6 6 6-6"/></svg>
    </a>
    <p class="dept-credit">
      Photograph: <a href={d.image.source} target="_blank" rel="noopener">{d.image.credit}</a>
    </p>
  </div>
</header>

<slot />
