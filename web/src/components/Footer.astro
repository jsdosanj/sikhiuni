---
<!--
  Footer has no real topics/schools data source of its own (checked
  web/src/lib/data before writing this — only index.astro imports `topics`),
  so per the redesign plan's fallback rule this keeps the footer's real,
  pre-existing sections (Learn / More) and applies the registrar's-ledger
  visual vocabulary to them: mono eyebrows for the section heads and
  border-t ruled rows for the link lists, rather than inventing a "schools"
  panel this component has no data to fill.
-->
<footer class="border-t border-line bg-surface mt-20" style="padding-bottom: env(safe-area-inset-bottom)">
  <div class="wrap py-10 text-sm text-muted">
    <div class="grid gap-10 sm:grid-cols-3">
      <div>
        <div class="flex items-center gap-2.5">
          <img src="/assets/su-crest.png" alt="" aria-hidden="true" class="h-10 w-auto" />
          <img src="/assets/su-wordmark.png" alt="Sikhi University" class="h-6 w-auto" />
        </div>
        <p class="mt-3 max-w-xs" data-i18n="footer.tagline">A free, open online university — a space for anyone, anywhere to dig deeper into Sikhi and the skills of today.</p>
      </div>
      <div>
        <div class="eyebrow text-navy" data-i18n="footer.learn">Learn</div>
        <ul class="mt-3">
          <li class="row-ruled"><a href="/catalog" data-i18n="footer.catalogue">Course catalogue</a></li>
          <li class="row-ruled"><a href="/catalog#paths" data-i18n="footer.paths">Learning paths</a></li>
          <li class="row-ruled"><a href="/professors" data-i18n="nav.professors">Professors</a></li>
          <li class="row-ruled"><a href="/search" data-i18n="footer.search">Search</a></li>
        </ul>
      </div>
      <div>
        <div class="eyebrow text-navy" data-i18n="footer.more">More</div>
        <ul class="mt-3">
          <li class="row-ruled"><a href="/about" data-i18n="footer.about">About</a></li>
          <li class="row-ruled"><a href="/integrity" data-i18n="footer.integrity">Content integrity</a></li>
          <li class="row-ruled"><a href="/external" data-i18n="footer.studyelsewhere">Study elsewhere</a></li>
          <li class="row-ruled"><a href="/feedback" data-i18n="footer.feedback">Feedback</a></li>
          <li class="row-ruled"><a href="/legal" data-i18n="footer.legal">Terms &amp; Privacy</a></li>
          <li class="row-ruled"><a href="/ai-policy" data-i18n="footer.aipolicy">AI &amp; content-usage policy</a></li>
          <li class="row-ruled"><a href="https://sikharchive.net" target="_blank" rel="noopener">Sikh Archive ↗</a></li>
        </ul>
      </div>
    </div>
    <div class="mt-8 pt-6 border-t-2 border-navy text-center font-mono text-[0.68rem] uppercase tracking-wide">
      <span data-i18n="footer.aiNote">Courses labelled "Created by AI" are AI-drafted and reviewed for accuracy. Sacred content is handled with care.</span> · © Sikhi University
    </div>
  </div>
</footer>
