---
import { published } from '../lib/data';
const practice = published.filter(c => !c.gated && c.quiz?.length).slice(0, 24).map(c => ({id:c.id,title:c.title,question:c.quiz[0]}));
---
<section class="studio" id="study-studio" aria-labelledby="studio-title">
  <div class="studio-heading"><div><p class="desk-label">Your space to make progress</p><h2 id="studio-title">What moves you forward today?</h2></div><span class="studio-tag">Choose your rhythm</span></div>
  <div class="studio-tabs" role="tablist" aria-label="Study tools"><button id="tab-plan" role="tab" aria-controls="panel-plan" aria-selected="true" data-studio="plan">01 <span>My session</span></button><button id="tab-practice" role="tab" aria-controls="panel-practice" aria-selected="false" tabindex="-1" data-studio="practice">02 <span>Quick challenge</span></button><button id="tab-journal" role="tab" aria-controls="panel-journal" aria-selected="false" tabindex="-1" data-studio="journal">03 <span>Reflection journal</span></button></div>
  <div id="panel-plan" role="tabpanel" aria-labelledby="tab-plan" class="studio-panel">
    <div class="plan-copy"><span class="studio-orb" aria-hidden="true">↗</span><h3>A small plan. <br />A real step forward.</h3><p>Choose the time you have. Build a session you can actually finish.</p><div class="time-choices" role="group" aria-label="Available study time"><button data-minutes="5" aria-pressed="false">5 min</button><button data-minutes="15" aria-pressed="true">15 min</button><button data-minutes="30" aria-pressed="false">30 min</button></div></div>
    <ol class="session-path" id="session-path" aria-live="polite"></ol>
  </div>
  <div id="panel-practice" role="tabpanel" aria-labelledby="tab-practice" class="studio-panel" hidden>
    <div class="challenge-intro"><p class="desk-label">Practice, without the pressure</p><h3>Put your knowledge<br />into play.</h3><p>Questions from our open courses. These practice answers do not affect your grades.</p><label for="challenge-subject">Choose a course</label><select id="challenge-subject">{practice.map((c,i)=><option value={i}>{c.title}</option>)}</select><div class="challenge-score"><strong id="challenge-score">0</strong><span>correct this visit</span></div></div>
    <div class="challenge-card"><p id="challenge-question"></p><div id="challenge-options"></div><p id="challenge-feedback" role="status"></p><div class="challenge-bottom"><a id="challenge-source" href="/catalog">Study this course ↗</a><button id="challenge-next" type="button">Next challenge →</button></div></div>
  </div>
  <div id="panel-journal" role="tabpanel" aria-labelledby="tab-journal" class="studio-panel" hidden>
    <div class="journal-intro"><p class="desk-label">Keep the insight</p><h3>What will you<br />take with you?</h3><p>Your journal stays on this device. It is separate from your course notes and account.</p><button id="journal-prompt" type="button">Try another prompt ↻</button><p id="journal-prompt-text">What is one idea you could explain to someone else?</p></div>
    <div class="journal-editor"><label for="studio-reflection">Your reflection</label><textarea id="studio-reflection" rows="5" maxlength="2000" placeholder="Today I discovered…"></textarea><div><button id="journal-save" type="button">Save reflection</button><span id="journal-status" role="status"></span></div><details><summary>Previous reflections <span id="journal-count">0</span></summary><div id="journal-history"></div></details></div>
  </div>
  <script type="application/json" id="studio-questions" set:html={JSON.stringify(practice).replace(/</g,'\\u003c')} />
</section>
<script>
 if (document.getElementById('study-studio')) {
 const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-studio]')];
 function selectTab(key:string) { tabs.forEach(t=>{const on=t.dataset.studio===key;t.setAttribute('aria-selected',String(on));t.tabIndex=on?0:-1;document.getElementById('panel-'+t.dataset.studio).hidden=!on;}); }
 tabs.forEach((t,i)=>{t.addEventListener('click',()=>selectTab(t.dataset.studio));t.addEventListener('keydown',e=>{let next=i;if(e.key==='ArrowRight')next=(i+1)%tabs.length;else if(e.key==='ArrowLeft')next=(i+tabs.length-1)%tabs.length;else if(e.key==='Home')next=0;else if(e.key==='End')next=tabs.length-1;else return;e.preventDefault();selectTab(tabs[next].dataset.studio);tabs[next].focus();});});
 const plans={5:[['2 min','Wake up your recall','Try a quick challenge','practice'],['2 min','Revisit a key idea','Open your learning record','/dashboard/learning'],['1 min','Keep one insight','Write a reflection','journal']],15:[['8 min','Continue your learning','Find your next lesson','/dashboard/learning'],['5 min','Make it stick','Try a quick challenge','practice'],['2 min','Connect the dots','Write a reflection','journal']],30:[['20 min','Go a little deeper','Continue a course','/dashboard/learning'],['7 min','Test your understanding','Try a quick challenge','practice'],['3 min','Bring it into daily life','Write a reflection','journal']]};
 function drawPlan(minutes:number){const list=document.getElementById('session-path');list.replaceChildren();plans[minutes].forEach(([time,title,label,target],i)=>{const li=document.createElement('li');const number=document.createElement('span');number.className='path-number';number.textContent=String(i+1).padStart(2,'0');const body=document.createElement('div');const small=document.createElement('small');small.textContent=time;const heading=document.createElement('h4');heading.textContent=title;const action=document.createElement(target.startsWith('/')?'a':'button');action.textContent=label+' →';if(action instanceof HTMLAnchorElement)action.href=target;else action.addEventListener('click',()=>selectTab(target));body.append(small,heading,action);li.append(number,body);list.append(li);});}
 document.querySelectorAll<HTMLButtonElement>('[data-minutes]').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('[data-minutes]').forEach(x=>x.setAttribute('aria-pressed',String(x===b)));drawPlan(Number(b.dataset.minutes));}));drawPlan(15);
 const questions=JSON.parse(document.getElementById('studio-questions').textContent);let questionIndex=0;const answered=new Set<number>();let correct=0;
 const subject=document.getElementById('challenge-subject') as HTMLSelectElement;
 function drawQuestion(){const item=questions[questionIndex];if(!item)return;subject.value=String(questionIndex);document.getElementById('challenge-question').textContent=item.question.q;const options=document.getElementById('challenge-options');options.replaceChildren();document.getElementById('challenge-feedback').textContent='';const source=document.getElementById('challenge-source') as HTMLAnchorElement;source.href='/course/'+encodeURIComponent(item.id);let locked=false;item.question.options.forEach((label:string,i:number)=>{const button=document.createElement('button');button.type='button';button.textContent=String.fromCharCode(65+i)+'. '+label;button.addEventListener('click',()=>{if(locked)return;locked=true;const ok=i===item.question.answer;if(ok&&!answered.has(questionIndex))correct++;answered.add(questionIndex);document.getElementById('challenge-score').textContent=String(correct);options.querySelectorAll('button').forEach((b,n)=>{b.disabled=true;b.classList.toggle('answer-correct',n===item.question.answer);if(n===i&&!ok)b.classList.add('answer-incorrect');});document.getElementById('challenge-feedback').textContent=ok?'That’s right. Ready for another?':'Keep exploring. The correct answer is '+item.question.options[item.question.answer]+'. Read the course for context.';});options.append(button);});}
 subject.addEventListener('change',()=>{questionIndex=Number(subject.value);drawQuestion();});document.getElementById('challenge-next').addEventListener('click',()=>{questionIndex=(questionIndex+1)%questions.length;drawQuestion();});drawQuestion();
 const journalKey='su_studio_journal';let entries:Array<{text:string,date:string}>=[];try{const saved=JSON.parse(localStorage.getItem(journalKey)||'[]');if(Array.isArray(saved))entries=saved.filter(e=>typeof e?.text==='string'&&typeof e?.date==='string').slice(0,50);}catch{}
 const textarea=document.getElementById('studio-reflection') as HTMLTextAreaElement;
 try { textarea.value=localStorage.getItem('su_studio_journal_draft')||''; } catch {}
 textarea.addEventListener('input',()=>{try{localStorage.setItem('su_studio_journal_draft',textarea.value);document.getElementById('journal-status').textContent='Draft saved on this device.';}catch{document.getElementById('journal-status').textContent='Draft could not save. Keep a copy before leaving.';}});
 function drawJournal(){const history=document.getElementById('journal-history');history.replaceChildren();document.getElementById('journal-count').textContent=String(entries.length);entries.forEach(entry=>{const article=document.createElement('article'),date=document.createElement('small'),p=document.createElement('p');date.textContent=new Date(entry.date).toLocaleDateString(undefined,{day:'numeric',month:'short',year:'numeric'});p.textContent=entry.text;article.append(date,p);history.append(article);});}
 document.getElementById('journal-save').addEventListener('click',()=>{const text=textarea.value.trim();const status=document.getElementById('journal-status');if(!text){status.textContent='Write a thought first.';textarea.focus();return;}const next=[{text,date:new Date().toISOString()},...entries].slice(0,50);try{localStorage.setItem(journalKey,JSON.stringify(next));entries=next;textarea.value='';localStorage.removeItem('su_studio_journal_draft');status.textContent='Saved on this device.';drawJournal();}catch{status.textContent='Could not save. Keep a copy of your reflection.';}});
 const prompts=['What is one idea you could explain to someone else?','What surprised you today?','Where could you apply what you learned?','What question would you like to explore next?'];let prompt=0;document.getElementById('journal-prompt').addEventListener('click',()=>{prompt=(prompt+1)%prompts.length;document.getElementById('journal-prompt-text').textContent=prompts[prompt];});drawJournal();
 }
</script>
