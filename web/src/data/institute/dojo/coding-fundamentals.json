        [["t", "  } "], ["k", "catch"], ["t", " ("], ["t", "err"], ["p", ") {"], ["c", "                        // only runs if try fails"]],
        [["t", "    "], ["k", "return"], ["t", " []"], ["p", ";"]],
        [["t", "  }"]],
        [["p", "}"]],
        [],
        [["f", "greetAll"], ["p", "("], ["t", "sangat"], ["p", ");"], ["c", "                        // [\"Sat Sri Akal, Simran\", ...]"]]
