        [["c", "// -- 03-conditionals.js --------------------------------"]],
        [["c", "// code that branches, based on a question"]],
        [],
        [["k", "const"], ["t", " age = "], ["n", "20"], ["p", ";"]],
        [],
        [["k", "if"], ["t", " ("], ["t", "age"], ["t", " >= "], ["n", "18"], ["p", ") {"]],
        [["t", "  "], ["f", "console"], ["p", "."], ["f", "log"], ["p", "("], ["s", "\"adult\""], ["p", ");"]],
        [["p", "} "], ["k", "else"], ["t", " {"]],
        [["t", "  "], ["f", "console"], ["p", "."], ["f", "log"], ["p", "("], ["s", "\"minor\""], ["p", ");"]],
        [["p", "}"]]
      ],
      "runSteps": [
        { "k": "cmd", "t": "node 03-conditionals.js", "gap": 300 },
        { "k": "out", "t": "adult", "gap": 260 },
        { "k": "blank", "gap": 140 }
      ],
      "lineNotes": {
        "5": "`if (...)` — the code inside `{ }` only runs when the question in parentheses is true",
        "7": "`else` — runs instead, whenever the `if` question was false",
        "3": "`>=`, `===`, `&&`, `||`, `!` are the questions code can ask — always prefer `===` (exact equality) over `==`"
      }
