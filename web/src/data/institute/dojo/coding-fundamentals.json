        [["p", "}"]],
        [],
        [["k", "const"], ["t", " seeker = "], ["k", "new"], ["t", " "], ["f", "Seeker"], ["p", "("], ["s", "\"Simran\""], ["p", ");"], ["c", "     // an instance"]],
        [["k", "await"], ["t", " seeker."], ["f", "readAng"], ["p", "("], ["n", "1"], ["p", ");"], ["c", "                     // calling the async method"]]
