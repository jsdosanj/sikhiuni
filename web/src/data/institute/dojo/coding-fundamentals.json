      "name": "01-variables.js", "glyph": "JS", "gc": "#E8C15A", "lang": "Topic 1 · Variables",
      "outline": [["◇", "let vs const", "#E3C377"], ["\"", "string / number / boolean", "#79C98C"]],
      "raw": [
        [["c", "// -- 01-variables.js -----------------------------------"]],
        [["c", "// a variable is a labelled box that holds a value"]],
        [],
        [["k", "let"], ["t", " name = "], ["s", "\"Nanak\""], ["p", ";"], ["c", "          // a string — text, in quotes"]],
        [["k", "let"], ["t", " age = "], ["n", "556"], ["p", ";"], ["c", "                  // a number — no quotes"]],
        [["k", "let"], ["t", " awake = "], ["t", "true"], ["p", ";"], ["c", "               // a boolean — true or false"]],
        [],
        [["k", "const"], ["t", " foundingYear = "], ["n", "1469"], ["p", ";"], ["c", "     // const — this can never be reassigned"]],
        [["t", "age = "], ["n", "557"], ["p", ";"], ["c", "                          // let CAN be reassigned — this is fine"]]
      ],
      "runSteps": [
        { "k": "cmd", "t": "node 01-variables.js", "gap": 300 },
        { "k": "ok", "t": "name = \"Nanak\" · age = 557 · awake = true", "gap": 300 },
        { "k": "blank", "gap": 140 }
      ],
      "lineNotes": {
        "3": "`let` declares a variable that CAN change later — this one holds a string (text, in quotes)",
        "4": "a number — no quotes needed",
        "5": "a boolean — only ever `true` or `false`",
        "7": "`const` declares a variable that can NEVER be reassigned — prefer it by default, use `let` only when you need to change the value"
      }
    },
