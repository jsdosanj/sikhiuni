---
import Base from '../layouts/Base.astro';
import programsData from '../../public/assets/data/programs.json';

// --- Registrar's-ledger programmes list (task 7: isprograms, lines 921-953) ---
// One flat ruled row per real programme, ordered certificate -> associate ->
// bachelor -> master -> giani (the same academic-ladder order the
// old card grid used). No invented course codes (Decision 12): the tinted
// mono slot is the real abbreviation from programs.json, never a fabricated
// code.
const typeOrder = ['certificate', 'associate', 'bachelor', 'master', 'giani'];
const TYPE_TINT: Record<string, string> = {
  certificate: 'text-saffron-deep',
  associate: 'text-navy-soft',
  bachelor: 'text-navy',
};
// Master/Giani tints are page-local constants (Design decision 1) — used
// nowhere else in the design system, not worth a token.
const TYPE_HEX: Record<string, string> = { master: '#5c3b8a', giani: '#8a5a14' };
const orderedPrograms = typeOrder.flatMap((t) => programsData.programs.filter((p) => p.type === t));

const passMarks = [...new Set(programsData.programs.map((p) => p.passMark))];
const passMarkLabel = passMarks.length === 1 ? `${passMarks[0]}%` : '—';

function prereqLabel(p: (typeof programsData.programs)[number]): { text: string; none: boolean } {
  if (!p.prerequisites.length) return { text: 'No prerequisites', none: true };
  const abbrs = p.prerequisites.map(
    (pid) => programsData.programs.find((x) => x.id === pid)?.abbreviation ?? pid,
  );
  return { text: abbrs.join(' or '), none: false };
}

// Real data issues found while building this page (Decision 12 — flagged
// data problems are noted for the maintainer, never silently "fixed" and
// never shipped as page copy):
//   1. `credits` on every one of the 11 programmes is exactly the length of
//      `courseIds` — it is a course count, not a weighted credit value. The
//      column below is labelled "Courses" for that reason.
//   2. M.A.S.S. (mass) and Giani both require 558 courses (courseIds.length),
//      but the Giani programme's own `description` field says "all 534
//      courses" — a third number. One of these three figures is wrong.
---
<Base title="Degree Programs — Sikhi University" description="Certificate, Associate, Bachelor's, Master's and Giani degree programs in Sikh Studies — free, open, and comprehensive." ambient="study">
  <section class="wrap pt-10 pb-2">
    <div class="rule-navy flex flex-wrap items-end justify-between gap-6 pb-4">
      <div class="min-w-0 flex-1">
        <p class="eyebrow flex items-center gap-2 text-saffron-deep">
          <span aria-hidden="true" class="inline-block h-px w-6 bg-current opacity-50"></span>
          <span data-i18n="programs.eyebrow">Programmes of study</span>
        </p>
        <h1 class="text-display mt-3 text-navy" data-i18n="programs.h1">From a first certificate to Giani</h1>
        <p class="mt-4 max-w-[66ch] font-sans text-lg leading-relaxed text-muted" data-i18n="programs.sub">Eleven programmes. Each is a named set of courses with a comprehensive examination at the end — every one free, every one open to anyone.</p>
      </div>
      <div class="flex flex-none gap-8 pb-1">
        <div class="stat-mono"><span data-no-i18n>{programsData.programs.length}</span><span data-i18n="programs.stat.programmes">Programmes</span></div>
        <div class="stat-mono"><span data-no-i18n>{passMarkLabel}</span><span data-i18n="programs.stat.passmark">Pass mark</span></div>
      </div>
    </div>
  </section>

  <section class="wrap pb-16">
    <!-- Mono column-header row -->
    <div class="flex flex-wrap gap-x-4 gap-y-1 border-b border-line py-3 font-mono text-[10px] uppercase tracking-[.16em] text-muted">
      <span class="w-[76px] flex-none" data-i18n="programs.col.abbr">Abbrev.</span>
      <span class="min-w-[220px] flex-1" data-i18n="programs.col.programme">Programme</span>
      <span class="w-[130px] flex-none" data-i18n="programs.col.duration">Duration</span>
      <span class="w-[80px] flex-none" data-i18n="programs.col.courses">Courses</span>
      <span class="w-[64px] flex-none" data-i18n="programs.col.exam">Exam</span>
      <span class="min-w-[150px] flex-1" data-i18n="programs.col.entry">Entry from</span>
    </div>

    {orderedPrograms.map((p) => {
      const pre = prereqLabel(p);
      const tintClass = TYPE_TINT[p.type];
      const tintHex = TYPE_HEX[p.type];
      return (
        <a href={`/program/${p.id}`} class="row-ruled hover:bg-paper" data-no-i18n>
          <span class:list={["w-[76px] flex-none font-mono text-[12.5px] font-medium", tintClass]} style={tintHex ? { color: tintHex } : undefined}>{p.abbreviation}</span>
          <span class="min-w-[220px] flex-1">
            <span class="block text-[16.5px] font-semibold leading-tight text-navy">{p.title}</span>
            <span lang="pa" class="mt-0.5 block font-gurmukhi text-sm leading-[1.85] text-muted">{p.titleGur}</span>
          </span>
          <span class="w-[130px] flex-none font-mono text-[11.5px] text-muted">{p.duration}</span>
          <span class="w-[80px] flex-none font-mono text-[11.5px] text-navy">{p.courseIds.length}</span>
          <span class="w-[64px] flex-none font-mono text-[11.5px] text-muted">{p.testQuestions} Q</span>
          <span class:list={["min-w-[150px] flex-1 font-mono text-[11.5px]", pre.none ? "text-saffron-deep" : "text-muted"]}>{pre.text}</span>
        </a>
      );
    })}

    <div class="mt-10 max-w-[78ch] border border-line border-l-[3px] border-l-saffron-deep bg-surface px-5 py-4">
      <p class="font-mono text-[10.5px] uppercase tracking-[.18em] text-saffron-deep" data-i18n="programs.disclaimer.label">Not an accredited university</p>
      <p class="mt-2.5 font-sans text-[15.5px] leading-relaxed text-muted" data-i18n="programs.disclaimer">Sikhi University is not an accredited university and these courses are for self-development only.</p>
    </div>

    <div class="mt-10 border-t-2 border-navy pt-6">
      <h2 class="text-xl font-bold text-navy" data-i18n="programs.how.h2">How programs work</h2>
      <ol class="mt-4 max-w-[74ch] list-decimal space-y-3 pl-5 font-sans text-sm text-muted">
        <li data-i18n="programs.how.step1">Complete all courses in the program — each has lectures, reading, and a quiz.</li>
        <li><span data-i18n="programs.how.step2a">Once every course is passed (70% quiz score), unlock the</span> <strong class="text-ink" data-i18n="programs.how.step2b">Cumulative Examination</strong>.</li>
        <li><span data-i18n="programs.how.step3a">Pass the cumulative exam with</span> <strong class="text-ink" data-i18n="programs.how.step3b">80% or higher</strong> <span data-i18n="programs.how.step3c">to earn the credential.</span></li>
        <li data-i18n="programs.how.step4">Download your certificate and share your academic credential.</li>
      </ol>
      <p class="mt-4 max-w-[74ch] font-sans text-sm text-muted" data-i18n="programs.how.footer">Programs are stackable — courses completed in a certificate count toward higher degrees. Your progress is always saved.</p>
    </div>
  </section>
</Base>
