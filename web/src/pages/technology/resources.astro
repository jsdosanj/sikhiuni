---
import Base from '../../layouts/Base.astro';
import InstituteRail from '../../components/institute/InstituteRail.astro';
import { resources, gurmukhiHtml } from '../../lib/institute';

const SECTIONS = [
  { id: 'lists', label: 'Curated lists & directories', hint: 'free — hand-picked link collections' },
  { id: 'books', label: 'Books', hint: 'a shelf, not a syllabus' },
  { id: 'courses', label: 'Paid courses', hint: 'when you want a deadline and a reviewer' },
] as const;

const desc = 'Books, curated link directories, and paid courses worth your time once you have outgrown the Institute’s own tracks and the free college fair.';
---
<Base title="More resources — Institute of Technology" description={desc} institute>
  <InstituteRail />

  <section class="i-wrap i-res-head">
    <span class="i-label">/technology/resources</span>
    <h1>More resources</h1>
    <p class="i-prose">The Institute's own courses come first, and the <a href="/technology/explore">college fair</a> covers free curricula. This shelf is everything else worth pointing you at: hand-picked link directories, books, and a few paid courses — for when self-study wants a deadline or a second voice. Nothing here is rehosted; every card links straight out.</p>
  </section>

  {SECTIONS.map((sec) => (
    <section class="i-wrap i-sec" id={sec.id}>
      <span class="i-label">{sec.label}</span>
      <p class="i-prose i-res-hint">{sec.hint}</p>
      <div class="i-res-grid">
        {resources.filter((r) => r.category === sec.id).map((r) => (
          <a class="i-panel i-res-card" href={r.href} target="_blank" rel="noopener">
            <span class="i-corner">{r.price}</span>
            <strong class="i-res-title">{r.title}</strong>
            <span class="i-mono i-res-author">{r.author}</span>
            <span class="i-prose i-res-blurb" set:html={gurmukhiHtml(r.blurb)} />
            <span class="i-res-go">open &nearr;</span>
          </a>
        ))}
      </div>
    </section>
  ))}

  <section class="i-wrap i-sec i-sec-last">
    <p class="i-prose" style="font-size:13px;color:var(--i-muted)">
      This shelf will grow — more books, more courses, more of "and more" — as we find things worth sending you to. Full attribution and licences: <a href="/technology/licenses">/technology/licenses</a>.
    </p>
  </section>

  <style>
    .i-res-head { padding: 40px 24px 8px; }
    .i-res-head h1 { margin: 6px 0 10px; font-size: clamp(24px, 4vw, 34px); }
    .i-res-head p { max-width: 62ch; }
    .i-res-hint { margin: 0 0 16px !important; font-size: 13px; color: var(--i-muted); text-transform: none; }

    .i-res-grid { display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); }
    .i-res-card { display: flex; flex-direction: column; text-decoration: none; }
    .i-res-card:hover { border-color: color-mix(in srgb, var(--i-signal) 40%, var(--i-line)); }
    .i-res-title { display: block; font-family: "Chakra Petch", sans-serif; font-weight: 600; font-size: 16px; color: var(--i-ink); }
    .i-res-author { display: block; margin-top: 4px; font-size: 11.5px; color: var(--i-muted); }
    .i-res-blurb { display: block; margin-top: 10px; font-size: 13.5px; flex: 1; }
    .i-res-go { margin-top: 14px; font-family: "JetBrains Mono", monospace; font-size: 12px; letter-spacing: 0.08em; color: var(--i-filament); }
  </style>
</Base>
