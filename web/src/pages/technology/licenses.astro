---
import Base from '../../layouts/Base.astro';
import InstituteRail from '../../components/institute/InstituteRail.astro';

const rows = [
  {
    what: 'AI Engineering from Scratch',
    who: 'Rohit Ghumare and contributors',
    license: 'MIT License',
    use: 'The AI-engineering phases are adapted from this curriculum, used under the MIT License. Modifications: reformatted into Sikhi University’s course structure, with a browser code lab, quizzes, and seva-framed introductions added. The full MIT text is retained in the repository and linked from every phase.',
    link: 'https://aiengineeringfromscratch.com',
  },
  {
    what: 'Sikh Code — Learn Coding, Learn Agentic Coding, Claude Code Guide, Build for the Panth',
    who: 'Sikhi University',
    license: 'CC BY-SA 4.0 (prose) · MIT (engine code)',
    use: 'Written by Sikhi University for the Institute. The Learn Agentic Coding course tracks the public Claude Code documentation and links to it; no Anthropic branding is used beyond naming the product.',
    link: 'https://sikhi.io',
  },
  {
    what: 'Awesome Cyber Security University (Cybersecurity School — path sequencing)',
    who: 'Oaker Min (brootware) and contributors',
    license: 'CC0 1.0 Universal (public domain dedication)',
    use: 'The Cybersecurity School’s four practitioner paths — foundations, defence, offence, and the range — follow this roadmap’s sequencing, which its authors placed in the public domain under CC0 1.0. Modifications: re-cut into the Institute’s module structure, with Sikhi University’s own objectives, teaching notes, and seva-framed introductions written around each module, and the list narrowed to a syllabus. CC0 requires no attribution; we credit it because it is the right thing to do.',
    link: 'https://github.com/brootware/awesome-cyber-security-university',
  },
  {
    what: 'Cybersecurity training platforms (TryHackMe, CyberDefenders, OverTheWire, picoCTF, CryptoHack, echoCTF.RED, LabEx, Cyborg Security)',
    who: 'Each platform’s own operator',
    license: 'Link-out only — no content used',
    use: 'Every lab in the Cybersecurity School opens on the platform that runs it. No room, challenge, write-up, walkthrough, flag, or lab environment is copied or rehosted here, and no account or paywall is circumvented. Each card states the platform and whether a free account is needed. Sikhi University is not affiliated with, sponsored by, or endorsed by any of them; their names are used nominatively to say where a lab lives.',
    link: 'https://brootware.github.io/awesome-cyber-security-university/',
  },
  {
    what: 'SANS Institute free resources (bench references)',
    who: 'Escal Institute of Advanced Technologies, Inc. (SANS Institute)',
    license: 'Copyright SANS — free to download, licensed for non-commercial use only. Not an open licence.',
    use: 'The Cybersecurity School links to SANS’s free posters, cheat sheets, and security policy templates as bench references. Nothing is copied, mirrored, or redistributed — every reference opens on sans.org, where SANS’s own terms apply. Because these materials are licensed for non-commercial use and are not openly licensed, they are linked and never rehosted. “SANS” is a trademark of the Escal Institute of Advanced Technologies, Inc.; Sikhi University is not affiliated with, sponsored by, or endorsed by SANS.',
    link: 'https://www.sans.org/security-resources/download',
  },
  {
    what: 'NICCS · CISA and CYBER.ORG (Cyber for Schools & Families)',
    who: 'US Cybersecurity and Infrastructure Security Agency; CYBER.ORG (Cyber Innovation Center)',
    license: 'NICCS/CISA pages: US Government work, public domain (17 U.S.C. § 105) · CYBER.ORG curriculum and range: CYBER.ORG’s own, free to educators',
    use: 'The “Cyber for Schools & Families” path is a reading map over public NICCS, CISA, and CYBER.ORG pages, written for Khalsa school staff, gurdwara youth programmes, and parents. Every item links out; no curriculum, lesson plan, lab, or range content is copied, and CYBER.ORG material is reached through CYBER.ORG’s own accounts under its own terms. Agency seals and logos are not used. Sikhi University is not affiliated with, sponsored by, or endorsed by CISA, DHS, NICCS, or CYBER.ORG, and this listing implies no endorsement of Sikhi University by them.',
    link: 'https://niccs.cisa.gov/news-events/featured-stories/check-out-k-12-cyber-resources-educators',
  },
  {
    what: 'Awesome CloudSec Labs (Cloud Security path — lab discovery)',
    who: 'Jason Ostrom (iknowjason) and contributors',
    license: 'No stated licence — linked, never adapted',
    use: 'This directory has no LICENSE file, which under default copyright means all rights reserved — so unlike the CC0 roadmap behind the school’s other paths, the Institute does not adapt it. The Cloud Security path’s modules are organised by platform on our own editorial judgement, every teaching note is written by Sikhi University, and the directory is credited and linked as where the labs were found. Nothing from it is reproduced.',
    link: 'https://github.com/iknowjason/Awesome-CloudSec-Labs',
  },
  {
    what: 'Cloud security lab projects (CloudGoat, IAM Vulnerable, CloudFoxable, AzureGoat, EntraGoat, BadZure, Kubernetes Goat, TerraGoat, CI/CD Goat and others)',
    who: 'Rhino Security Labs, Bishop Fox, INE Labs, Semperis, NCC Group, Wiz, XM Cyber, Mandiant, Madhu Akula, Rory McCune, Bridgecrew, Cider Security, StepSecurity, Ermetic and others',
    license: 'Each project keeps its own licence — check it before you run one',
    use: 'Every lab in the Cloud Security path is linked at its own home and none is copied, forked, mirrored, or rehosted here. These are deliberately vulnerable environments: most are self-hosted, meaning you deploy them into your own cloud account, at your own cost and your own risk. The path says so before the first module. Provider names are used nominatively to say who publishes each lab; no affiliation or endorsement is claimed by or of any of them.',
    link: 'https://github.com/iknowjason/Awesome-CloudSec-Labs',
  },
  {
    what: 'Google Skills (Cloud Security path, Explore booth)',
    who: 'Google LLC',
    license: 'Link-out only — no content used',
    use: 'Google Skills — formerly Cloud Skills Boost, formerly Qwiklabs — is linked for its labs, courses, and skill badges. No course, lab, video, or assessment content is copied. Badges and certificates are issued by Google alone; the Google Cloud career certificates sit behind Google’s own subscription and the Institute neither resells nor discounts them. “Google”, “Google Cloud” and their product names are trademarks of Google LLC, used nominatively. Sikhi University is not affiliated with, sponsored by, or endorsed by Google.',
    link: 'https://www.skills.google/',
  },
  {
    what: 'Apple Professional Training (School of IT — IT Support path)',
    who: 'Apple Inc.',
    license: 'Link-out only — no content used',
    use: 'The Apple Device Support, Apple Deployment and Management, and Mac Security Compliance courses are published free and self-paced by Apple on it-training.apple.com, and are linked there. No tutorial text, video, exercise, or assessment is reproduced here. Certification exams are paid and are administered and awarded by Apple alone — the Institute confers nothing and the path says so on every card. “Apple”, “Mac”, “macOS”, “Apple Business Manager” and “Apple School Manager” are trademarks of Apple Inc., used nominatively. Sikhi University is not affiliated with, sponsored by, or endorsed by Apple, and no Apple branding or logo is used.',
    link: 'https://it-training.apple.com/',
  },
  {
    what: 'Microsoft Learn credentials (School of IT — IT Support path)',
    who: 'Microsoft Corporation',
    license: 'Link-out only — no content used',
    use: 'Microsoft Learn training and the credentials catalogue are linked, never copied. The path distinguishes Applied Skills (lab-based, currently free end to end) from certifications (exam-based and paid) because that difference decides what a student can afford — but exam pricing and programme terms are Microsoft’s and can change, so the vendor’s page is authoritative, not ours. Credentials are awarded by Microsoft alone. “Microsoft”, “Azure”, “Windows” and “Microsoft 365” are trademarks of Microsoft Corporation, used nominatively; Sikhi University is not affiliated with, sponsored by, or endorsed by Microsoft.',
    link: 'https://learn.microsoft.com/en-us/credentials/',
  },
  {
    what: 'Undercode Testing — free certification course roundup (More resources, bench reference)',
    who: 'Undercode Testing',
    license: 'Link-out only — no content used',
    use: 'Linked as a community aggregator of free security and cloud certification courses. Their selection and editorial are their own; none of it is reproduced, and the Institute does not vouch for the individual courses it lists. Not affiliated with or endorsed by Undercode Testing.',
    link: 'https://undercodetesting.com/free-cybersecurity-and-cloud-certification-courses/',
  },
  {
    what: 'Cert Prep (Certifications section, Explore booth, catalogue)',
    who: 'Dosanjh Labs — the same team as Sikhi University',
    license: 'Sibling site — link-out only, no content used',
    use: 'The Institute links to Cert Prep for PMP, CISM, and CompTIA Security+ preparation. It is a separate site with its own content; nothing is copied or rehosted here, and the link is disclosed as a sibling project rather than an unaffiliated recommendation. “PMP” is a registered mark of the Project Management Institute, “CISM” of ISACA, and “Security+” of CompTIA, used nominatively to name the exams. Neither Sikhi University nor Dosanjh Labs is affiliated with, sponsored by, or endorsed by PMI, ISACA, or CompTIA; those bodies alone set and award their certifications, and no preparation site can confer one.',
    link: 'https://cert-prep.dosanjhlabs.com/',
  },
  {
    what: 'freeCodeCamp curriculum (Explore booth)',
    who: 'freeCodeCamp.org (a 501(c)(3) non-profit)',
    license: 'Curriculum: CC BY-SA 4.0 · Platform code: BSD-3-Clause',
    use: 'The Institute links to the freeCodeCamp curriculum and rehosts none of it. Sikhi University is not affiliated with, sponsored by, or endorsed by freeCodeCamp.org. Certifications are issued by freeCodeCamp. “freeCodeCamp” and its logo are trademarks of freeCodeCamp.org.',
    link: 'https://www.freecodecamp.org/learn/',
  },
  {
    what: 'Class Central (Explore booth)',
    who: 'Class Central SL',
    license: 'Link-out only — no content used',
    use: 'The Institute links to Class Central as a course-discovery aggregator and uses none of its listings, ratings, or editorial content. “Class Central” is a trademark of Class Central SL, used nominatively to name the service; no affiliation or endorsement is claimed.',
    link: 'https://www.classcentral.com/',
  },
  {
    what: 'Libre.academy (Explore booth)',
    who: 'Libre.academy',
    license: 'App: MIT · Course packs: various (several CC BY-NC / BY-NC-ND)',
    use: 'The Institute links to the Libre.academy desktop app and rehosts none of its course packs. Each pack is adapted from a separate book — several under non-commercial or no-derivatives terms (Eloquent JavaScript, You Don’t Know JS Yet, Pro Git, JavaScript.info, Automate the Boring Stuff) — which is why this booth links out rather than rehosting.',
    link: 'https://libre.academy/',
  },
  {
    what: 'Open Source Atlas — repository catalogue',
    who: 'Curated by Tom Dörr (repo_posts)',
    license: 'Repo metadata: factual, from public sources · curation credited',
    use: 'The Atlas lists ~12,500 open-source repositories with their names, one-line descriptions, and dates, drawn from Tom Dörr’s public curation at tom-doerr.github.io/repo_posts. Screenshots are GitHub’s own OpenGraph cards, loaded from GitHub — none are stored. The “what you could build for the Panth” line on each card is written by Sikhi University. Every listed project keeps its own licence; check it on GitHub before use.',
    link: 'https://tom-doerr.github.io/repo_posts/',
  },
  {
    what: 'Anthropic Academy (Learning Claude page)',
    who: 'Anthropic PBC',
    license: 'Link-out only — no content used',
    use: 'The /technology/claude page lists Anthropic Academy’s course catalogue as an outline and links each course straight to anthropic.skilljar.com. No course content, video, or text is copied. Sikhi University is not affiliated with, sponsored by, or endorsed by Anthropic. “Claude” and “Anthropic” are trademarks of Anthropic PBC, used nominatively.',
    link: 'https://www.anthropic.com/learn',
  },
  {
    what: 'Claude 101 (claude101.com)',
    who: 'A community project',
    license: 'Link-out only — no content used',
    use: 'Linked from /technology/claude as a community companion. None of its 18 guides are rehosted. Not affiliated with Anthropic or Sikhi University.',
    link: 'https://claude101.com',
  },
  {
    what: 'Open Source Atlas — video shelf',
    who: 'Andrej Karpathy, Cloud Codes, Proton (YouTube)',
    license: 'Link/embed only — no content rehosted',
    use: 'The Atlas embeds videos from three YouTube channels — Andrej Karpathy (from-scratch deep learning), Cloud Codes (AI engineering), and Proton (privacy and security) — via youtube-nocookie.com. No video content is stored; each plays from YouTube. Titles and dates come from the channels’ public feeds. Not affiliated with or endorsed by any of them.',
    link: 'https://www.youtube.com/@AndrejKarpathy',
  },
  {
    what: 'Loop Library (More resources)',
    who: 'Forward Future',
    license: 'Link-out only — no content used',
    use: 'The More Resources shelf links to Forward Future’s Loop Library, a community-contributed collection of AI-agent workflow prompts. No prompt text is rehosted. Not affiliated with or endorsed by Forward Future.',
    link: 'https://signals.forwardfuture.com/loop-library/',
  },
  {
    what: 'The Coding Interview (More resources)',
    who: 'Matthias Endler (mre) and contributors',
    license: 'MIT License',
    use: 'The More Resources shelf links to this repository of interview exercises and katas. Nothing is copied or rehosted — the card links straight to GitHub.',
    link: 'https://github.com/mre/the-coding-interview',
  },
  {
    what: 'Awesome Learn to Code (More resources)',
    who: 'md8-habibullah',
    license: 'Apache License 2.0',
    use: 'The More Resources shelf links to this directory of beginner-friendly open-source repositories. Nothing is copied or rehosted — the card links straight to GitHub Pages.',
    link: 'https://md8-habibullah.github.io/awesome-learn-to-code/',
  },
  {
    what: 'More resources — books & paid courses',
    who: 'Various publishers and authors (see each card)',
    license: 'Link-out only — no content used',
    use: 'The books and paid-course cards on /technology/resources are pointers, not content: titles, authors, and one-line descriptions written by Sikhi University, each linking to the publisher’s or provider’s own page. No book text, course video, or paywalled material is copied or rehosted. Sikhi University is not affiliated with, sponsored by, or endorsed by any publisher or provider listed.',
    link: '/technology/resources',
  },
];
---
<Base title="Sources & licenses — Institute of Technology" description="Every content source behind the Institute of Technology, and the license it is used under." institute>
  <InstituteRail />

  <section class="i-wrap" style="padding:40px 24px 72px">
    <span class="i-label">/technology/licenses</span>
    <h1 style="margin:6px 0 10px;font-size:clamp(24px,4vw,34px)">Sources &amp; licenses</h1>
    <p class="i-prose">The Institute is only as legitimate as its content rights. Every source here is either ours or openly licensed, used with attribution and — where required — share-alike, and nothing is rehosted without permission.</p>

    <div class="i-lic-list">
      {rows.map((r) => (
        <article class="i-panel" style="margin-top:14px">
          <span class="i-corner">{r.license}</span>
          <h2 style="margin:6px 0 0;font-size:17px">{r.what}</h2>
          <p class="i-mono" style="margin:4px 0 0;font-size:12px;color:var(--i-muted)">{r.who}</p>
          <p class="i-prose" style="margin:10px 0 0;font-size:14px">{r.use}</p>
          <p style="margin:10px 0 0;font-size:13px"><a href={r.link} target="_blank" rel="noopener">{r.link} &nearr;</a></p>
        </article>
      ))}
    </div>

    <article class="i-panel" style="margin-top:14px">
      <span class="i-corner">CC BY-SA 4.0</span>
      <h2 style="margin:6px 0 0;font-size:17px">The Institute's own additions</h2>
      <p class="i-prose" style="margin:10px 0 0;font-size:14px">
        Everything Sikhi University wrote for the Institute — the seva-framed phase and path introductions, the code-lab exercises and checks, the Cybersecurity School's module objectives and teaching notes, the "Build for the Panth" project briefs, and this page — is offered under <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener">Creative Commons Attribution-ShareAlike 4.0</a>, matching the university's open-content posture. The engine code (the code lab, the terminal dojo) is MIT. Course content is authoritative in English; it is never machine-translated for the Institute.
      </p>
    </article>

    <p class="i-prose" style="margin-top:28px;font-size:13px;color:var(--i-muted)">
      The Institute is governed by the same <a href="/legal">Terms &amp; Privacy</a> as the rest of Sikhi University. The Explore booths above all link out and rehost nothing, and so does every lab and bench reference in the <a href="/technology/school/cybersecurity">Cybersecurity School</a>.
    </p>
    <p class="i-prose" style="margin-top:14px;font-size:13px;color:var(--i-muted)">
      A note on the Cybersecurity School specifically: its techniques are dual-use, and it is taught for defence and for authorised testing only. Running any of it against a system you do not own or have written permission to test is a criminal offence in most jurisdictions, and is not something this Institute teaches or condones.
    </p>
  </section>
</Base>
