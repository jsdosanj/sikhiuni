---
import Base from '../../../layouts/Base.astro';
import InstituteRail from '../../../components/institute/InstituteRail.astro';
import CodeLab from '../../../components/institute/CodeLab.astro';
import { phases, trackById } from '../../../lib/institute';

// Every imported AISF lesson. path = "<track>/<slug>" (a rest param so the
// slash stays in the URL). Lesson JSON is read at build time from imported/;
// the quiz is rendered WITHOUT answers (server grades via /api/quiz).
const lessons = import.meta.glob('../../../data/institute/imported/*/*.json', { eager: true });
const indexes = import.meta.glob('../../../data/institute/imported/*/index.json', { eager: true });
// Our own additions (C7): an authored code-lab exercise for a lesson lives in
// ours/<track>/<slug>.json and is NEVER touched by a re-sync of imported/.
const oursMods = import.meta.glob('../../../data/institute/ours/*/*.json', { eager: true });

export async function getStaticPaths() {
  const all = import.meta.glob('../../../data/institute/imported/*/*.json', { eager: true });
  const out = [];
  for (const [file, mod] of Object.entries(all)) {
    if (file.endsWith('/index.json')) continue;
    const m = file.match(/imported\/([^/]+)\/([^/]+)\.json$/);
    if (!m) continue;
    out.push({ params: { path: `${m[1]}/${m[2]}` }, props: { lesson: mod.default ?? mod } });
  }
  return out;
}

const { lesson } = Astro.props;
const [trackId, slug] = Astro.params.path.split('/');
const track = trackById(trackId);
const idxMod = indexes[`../../../data/institute/imported/${trackId}/index.json`];
const idx = (idxMod && (idxMod.default ?? idxMod)) || { lessons: [] };
const pos = idx.lessons.findIndex((l) => l.slug === slug);
const prev = pos > 0 ? idx.lessons[pos - 1] : null;
const next = pos >= 0 && pos < idx.lessons.length - 1 ? idx.lessons[pos + 1] : null;

const codeEntries = Object.entries(lesson.code || {});
const LANG_NAME = { py: 'Python', ts: 'TypeScript', js: 'JavaScript', rs: 'Rust', jl: 'Julia' };

const oursMod = oursMods[`../../../data/institute/ours/${trackId}/${slug}.json`];
const ours = (oursMod && (oursMod.default ?? oursMod)) || null;
// A code-lab exercise: our own hands-on bench for this lesson. Runs in the
// browser (JS / Python-via-Pyodide / HTML) and marks the lesson done on a pass.
const lab = ours?.lab || null;
const labId = lab ? `${trackId}::${slug}::lab` : '';

const ld = {
  '@context': 'https://schema.org', '@type': 'LearningResource',
  name: lesson.title, learningResourceType: 'lesson',
  isAccessibleForFree: true, inLanguage: 'en',
  educationalLevel: track?.level ?? 100,
  isPartOf: { '@type': 'Course', name: track?.title || trackId },
};
---
<Base
  title={`${lesson.title}, ${track?.title || 'Institute of Technology'}`}
  description={lesson.tagline || `${lesson.title}, a lesson in ${track?.title || 'the Institute of Technology'}.`}
  institute ogType="article"
>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} slot="head" />
  <InstituteRail />

  <div class="i-lessonwrap">
    <header class="i-lesson-head">
      <a class="i-lesson-crumb i-mono" href={`/technology/track/${track?.slug || trackId}`}>&larr; {track?.title || trackId}</a>
      <h1>{lesson.title}</h1>
      {lesson.tagline && <p class="i-prose i-lesson-tag">{lesson.tagline}</p>}
      <p class="i-mono i-lesson-meta">
        {[lesson.type, lesson.time, lesson.languages].filter(Boolean).join(' · ')}
      </p>
      {lesson.objectives?.length > 0 && (
        <div class="i-lesson-obj">
          <span class="i-label">what you'll be able to do</span>
          <ul>{lesson.objectives.map((o) => <li>{o}</li>)}</ul>
        </div>
      )}
    </header>

    <article class="i-lesson-prose" set:html={lesson.prose_html}></article>

    {codeEntries.length > 0 && (
      <section class="i-lesson-code">
        <span class="i-label">the code, run it on your machine from the repo root</span>
        {codeEntries.map(([k, src]) => (
          <details class="i-panel" open={k === 'py'}>
            <summary class="i-corner">{LANG_NAME[k] || k}</summary>
            <pre><code class={`language-${k === 'py' ? 'python' : k === 'ts' ? 'typescript' : k}`}>{src}</code></pre>
          </details>
        ))}
        <p class="i-prose" style="font-size:13px;color:var(--i-muted)">
          Rust and Julia don't run in the browser lab, copy the code and run it locally.
          {lab ? ' The exercise below runs right here.' : ' Python and JavaScript exercises run right here in some lessons.'}
        </p>
      </section>
    )}

    {lab && (
      <section class="i-lesson-lab">
        <span class="i-label">{lab.prompt ? 'exercise' : 'try it, the bench runs in your browser'}</span>
        {lab.prompt && <p class="i-prose i-lesson-lab-prompt" set:html={lab.prompt}></p>}
        <CodeLab
          id={labId}
          lang={lab.lang || 'js'}
          starter={lab.starter}
          checks={lab.checks || []}
          solution={lab.solution}
          title={lab.title}
          track={trackId}
          lessonIndex={pos}
        />
        {(lab.lang || 'js') === 'py' && (
          <p class="i-prose" style="font-size:12.5px;color:var(--i-muted);margin-top:8px">
            The first Run downloads Python (Pyodide) in your browser, a few seconds once, then it is instant.
          </p>
        )}
      </section>
    )}

    {lesson.quiz?.length > 0 && (
      <section class="i-lesson-quiz" data-lesson-id={lesson.id}>
        <span class="i-label">check your understanding</span>
        <form class="i-quiz-form">
          {lesson.quiz.map((q, i) => (
            <fieldset class="i-quiz-q">
              <legend>{i + 1}. {q.q}</legend>
              {q.options.map((opt, j) => (
                <label><input type="radio" name={`q${i}`} value={j} /> {opt}</label>
              ))}
            </fieldset>
          ))}
          <button type="submit" class="i-btn i-btn-primary">Submit</button>
          <p class="i-quiz-result i-mono" role="status" aria-live="polite"></p>
        </form>
      </section>
    )}

    <nav class="i-lesson-nav">
      {prev
        ? <a class="i-btn i-btn-ghost" href={`/technology/lesson/${trackId}/${prev.slug}`}>&larr; {prev.title}</a>
        : <span></span>}
      {next
        ? <a class="i-btn i-btn-ghost" href={`/technology/lesson/${trackId}/${next.slug}`}>{next.title} &rarr;</a>
        : <a class="i-btn i-btn-primary" href={`/technology/track/${track?.slug || trackId}`}>Finish the phase &rarr;</a>}
    </nav>
  </div>

  <style>
    .i-lessonwrap { max-width: 780px; margin: 0 auto; padding: 32px 24px 80px; }
    .i-lesson-head { border-bottom: 1px solid var(--i-line); padding-bottom: 22px; margin-bottom: 26px; }
    .i-lesson-crumb { display: inline-block; font-size: 12px; color: var(--i-ink-dim); text-decoration: none; margin-bottom: 12px; }
    .i-lesson-crumb:hover { color: var(--i-filament); }
    .i-lesson-head h1 { font-size: clamp(24px, 4vw, 33px); margin: 0; }
    .i-lesson-tag { margin: 10px 0 0; font-size: 17px; }
    .i-lesson-meta { margin: 12px 0 0; font-size: 11px; color: var(--i-muted); letter-spacing: 0.05em; text-transform: uppercase; }
    .i-lesson-obj { margin-top: 18px; }
    .i-lesson-obj ul { margin: 8px 0 0; padding-left: 18px; }
    .i-lesson-obj li { color: var(--i-ink-dim); line-height: 1.7; }

    .i-lesson-prose { line-height: 1.72; color: var(--i-ink-dim); }
    .i-lesson-prose :global(h2) { font-family: "Chakra Petch", sans-serif; font-weight: 600; color: var(--i-ink); font-size: 20px; margin: 32px 0 10px; }
    .i-lesson-prose :global(h3) { font-family: "Chakra Petch", sans-serif; font-weight: 600; color: var(--i-ink); font-size: 16px; margin: 24px 0 8px; }
    .i-lesson-prose :global(p) { margin: 0 0 14px; }
    .i-lesson-prose :global(strong) { color: var(--i-ink); }
    .i-lesson-prose :global(a) { color: var(--i-filament); }
    .i-lesson-prose :global(ul), .i-lesson-prose :global(ol) { margin: 0 0 14px; padding-left: 22px; }
    .i-lesson-prose :global(li) { margin: 4px 0; }
    .i-lesson-prose :global(pre) {
      background: var(--i-surface-2); border: 1px solid var(--i-line); border-radius: var(--i-r-md);
      padding: 14px 16px; overflow-x: auto; margin: 0 0 16px;
      font-family: "JetBrains Mono", monospace; font-size: 12.5px; line-height: 1.7; color: var(--i-ink);
    }
    .i-lesson-prose :global(code) { font-family: "JetBrains Mono", monospace; font-size: 0.92em; }
    .i-lesson-prose :global(p > code), .i-lesson-prose :global(li > code) {
      background: var(--i-surface); border: 1px solid var(--i-line-soft); border-radius: 3px; padding: 1px 5px; color: var(--i-ink);
    }
    .i-lesson-prose :global(table) { border-collapse: collapse; width: 100%; margin: 0 0 16px; font-size: 13.5px; }
    .i-lesson-prose :global(th), .i-lesson-prose :global(td) { border: 1px solid var(--i-line); padding: 7px 10px; text-align: left; }
    .i-lesson-prose :global(th) { background: var(--i-surface); color: var(--i-ink); }
    .i-lesson-prose :global(blockquote) { border-left: 2px solid var(--i-filament-dim); padding-left: 16px; margin: 0 0 16px; color: var(--i-ink-dim); }
    .i-lesson-prose :global(.mermaid) {
      background: var(--i-surface); border: 1px solid var(--i-line); border-radius: var(--i-r-md);
      padding: 16px; margin: 0 0 16px; text-align: center; overflow-x: auto;
    }
    .i-lesson-prose :global(.i-lesson-figure) { font-size: 13px; color: var(--i-muted); }
    /* Imported diagram (![alt](../assets/x.svg)). The source SVGs are drawn for
       a light page, so they sit on a light card in both themes, same call the
       Atlas makes for GitHub's OG cards. */
    .i-lesson-prose :global(.i-lesson-fig) {
      margin: 0 0 18px; padding: 14px; border: 1px solid var(--i-line);
      border-radius: var(--i-r-md); background: #f7f4ee; text-align: center;
    }
    .i-lesson-prose :global(.i-lesson-fig img) { max-width: 100%; height: auto; }
    .i-lesson-prose :global(.i-lesson-fig figcaption) {
      margin-top: 10px; font-size: 12px; line-height: 1.5; color: #5a5344;
      font-family: "JetBrains Mono", monospace;
    }

    .i-lesson-lab { margin: 34px 0; }
    .i-lesson-lab > .i-label { display: block; margin-bottom: 10px; }
    .i-lesson-lab-prompt { margin: 0 0 14px; }

    .i-lesson-code { margin: 34px 0; }
    .i-lesson-code .i-panel { margin-top: 10px; padding: 0; }
    .i-lesson-code summary { padding: 10px 14px; cursor: pointer; }
    .i-lesson-code pre { margin: 0; border-top: 1px solid var(--i-line); border-radius: 0 0 var(--i-r-md) var(--i-r-md); background: var(--i-surface-2); padding: 14px 16px; overflow-x: auto; font-family: "JetBrains Mono", monospace; font-size: 12.5px; line-height: 1.7; color: var(--i-ink); }

    .i-lesson-quiz { margin: 34px 0; }
    .i-quiz-form { margin-top: 12px; }
    .i-quiz-q { border: 1px solid var(--i-line); border-radius: var(--i-r-md); padding: 14px 16px; margin: 0 0 12px; }
    .i-quiz-q legend { font-family: "Chakra Petch", sans-serif; font-weight: 600; color: var(--i-ink); padding: 0 6px; }
    .i-quiz-q label { display: block; padding: 5px 0; color: var(--i-ink-dim); cursor: pointer; }
    .i-quiz-q input { margin-right: 8px; accent-color: var(--i-signal); }
    .i-quiz-result { margin-top: 10px; }
    .i-quiz-result.pass { color: var(--i-signal); }
    .i-quiz-result.fail { color: var(--i-fail); }

    .i-lesson-nav { display: flex; justify-content: space-between; gap: 12px; margin-top: 40px; flex-wrap: wrap; }
  </style>

  <script>
    import { initLesson } from '../../../lib/institute/lesson';
    initLesson();
  </script>
</Base>
