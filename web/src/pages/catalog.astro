    #level-filters button { min-height:40px; border-radius:3px; }
    @media(min-width:1024px) { .catalog-filter-rail { position:sticky; top:90px; max-height:calc(100dvh - 110px); overflow-y:auto; padding-inline-end:12px; scrollbar-width:thin; } }
    @media(max-width:1023px) { #cat-filters { flex-direction:row; flex-wrap:nowrap; overflow-x:auto; padding-bottom:10px; gap:8px; } #cat-filters button { flex-shrink:0; gap:12px; border:1px solid rgb(var(--c-line)); border-radius:3px; padding-inline:12px; } }

    /* CSS-only fade when the catalogue grid first paints. Per-card reveal would
       replay every time the filter toggles display:none/'' on items, so the
       whole ledger fades once instead. Frozen by the global reduced-motion guard. */
    @keyframes su-cat-fade { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
    #view-catalog { animation: su-cat-fade .5s cubic-bezier(.2,.7,.3,1) both; }

    .catalog-intro { padding-top:48px; }
    .catalog-intro h1 { max-width:16ch; font-size:clamp(36px,4.6vw,65px); letter-spacing:-.055em; line-height:1.06; }
    .catalog-intro .rule-navy { padding-bottom:32px; }
    .catalog-totals { border-left:1px solid rgb(var(--c-line)); padding-left:32px; }
    #tabbar { border:0; border-bottom:1px solid rgb(var(--c-line)); background:transparent; padding:0; gap:22px; width:100%; border-radius:0; }
    #tabbar button { background:transparent; border-bottom:3px solid transparent; color:rgb(var(--c-muted)); padding:15px 3px; border-radius:0; }
    #tabbar [aria-selected="true"] { border-bottom-color:rgb(var(--c-saffron-deep)); color:rgb(var(--c-navy)); font-weight:650; }
    .catalog-search-box { border-radius:12px; padding:18px 24px; border:1px solid rgb(var(--c-line)); box-shadow:0 4px 18px #152c4910; }
    .catalog-toolbar { display:flex; justify-content:space-between; gap:15px; align-items:center; margin-top:20px; color:rgb(var(--c-muted)); font-size:12px; }
    .catalog-toolbar>div { display:flex; gap:12px; align-items:center; flex-wrap:wrap; }
    .catalog-toolbar select,.catalog-toolbar button { min-height:38px; border:1px solid rgb(var(--c-line)); border-radius:6px; padding:8px 10px; background:rgb(var(--c-surface)); color:rgb(var(--c-navy)); }
    .catalog-filter-rail { padding:20px 16px; border:1px solid rgb(var(--c-line)); border-radius:12px; background:rgb(var(--c-surface)); }
    #cat-filters button { font-size:12px; min-height:38px; border-bottom:0; margin:1px 0; }
    #cat-filters [aria-pressed="true"] { background:rgb(var(--c-paper)); }
    #level-filters { gap:6px; } #level-filters button { font-size:10px; padding:6px 10px; }
    .cat-group { border:1px solid rgb(var(--c-line)); background:rgb(var(--c-surface)); border-radius:12px; overflow:hidden; }
    .cat-group>.rule-navy { padding:22px; border-bottom:1px solid rgb(var(--c-line)); background:rgb(var(--c-paper)); }
    .cat-group h2 { font-size:23px; }.cat-group>.rule-navy>span:last-child { font-size:12px; }
    .cat-item { display:flex; align-items:flex-start; padding:24px 22px; gap:20px; border-bottom:1px solid rgb(var(--c-line)); }
    .cat-item:last-child { border-bottom:0; }.cat-item:hover { background:rgb(var(--c-paper)); }
    .cat-stage { flex:0 0 70px; padding-top:4px; font:10px/1.6 'IBM Plex Mono',monospace; color:rgb(var(--c-saffron-deep)); }
    .cat-course-main { flex:1; min-width:0; }.cat-course-main strong { display:block; font-size:17px; line-height:1.4; color:rgb(var(--c-navy)); font-weight:650; }
    .cat-summary { display:block; font-size:13px; line-height:1.65; color:rgb(var(--c-muted)); margin-top:7px; max-width:65ch; }
    .cat-teacher { display:block; font-size:11px; margin-top:10px; color:rgb(var(--c-muted)); }
    .cat-course-end { display:flex; flex-direction:column; align-items:flex-end; gap:14px; flex:0 0 75px; font-size:10px; color:rgb(var(--c-muted)); }.cat-course-end>span:last-child { font-size:24px; color:rgb(var(--c-saffron-deep)); }
    .catalog-compact .cat-summary,.catalog-compact .cat-teacher { display:none; }.catalog-compact .cat-item { padding-block:15px; }.catalog-compact .cat-course-end { flex-direction:row; flex-basis:90px; align-items:center; }
    @media(max-width:700px) { .catalog-totals { border-left:0; padding-left:0; }.catalog-toolbar { align-items:start; flex-direction:column; }.cat-item { flex-wrap:wrap; gap:8px; padding:20px 16px; }.cat-stage { flex-basis:100%; }.cat-course-end { flex-basis:60px; }.cat-course-main strong { font-size:16px; }#tabbar { gap:14px; }#tabbar button { font-size:12px; }.catalog-filter-rail { padding:15px; } }
  </style>

  <style is:global>
    html[data-theme="light"] body.su-catalog { background:#f7f4ed; --c-paper:247 244 237; --c-surface:255 253 248; --c-line:218 211 198; }
