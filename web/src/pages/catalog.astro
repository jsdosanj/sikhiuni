---
import { stageName } from '../lib/stages';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { topics, published, topicName, paths, TOPIC_ICONS } from '../lib/data';
import programsData from '../../public/assets/data/programs.json';
const sorted = [...published].sort((a, b) => a.level - b.level);
const byId = Object.fromEntries(published.map((c) => [c.id, c]));
// NOTE: the `filt` class and the data-t / data-l attributes are JS hooks
// (see the script below, setActive() toggles bg-brand/text-white/border-navy/
// text-muted/bg-surface on these). Style around them, never rename them.
const btn = 'filt rounded-full border border-line bg-surface px-4 py-1.5 font-sans text-muted cursor-pointer transition duration-200 hover:-translate-y-px hover:border-saffron hover:text-navy hover:shadow-card';
import { SITE } from '../lib/site';
const itemListLd = {
  '@context': 'https://schema.org', '@type': 'ItemList',
  name: 'Sikhi University course catalogue', numberOfItems: sorted.length,
  itemListElement: sorted.map((c, i) => ({ '@type': 'ListItem', position: i + 1, url: `${SITE}/course/${c.id}`, name: c.title })),
};

// Values are icon names from web/src/lib/icons.ts (rendered via <Icon>).
const CURATED_ICONS: Record<string, string> = {
  gurbani: 'book', foundations: 'diya', 'history-journey': 'scroll', language: 'pen',
  'spiritual-practice': 'meditation', 'philosophy-thought': 'thought', 'arts-culture': 'palette',
  'modern-skills': 'robot', teekas: 'books',
};
const GRADS = [
  'from-brand to-navy-soft', 'from-[#8a5a14] to-[#c98a1a]', 'from-[#1d4e89] to-[#2f7d4f]',
  'from-[#5c3b8a] to-[#1d4e89]', 'from-[#0f7b6c] to-[#16335c]', 'from-[#a23b2e] to-[#8a5a14]',
];
const iconFor = (p: typeof paths[number]) =>
  p.id.startsWith('topic-') ? (TOPIC_ICONS[p.id.slice(6)] || 'book') : (CURATED_ICONS[p.id] || 'cap');
const featured = paths.filter((p) => !p.id.startsWith('topic-'));
const subjects = paths.filter((p) => p.id.startsWith('topic-'));
const withGrad = (list: typeof paths, offset: number) => list.map((p, gi) => ({ p, grad: GRADS[(gi + offset) % GRADS.length] }));
const progTypeOrder = ['certificate', 'associate', 'bachelor', 'master', 'giani'];
const progTypeLabel: Record<string, string> = { certificate: 'Certificates', associate: 'Associate Degree', bachelor: "Bachelor's Degrees", master: "Master's Degrees", giani: 'Giani, Highest Distinction' };
const progTypeBg: Record<string, string> = { certificate: 'bg-saffron-soft', associate: 'bg-blue-50 dark:bg-blue-950/20', bachelor: 'bg-paper', master: 'bg-navy/5 dark:bg-navy/20', giani: 'bg-saffron-soft' };
const grouped = progTypeOrder.map((t) => ({ type: t, label: progTypeLabel[t], programs: programsData.programs.filter((p) => p.type === t) }));

// --- Registrar's-ledger catalogue grouping (task 6: iscatalog, lines 429-462) ---
// Schools are real topics (web/src/lib/data.ts), sorted the same way the left
// filter rail already sorted them, so the roman-numeral index the two lists
// share always lines up. No invented course codes (Decision 12): the short
// mono label beside each row is derived from the real topic id, never a
// fabricated "THEO 110"-shaped code.
const topicsAlpha = [...topics].sort((a, b) => a.name.localeCompare(b.name));
const topicCourseCount = (id: string) => published.filter((c) => c.topic === id).length;
const ROMAN: [number, string][] = [[1000, 'M'], [900, 'CM'], [500, 'D'], [400, 'CD'], [100, 'C'], [90, 'XC'], [50, 'L'], [40, 'XL'], [10, 'X'], [9, 'IX'], [5, 'V'], [4, 'IV'], [1, 'I']];
function roman(num: number): string {
  let n = num, r = '';
  for (const [v, s] of ROMAN) { while (n >= v) { r += s; n -= v; } }
  return r;
}
const shortCode = (topicId: string) => topicId.replace(/[^a-z]/gi, '').slice(0, 4).toUpperCase();
const catGroups = topicsAlpha
  .map((t) => ({ topic: t, courses: sorted.filter((c) => c.topic === t.id) }))
  .filter((g) => g.courses.length > 0);
---
<Base title="Courses & learning paths, Sikhi University" description="Browse all Sikhi University courses by topic, or follow a guided learning path, history, theology, philosophy, language, music, the arts and modern skills." ambient="none" bodyClass="su-catalog">
  <script type="application/ld+json" set:html={JSON.stringify(itemListLd)} slot="head" />

  <!-- Dept header: eyebrow-with-dash, display h1, mono stat pair (iscatalog 429-441) -->
  <section class="wrap catalog-intro pt-10 pb-2">
    <div class="rule-navy flex flex-wrap items-end justify-between gap-6 pb-4">
      <div class="min-w-0 flex-1">
        <p class="eyebrow flex items-center gap-2 text-saffron-deep">
          <span aria-hidden="true" class="inline-block h-px w-6 bg-current opacity-50"></span>
          <span data-i18n="catalog.eyebrow">Catalogue</span>
        </p>
        <h1 class="text-display mt-3 text-navy" data-i18n="catalog.h1">Find your next discovery.</h1>
        <p class="mt-3 max-w-2xl font-sans text-muted" data-i18n="catalog.sub">Explore a subject, build a skill or follow a whole programme. There is a place to begin at every stage.</p>
      </div>
      <div class="catalog-totals flex flex-none gap-8 pb-1">
        <div class="stat-mono"><span>{topics.length}</span><span data-i18n="catalog.stat.subjects">Subjects</span></div>
        <div class="stat-mono"><span >{sorted.length}</span><span data-i18n="catalog.courseslabel">Courses</span></div>
      </div>
    </div>
  </section>

  <section class="wrap py-10">
    <div id="tabbar" role="tablist" aria-label="Browse courses" data-i18n-aria="catalog.tabbar.aria" class="inline-flex rounded-full border border-line bg-surface p-1 font-sans text-sm">
      <button id="tab-catalog-btn" role="tab" aria-controls="view-catalog" aria-selected="true" class="rounded-full px-4 py-1.5 bg-brand text-white" data-i18n="catalog.eyebrow">Catalogue</button>
      <button id="tab-paths-btn" role="tab" aria-controls="view-paths" aria-selected="false" class="rounded-full px-4 py-1.5 text-muted" data-i18n="catalog.tab.paths">Learning paths</button>
      <button id="tab-programs-btn" role="tab" aria-controls="view-programs" aria-selected="false" class="rounded-full px-4 py-1.5 text-muted" data-i18n="catalog.tab.programs">Programs</button>
    </div>

    <!-- Catalogue view (default view, per explicit instruction 2026-09-06 --
         was previously hidden by default so guided paths led instead; the
         558-row cost on first paint is now the accepted tradeoff). Registrar's-
         ledger layout: a ruled "filter by school" rail on the left, the
         courses grouped by school as rule-navy heads + row-ruled rows on the
         right. -->
    <div id="view-catalog" role="tabpanel" aria-labelledby="tab-catalog-btn" class="mt-6">
      <div class="catalog-search-box rounded-[3px] border border-navy bg-surface p-4">
        <input id="cat-search" type="search" placeholder="What would you like to learn?" data-i18n-ph="catalog.search.ph" aria-label="Search courses" data-i18n-aria="catalog.search.aria"
          class="w-full max-w-xl bg-transparent px-1 py-1 font-sans focus:outline-none" />
      </div>

      <div class="catalog-toolbar"><p role="status" aria-live="polite"><strong id="cat-count">{sorted.length}</strong> courses to explore</p><div><label for="cat-sort">Order</label><select id="cat-sort"><option value="stage">Learning stage</option><option value="title">Title A–Z</option><option value="lessons">Fewest lessons</option></select><button id="cat-density" type="button" aria-pressed="false">Compact view</button><button id="cat-reset" type="button">Reset filters ↺</button></div></div>
      <div class="mt-8 flex flex-wrap items-start gap-x-10 gap-y-8">
        <!-- Left filter rail: ruled rows with mono counts (Decision 6). -->
        <div class="catalog-filter-rail w-full flex-none lg:w-[220px]">
          <p class="eyebrow text-muted" >Browse subjects</p>
          <div id="cat-filters" class="mt-3 flex flex-col font-sans">
            <button data-t="all" class="filt flex items-center justify-between gap-2 border-b border-line py-1.5 text-left text-[14.5px] text-navy" aria-pressed="true">
              <span data-i18n="catalog.filter.all">All</span>
              <span class="font-mono text-[11px] text-saffron-deep">{sorted.length}</span>
            </button>
            {topicsAlpha.map((t) => (
              <button data-t={t.id} class="filt flex items-center justify-between gap-2 border-b border-line py-1.5 text-left text-[14.5px] text-muted" aria-pressed="false">
                <span data-no-i18n>{t.name}</span>
                <span class="font-mono text-[11px] text-muted">{topicCourseCount(t.id)}</span>
              </button>
            ))}
          </div>

          <p class="eyebrow mt-6 text-muted" >Learning stage</p>
          <div id="level-filters" class="mt-3 flex flex-wrap items-center gap-2 font-sans text-sm">
            <button data-l="all" class={btn} aria-pressed="true" >All stages</button>
            {[100, 200, 300, 400, 500].map((l) => <button data-l={String(l)} class={`${btn} font-mono`} aria-pressed="false">{stageName(l)}</button>)}
          </div>
        </div>

        <!-- Ruled ledger, grouped by school. -->
        <div class="min-w-0 flex-1">
          {catGroups.map((g, i) => (
            <div class="cat-group mt-8 first:mt-0" data-group={g.topic.id}>
              <div class="rule-navy flex flex-wrap items-baseline gap-3 pb-2">
                <span aria-hidden="true" data-no-i18n class="font-mono text-[11px] text-saffron-deep">{roman(i + 1)}</span>
                <h2 class="text-[25px] font-bold leading-[1.15] tracking-[-.026em] text-navy" data-no-i18n>{g.topic.name}</h2>
                {g.topic.blurb && <span class="text-sm italic text-muted" data-no-i18n>{g.topic.blurb}</span>}
              </div>
              {g.courses.map((c) => (
                <a href={`/course/${c.id}`}
                   class="cat-item row-ruled group hover:bg-paper"
                   data-title={c.title} data-lessons={c.lessons?.length || 0} data-topic={c.topic} data-level={String(Math.floor(c.level / 100) * 100)}
                   data-hay={`${c.title} ${c.summary} ${c.professor} ${topicName(c.topic)}`.toLowerCase()}>
                  <span class="cat-stage" data-no-i18n>{stageName(c.level)}</span>
                  <span class="cat-course-main" data-no-i18n><strong>{c.title}</strong><span class="cat-summary">{c.summary.replace(/<[^>]*>/g, '').slice(0,170)}{c.summary.length > 170 ? '…' : ''}</span><span class="cat-teacher">{c.professor}</span></span>

                  <span class="cat-course-end"><span>{c.gated ? 'Institutional' : `${c.lessons?.length || 0} lessons`}</span><span aria-hidden="true">↗</span></span>
                </a>
              ))}
            </div>
          ))}
          <div id="cat-empty" class="mt-10 hidden rounded-[3px] border border-line bg-surface p-8 text-center" aria-live="polite">
            <div class="flex flex-col items-center gap-3">
              <span class="inline-flex h-14 w-14 items-center justify-center rounded-full bg-paper text-muted"><Icon name="folder" class="h-7 w-7" /></span>
              <p class="text-lg font-bold text-navy" data-i18n="catalog.empty.title">No courses match</p>
              <p class="max-w-sm font-sans text-sm text-muted" data-i18n="catalog.empty.sub">Try a different topic, level, or search term.</p>
              <button id="cat-clear" type="button" class="btn mt-1" data-i18n="catalog.empty.clear">Clear filters</button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Learning paths view -->
    <div id="view-paths" role="tabpanel" aria-labelledby="tab-paths-btn" class="mt-6" hidden>
      <p class="text-muted" data-i18n="catalog.paths.intro">Follow a path from foundations to advanced study, finish one course to light up the next. Every course belongs to a path.</p>
      <details id="guided-journeys-section" open class="group/sect mt-6 rounded-xl2 border border-line bg-surface shadow-card">
        <summary class="flex cursor-pointer list-none items-center justify-between px-5 py-4">
          <div>
            <h2 class="text-xl font-bold" data-i18n="catalog.paths.guided.h">Guided journeys</h2>
            <p class="text-muted text-sm" data-i18n="catalog.paths.guided.sub">Hand-curated routes that weave across subjects.</p>
          </div>
          <span aria-hidden="true" class="chev shrink-0 text-lg text-muted transition-transform group-open/sect:rotate-180">▾</span>
        </summary>
        <div class="space-y-4 px-4 pb-6 sm:px-6">
        {withGrad(featured, 0).map(({ p, grad }) => (
          <details id={p.id} class="path group scroll-mt-24 overflow-hidden rounded-xl2 shadow-card ring-1 ring-black/5 transition duration-200 hover:shadow-lift">
            <summary class={`relative flex cursor-pointer list-none items-center gap-4 overflow-hidden bg-gradient-to-r ${grad} p-4 text-white`}>
              <span aria-hidden="true" class="pattern-lattice pointer-events-none absolute inset-0"></span>
              <span class="relative inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-white/15 ring-1 ring-white/25">
                <Icon name={iconFor(p)} class="h-6 w-6 text-white" />
              </span>
              <span class="relative min-w-0 flex-1">
                <span class="block text-lg font-bold leading-tight text-white">{p.name}</span>
                <span class="block font-sans text-xs text-white/80">{p.blurb}</span>
              </span>
              <span class="path-count relative shrink-0 rounded-full bg-white/20 px-3 py-1 font-sans text-xs font-semibold ring-1 ring-white/25" data-path={p.id}>{p.courseIds.length} courses</span>
              <span aria-hidden="true" class="chev relative shrink-0 text-lg transition-transform group-open:rotate-180">▾</span>
            </summary>
            <div class="bg-surface p-5">
              <div class="h-1.5 w-full overflow-hidden rounded-full bg-line/70"><div class="path-bar h-full rounded-full bg-saffron transition-all duration-700" data-path={p.id} style="width:0%"></div></div>
              <ol class="path-list mt-5">
                {p.courseIds.map((id) => byId[id] && (
                  <li><a class="font-semibold text-navy hover:text-saffron-deep" href={`/course/${id}`} data-course={id}>{byId[id].title}</a><div class="text-sm leading-snug text-muted">{byId[id].summary}</div></li>
                ))}
              </ol>
            </div>
          </details>
        ))}
        </div>
      </details>

      <details id="explore-by-subject-section" open class="group/sect mt-6 rounded-xl2 border border-line bg-surface shadow-card">
        <summary class="flex cursor-pointer list-none items-center justify-between px-5 py-4">
          <div>
            <h2 class="text-xl font-bold" data-i18n="catalog.paths.subject.h">Explore by subject</h2>
            <p class="text-muted text-sm" data-i18n="catalog.paths.subject.sub">Every subject, with all its courses in order.</p>
          </div>
          <span aria-hidden="true" class="chev shrink-0 text-lg text-muted transition-transform group-open/sect:rotate-180">▾</span>
        </summary>
        <div class="space-y-4 px-4 pb-6 sm:px-6">
        {withGrad(subjects, 1).map(({ p, grad }) => (
          <details id={p.id} class="path group scroll-mt-24 overflow-hidden rounded-xl2 shadow-card ring-1 ring-black/5 transition duration-200 hover:shadow-lift">
            <summary class={`relative flex cursor-pointer list-none items-center gap-4 overflow-hidden bg-gradient-to-r ${grad} p-4 text-white`}>
              <span aria-hidden="true" class="pattern-lattice pointer-events-none absolute inset-0"></span>
              <span class="relative inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-white/15 ring-1 ring-white/25">
                <Icon name={iconFor(p)} class="h-6 w-6 text-white" />
              </span>
              <span class="relative min-w-0 flex-1">
                <span class="block text-lg font-bold leading-tight text-white">{p.name}</span>
                <span class="block font-sans text-xs text-white/80">{p.blurb}</span>
              </span>
              <span class="path-count relative shrink-0 rounded-full bg-white/20 px-3 py-1 font-sans text-xs font-semibold ring-1 ring-white/25" data-path={p.id}>{p.courseIds.length} courses</span>
              <span aria-hidden="true" class="chev relative shrink-0 text-lg transition-transform group-open:rotate-180">▾</span>
            </summary>
            <div class="bg-surface p-5">
              <div class="h-1.5 w-full overflow-hidden rounded-full bg-line/70"><div class="path-bar h-full rounded-full bg-saffron transition-all duration-700" data-path={p.id} style="width:0%"></div></div>
              <ol class="path-list mt-5">
                {p.courseIds.map((id) => byId[id] && (
                  <li><a class="font-semibold text-navy hover:text-saffron-deep" href={`/course/${id}`} data-course={id}>{byId[id].title}</a><div class="text-sm leading-snug text-muted">{byId[id].summary}</div></li>
                ))}
              </ol>
            </div>
          </details>
        ))}
        </div>
      </details>
    </div>

    <!-- Programs view -->
    <div id="view-programs" role="tabpanel" aria-labelledby="tab-programs-btn" class="mt-8" hidden>
      <p class="max-w-3xl text-lg leading-relaxed text-muted" data-i18n="catalog.programs.intro">Certificate to Giani, a full academic ladder, free and open to all.</p>
      <div class="glass mt-6 border-l-4 border-saffron p-5 font-sans text-sm" data-i18n="catalog.programs.disclaimer">
        Sikhi University is not an accredited university and these courses are for self-development only.
      </div>
      {grouped.map(({ type, label, programs }) => programs.length > 0 && (
        <div class="mt-14">
          <h2 class="flex items-center gap-5 text-2xl font-bold">
            <span class="shrink-0">{label}</span>
            <span aria-hidden="true" class="h-px flex-1 bg-gradient-to-r from-line to-transparent"></span>
          </h2>
          <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {programs.map((p) => (
              <a href={`/program/${p.id}`} class={`glass-lite relative flex flex-col gap-2 p-5 transition duration-200 hover:-translate-y-1.5 hover:border-saffron hover:shadow-lift active:scale-[.985] ${progTypeBg[type]}`}>
                <div class="flex items-center gap-3">
                  <Icon name={p.icon} class="h-8 w-8 shrink-0 text-saffron-deep" />
                  <div>
                    <div class="eyebrow text-muted">{p.abbreviation}</div>
                    <h3 class="mt-0.5 text-lg font-bold text-navy leading-tight">{p.title}</h3>
                    <div class="font-gur text-sm text-muted" lang="pa">{p.titleGur}</div>
                  </div>
                </div>
                <p class="flex-1 font-sans text-sm text-muted">{p.description.slice(0, 140)}…</p>
                <div class="mt-auto flex flex-wrap gap-3 border-t border-line pt-3 font-sans text-xs text-muted">
                  <span class="inline-flex items-center gap-1"><Icon name="books" class="h-3.5 w-3.5" />{p.courseIds.length} courses</span>
                  <span class="inline-flex items-center gap-1"><Icon name="clock" class="h-3.5 w-3.5" />{p.duration}</span>
                  <span class="inline-flex items-center gap-1"><Icon name="check-square" class="h-3.5 w-3.5" />{p.passMark}% to pass cumulative exam</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      ))}
      <div class="glass mt-16 p-6 sm:p-8">
        <h2 class="text-2xl font-bold" data-i18n="catalog.programs.how.h">How programs work</h2>
        <ol class="how-list mt-6 space-y-4 font-sans text-sm text-muted">
          <li data-i18n="catalog.programs.how.li1">Complete all courses in the program, each has lectures, reading, and a quiz.</li>
          <li>Once every course is passed (70% quiz score), unlock the <strong>Cumulative Examination</strong>.</li>
          <li>Pass the cumulative exam with <strong>80% or higher</strong> to earn the credential.</li>
          <li data-i18n="catalog.programs.how.li4">Download your certificate and share your academic credential.</li>
        </ol>
        <p class="mt-6 border-t border-line pt-5 font-sans text-sm text-muted" data-i18n="catalog.programs.stackable">Programs are stackable, courses completed in a certificate count toward higher degrees. Your progress is always saved.</p>
      </div>
    </div>
  </section>

  <script type="application/json" id="paths-data" set:html={JSON.stringify(paths.map((p) => ({ id: p.id, courseIds: p.courseIds })))}></script>
  <script>
    import { iconSvg } from '../lib/icons';
    // --- Tabs (Catalogue / Learning paths / Programs) ---
    const vc = document.getElementById('view-catalog'), vp = document.getElementById('view-paths'), vprog = document.getElementById('view-programs');
    const bC = document.getElementById('tab-catalog-btn'), bP = document.getElementById('tab-paths-btn'), bProg = document.getElementById('tab-programs-btn');
    function setTab(which, push) {
      [['paths', vp, bP], ['catalog', vc, bC], ['programs', vprog, bProg]].forEach(([key, view, btn]) => { const on = key === which; view.hidden = !on; btn.classList.toggle('bg-brand', on); btn.classList.toggle('text-white', on); btn.classList.toggle('text-muted', !on); btn.setAttribute('aria-selected', on ? 'true' : 'false'); });
      if (push) history.replaceState(null, '', which === 'paths' ? '#paths' : which === 'programs' ? '#programs' : location.pathname);
    }
    bC.addEventListener('click', () => setTab('catalog', true));
    bP.addEventListener('click', () => setTab('paths', true));
    bProg.addEventListener('click', () => setTab('programs', true));

    // --- Catalogue filter + search ---
    const items = Array.from(document.querySelectorAll('.cat-item'));
    const groupEls = Array.from(document.querySelectorAll('.cat-group'));
    const filters = Array.from(document.querySelectorAll('#cat-filters .filt'));
    const levelBtns = Array.from(document.querySelectorAll('#level-filters .filt'));
    const search = document.getElementById('cat-search');
    const empty = document.getElementById('cat-empty');
    const countEl = document.getElementById('cat-count');
    const clearBtn = document.getElementById('cat-clear');
    let topic = 'all', level = 'all', q = '';
    const CAT_STATE_KEY = 'su_v1_catalog';
    function saveCatState() { try { localStorage.setItem(CAT_STATE_KEY, JSON.stringify({ topic, level })); } catch {} }
    function loadCatState() { try { const v = JSON.parse(localStorage.getItem(CAT_STATE_KEY)); return v && typeof v === 'object' ? v : null; } catch { return null; } }
    function setActive() {
      filters.forEach((b) => {
        const on = b.dataset.t === topic;
        b.classList.toggle('text-navy', on); b.classList.toggle('font-semibold', on); b.classList.toggle('border-saffron', on);
        b.classList.toggle('text-muted', !on); b.classList.toggle('border-line', !on);
        b.setAttribute('aria-pressed', String(on));
      });
      levelBtns.forEach((b) => {
        const on = b.dataset.l === level;
        b.classList.toggle('bg-brand', on); b.classList.toggle('text-white', on);
        b.classList.toggle('border-navy', on); b.classList.toggle('text-muted', !on);
        b.classList.toggle('bg-surface', !on);
        b.setAttribute('aria-pressed', String(on));
      });
    }
    function renderCat() {
      let shown = 0;
      const groupShown = {};
      items.forEach((el) => {
        const okT = topic === 'all' || el.dataset.topic === topic;
        const okL = level === 'all' || el.dataset.level === level;
        const okQ = !q || q.split(/\s+/).every((t) => el.dataset.hay.indexOf(t) !== -1);
        const vis = okT && okL && okQ; el.style.display = vis ? '' : 'none';
        if (vis) { shown++; groupShown[el.dataset.topic] = (groupShown[el.dataset.topic] || 0) + 1; }
      });
      groupEls.forEach((g) => { g.hidden = !groupShown[g.dataset.group]; });
      empty.classList.toggle('hidden', shown > 0);
      if (countEl) countEl.textContent = String(shown);
      setActive();
    }
    filters.forEach((b) => b.addEventListener('click', () => { topic = b.dataset.t; saveCatState(); renderCat(); }));
    levelBtns.forEach((b) => b.addEventListener('click', () => { level = b.dataset.l; saveCatState(); renderCat(); }));
    search.addEventListener('input', () => { q = search.value.toLowerCase().trim(); renderCat(); });
    if (clearBtn) clearBtn.addEventListener('click', () => { topic = 'all'; level = 'all'; q = ''; search.value = ''; saveCatState(); renderCat(); });

    document.getElementById('cat-reset').addEventListener('click', () => { topic='all'; level='all'; q=''; search.value=''; saveCatState(); renderCat(); });
    document.getElementById('cat-density').addEventListener('click', (event) => { const button=event.currentTarget as HTMLButtonElement; const compact=vc.classList.toggle('catalog-compact'); button.setAttribute('aria-pressed',String(compact)); button.textContent=compact?'Comfortable view':'Compact view'; });
    document.getElementById('cat-sort').addEventListener('change', (event) => { const order=(event.target as HTMLSelectElement).value; groupEls.forEach(group=>{const rows=[...group.querySelectorAll<HTMLElement>('.cat-item')];rows.sort((a,b)=>order==='title'?a.dataset.title.localeCompare(b.dataset.title):order==='lessons'?Number(a.dataset.lessons)-Number(b.dataset.lessons):Number(a.dataset.level)-Number(b.dataset.level)||a.dataset.title.localeCompare(b.dataset.title));rows.forEach(row=>group.appendChild(row));}); });
    // --- Path progress (server grades are the source of truth) ---
    const pdata = JSON.parse(document.getElementById('paths-data').textContent);
    const passed = (id) => { try { return !!localStorage.getItem('su_v1_passed_' + id); } catch { return false; } };
    function renderPaths() {
      pdata.forEach((p) => {
        const done = p.courseIds.filter(passed).length;
        const bar = document.querySelector(`.path-bar[data-path="${p.id}"]`);
        const cnt = document.querySelector(`.path-count[data-path="${p.id}"]`);
        if (bar) bar.style.width = (p.courseIds.length ? Math.round((done / p.courseIds.length) * 100) : 0) + '%';
        if (cnt) cnt.textContent = `${done} / ${p.courseIds.length} done`;
      });
      document.querySelectorAll('a[data-course]').forEach((a) => { if (passed(a.dataset.course) && !a.querySelector('.tick')) a.innerHTML += ' <span class="tick text-ok inline-flex align-[-0.15em]">' + iconSvg('check', 'h-4 w-4') + '</span>'; });
    }
    fetch('/api/progress', { credentials: 'same-origin' }).then((r) => (r.ok ? r.json() : null)).then((d) => {
      if (d && d.progress) d.progress.forEach((row) => { if (row.passed_score >= 80) { try { localStorage.setItem('su_v1_passed_' + row.course_id, JSON.stringify(row.passed_score)); } catch {} } });
      renderPaths();
    }).catch(renderPaths);

    // initial state: a topic filter (#<topic>) or level (#100 etc) opens the catalogue;
    // #paths opens Learning paths; #programs opens programs; everything else defaults to the Catalogue.
    const hash = (location.hash || '').replace('#', '');
    if (hash && filters.some((b) => b.dataset.t === hash)) { topic = hash; setTab('catalog', false); }
    else if (hash && pdata.some((p) => p.id === hash)) {
      setTab('paths', false);
      const selectedPath = document.getElementById(hash);
      if (selectedPath instanceof HTMLDetailsElement) {
        selectedPath.open = true;
        requestAnimationFrame(() => selectedPath.scrollIntoView({ block: 'start' }));
      }
    }
    else if (hash && levelBtns.some((b) => b.dataset.l === hash)) { level = hash; setTab('catalog', false); }
    else {
      // no topic/level hash to honor, restore the last persisted catalogue filter state
      const savedCat = loadCatState();
      if (savedCat) {
        if (savedCat.topic && filters.some((b) => b.dataset.t === savedCat.topic)) topic = savedCat.topic;
        if (savedCat.level && levelBtns.some((b) => b.dataset.l === savedCat.level)) level = savedCat.level;
      }
      if (hash === 'paths') setTab('paths', false);
      else if (hash === 'programs') setTab('programs', false);
      else setTab('catalog', false);
    }
    renderCat(); renderPaths();
  </script>

  <style>
