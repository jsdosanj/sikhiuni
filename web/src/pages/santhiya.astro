    }

    // Pathway progress: per-step completion, persisted on this device
    // (su_v1_santhya_steps), with a hero progress bar and a continue chip
    // pointing at the first incomplete step.
    function runPathwayProgress() {
      var toggles = Array.prototype.slice.call(document.querySelectorAll('[data-step-toggle]'));
      if (!toggles.length) return;
      var done = get('santhya_steps', []);
      var wrap = document.getElementById('pathway-progress');
      var bar = document.getElementById('pp-bar'), count = document.getElementById('pp-count');
      var cont = document.getElementById('pp-continue'), contName = document.getElementById('pp-continue-name');
      var cards = toggles.map(function (b) { return b.closest('li'); });
      function paint() {
        toggles.forEach(function (b, i) {
          var on = done.indexOf(i) !== -1;
          var lbl = b.querySelector('.step-lbl');
          if (window.suRelabel && lbl) {
            if (on) window.suRelabel(lbl, 'santhiya.stepdone', 'Completed');
            else window.suRelabel(lbl, 'santhiya.markdone', 'Mark complete');
          } else if (lbl) lbl.textContent = on ? 'Completed' : 'Mark complete';
          b.classList.toggle('border-ok', on); b.classList.toggle('text-ok', on);
        });
        // Number circles: completed steps go solid green-ok.
        cards.forEach(function (li, i) {
          var circle = li && li.querySelector('div > div.z-10');
          if (circle) {
            var on = done.indexOf(i) !== -1;
            circle.classList.toggle('bg-ok', on); circle.classList.toggle('text-white', on); circle.classList.toggle('ring-ok', on);
            circle.classList.toggle('bg-saffron-soft', !on); circle.classList.toggle('text-saffron-deep', !on); circle.classList.toggle('ring-saffron', !on);
          }
        });
        if (wrap) {
          wrap.hidden = done.length === 0;
          if (count) count.textContent = String(done.length);
          if (bar) bar.style.width = Math.round((done.length / toggles.length) * 100) + '%';
        }
        if (cont) {
          var next = -1;
          for (var i = 0; i < toggles.length; i++) { if (done.indexOf(i) === -1) { next = i; break; } }
          if (done.length > 0 && next !== -1) {
            var link = cards[next] && cards[next].querySelector('a.btn');
            var gur = cards[next] && cards[next].querySelector('.gur');
            if (link) { cont.href = link.getAttribute('href'); cont.hidden = false; if (contName && gur) contName.textContent = gur.textContent; }
          } else cont.hidden = true;
        }
      }
      toggles.forEach(function (b, i) {
        b.addEventListener('click', function () {
          var at = done.indexOf(i);
          if (at === -1) done.push(i); else done.splice(at, 1);
          set('santhya_steps', done); paint();
        });
      });
      paint();
    }
    function runReader() {
    var cfg = SRC[src];
    var page = document.getElementById('page'), aud = document.getElementById('aud'), angin = document.getElementById('angin'), note = document.getElementById('audnote'), audph = document.getElementById('audph');
    document.getElementById('title').textContent = cfg.name;
    document.getElementById('anglabel').childNodes[0].nodeValue = cfg.unit + ' ';
    angin.max = cfg.max;
    var ang = parseInt(qp.get('ang') || get(src + '_ang', 1), 10) || 1;
    var words = [], cum = [], total = 0, curIdx = -1;

    var santhya = null, curUrl = '';
    function trackFor(n) {
      if (!santhya || !santhya.length) return null;
      var best = null;
      for (var i = 0; i < santhya.length; i++) {
        var r = santhya[i];
        if (n >= r.start && n <= r.end) return r;
        if (r.start <= n) best = r;
      }
      return best || santhya[0];
    }
    // ── Audio ⇄ ang alignment (lib/santhya-sync). A Santhya track spans many
    // angs; the segment timeline (built from each covered ang's text weight)
    // gives every ang an estimated window inside the track. Opening an ang
    // seeks to its window; the word highlight runs inside it; `drift` is the
    // user's tap-to-anchor correction for this segment. ────────────────────
    var segTrack = null, segTl = null, drift = 0, seekAng = null;
    var angWCache = {};
    function fetchAngWeight(n) {
      if (angWCache[n] != null) return angWCache[n];
      angWCache[n] = fetch('/assets/gurbani/' + src + '/' + n + '.json')
        .then(function (r) { return r.json(); })
        .then(function (d) { return angWeight(d.lines || []); })
        .catch(function () { return 0; });
      return angWCache[n];
    }
    function buildSegTl(t) {
      var angs = []; for (var a = t.start; a <= t.end; a++) angs.push(a);
      Promise.all(angs.map(fetchAngWeight)).then(function (ws) {
        if (segTrack !== t) return; // a newer segment took over
        segTl = segmentTimeline(t.start, ws);
        maybeSeek(); updateNote();
      });
    }
    function updateNote() {
      if (!cfg.audio || !segTrack) return;
      var sync = segTrack.end > segTrack.start
        ? (segTl ? ' · ≈ synced to ' + cfg.unit + ' ' + ang + ' (tap a word to fine-tune)' : ' · syncing…')
        : '';
      note.textContent = 'Santhya · ' + segTrack.title + sync + ' — ' + (ATTR[src] || 'gurmatveechar.com');
    }
    function curWin() {
      if (!segTl || !aud.duration || !segTrack) return null;
      var w = angWindow(segTl, aud.duration, ang);
      return { start: w.start + drift, end: w.end + drift };
    }
    function maybeSeek() {
      if (seekAng == null || !segTl || !aud.duration || !segTrack) return;
      if (seekAng >= segTrack.start && seekAng <= segTrack.end) {
        var w = angWindow(segTl, aud.duration, seekAng);
        try { aud.currentTime = Math.max(0, Math.min(aud.duration - 0.5, w.start + drift)); } catch (e) {}
      }
      seekAng = null;
    }
    function setAudio(n) {
      if (!cfg.audio) { aud.style.display = 'none'; audph.style.display = 'none'; note.textContent = 'Text read-along (no audio for this Granth yet).'; return; }
      var t = trackFor(n);
      if (!t) return;
      aud.style.display = ''; audph.style.display = 'none';
      if (t.url !== curUrl) {
        curUrl = t.url; segTrack = t; segTl = null; drift = 0;
        aud.src = t.url; aud.load();
        buildSegTl(t);
      }
      updateNote();
    }

    function buildTiming() { cum = []; total = 0; for (var i = 0; i < words.length; i++) { total += wordWeight(words[i].textContent || ''); cum.push(total); } }
    function applyWord(i) {
      if (i === curIdx || i < 0) return;
      if (curIdx >= 0 && words[curIdx]) words[curIdx].classList.remove('on');
      curIdx = i;
      if (words[i]) { words[i].classList.add('on'); words[i].scrollIntoView({ block: 'center', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' }); }
    }
    function render(data) {
      page.innerHTML = ''; words = [];
      data.lines.forEach(function (line) {
        var ln = document.createElement('div'); ln.className = 'ln';
        var lineStart = words.length;
        line.split(/\s+/).forEach(function (tok) { if (!tok) return; var s = document.createElement('span'); s.className = 'w'; s.textContent = tok; ln.appendChild(s); ln.appendChild(document.createTextNode(' ')); words.push(s); });
        // ਅਰਥ — published translations for this line (BaniDB), plus
        // play-from-line when audio + timeline are ready.
        var ab = document.createElement('button');
        ab.className = 'arth-btn'; ab.type = 'button';
        ab.setAttribute('aria-label', 'Meaning of this line');
        ab.innerHTML = iconSvg('book', 'h-4 w-4');
        (function (lineText, startIdx, angNow) {
          ab.addEventListener('click', function (e) {
            e.stopPropagation();
            var onPlay = null;
            if (cfg.audio && segTl && aud.duration && segTrack) {
              onPlay = function () {
                var w0 = angWindow(segTl, aud.duration, angNow);
                try { aud.currentTime = Math.max(0, wordTime(startIdx, w0, cum, total) + drift); } catch (err) {}
                aud.play().catch(function () {});
              };
            }
            openLineStudy(src, angNow, lineText, onPlay || undefined);
          });
        })(line, lineStart, ang);
        ln.appendChild(ab);
        page.appendChild(ln);
      });
      curIdx = -1; buildTiming();
    }
    function load(n, opts) {
      n = Math.max(1, Math.min(cfg.max, n)); ang = n; angin.value = n; set(src + '_ang', n);
      history.replaceState(null, '', '/santhiya?src=' + src + '&ang=' + n);
      note.textContent = '';
      fetch('/assets/gurbani/' + src + '/' + n + '.json').then(function (r) { return r.json(); }).then(render).catch(function () { page.innerHTML = '<p class="text-muted" style="font-size:1rem">Could not load this ' + cfg.unit + '.</p>'; });
      // User navigation seeks the audio to this ang's estimated window; a
      // page-turn driven by the playback itself (opts.noSeek) never does.
      if (!(opts && opts.noSeek)) seekAng = n;
      setAudio(n);
      maybeSeek();
    }
    aud.addEventListener('loadedmetadata', maybeSeek);
    aud.addEventListener('timeupdate', function () {
      if (!cfg.audio) return;
      var w = curWin(); if (!w) return;
      applyWord(wordIndexAt(aud.currentTime, w, cum, total));
      // Sehaj flow: the recitation crossed this ang's window — turn the page
      // with it (and turn back if the listener scrubbed backwards).
      if (!aud.paused && segTrack) {
        if (ang < segTrack.end && aud.currentTime > w.end + 1.5) { load(ang + 1, { noSeek: true }); syncChapter(ang); }
        else if (ang > segTrack.start && aud.currentTime < w.start - 1.5) { load(ang - 1, { noSeek: true }); syncChapter(ang); }
      }
    });
    // Tap the word you are hearing: paused → play from that word's estimated
    // position; playing → anchor the sync estimate to it (drift correction
    // for the rest of this segment).
    page.addEventListener('click', function (e) {
      var el = e.target && e.target.closest ? e.target.closest('.w') : null;
      if (!el || !cfg.audio || !segTl || !aud.duration || !segTrack) return;
      var i = words.indexOf(el); if (i === -1) return;
      var w0 = angWindow(segTl, aud.duration, ang);
      var t = wordTime(i, w0, cum, total);
      if (aud.paused) {
        try { aud.currentTime = Math.max(0, t + drift); } catch (err) {}
        aud.play().catch(function () {});
      } else {
        drift = aud.currentTime - t;
        applyWord(i);
        if (window.suToast) window.suToast('Audio sync anchored to this word.');
      }
    });
    aud.addEventListener('error', function () { if (cfg.audio && curUrl) { aud.style.display = 'none'; audph.style.display = 'flex'; note.textContent = 'This Santhya recording could not be reached just now — text read-along still works.'; } });
    aud.addEventListener('ended', function () {
      if (!santhya) return;
      for (var i = 0; i < santhya.length; i++) { if (santhya[i].url === curUrl) { var nx = santhya[i + 1]; if (nx) { load(nx.start); aud.play().catch(function () {}); } return; } }
    });
    var chapSel = document.getElementById('chapter'), chapList = [];
    function syncChapter(n) {
      if (!chapList.length) return;
      var sel = chapList[0].ang;
      for (var i = 0; i < chapList.length; i++) { if (chapList[i].ang <= n) sel = chapList[i].ang; }
      chapSel.value = String(sel);
    }
    fetch('/assets/gurbani/chapters.json').then(function (r) { return r.json(); }).then(function (all) {
      chapList = all[src] || [];
      if (!chapList.length) { chapSel.style.display = 'none'; return; }
      chapSel.innerHTML = chapList.map(function (c) {
        return '<option value="' + c.ang + '">' + (c.gur ? c.gur + ' · ' : '') + c.label + (cfg.max > 1 ? ' (' + cfg.unit + ' ' + c.ang + ')' : '') + '</option>';
      }).join('');
      syncChapter(ang);
      chapSel.addEventListener('change', function () { go(parseInt(chapSel.value, 10) || 1); });
    }).catch(function () { chapSel.style.display = 'none'; });
    function go(n) { load(n); syncChapter(n); }
    document.getElementById('next').onclick = document.getElementById('next2').onclick = function () { go(ang + 1); };
    document.getElementById('prev').onclick = document.getElementById('prev2').onclick = function () { go(ang - 1); };
    angin.addEventListener('change', function () { go(parseInt(angin.value, 10) || 1); });
    var fs = get('read_fs', 1.9);
    function applyFs() { page.style.fontSize = (fs + (document.body.classList.contains('zen') ? 0.4 : 0)) + 'rem'; }
    applyFs();
    document.querySelectorAll('[data-fs]').forEach(function (b) { b.onclick = function () { fs = Math.max(1.1, Math.min(3.2, fs + (b.dataset.fs === '+' ? 0.2 : -0.2))); applyFs(); set('read_fs', fs); }; });
    document.getElementById('larivaar').onclick = function (e) { var on = page.classList.toggle('lari'); e.currentTarget.setAttribute('aria-pressed', String(on)); };
    // Player extras: ±10s skip and playback speed (persisted).
    var skipB = document.getElementById('skip-back'), skipF = document.getElementById('skip-fwd'), rateSel = document.getElementById('aud-rate');
    if (skipB) skipB.onclick = function () { try { aud.currentTime = Math.max(0, aud.currentTime - 10); } catch (e) {} };
    if (skipF) skipF.onclick = function () { try { aud.currentTime = aud.currentTime + 10; } catch (e) {} };
    if (rateSel) {
      var savedRate = get('read_rate', 1); aud.playbackRate = savedRate; rateSel.value = String(savedRate);
      rateSel.addEventListener('change', function () { var r = parseFloat(rateSel.value) || 1; aud.playbackRate = r; set('read_rate', r); });
      aud.addEventListener('loadedmetadata', function () { aud.playbackRate = parseFloat(rateSel.value) || 1; });
    }
    if (!cfg.audio) { if (skipB) skipB.style.display = 'none'; if (skipF) skipF.style.display = 'none'; if (rateSel) rateSel.style.display = 'none'; }
    // Keyboard shortcuts: ←/→ change Ang, space toggles play/pause — never
    // while typing in an input/select.
    document.addEventListener('keydown', function (e) {
      var tag = (e.target && e.target.tagName || '').toLowerCase();
      if (tag === 'input' || tag === 'select' || tag === 'textarea' || (e.target && e.target.isContentEditable) || e.metaKey || e.ctrlKey || e.altKey) return;
      // Space must never hijack a focused control's native activation.
      if (e.key === ' ' && (tag === 'button' || tag === 'a' || tag === 'summary' || tag === 'audio')) return;
      if (e.key === 'ArrowLeft') { go(ang - 1); e.preventDefault(); }
      else if (e.key === 'ArrowRight') { go(ang + 1); e.preventDefault(); }
      else if (e.key === ' ' && cfg.audio && aud.style.display !== 'none') { if (aud.paused) aud.play().catch(function () {}); else aud.pause(); e.preventDefault(); }
      else if (e.key === 'z' || e.key === 'Z') { toggleZen(); e.preventDefault(); }
      else if (e.key === 'Escape' && document.body.classList.contains('zen')) { zenOff(); e.preventDefault(); }
    });

    // Zen mode: full-viewport, chrome-free reading. Idempotent on/off so the
    // keydown-Escape path and the fullscreenchange path can't double-toggle.
    var zenIdleT = null, wakeLock = null;
    function wakeControls() {
      document.body.classList.remove('zen-idle');
      if (zenIdleT) clearTimeout(zenIdleT);
      zenIdleT = setTimeout(function () { if (document.body.classList.contains('zen')) document.body.classList.add('zen-idle'); }, 3000);
    }
    function requestWake() {
      if (!document.body.classList.contains('zen') || !cfg.audio || aud.paused) return;
      if (!('wakeLock' in navigator)) return;
      try { navigator.wakeLock.request('screen').then(function (w) { wakeLock = w; }).catch(function () {}); } catch (e) {}
    }
    function releaseWake() { if (wakeLock) { try { wakeLock.release(); } catch (e) {} wakeLock = null; } }
    function zenOn() {
      if (document.body.classList.contains('zen')) return;
      document.body.classList.add('zen');
      applyFs();
      var nav = document.querySelector('nav'); if (nav) nav.inert = true;
      try { var el = document.documentElement; if (el.requestFullscreen) { var p = el.requestFullscreen(); if (p && p.catch) p.catch(function () {}); } } catch (e) {}
      requestWake();
      wakeControls();
    }
    function zenOff() {
      if (!document.body.classList.contains('zen')) return;
      document.body.classList.remove('zen'); document.body.classList.remove('zen-idle');
      if (zenIdleT) { clearTimeout(zenIdleT); zenIdleT = null; }
      applyFs();
      releaseWake();
      var nav = document.querySelector('nav'); if (nav) nav.inert = false;
      if (document.fullscreenElement) { try { var p = document.exitFullscreen(); if (p && p.catch) p.catch(function () {}); } catch (e) {} }
      var zb = document.getElementById('zen-btn'); if (zb) zb.focus();
    }
    function toggleZen() { if (document.body.classList.contains('zen')) zenOff(); else zenOn(); }
    document.getElementById('zen-btn').onclick = document.getElementById('zen-exit').onclick = toggleZen;
    document.addEventListener('fullscreenchange', function () { if (!document.fullscreenElement && document.body.classList.contains('zen')) zenOff(); });
    ['pointermove', 'keydown', 'focus'].forEach(function (ev) { document.addEventListener(ev, function () { if (document.body.classList.contains('zen')) wakeControls(); }, true); });
    if (cfg.audio) { aud.addEventListener('play', requestWake); aud.addEventListener('pause', releaseWake); aud.addEventListener('ended', releaseWake); }
    load(ang);
    if (cfg.audio) {
      note.textContent = 'Loading Santhya audio…';
      fetch('/assets/gurbani/santhya-' + src + '-index.json').then(function (r) { return r.json(); }).then(function (d) { santhya = d; seekAng = ang; setAudio(ang); }).catch(function () { aud.style.display = 'none'; note.textContent = 'Santhya audio is unavailable right now — text read-along still works.'; });
    }
    } // end runReader
