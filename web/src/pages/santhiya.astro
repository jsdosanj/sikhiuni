          var stars = kit.getStars(g.id);
          card.innerHTML =
            '<div class="flex items-baseline gap-2"><span class="gur text-2xl font-bold text-white" lang="pa">' + g.gur + '</span><span class="font-sans text-sm font-semibold text-white">' + g.title + '</span></div>' +
            '<p class="mt-1 font-sans text-xs text-white/70">' + g.blurb + '</p>' +
            '<div class="mt-3 flex items-center justify-between">' +
            '<span class="star-count inline-flex items-center gap-1 font-sans text-xs text-saffron">' + (stars > 0 ? iconSvg('star', 'h-3.5 w-3.5') + ' ' + stars : '') + '</span>' +
            '<button type="button" class="arcade-play min-h-[44px] rounded-sm border border-white/25 px-5 py-1.5 font-sans text-sm font-semibold text-white transition">Play</button></div>';
          card.querySelector('.arcade-play').addEventListener('click', function () {
