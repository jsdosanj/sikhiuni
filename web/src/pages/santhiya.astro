---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
// Descriptions may embed a Gurmukhi tuk mid-sentence; every Gurmukhi run must
// render inside lang="pa" (reverence rule), so split on the Gurmukhi block.
const paSegs = (s: string) =>
  s.split(/([਀-੿][਀-੿\s]*)/).filter(Boolean).map((x) => ({ pa: /[਀-੿]/.test(x), x }));
const texts = [
  { gur: 'ਬਾਲ ਉਪਦੇਸ਼', en: 'Baal Updesh', d: "The complete beginner's primer — the alphabet, the extra letters, the numerals, and the full Muharni (every consonant through the ten vowel signs). Where every reader begins.", href: '/baal-updesh', live: true },
  { gur: 'ਨਿਤਨੇਮ', en: 'Nitnem', d: 'The daily banis — the foundation of a Sikh reading practice.', href: '/collection/nitnem', live: true },
  { gur: 'ਸੁੰਦਰ ਗੁਟਕਾ', en: 'Sundar Gutka', d: 'The common collection of daily and occasional banis.', href: '/collection/sundar-gutka', live: true },
  { gur: 'ਪੰਜ ਗ੍ਰੰਥੀ', en: 'Panj Granthi', d: 'Five longer baanis: Sukhmani Sahib, Asa di Vaar, Baavan Akhri, Sidh Gosht and Dakhni Oankaar.', href: '/collection/panj-granthi', live: true },
  { gur: 'ਦਸ ਗ੍ਰੰਥੀ', en: 'Das Granthi', d: 'Ten baanis of the Dasam Granth — the compositions associated with Guru Gobind Singh Ji.', href: '/collection/das-granthi', live: true },
  { gur: 'ਸ੍ਰੀ ਗੁਰੂ ਗ੍ਰੰਥ ਸਾਹਿਬ ਜੀ', en: 'Sri Guru Granth Sahib Ji', d: 'The complete Granth, Ang by Ang, with Santhya audio (Bhindran Taksal — gurmatveechar.com) and word-by-word read-along.', href: '/santhiya?src=sggs', live: true },
  { gur: 'ਦਸਮ ਗ੍ਰੰਥ', en: 'Dasam Granth', d: 'The compositions associated with Guru Gobind Singh Ji — Ang-by-Ang read-along (text).', href: '/santhiya?src=dasam', live: true },
  { gur: 'ਸਰਬਲੋਹ ਗ੍ਰੰਥ', en: 'Sri Sarbloh Granth Sahib', d: 'The complete Sri Sarbloh Granth Sahib (the Khalsa Mahima) — Ang by Ang read-along.', href: '/santhiya?src=sarbloh', live: true },
  { gur: 'ਪੰਜ ਗ੍ਰੰਥਾਵਲੀ', en: 'Panj Granthavali', d: 'Five non-Gurbani granths (Chanakya Niti, Sarukatavali, Bhavrasamrit, Vichar Mala, Adhyatam Prakash) — placed last as supplementary, non-Gurbani works.', href: '/collection/panj-granthavali', live: true },
  { gur: 'ਭਗਤੀ ਅਭਿਆਸ', en: 'Bhagti Abhyas — Meditation & Contemplation', d: 'Simran and meditation as the foundation of the Sikh jeevan. Without Bhagti, all knowledge is empty — ਗਿਆਨੀ ਭੂਲੇ ਬਿਨੁ ਭਗਤੀ ਅਭਿਮਾਨੀ. Begin here.', href: '/collection/bhagti-abhyas', live: true },
  { gur: 'ਇਤਿਹਾਸਕ ਗ੍ਰੰਥ', en: 'Historical Chronicles', d: 'The great historical works: Suraj Prakash, Sri Nanak Prakash, Gurbilas Patshahi 6 & 10, Panth Prakash, Twarikh Guru Khalsa, and Bansavalinama — all in the Sikh Archive reader.', href: '/collection/historical-chronicles', live: true },
  { gur: 'ਅਧਿਆਤਮਕ ਟੀਕੇ', en: 'Spiritual Commentaries', d: 'Vaaran Bhai Gurdas, Kabitt Savaiye, the writings of Bhai Nand Lal, and the major Guru Granth Sahib teekas (Faridkot Wala Teeka, Guru Granth Darpan).', href: '/collection/spiritual-commentaries', live: true },
  { gur: 'ਰਾਜਨੀਤਕ ਗ੍ਰੰਥ', en: 'Political & Governance Texts', d: 'Primary sources on Sikh political thought — the Hukamnamas of the Gurus, and the Zafarnama of Guru Gobind Singh Ji.', href: '/collection/political-governance', live: true },
  { gur: 'ਰਹਿਤ ਅਤੇ ਨੈਤਿਕਤਾ', en: 'Rehat & Ethics', d: 'The Sikh codes of conduct — historical Rehatnamas, Sikh Rehat Maryada, Tankhahnama, and Prem Sumarag. The ethics of the Khalsa.', href: '/collection/rehat-ethics', live: true },
];
---
<Base title="Santhya Pathway & Read-along — Sikhi University" description="Learn to read Gurbani with shudh uchaaran: from the first primer to the complete Sri Guru Granth Sahib Ji, with read-along audio — read Ang by Ang here." ambient="sanctum">
  <!-- Dark hero (redesign task 11, issanthya, prototype lines 1144-1156): the
       page's own ambient-sanctum gradient (.ambient-sanctum in global.css) IS
       the prototype's inline dark-navy linear-gradient — same colours, one
       layer, per Decision 5 — so no separate glass/midnight box sits here;
       this is just the text content over the ambient (same convention as
       collection/[name].astro's dark header). -->
  <header id="su-hero" class="wrap relative py-14 text-paper sm:py-16">
    <p class="eyebrow text-saffron" data-i18n="santhiya.eyebrow">Shudh Uchaaran · Read-along</p>
    <h1 class="mt-4 flex flex-wrap items-baseline gap-x-4 gap-y-1">
      <span class="gur text-display font-bold text-white" lang="pa">ਸੰਥਿਆ</span>
      <span class="text-display-sm font-bold text-white" data-i18n="santhiya.h1">The Santhya Pathway</span>
    </h1>
    <p class="mt-5 max-w-2xl text-lg text-paper/85" data-i18n="santhiya.hero.sub">Santhya is the careful, correct reading of Gurbani. Walk the traditional path — from your first letters to the complete Sri Guru Granth Sahib Ji — reading along with audio, one step at a time.</p>
    <div id="pathway-progress" hidden class="mt-6 max-w-md">
      <div class="flex items-baseline justify-between font-mono text-[11px] uppercase tracking-[.12em] text-paper/70">
        <span><span id="pp-count">0</span> / {texts.length} <span data-i18n="santhiya.steps">steps completed</span></span>
      </div>
      <div class="mt-1.5 h-[3px] overflow-hidden bg-white/15"><div id="pp-bar" class="h-full bg-saffron transition-all" style="width:0%"></div></div>
    </div>
    <a id="pp-continue" hidden href="#" class="mt-4 inline-flex items-center gap-2 rounded-sm border border-saffron/50 bg-saffron/10 px-4 py-1.5 font-sans text-sm text-saffron hover:bg-saffron/20"><Icon name="compass" class="h-4 w-4 shrink-0" /><span data-i18n="santhiya.continue">Continue where you left off</span><span id="pp-continue-name" class="gur" lang="pa"></span></a>
  </header>

  <!-- Learning arcade: mini-games for the foundational santhiya skills.
       Interactive-only by nature (games need JS); the sacred learning content
       itself lives in the pathway/reader below, never gated. A contained
       feature panel (its own cosmos glow/star decoration), not a page-level
       hero — kept bordered/flat (no glass, no blur) per Decision 5. -->
  <section id="arcade" class="wrap pb-10 pt-2">
    <div class="cosmos-panel relative overflow-hidden rounded-xl2 border border-white/14 p-6 sm:p-8">
      <div aria-hidden="true" class="cosmos absolute inset-0"></div>
      <div class="relative">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h2 class="flex items-baseline gap-3 text-2xl font-bold text-white"><span class="gur text-saffron" lang="pa">ਖੇਡੋ ਤੇ ਸਿੱਖੋ</span><span>Learn by playing</span></h2>
          <div class="flex items-center gap-3 font-sans text-sm text-white/85">
            <span id="arcade-streak" class="inline-flex items-center gap-1.5"></span>
            <button id="arcade-kid" type="button" role="switch" aria-checked="false" class="inline-flex min-h-[44px] items-center gap-2 rounded-sm border border-white/25 px-4 py-1.5 hover:border-saffron">Kids mode <span id="arcade-kid-dot" class="h-2.5 w-2.5 rounded-full bg-white/30"></span></button>
          </div>
        </div>
        <p class="mt-1 max-w-2xl font-sans text-sm text-white/75">Little games that teach the letters, sounds and words of Gurmukhi — for kids and grown-ups. Stars and seals are saved on this device.</p>
        <div id="arcade-games" class="mt-5 grid gap-4 sm:grid-cols-3"></div>
      </div>
    </div>
  </section>

  <!-- Ruled pathway ladder (Decision 6: list-like data is a ruled ledger, not
       cards). Sits in its own light paper band — same "dark hero, light
       ledger band beneath" shape as collection/[name].astro — since the
       ambient behind is dark navy and ruled-row text (navy/ink/muted) needs a
       light surface to read against. -->
  <div id="pathway" class="border-t border-line bg-paper">
    <div class="wrap py-12">
      <ol>
        {texts.map((t, i) => (
          <li class="row-ruled items-start gap-y-2 py-5">
            <div class="flex flex-none flex-col items-center">
              <div class="z-10 flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-saffron-soft font-mono text-[13px] font-semibold text-saffron-deep ring-2 ring-saffron">{i + 1}</div>
            </div>
            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <span class="gur text-xl font-bold text-navy" lang="pa">{t.gur}</span>
                <span class="font-mono text-[11px] uppercase tracking-[.12em] text-muted">{t.en}</span>
                {t.live && <span class="chip-status border-ok text-ok" data-i18n="santhiya.available">Available</span>}
              </div>
              <p class="mt-2 max-w-[62ch] text-[15.5px] leading-relaxed text-ink/90">{paSegs(t.d).map((s) => (s.pa ? <span lang="pa" class="gur">{s.x}</span> : s.x))}</p>
              <div class="mt-3 flex flex-wrap items-center gap-3">
                {t.href
                  ? <a href={t.href} class="btn btn-primary" data-i18n="santhiya.open">Open →</a>
                  : <span class="font-mono text-[11px] uppercase tracking-[.12em] text-muted" data-i18n="santhiya.comingsoon">Reader coming soon</span>}
                <button type="button" data-step-toggle={i} class="chip-status gap-1.5 border-line text-muted transition hover:border-saffron hover:text-navy"><Icon name="check" class="h-3.5 w-3.5 shrink-0" /><span class="step-lbl" data-i18n="santhiya.markdone">Mark complete</span></button>
              </div>
            </div>
          </li>
        ))}
      </ol>
      <p class="mt-8 font-sans text-sm text-muted">Audio: <em>SGGS Santhya Shudh Uchaaran Sehaj Paath</em> — Bhindran Taksal (gurmatveechar.com). Gurbani text handled with reverence; report any correction via <a class="underline" href="/feedback" data-i18n="santhiya.feedbacklink">feedback</a>.</p>
    </div>
  </div>

  <!-- Read-along reader (merged from the former /read page; redesign task 11,
       isreader, prototype lines 529-553); shown when ?src=… is present. No
       separate dark box here either — the ambient-sanctum layer behind IS the
       prototype's dark gradient reader surface (Decision 5); only the text
       colours below are set for it. Real functional controls (chapter jump,
       audio player, skip/rate/larivaar/zen) go well beyond the prototype's
       static 3-toggle mockup, so they're restyled in the same mono-bordered
       language rather than replaced by it. -->
  <section id="reader" class="wrap py-8" style="display:none">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-white/14 pb-4">
      <div class="flex flex-wrap items-baseline gap-3">
        <h1 id="title" class="font-mono text-[12px] font-semibold uppercase tracking-[.16em] text-saffron">Read-along</h1>
        <span lang="pa" class="gur text-sm text-white/70">ਅੰਗ</span>
      </div>
      <div class="flex flex-wrap items-center gap-2 font-mono text-[10.5px] uppercase tracking-[.1em]">
        <select id="chapter" aria-label="Jump to chapter" data-i18n-aria="santhiya.aria.chapter" class="max-w-[60vw] rounded-sm border border-line bg-surface px-2 py-1.5 normal-case tracking-normal sm:max-w-xs"></select>
        <button id="prev" aria-label="Previous Ang" data-i18n-aria="santhiya.aria.prevang" class="rounded-sm border border-white/25 px-3 py-1.5 text-white/80 hover:border-saffron hover:text-saffron">←</button>
        <label id="anglabel" class="flex items-center gap-1.5 normal-case tracking-normal text-white/80">Ang <input id="angin" type="number" min="1" value="1" class="w-16 rounded-sm border border-line bg-surface px-2 py-1 text-center"></label>
        <button id="next" aria-label="Next Ang" data-i18n-aria="santhiya.aria.nextang" class="rounded-sm border border-white/25 px-3 py-1.5 text-white/80 hover:border-saffron hover:text-saffron">→</button>
      </div>
    </div>

    <div class="mx-auto max-w-[70ch]">
      <div id="audbar" class="mt-4 flex flex-wrap items-center gap-3 rounded-xl2 border p-3">
        <audio id="aud" controls preload="none" class="min-w-[260px] flex-1"></audio>
        <div id="audph" class="hidden min-w-[260px] flex-1 items-center gap-2 rounded-sm bg-white/10 px-3 py-2 font-sans text-sm text-white/70"><Icon name="volume-off" class="h-4 w-4 shrink-0" /><span data-i18n="santhiya.audioprep">Audio for this Ang is being prepared.</span></div>
        <div class="flex flex-wrap items-center gap-2 font-mono text-[10px] uppercase tracking-[.1em]">
          <button id="skip-back" aria-label="Back 10 seconds" class="rounded-sm border border-white/25 px-2.5 py-1 text-white/80 hover:border-saffron hover:text-saffron">−10s</button>
          <button id="skip-fwd" aria-label="Forward 10 seconds" class="rounded-sm border border-white/25 px-2.5 py-1 text-white/80 hover:border-saffron hover:text-saffron">+10s</button>
          <select id="aud-rate" aria-label="Playback speed" class="rounded-sm border border-line bg-surface px-1.5 py-1 normal-case tracking-normal">
            <option value="0.75">0.75×</option><option value="1" selected>1×</option><option value="1.25">1.25×</option><option value="1.5">1.5×</option>
          </select>
          <button data-fs="-" aria-label="Decrease text size" data-i18n-aria="santhiya.aria.smaller" class="rounded-sm border border-white/25 px-2.5 py-1 text-white/80 hover:border-saffron">A−</button>
          <button data-fs="+" aria-label="Increase text size" data-i18n-aria="santhiya.aria.bigger" class="rounded-sm border border-white/25 px-2.5 py-1 text-white/80 hover:border-saffron">A+</button>
          <button id="larivaar" aria-pressed="false" data-i18n="santhiya.larivaar" class="rounded-sm border border-white/25 px-2.5 py-1 text-white/80 hover:border-saffron">Larivaar</button>
          <button id="zen-btn" type="button" aria-label="Zen reading mode" class="inline-flex items-center gap-1.5 rounded-sm border border-white/25 px-2.5 py-1 text-white/80 hover:border-saffron"><Icon name="meditation" class="h-4 w-4 shrink-0" />Zen</button>
          <button id="zen-exit" type="button" aria-label="Exit Zen reading mode" class="inline-flex items-center gap-1.5 rounded-sm border border-white/25 px-2.5 py-1 text-white/80 hover:border-saffron"><Icon name="stop" class="h-4 w-4 shrink-0" />Exit</button>
        </div>
      </div>
      <p id="audnote" class="mt-1 font-mono text-[11px] text-white/60"></p>

      <div id="page" aria-live="polite" aria-label="Gurbani text" lang="pa" class="gur mt-6 leading-loose" style="font-size:1.9rem"></div>
    </div>

    <div class="mt-8 flex items-center justify-between border-t border-white/14 pt-4 font-mono text-[11px] uppercase tracking-[.14em] text-white/72">
      <button id="prev2" class="hover:text-saffron" data-i18n="santhiya.prev">← Previous</button>
      <a href="/santhiya" class="hover:text-saffron" data-i18n="santhiya.alltexts">← All Santhya texts</a>
      <button id="next2" class="hover:text-saffron" data-i18n="santhiya.next">Next →</button>
    </div>
  </section>

  <style is:global>
    #page .w { transition: color .08s, background-color .08s; padding: 0 .04em; border-radius: 4px; cursor: pointer; }
    /* Per-line ਅਰਥ affordance: quiet until the line is hovered/focused;
       always faintly present on touch screens (no hover to reveal it). */
    #page .arth-btn { display: inline-flex; vertical-align: middle; margin-inline-start: .5rem; padding: .3rem; border-radius: 9999px; color: rgb(var(--c-muted)); opacity: 0; transition: opacity .15s, background-color .15s; }
    #page .ln:hover .arth-btn, #page .ln:focus-within .arth-btn, #page .arth-btn:focus-visible { opacity: 1; }
    #page .arth-btn:hover { background: rgb(var(--c-saffron-soft)); color: rgb(var(--c-saffron-deep)); }
    @media (hover: none) { #page .arth-btn { opacity: .45; } }
    body.zen #page .arth-btn { display: none; }
    /* ── Arcade cosmos: pure gradients (no backdrop-filter cost), slow
       transform/opacity drift, frozen by reduced-motion, off in hc. ─── */
    .cosmos-panel { background: linear-gradient(150deg, rgb(11 30 58 / .92), rgb(10 13 20 / .95)); }
    .cosmos { pointer-events: none; }
    .cosmos::before, .cosmos::after { content: ''; position: absolute; border-radius: 9999px; will-change: transform; }
    .cosmos::before { width: 26rem; height: 26rem; left: -8rem; top: -10rem; background: radial-gradient(closest-side, rgb(244 178 26 / .18), transparent 70%); animation: su-drift-a 50s var(--ease-out) infinite alternate; }
    .cosmos::after { width: 22rem; height: 22rem; right: -7rem; bottom: -9rem; background: radial-gradient(closest-side, rgb(106 166 255 / .16), transparent 70%); animation: su-drift-b 70s var(--ease-out) infinite alternate; }
    .cosmos .stars { position: absolute; inset: 0; background-image: radial-gradient(circle 1.5px, rgb(255 200 61 / .8) 99%, transparent), radial-gradient(circle 1px, rgb(255 255 255 / .7) 99%, transparent), radial-gradient(circle 1.5px, rgb(255 200 61 / .6) 99%, transparent), radial-gradient(circle 1px, rgb(255 255 255 / .5) 99%, transparent); background-size: 340px 260px, 220px 180px, 420px 300px, 260px 240px; background-position: 20px 30px, 110px 90px, 200px 40px, 60px 160px; animation: su-twinkle 7s ease-in-out infinite alternate; }
    @keyframes su-twinkle { from { opacity: .35; } to { opacity: .9; } }
    @media (prefers-reduced-motion: reduce) { .cosmos::before, .cosmos::after, .cosmos .stars { animation: none; } }
    body.hc .cosmos { display: none; }
    body.hc .cosmos-panel { background: #000; }
    .arcade-card { min-height: 44px; }
    .arcade-card:hover .arcade-play { border-color: #f4b21a; color: #ffc83d; }
    #page .w.on { background: #ffe69a; color: #1a1205; font-weight: 700; box-shadow: 0 0 0 2px #ffe69a; }
    #page .ln { margin: .35rem 0; }
    #page.lari .ln { word-spacing: -0.25em; }
    [data-theme="dark"] #page .w.on { background: #f4b21a; color: #0a0d14; box-shadow: 0 0 0 2px #f4b21a; }

    /* Sanctum skin: reader presents dark (ambient-sanctum sits behind it, per
       Decision 5) so white/saffron text stays AA there; #angin/#chapter/
       #aud-rate are native form controls and keep the light surface/ink pair
       (matches every other reader-style input on this site) rather than
       fighting the browser's own control chrome. Guarded off body.hc so
       high-contrast stays solid. */
    body:not(.hc) #reader { color: #eaf0f8; }
    body:not(.hc) #reader input, body:not(.hc) #reader select { color: rgb(var(--c-ink)); background: rgb(var(--c-surface)); }
    body:not(.hc) #page { color: #eef2f8; }
    body:not(.hc) #audbar { background: rgb(11 30 58 / .60); border-color: rgb(255 255 255 / .12); }
    body:not(.hc) #audnote { color: rgb(255 255 255 / .74); }

    /* Larivaar is a real toggle (JS flips aria-pressed on click) — mono
       bordered off, gold filled on, matching the prototype's active-toggle
       styling (isreader, "Santhiya" pill). */
    #larivaar[aria-pressed="true"] { border-color: #f4b21a; background: #f4b21a; color: #0A1729; }

    /* Zen mode — a distraction-free full-viewport reader. */
    #zen-exit { display: none; }
    body.zen nav, body.zen footer, body.zen #a11y-fab, body.zen #pathway { display: none; }
    body.zen #reader { position: fixed; inset: 0; overflow-y: auto; z-index: 60; padding: 6vh 5vw; background: linear-gradient(180deg, #0b1e3a, #0a0d14 80%); }
    body.zen #page { max-width: 52rem; margin: 0 auto; }
    body.zen #page .w.on { background: transparent; color: #ffc83d; text-shadow: 0 0 24px rgb(244 178 26 / .55); font-weight: 700; }
    body.zen #zen-exit { display: inline-flex; }
    body.zen #audbar { position: fixed; left: 50%; bottom: max(1.25rem, env(safe-area-inset-bottom)); transform: translateX(-50%); z-index: 70; width: auto; max-width: 92vw; margin: 0; transition: opacity .4s ease; }
    body.zen.zen-idle #audbar { opacity: .12; }
  </style>

  <script>
    import { angWeight, segmentTimeline, angWindow, wordIndexAt, wordTime, wordWeight } from '../lib/santhya-sync';
    import { openLineStudy } from '../lib/line-study';
    import { iconSvg } from '../lib/icons';
    var SRC = {
      sggs: { name: 'Sri Guru Granth Sahib Ji', unit: 'Ang', max: 1430, audio: true },
      dasam: { name: 'Dasam Granth', unit: 'Ang', max: 1428, audio: true },
      sarbloh: { name: 'Sri Sarbloh Granth Sahib', unit: 'Ang', max: 1040, audio: false },
    };
    var ATTR = {
      sggs: 'Bhindrān Taksāl (gurmatveechar.com)',
      dasam: 'Kabaal Singh, Hazoor Sahib wale (gurmatveechar.com)',
    };
    var P = 'su_v1_';
    var get = function (k, d) { try { var v = localStorage.getItem(P + k); return v == null ? d : JSON.parse(v); } catch (e) { return d; } };
    var set = function (k, v) { try { localStorage.setItem(P + k, JSON.stringify(v)); } catch (e) {} };
    var qp = new URLSearchParams(location.search);
    var src = SRC[qp.get('src')] ? qp.get('src') : '';
    if (src) {
      // A Granth was chosen — switch from the pathway list to the reader.
      var hero = document.getElementById('su-hero'); if (hero) hero.style.display = 'none';
      var pw = document.getElementById('pathway'); if (pw) pw.style.display = 'none';
      var ar = document.getElementById('arcade'); if (ar) ar.style.display = 'none';
      var rd = document.getElementById('reader'); if (rd) rd.style.display = '';
      runReader();
    } else {
      runPathwayProgress();
      runArcade();
    }

    // ── Learning arcade: the mini-game modules under lib/games. Overlay,
    // stars/streak/seals and kid-mode come from the shared kit. ─────────────
    function runArcade() {
      var wrap = document.getElementById('arcade-games');
      if (!wrap) return;
      var host = document.querySelector('#arcade .cosmos');
      if (host) { var st = document.createElement('div'); st.className = 'stars'; host.appendChild(st); }
      Promise.all([
        import('../lib/games/kit'),
        import('../lib/games/jodi-match'),
        import('../lib/games/shabad-builder'),
        import('../lib/games/akhar-pop'),
      ]).then(function (mods) {
        var kit = mods[0];
        var games = [mods[1].game, mods[2].game, mods[3].game];
        // Hoist every module's keyframes once (style-src allows inline styles).
        var css = [kit.KEYFRAMES, mods[1].GAME_KEYFRAMES || '', mods[2].GAME_KEYFRAMES || '', mods[3].GAME_KEYFRAMES || ''].join('\n');
        var styleEl = document.createElement('style'); styleEl.textContent = css; document.head.appendChild(styleEl);

        var kidBtn = document.getElementById('arcade-kid'), kidDot = document.getElementById('arcade-kid-dot');
        function paintKid() {
          var on = kit.kidMode();
          kidBtn.setAttribute('aria-checked', String(on));
          kidDot.className = 'h-2.5 w-2.5 rounded-full ' + (on ? 'bg-saffron' : 'bg-white/30');
        }
        kidBtn.addEventListener('click', function () { kit.setKidMode(!kit.kidMode()); paintKid(); });
        paintKid();

        function paintStreak() {
          var el = document.getElementById('arcade-streak');
          var days = kit.getStreak(), seals = kit.getSeals().length;
          el.innerHTML = (days > 0 ? iconSvg('fire', 'h-4 w-4') + ' <strong>' + days + '</strong>-day streak' : '') +
            (seals > 0 ? ' <span class="ml-2">' + iconSvg('medal', 'h-4 w-4') + ' <strong>' + seals + '</strong> seals</span>' : '');
