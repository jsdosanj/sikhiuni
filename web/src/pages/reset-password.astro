---
import Base from '../layouts/Base.astro';
---
<Base title="Reset password — Sikhi University" description="Reset the password on your Sikhi University account." ambient="hall" noindex={true}>
  <!-- isresetpw (1391-1414): same hero-midnight surface as login/mfa. This
       page has no existing strength-meter, so per plan Decision 9(a)/task 14
       none is added -- real fields/ids/logic below are untouched. -->
  <div class="hero-midnight flex min-h-[560px] items-center py-16">
    <div class="wrap relative w-full">
      <div class="mx-auto w-full max-w-[430px]">
        <div class="flex justify-center">
          <img src="/assets/su-crest-ivory.png" alt="Sikhi University crest" class="h-14 w-auto" />
        </div>
        <p class="eyebrow mt-4 text-center text-saffron">Reset password</p>
        <h1 class="text-display-sm mt-4 text-center font-bold text-white" id="h1">Reset your password</h1>
        <p class="mt-3 text-center text-[15.5px] leading-relaxed text-white/[0.72]" id="sub">Enter your email and we'll send you a reset link.</p>

        <!-- Request form: shown when no ?token is present -->
        <form id="request-form" class="mt-7 space-y-5">
          <label class="block"><span class="field-label-dark">Email</span>
            <input id="req-email" type="email" required placeholder="you@example.com" class="mt-2 w-full rounded-[2px] border border-white/[0.34] bg-white/[0.05] px-4 py-3.5 text-base text-white placeholder:text-white/[0.55] focus:border-saffron focus:outline-none" />
          </label>
          <button id="req-btn" type="submit" class="btn btn-primary w-full justify-center">Send reset link</button>
        </form>

        <!-- Set-password form: shown when ?token is present -->
        <form id="reset-form" class="mt-7 hidden space-y-5">
          <label class="block"><span class="field-label-dark">New password</span>
            <input id="password" type="password" required minlength="12" autocomplete="new-password" class="mt-2 w-full rounded-[2px] border border-white/[0.34] bg-white/[0.05] px-4 py-3.5 text-base text-white placeholder:text-white/[0.55] focus:border-saffron focus:outline-none" />
          </label>
          <label class="block"><span class="field-label-dark">Confirm password</span>
            <input id="confirm" type="password" required minlength="12" autocomplete="new-password" class="mt-2 w-full rounded-[2px] border border-white/[0.34] bg-white/[0.05] px-4 py-3.5 text-base text-white placeholder:text-white/[0.55] focus:border-saffron focus:outline-none" />
          </label>
          <button id="reset-btn" type="submit" class="btn btn-primary w-full justify-center">Reset password</button>
        </form>

        <div id="out" class="mt-4"></div>
      </div>
    </div>
  </div>
  <script>
    function esc(s: string) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;'); }
    const params = new URLSearchParams(location.search);
    const token = params.get('token');
    const out = document.getElementById('out')!;
    const requestForm = document.getElementById('request-form') as HTMLFormElement;
    const resetForm = document.getElementById('reset-form') as HTMLFormElement;

    if (token) {
      requestForm.classList.add('hidden');
      resetForm.classList.remove('hidden');
      document.getElementById('h1')!.textContent = 'Choose a new password';
      document.getElementById('sub')!.textContent = 'This link is single-use and expires in 1 hour.';

      resetForm.addEventListener('submit', (ev) => {
        ev.preventDefault();
        const password = (document.getElementById('password') as HTMLInputElement).value;
        const confirm = (document.getElementById('confirm') as HTMLInputElement).value;
        if (password !== confirm) { out.innerHTML = `<div class="rounded-[2px] border-l-4 border-saffron bg-surface p-3 font-sans text-sm"><strong>Passwords don't match.</strong></div>`; return; }
        const btn = document.getElementById('reset-btn') as HTMLButtonElement;
        btn.disabled = true; btn.textContent = 'Resetting…';
        fetch('/api/auth/reset-password', { method: 'POST', credentials: 'same-origin', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ token, password }) })
          .then((r) => r.json().then((d) => ({ ok: r.ok, d })))
          .then(({ ok, d }) => {
            btn.disabled = false; btn.textContent = 'Reset password';
            if (!ok) { out.innerHTML = `<div class="rounded-[2px] border-l-4 border-saffron bg-surface p-3 font-sans text-sm"><strong>${esc((d && d.error) || 'Could not reset password.')}</strong></div>`; return; }
            out.innerHTML = `<div class="rounded-[2px] border-l-4 border-ok bg-surface p-3 font-sans text-sm"><strong>Password reset.</strong> Redirecting…</div>`;
            location.href = d.mfaRequired ? '/mfa.html' : '/dashboard.html';
          })
          .catch(() => { btn.disabled = false; btn.textContent = 'Reset password'; out.innerHTML = '<div class="rounded-[2px] border-l-4 border-saffron bg-surface p-3 font-sans text-sm">Network error. Please try again.</div>'; });
      });
    } else {
      requestForm.addEventListener('submit', (ev) => {
        ev.preventDefault();
        const email = (document.getElementById('req-email') as HTMLInputElement).value.trim();
        if (!email) return;
        const btn = document.getElementById('req-btn') as HTMLButtonElement;
        btn.disabled = true; btn.textContent = 'Sending…';
        fetch('/api/auth/forgot-password', { method: 'POST', credentials: 'same-origin', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ email }) })
          .then(() => {
            btn.disabled = false; btn.textContent = 'Send reset link';
            out.innerHTML = `<div class="rounded-[2px] border-l-4 border-ok bg-surface p-3 font-sans text-sm"><strong>Check your email.</strong> If an account exists for ${esc(email)}, a reset link is on its way.</div>`;
          })
          .catch(() => { btn.disabled = false; btn.textContent = 'Send reset link'; out.innerHTML = '<div class="rounded-[2px] border-l-4 border-saffron bg-surface p-3 font-sans text-sm">Network error. Please try again.</div>'; });
      });
    }
  </script>
</Base>
