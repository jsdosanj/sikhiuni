---
import Base from '../layouts/Base.astro';
---
<Base title="Reset password, Sikhi University" description="Reset the password on your Sikhi University account." ambient="hall" noindex={true}>
  <!-- isresetpw (1391-1414): same hero-midnight surface as login/mfa.
       This page has no existing strength-meter, so per plan Decision 9(a)
       none is added.

       2026-09-06, the reset is now a 6-DIGIT CODE bound to this browser
       (httpOnly psid cookie), not a clickable link. A link signs in whatever
       device opens the email, often the phone, not the desktop the user is
       actually locked out of, and anyone who can read the mailbox holds a
       working password change.

       The ?token branch is a DELIBERATE, TIME-LIMITED grace path for links
       minted by the old flow that are still inside their one-hour validity
       when this deploys. Delete it (and the token branch in
       functions/api/auth/reset-password.js) in the follow-up. -->
  <div class="hero-midnight flex min-h-[560px] items-center py-16">
    <div class="wrap relative w-full">
      <div class="mx-auto w-full max-w-[430px]">
        <div class="flex justify-center">
          <img src="/assets/su-crest-ivory.png" alt="Sikhi University crest" class="h-14 w-auto" />
        </div>
        <p class="eyebrow mt-4 text-center text-saffron">Reset password</p>
        <h1 class="text-display-sm mt-4 text-center font-bold text-white" id="h1">Reset your password</h1>
        <p class="mt-3 text-center text-[15.5px] leading-relaxed text-white/[0.72]" id="sub">Enter your email and we'll send you a 6-digit code.</p>

        <!-- Step 1: ask for the code -->
        <form id="request-form" class="mt-7 space-y-5">
          <label class="block"><span class="field-label-dark">Email</span>
            <input id="req-email" type="email" required placeholder="you@example.com" data-testid="reset-email" class="mt-2 w-full rounded-[2px] border border-white/[0.34] bg-white/[0.05] px-4 py-3.5 text-base text-white placeholder:text-white/[0.55] focus:border-saffron focus:outline-none" />
          </label>
          <button id="req-btn" type="submit" data-testid="reset-start" class="btn btn-primary w-full justify-center">Send me a code</button>
        </form>

        <!-- Step 2: confirm the emailed code -->
        <form id="code-form" class="mt-7 hidden space-y-5">
          <label class="block"><span class="field-label-dark">6-digit code</span>
            <input id="code" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="6" autocomplete="one-time-code" data-testid="reset-code" class="mt-2 w-full rounded-[2px] border border-white/[0.34] bg-white/[0.05] px-4 py-3.5 text-center text-base tracking-[0.5em] text-white focus:border-saffron focus:outline-none" />
          </label>
          <button id="code-btn" type="submit" data-testid="reset-verify" class="btn btn-primary w-full justify-center">Confirm code</button>
        </form>

        <!-- Step 3: choose the new password (also the ?token legacy entry) -->
        <form id="reset-form" class="mt-7 hidden space-y-5">
          <label class="block"><span class="field-label-dark">New password</span>
            <input id="password" type="password" required minlength="12" autocomplete="new-password" data-testid="reset-password" class="mt-2 w-full rounded-[2px] border border-white/[0.34] bg-white/[0.05] px-4 py-3.5 text-base text-white placeholder:text-white/[0.55] focus:border-saffron focus:outline-none" />
          </label>
          <label class="block"><span class="field-label-dark">Confirm password</span>
            <input id="confirm" type="password" required minlength="12" autocomplete="new-password" data-testid="reset-password-confirm" class="mt-2 w-full rounded-[2px] border border-white/[0.34] bg-white/[0.05] px-4 py-3.5 text-base text-white placeholder:text-white/[0.55] focus:border-saffron focus:outline-none" />
          </label>
          <button id="reset-btn" type="submit" data-testid="reset-complete" class="btn btn-primary w-full justify-center">Reset password</button>
        </form>

        <div id="out" class="mt-4"></div>

        <!-- The shared cross-site family mark, same treatment as login.astro. -->
        <p class="mt-8 text-center font-mono text-[11px] tracking-[0.08em] text-white/[0.62]">
          Powered by <a href="https://sikhi.io" class="underline underline-offset-2">sikhi.io</a>
        </p>
      </div>
    </div>
  </div>
  <script>
    function esc(s: string) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;'); }
    const params = new URLSearchParams(location.search);
    // Legacy grace path only, see the comment at the top of this file.
    const token = params.get('token');

    const out = document.getElementById('out')!;
    const requestForm = document.getElementById('request-form') as HTMLFormElement;
    const codeForm = document.getElementById('code-form') as HTMLFormElement;
    const resetForm = document.getElementById('reset-form') as HTMLFormElement;
    const h1 = document.getElementById('h1')!;
    const sub = document.getElementById('sub')!;

    const problem = (msg: string) => { out.innerHTML = `<div class="rounded-[2px] border-l-4 border-saffron bg-surface p-3 font-sans text-sm"><strong>${esc(msg)}</strong></div>`; };
    const good = (html: string) => { out.innerHTML = `<div class="rounded-[2px] border-l-4 border-ok bg-surface p-3 font-sans text-sm">${html}</div>`; };

    async function postJson(url: string, payload: unknown) {
      const r = await fetch(url, {
        method: 'POST', credentials: 'same-origin',
        headers: { 'content-type': 'application/json' }, body: JSON.stringify(payload),
      });
      const d = await r.json().catch(() => ({}));
      return { ok: r.ok, d: d as Record<string, any> };
    }

    function showPasswordStep(subtitle: string) {
      requestForm.classList.add('hidden');
      codeForm.classList.add('hidden');
      resetForm.classList.remove('hidden');
      h1.textContent = 'Choose a new password';
      sub.textContent = subtitle;
    }

    // The password step is shared by the code path and the legacy token path;
    // only the request body differs.
    resetForm.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const password = (document.getElementById('password') as HTMLInputElement).value;
      const confirm = (document.getElementById('confirm') as HTMLInputElement).value;
      if (password !== confirm) { problem("Passwords don't match."); return; }
      const btn = document.getElementById('reset-btn') as HTMLButtonElement;
      btn.disabled = true; btn.textContent = 'Resetting…';
      try {
        const { ok, d } = await postJson('/api/auth/reset-password', token ? { token, password } : { password });
        if (!ok) { problem(d.error || 'Could not reset password.'); return; }
        good('<strong>Password reset.</strong> Redirecting…');
        location.href = d.mfaRequired ? '/mfa.html' : '/dashboard.html';
      } catch {
        problem('Network error. Please try again.');
      } finally {
        btn.disabled = false; btn.textContent = 'Reset password';
      }
    });

    if (token) {
      showPasswordStep('This link is single-use and expires in 1 hour.');
    } else {
      requestForm.addEventListener('submit', async (ev) => {
        ev.preventDefault();
        const email = (document.getElementById('req-email') as HTMLInputElement).value.trim();
        if (!email) return;
        const btn = document.getElementById('req-btn') as HTMLButtonElement;
        btn.disabled = true; btn.textContent = 'Sending…';
        try {
          const { ok, d } = await postJson('/api/auth/forgot-password', { email });
          if (!ok) { problem(d.error || 'Could not send the code.'); return; }
          // Deliberately advances even for an address with no account: the
          // endpoint is enumeration-resistant and always returns ok, so the
          // UI must not reveal the difference either.
          requestForm.classList.add('hidden');
          codeForm.classList.remove('hidden');
          h1.textContent = 'Enter your code';
          sub.textContent = 'It expires in 15 minutes.';
          good(`<strong>Check your email.</strong> If an account exists for ${esc(email)}, a 6-digit code is on its way.`);
        } catch {
          problem('Network error. Please try again.');
        } finally {
          btn.disabled = false; btn.textContent = 'Send me a code';
        }
      });

      codeForm.addEventListener('submit', async (ev) => {
        ev.preventDefault();
        const code = (document.getElementById('code') as HTMLInputElement).value.trim();
        if (!code) return;
        const btn = document.getElementById('code-btn') as HTMLButtonElement;
        btn.disabled = true; btn.textContent = 'Checking…';
        try {
          const { ok, d } = await postJson('/api/auth/verify-reset-code', { code });
          if (!ok) { problem(d.error || 'That code isn’t right.'); return; }
          out.innerHTML = '';
          showPasswordStep('Choose something at least 12 characters long.');
        } catch {
          problem('Network error. Please try again.');
        } finally {
          btn.disabled = false; btn.textContent = 'Confirm code';
        }
      });
    }
  </script>
</Base>
