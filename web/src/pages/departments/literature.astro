---
import Base from '../../layouts/Base.astro';
import '../../styles/departments.css';
import DeptHero from '../../components/departments/DeptHero.astro';
import DeptSections from '../../components/departments/DeptSections.astro';
import { departments } from '../../lib/departments';
const d = departments.find((x) => x.id === 'literature')!;
const ld = {
  '@context': 'https://schema.org', '@type': 'EducationalOrganization',
  name: `${d.name}, Sikhi University`, description: d.blurb,
  url: 'https://sikhiuni.com/departments/literature',
  parentOrganization: { '@type': 'CollegeOrUniversity', name: 'Sikhi University', url: 'https://sikhiuni.com/' },
};
// The comparative reading room, verified public-domain translations, hosted on
// our sister project Sikhi.io (/classics/library). Read alongside the Sikh text.
const readingRoom = [
  { cat: 'Indian classics', n: 6, works: 'Bhagavad Gītā · Mahābhārata · Rāmāyaṇa · Ṛgveda · Vishnu Purāṇa' },
  { cat: 'Greek & Latin', n: 9, works: 'The Iliad · The Odyssey · The Aeneid · The Divine Comedy · Paradise Lost · Oedipus Rex' },
  { cat: 'World literature', n: 5, works: 'Shakespeare · Don Quixote · War and Peace · Crime and Punishment · The Brothers Karamazov' },
  { cat: 'Western philosophy', n: 21, works: 'Plato · Aristotle · Marcus Aurelius · Kant · Spinoza · Hume · Nietzsche · Machiavelli' },
  { cat: 'World scripture & wisdom', n: 20, works: 'Bible (KJV) · Torah · Talmud · Upanishads · Tao Te Ching · Dhammapada · Analects · Rumi · Hafez' },
];
const dust = Array.from({ length: 20 });
---
<Base title={`${d.name}, Sikhi University`} description={d.blurb} ambient="none">
  <script type="application/ld+json" set:html={JSON.stringify(ld)} slot="head" />
  <div class="dept-page lit-page" style={`--dept:${d.accent}`}>
    <DeptHero d={d}>
      <section class="lt-sig" aria-label="A manuscript, opening">
        <span class="lt-dust" aria-hidden="true">{dust.map((_, i) => <i style={`--n:${i}`}></i>)}</span>
        <div class="wrap lt-in">
          <p class="lt-kicker">Read slowly, the way the teeka tradition reads</p>
          <div class="lt-book" aria-hidden="true">
            <span class="lt-leaf lt-leaf-l"></span>
            <span class="lt-leaf lt-leaf-r"></span>
            <span class="lt-spine"></span>
          </div>
          <h2 class="lt-h">The Sikh canon, and the world's classics next to it</h2>
          <p class="lt-note">
            Bhai Gurdas's vaaran, Bhai Nand Lal's Persian, the Dasam Granth poetry, Bhai Vir Singh and the
            modern Punjabi renaissance, read closely, with prosody and narrative theory, and then set
            beside Homer, the Gītā and Rumi in the comparative reading room below.
          </p>
        </div>
      </section>
    </DeptHero>
    <DeptSections d={d} />

    <!-- The comparative reading room -->
    <section class="lt-room dept-grain" aria-label="The comparative reading room">
      <div class="wrap">
        <p class="dept-kicker" style="color:#e9c98a">The comparative reading room</p>
        <h2 class="lt-room-h">66 of the world's classics, in verified public-domain translations</h2>
        <p class="lt-room-lead">
          Hosted on our sister project, <a href="https://sikhi.io/classics/library" target="_blank" rel="noopener">Sikhi.io</a>,
          with a Gurmat commentary alongside each. Advanced literature courses draw on this shelf directly -
          Gurbani's imagery read against the epic, the scripture and the philosophy of other traditions.
        </p>
        <div class="lt-shelf">
          {readingRoom.map((r) => (
            <a class="lt-vol" href="https://sikhi.io/classics/library" target="_blank" rel="noopener">
              <span class="lt-vol-top">
                <span class="lt-vol-cat">{r.cat}</span>
                <span class="lt-vol-n">{r.n}</span>
              </span>
              <span class="lt-vol-works">{r.works}</span>
              <span class="lt-vol-go">Open the reading room &nearr;</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </div>

  <style>
    .lt-sig {
      position: relative; overflow: hidden;
      background: radial-gradient(120% 100% at 20% -10%, #203d60, #142c49 55%, #0d2037);
      color: #f0dcc6; padding: clamp(3.5rem, 9vw, 6.5rem) 0; border-bottom: 1px solid rgb(var(--c-line));
    }
    .lt-dust { position: absolute; inset: 0; pointer-events: none; }
    .lt-dust i {
      position: absolute; left: calc(8% + var(--n) * 4.3%); bottom: -4%;
      width: 3px; height: 3px; border-radius: 50%; background: #f0c674;
      box-shadow: 0 0 9px #d9a441; opacity: 0;
      animation: lt-rise calc(9s + var(--n) * 1.1s) linear infinite;
      animation-delay: calc(var(--n) * -1.3s);
    }
    @keyframes lt-rise {
      0% { transform: translateY(0) translateX(0); opacity: 0; }
      12% { opacity: .8; }
      85% { opacity: .35; }
      100% { transform: translateY(-46vh) translateX(28px); opacity: 0; }
    }
    .lt-in { position: relative; z-index: 1; }
    .lt-kicker { font-family: var(--font-sans, system-ui); font-size: 11px; font-weight: 800; letter-spacing: .18em; text-transform: uppercase; color: #e6b96a; }

    /* a bound book that opens on scroll (CSS 3D) */
    .lt-book {
      position: relative; width: min(320px, 70vw); height: 150px; margin: 26px 0 8px;
      perspective: 1100px;
    }
    .lt-spine {
      position: absolute; left: 50%; top: 0; width: 6px; height: 100%; transform: translateX(-50%);
      background: linear-gradient(180deg, #6b3a1e, #3a1c0c); border-radius: 3px; z-index: 3;
    }
    .lt-leaf {
      position: absolute; top: 0; width: 50%; height: 100%;
      background:
        linear-gradient(180deg, rgba(255,255,255,.06), transparent 40%),
        repeating-linear-gradient(0deg, transparent 0 15px, rgba(90,60,30,.16) 15px 16px),
        linear-gradient(180deg, #efe2c6, #e2cfa6);
      box-shadow: inset 0 0 40px rgba(120,80,30,.35);
      transform-origin: center left;
    }
    .lt-leaf-l { left: 0; transform-origin: center right; border-radius: 6px 2px 2px 6px;
      transform: rotateY(160deg); animation: lt-open-l both linear; animation-timeline: view(); animation-range: entry 2% cover 42%; }
    .lt-leaf-r { right: 0; border-radius: 2px 6px 6px 2px;
      transform: rotateY(-160deg); animation: lt-open-r both linear; animation-timeline: view(); animation-range: entry 2% cover 42%; }
    @keyframes lt-open-l { to { transform: rotateY(8deg); } }
    @keyframes lt-open-r { to { transform: rotateY(-8deg); } }
    @supports not (animation-timeline: view()) {
      .lt-leaf-l { animation: lt-open-l 1.6s ease-out .2s both; }
      .lt-leaf-r { animation: lt-open-r 1.6s ease-out .2s both; }
    }
    .lt-h { margin: 20px 0 0; font-size: clamp(1.35rem, 3vw, 1.95rem); font-weight: 800; color: #fff; max-width: 26ch; }
    .lt-note { margin: 16px 0 0; max-width: 62ch; font-size: 14.5px; line-height: 1.72; color: #d8b98f; }

    /* hardcover-feel curriculum accordions, scoped to this school */
    .lit-page :global(.dax-item) {
      border-radius: 6px; border-color: #caa06a;
      background:
        linear-gradient(90deg, color-mix(in srgb, var(--dept) 55%, #3a1c0c) 0 5px, transparent 5px),
        linear-gradient(180deg, rgb(var(--c-surface)), color-mix(in srgb, var(--dept) 5%, rgb(var(--c-surface))));
      box-shadow: 0 1px 0 #f2e6cf inset, 0 10px 24px rgb(60 30 10 / .12);
    }
    .lit-page :global(.dax-item[open]) {
      border-color: var(--dept);
      box-shadow: 0 1px 0 #f2e6cf inset, 0 18px 44px rgb(60 30 10 / .22);
    }
    .lit-page :global(.dax-t) { font-family: "Source Serif 4", Georgia, serif; letter-spacing: .01em; }

    /* the reading room */
    .lt-room {
      position: relative; overflow: hidden; color: #f0dcc6;
      background: linear-gradient(180deg, #193451, #10243e);
      padding-block: clamp(4rem, 9vw, 6.5rem);
      border-top: 1px solid rgb(var(--c-line));
    }
    .lt-room-h { margin: 8px 0 0; font-size: clamp(22px, 3.2vw, 32px); font-weight: 800; color: #fff; max-width: 22ch; }
    .lt-room-lead { margin: 14px 0 0; max-width: 64ch; font-size: 15px; line-height: 1.75; color: #d8b98f; }
    .lt-room-lead a { color: #f0c674; text-decoration: underline; text-underline-offset: 3px; }
    .lt-shelf { display: grid; gap: 14px; margin-top: 30px; }
    @media (min-width: 720px) { .lt-shelf { grid-template-columns: repeat(2, 1fr); } }
    @media (min-width: 1100px) { .lt-shelf { grid-template-columns: repeat(3, 1fr); } }
    .lt-vol {
      display: flex; flex-direction: column; gap: 10px; padding: 20px;
      border-radius: 4px; text-decoration: none;
      background: linear-gradient(180deg, rgba(255,255,255,.05), rgba(255,255,255,.02));
      border: 1px solid rgba(240,198,116,.28); border-left: 4px solid #c9962f;
      transition: transform .2s var(--ease-out, ease), border-color .2s, background .2s;
    }
    .lt-vol:hover { transform: translateY(-4px); border-left-color: #f0c674; background: rgba(255,255,255,.07); }
    .lt-vol-top { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
    .lt-vol-cat { font-family: "Source Serif 4", Georgia, serif; font-size: 16px; font-weight: 800; color: #fff; }
    .lt-vol-n { font-family: var(--font-sans, system-ui); font-size: 13px; font-weight: 800; color: #f0c674; }
    .lt-vol-works { font-size: 12.5px; line-height: 1.6; color: #cdb08a; }
    .lt-vol-go { margin-top: auto; font-family: var(--font-sans, system-ui); font-size: 11.5px; font-weight: 800; letter-spacing: .04em; color: #e6b96a; }

    @media (prefers-reduced-motion: reduce) {
      .lt-dust { display: none; }
      .lt-leaf-l { transform: rotateY(8deg); animation: none; }
      .lt-leaf-r { transform: rotateY(-8deg); animation: none; }
    }
  </style>
</Base>
