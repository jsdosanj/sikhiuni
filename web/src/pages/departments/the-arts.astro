---
import Base from '../../layouts/Base.astro';
import '../../styles/departments.css';
import DeptHero from '../../components/departments/DeptHero.astro';
import DeptSections from '../../components/departments/DeptSections.astro';
import { departments } from '../../lib/departments';
const d = departments.find((x) => x.id === 'the-arts')!;
const ld = {
  '@context': 'https://schema.org', '@type': 'EducationalOrganization',
  name: `${d.name}, Sikhi University`, description: d.blurb,
  url: 'https://sikhiuni.com/departments/the-arts',
  parentOrganization: { '@type': 'CollegeOrUniversity', name: 'Sikhi University', url: 'https://sikhiuni.com/' },
};
const raags = [
  ['Sirī','contentment, detachment'],['Mājh','longing, separation'],['Gaüṛī','reflection, seriousness'],
  ['Āsā','hope, striving'],['Gūjrī','quiet devotion'],['Bihāgṛā','the ache of union'],
  ['Vaḍahans','grief, and its acceptance'],['Sorṭh','praise'],['Dhanāsrī','inspiration to act'],
  ['Jaitsrī','humility'],['Ṭoḍī','the pull from the world'],['Tilaṅg','a plea'],
  ['Sūhī','joy, the bride'],['Bilāval','happiness, ease'],['Rāmkalī','discipline, yoga'],
  ['Māru','courage, the battlefield'],['Tukhārī','the seasons turning'],['Kedārā','devotion at dusk'],
  ['Bhairaü','awe, the fierce'],['Basant','renewal, spring'],['Sāraṅg','the thirst of noon'],
  ['Malār','the rains, and mercy'],['Kānṛā','steady love'],['Kalyāṇ','evening serenity'],
  ['Prabhātī','the first light'],['Jaijāvantī','acceptance, letting go'],
];
---
<Base title={`${d.name}, Sikhi University`} description={d.blurb} ambient="none">
  <script type="application/ld+json" set:html={JSON.stringify(ld)} slot="head" />
  <div class="dept-page ar-page" style={`--dept:${d.accent}`}>
    <DeptHero d={d}>
      <section class="ar-sig" aria-label="The raags of Sri Guru Granth Sahib Ji">
        <div class="ar-brush" aria-hidden="true">
          <svg viewBox="0 0 1200 260" preserveAspectRatio="none">
            <path class="ar-s ar-s1" d="M-20 120 C 200 40, 420 200, 660 110 S 1040 40, 1240 130" fill="none" stroke-width="52" stroke-linecap="round" pathLength="1" />
            <path class="ar-s ar-s2" d="M-20 170 C 260 240, 520 90, 780 180 S 1080 240, 1240 150" fill="none" stroke-width="34" stroke-linecap="round" pathLength="1" />
            <path class="ar-s ar-s3" d="M-20 70 C 320 130, 560 20, 820 90 S 1100 20, 1240 80" fill="none" stroke-width="20" stroke-linecap="round" pathLength="1" />
          </svg>
        </div>
        <div class="wrap ar-in">
          <p class="ar-kicker">Srī Guru Granth Sāhib Jī is organised by rāg, over thirty of them</p>
          <h2 class="ar-h">Each rāg carries a feeling. Kīrtan holds the Shabad in it.</h2>
          <div class="ar-raags" role="list">
            {raags.map(([name, mood]) => (
              <span class="ar-raag" role="listitem" tabindex="0">
                <span class="ar-name">{name}</span>
                <span class="ar-mood">{mood}</span>
              </span>
            ))}
          </div>
          <p class="ar-note">The department teaches the rāg and tāl, the tantī sāj the Gurus played, and the visual tradition alongside it, the frescoes, the illuminated biṛs, the architecture.</p>
        </div>
      </section>
    </DeptHero>
    <DeptSections d={d} />
  </div>

  <style>
    .ar-sig { position: relative; overflow: hidden; background: linear-gradient(180deg, #193655, #0e2139); color: #f4dbe4; padding: clamp(3.5rem, 9vw, 6.5rem) 0; border-bottom: 1px solid rgb(var(--c-line)); }
    .ar-brush { position: absolute; inset: 0; pointer-events: none; opacity: .5; }
    .ar-brush svg { width: 100%; height: 100%; }
    .ar-s { stroke-dasharray: 1; stroke-dashoffset: 1; animation: ar-paint linear both; animation-timeline: view(); }
    .ar-s1 { stroke: #e0553f; animation-range: entry 0% cover 45%; }
    .ar-s2 { stroke: #3f7de0; animation-range: entry 8% cover 55%; }
    .ar-s3 { stroke: #e0a83f; animation-range: entry 14% cover 62%; }
    @keyframes ar-paint { to { stroke-dashoffset: 0; } }
    @supports not (animation-timeline: view()) {
      .ar-s1 { animation: ar-paint 2s ease-out both; }
      .ar-s2 { animation: ar-paint 2s ease-out .25s both; }
      .ar-s3 { animation: ar-paint 2s ease-out .5s both; }
    }
    .ar-in { position: relative; z-index: 1; }
    .ar-kicker { font-family: var(--font-sans, system-ui); font-size: 11px; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; color: color-mix(in srgb, var(--dept) 45%, #fff); }
    .ar-h { margin: 8px 0 0; font-size: clamp(1.35rem, 3vw, 1.9rem); font-weight: 800; color: #fff; max-width: 28ch; }
    .ar-raags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 20px; }
    .ar-raag {
      position: relative; display: inline-flex; align-items: center; padding: 8px 14px; border-radius: 999px;
      background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.14);
      font-family: var(--font-sans, system-ui); font-size: 13px; color: #f0cdd6; cursor: default;
      transition: background .18s, border-color .18s, color .18s;
    }
    .ar-raag:hover, .ar-raag:focus-visible { background: color-mix(in srgb, var(--dept) 30%, transparent); border-color: var(--dept); color: #fff; outline: none; }
    .ar-mood {
      position: absolute; left: 50%; bottom: calc(100% + 8px); transform: translateX(-50%) translateY(4px);
      white-space: nowrap; padding: 5px 10px; border-radius: 8px; background: #122a45; border: 1px solid var(--dept); color: #fff;
      font-size: 11.5px; opacity: 0; pointer-events: none; transition: opacity .16s, transform .16s; z-index: 2;
    }
    .ar-raag:hover .ar-mood, .ar-raag:focus-visible .ar-mood { opacity: 1; transform: translateX(-50%) translateY(0); }
    .ar-note { margin: 24px 0 0; max-width: 62ch; font-size: 14px; line-height: 1.7; color: #d5aab6; }
    @media (prefers-reduced-motion: reduce) { .ar-s { stroke-dashoffset: 0; animation: none; } }
  </style>
</Base>
