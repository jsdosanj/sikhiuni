---
import Base from '../../layouts/Base.astro';
import '../../styles/departments.css';
import DeptHero from '../../components/departments/DeptHero.astro';
import DeptSections from '../../components/departments/DeptSections.astro';
import { departments } from '../../lib/departments';
const d = departments.find((x) => x.id === 'political-governance')!;
const ld = {
  '@context': 'https://schema.org', '@type': 'EducationalOrganization',
  name: `${d.name}, Sikhi University`, description: d.blurb,
  url: 'https://sikhiuni.com/departments/political-governance',
  parentOrganization: { '@type': 'CollegeOrUniversity', name: 'Sikhi University', url: 'https://sikhiuni.com/' },
};
const institutions = [
  ['Saṅgat', 'The congregation, authority sits with the gathered, not a clergy.'],
  ['Paṅgat &amp; Laṅgar', 'Everyone eats in one row. The kitchen is a political statement.'],
  ['Panj Pyāre', 'Five, chosen and equal, act for the whole. Leadership without a throne.'],
  ['Gurmatā', 'A decision taken in the presence of the Guru, binding on the Panth.'],
  ['Sarbat Khālsā', 'The whole Panth in assembly, the highest collective body.'],
  ['Akāl Takht', 'The seat of temporal authority, facing Darbār Sāhib. Mīrī and Pīrī together.'],
];
---
<Base title={`${d.name}, Sikhi University`} description={d.blurb} ambient="none">
  <script type="application/ld+json" set:html={JSON.stringify(ld)} slot="head" />
  <div class="dept-page pg-page" style={`--dept:${d.accent}`}>
    <DeptHero d={d}>
      <section class="pg-sig" aria-label="The institutions of the Panth">
        <div class="pg-arch" aria-hidden="true">
          <span class="pg-col pg-col-l"></span>
          <span class="pg-col pg-col-r"></span>
          <span class="pg-cap pg-cap-l"></span>
          <span class="pg-cap pg-cap-r"></span>
          <span class="pg-lintel"></span>
          <span class="pg-key"></span>
        </div>
        <div class="wrap pg-in">
          <p class="pg-kicker">Mīrī &amp; Pīrī, the temporal and the spiritual, held together</p>
          <h2 class="pg-h">The Gurus built institutions, not just ideas</h2>
          <ol class="pg-list">
            {institutions.map(([t, b], i) => (
              <li class="pg-node" style={`--i:${i}`}>
                <span class="pg-dot" aria-hidden="true"></span>
                <span class="pg-t" set:html={t} />
                <span class="pg-b" set:html={b} />
              </li>
            ))}
          </ol>
          <p class="pg-note">The department studies each of these as something meant to be practised, sovereignty you can run, not just admire.</p>
        </div>
      </section>
    </DeptHero>
    <DeptSections d={d} />
  </div>

  <style>
    .pg-sig { position: relative; overflow: hidden; background: linear-gradient(180deg, #141c2e, #0e1420); color: #dbe2ee; padding: clamp(4rem, 9vw, 7rem) 0 clamp(3rem, 7vw, 5rem); border-bottom: 1px solid rgb(var(--c-line)); }

    /* an archway that builds itself on load */
    .pg-arch { position: absolute; inset: 0; pointer-events: none; }
    .pg-arch span { position: absolute; background: linear-gradient(180deg, #4a566b, #2b3446); box-shadow: inset 0 0 0 1px rgba(255,255,255,.06); }
    .pg-col { bottom: 0; width: clamp(26px, 5vw, 48px); height: 0; animation: pg-rise .8s var(--ease-out, ease) .1s forwards; }
    .pg-col-l { left: 4%; } .pg-col-r { right: 4%; }
    .pg-cap { width: clamp(40px, 7vw, 66px); height: 12px; opacity: 0; animation: pg-fade .4s ease .9s forwards; }
    .pg-cap-l { left: calc(4% - 9px); bottom: min(64%, 420px); } .pg-cap-r { right: calc(4% - 9px); bottom: min(64%, 420px); }
    .pg-lintel { left: 4%; right: 4%; height: clamp(14px, 2.4vw, 22px); bottom: calc(min(64%, 420px) + 12px); transform: scaleX(0); transform-origin: center; animation: pg-span .7s var(--ease-out, ease) 1.15s forwards; }
    .pg-key { left: 50%; transform: translateX(-50%) scale(0); width: clamp(20px, 3vw, 30px); height: clamp(20px, 3vw, 30px); border-radius: 4px; background: var(--dept); bottom: calc(min(64%, 420px) + 24px); box-shadow: 0 0 20px color-mix(in srgb, var(--dept) 60%, transparent); animation: pg-pop .5s var(--ease-spring, ease) 1.75s forwards; }
    @keyframes pg-rise { to { height: min(64%, 420px); } }
    @keyframes pg-fade { to { opacity: .9; } }
    @keyframes pg-span { to { transform: scaleX(1); } }
    @keyframes pg-pop { to { transform: translateX(-50%) scale(1); } }

    .pg-in { position: relative; z-index: 1; }
    .pg-kicker { font-family: var(--font-sans, system-ui); font-size: 11px; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; color: #d7b46b; }
    .pg-h { margin: 8px 0 0; font-size: clamp(1.35rem, 3vw, 1.9rem); font-weight: 800; color: #fff; max-width: 22ch; }
    .pg-list { list-style: none; margin: 28px 0 0; padding: 0; max-width: 60ch; background: rgba(10,15,25,.4); border: 1px solid rgba(255,255,255,.08); border-radius: 14px; padding: 24px 24px 8px; }
    .pg-node { position: relative; padding: 0 0 20px 28px; opacity: 0; transform: translateY(12px); animation: pg-in .55s var(--ease-out, ease) forwards; animation-delay: calc(2s + var(--i) * .1s); }
    .pg-node:not(:last-child)::before { content: ""; position: absolute; left: 4px; top: 14px; bottom: 0; width: 2px; background: rgba(255,255,255,.12); }
    .pg-dot { position: absolute; left: 0; top: 4px; width: 10px; height: 10px; border-radius: 50%; background: #d7b46b; }
    .pg-t { display: block; font-weight: 800; font-size: 15.5px; color: #fff; }
    .pg-b { display: block; margin-top: 4px; font-size: 13px; line-height: 1.55; color: #aeb9cc; }
    .pg-note { margin: 20px 0 0; max-width: 58ch; font-size: 14px; line-height: 1.7; color: #9aa6bd; }
    @keyframes pg-in { to { opacity: 1; transform: none; } }
    @media (prefers-reduced-motion: reduce) {
      .pg-col { height: min(64%, 420px); animation: none; }
      .pg-cap { opacity: .9; animation: none; }
      .pg-lintel { transform: scaleX(1); animation: none; }
      .pg-key { transform: translateX(-50%) scale(1); animation: none; }
      .pg-node { opacity: 1; transform: none; animation: none; }
    }
  </style>
</Base>
