---
import Base from '../../layouts/Base.astro';
import '../../styles/departments.css';
import DeptHero from '../../components/departments/DeptHero.astro';
import DeptSections from '../../components/departments/DeptSections.astro';
import { departments } from '../../lib/departments';
const d = departments.find((x) => x.id === 'theology')!;
const ld = {
  '@context': 'https://schema.org', '@type': 'EducationalOrganization',
  name: `${d.name}, Sikhi University`, description: d.blurb,
  url: 'https://sikhiuni.com/departments/theology',
  parentOrganization: { '@type': 'CollegeOrUniversity', name: 'Sikhi University', url: 'https://sikhiuni.com/' },
};
const mool = ['ੴ','ਸਤਿ ਨਾਮੁ','ਕਰਤਾ ਪੁਰਖੁ','ਨਿਰਭਉ','ਨਿਰਵੈਰੁ','ਅਕਾਲ ਮੂਰਤਿ','ਅਜੂਨੀ','ਸੈਭੰ','ਗੁਰ ਪ੍ਰਸਾਦਿ ॥'];
const motes = Array.from({ length: 14 });
---
<Base title={`${d.name}, Sikhi University`} description={d.blurb} ambient="none">
  <script type="application/ld+json" set:html={JSON.stringify(ld)} slot="head" />
  <div class="dept-page th-page" style={`--dept:${d.accent}`}>
    <DeptHero d={d}>
      <section class="th-sig" aria-label="The Mool Mantar">
        <span class="th-rays" aria-hidden="true"></span>
        <span class="th-motes" aria-hidden="true">{motes.map((_, i) => <i style={`--n:${i}`}></i>)}</span>
        <div class="wrap th-in">
          <p class="th-kicker">Everything in this department begins with one verse</p>
          <p class="th-mool" lang="pa">{mool.map((w) => <span>{w}</span>)}</p>
          <p class="th-note">The Mūl Mantar, the opening of Srī Guru Granth Sāhib Jī, Aṅg 1. The theology, the metaphysics, the ethics of the whole tradition unfold from these words.</p>
        </div>
      </section>
    </DeptHero>
    <DeptSections d={d} />
  </div>

  <style>
    .th-sig {
      position: relative; overflow: hidden;
      background: radial-gradient(130% 100% at 22% -10%, #1c3c63, #122a49 55%, #0c1d34);
      color: #f4e6cf; padding: clamp(3.5rem, 9vw, 6.5rem) 0; border-bottom: 1px solid rgb(var(--c-line));
    }
    /* golden light through an archway */
    .th-rays {
      position: absolute; inset: -20% -10% auto -10%; height: 130%; pointer-events: none;
      background:
        conic-gradient(from 200deg at 22% -10%,
          transparent 0deg,
          color-mix(in srgb, var(--dept) 40%, transparent) 8deg,
          transparent 16deg,
          color-mix(in srgb, var(--dept) 30%, transparent) 26deg,
          transparent 34deg,
          color-mix(in srgb, var(--dept) 45%, transparent) 46deg,
          transparent 56deg);
      mask-image: radial-gradient(80% 100% at 22% 0%, #000 20%, transparent 78%);
      opacity: .55; animation: th-sway 16s ease-in-out infinite alternate;
    }
    @keyframes th-sway { from { transform: rotate(-2deg) scale(1.05); } to { transform: rotate(3deg) scale(1.12); } }
    .th-motes { position: absolute; inset: 0; pointer-events: none; }
    .th-motes i {
      position: absolute; left: calc(6% + var(--n) * 6.6%); top: -6%;
      width: 4px; height: 4px; border-radius: 50%; background: #ffdf9e;
      box-shadow: 0 0 10px color-mix(in srgb, var(--dept) 80%, transparent);
      opacity: 0; animation: th-fall calc(9s + var(--n) * 1.3s) linear infinite;
      animation-delay: calc(var(--n) * -1.7s);
    }
    @keyframes th-fall { 0% { transform: translateY(0) translateX(0); opacity: 0; } 10% { opacity: .9; } 90% { opacity: .5; } 100% { transform: translateY(120vh) translateX(30px); opacity: 0; } }

    .th-in { position: relative; z-index: 1; }
    .th-kicker { font-family: var(--font-sans, system-ui); font-size: 11px; font-weight: 800; letter-spacing: .18em; text-transform: uppercase; color: #e9c56a; }
    .th-mool {
      display: flex; flex-wrap: wrap; gap: 10px 26px; margin: 22px 0 0;
      font-family: "Noto Serif Gurmukhi", "Noto Sans Gurmukhi", serif;
      font-size: clamp(1.35rem, 3.4vw, 2.5rem); line-height: 1.5; color: #ffe6b0;
      text-shadow: 0 0 34px color-mix(in srgb, var(--dept) 55%, transparent);
    }
    .th-mool span { opacity: 0; transform: translateY(10px); animation: th-word .7s var(--ease-out, ease) forwards; }
    .th-mool span:nth-child(1){animation-delay:.05s}.th-mool span:nth-child(2){animation-delay:.18s}
    .th-mool span:nth-child(3){animation-delay:.31s}.th-mool span:nth-child(4){animation-delay:.44s}
    .th-mool span:nth-child(5){animation-delay:.57s}.th-mool span:nth-child(6){animation-delay:.70s}
    .th-mool span:nth-child(7){animation-delay:.83s}.th-mool span:nth-child(8){animation-delay:.96s}
    .th-mool span:nth-child(9){animation-delay:1.09s}
    @keyframes th-word { to { opacity: 1; transform: none; } }
    .th-note { margin: 26px 0 0; max-width: 58ch; font-size: 14.5px; line-height: 1.7; color: #d8bd8d; }
    @media (prefers-reduced-motion: reduce) {
      .th-rays, .th-motes i { animation: none; }
      .th-motes { display: none; }
      .th-mool span { opacity: 1; transform: none; animation: none; }
    }
  </style>
</Base>
