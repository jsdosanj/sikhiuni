---
import Base from '../layouts/Base.astro';
---
<Base title="Certificate, Sikhi University" description="Your Sikhi University certificate of completion." autoTranslate={false} ambient="study" noindex={true}>
  <section class="wrap py-10">
    <div id="cert-app"><p class="text-muted" data-i18n="cert.loading">Loading…</p></div>
  </section>
  <style>
    @media print { nav, footer, .noprint { display: none !important; } body { background: #fff; } }
  </style>
  <script>
    import { jsPDF } from 'jspdf';
    import html2canvas from 'html2canvas';
    import { iconSvg, sealMark } from '../lib/icons';
    const esc = (s) => String(s == null ? '' : s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    const get = (k, d) => { try { const v = localStorage.getItem('su_v1_' + k); return v == null ? d : JSON.parse(v); } catch { return d; } };
    const app = document.getElementById('cert-app');
    const id = new URLSearchParams(location.search).get('course');
    Promise.all([
      fetch('/data/index.json').then((r) => r.json()),
      fetch('/api/me', { credentials: 'same-origin' }).then((r) => (r.ok ? r.json() : { user: null })).catch(() => ({ user: null })),
    ]).then(([data, me]) => {
      const c = data.courses.find((x) => x.id === id);
      const tn = (t) => (data.topics.find((x) => x.id === t) || {}).name || t;
      if (!c) { app.innerHTML = '<p class="text-muted" data-i18n="cert.notfound">Course not found.</p>'; return; }
      const score = get('passed_' + c.id, null);
      if (!score) { app.innerHTML = `<div class="rounded-xl border-l-4 border-saffron bg-surface p-4"><span class="inline-flex items-center gap-1.5">${iconSvg('lock', 'h-4 w-4 shrink-0')}<span><span data-i18n="cert.locked.prefix">Complete</span> <a class="underline" href="/course/${c.id}">${esc(c.title)}</a> <span data-i18n="cert.locked.suffix">and pass its test (80%+) to earn your certificate.</span></span></span></div>`; return; }
      const name = (get('profile', {}) || {}).name || (me && me.user && me.user.name) || '';
      const issued = new Date().toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' });
      // Solid registrar's-ledger certificate, double-bordered (1px navy outer,
      // gold inner) per the redesign prototype's iscert block. THE RENDER
      // SURFACE (#cert-card) STAYS FULLY SOLID -- no glass, no alpha
      // background, no ambient bleed-through anywhere in this subtree:
      // html2canvas cannot rasterize backdrop-filter/translucency, and a
      // corrupted or blank captured certificate is a trust failure, not a
      // cosmetic one. Permanent exception to the surface language, not a
      // temporary shortcut. (A plain JS comment, not an HTML one -- an HTML
      // comment here would ship as a live node inside the captured card.)
      app.innerHTML = `
        ${name ? '' : '<div class="noprint mb-4 rounded-xl border-l-4 border-saffron bg-surface p-3 font-sans text-sm"><span data-i18n="cert.addname.prefix">Add your name on your</span> <a class="underline" href="/dashboard" data-i18n="cert.addname.link">dashboard</a> <span data-i18n="cert.addname.suffix">so it appears on the certificate.</span></div>'}
        <div id="cert-card" class="mx-auto max-w-3xl border border-navy bg-surface p-2">
          <div class="border border-saffron bg-surface px-8 py-12 text-center sm:px-12">
            <div class="flex justify-center text-saffron-deep">${iconSvg('diya', 'h-[78px] w-[78px]')}</div>
            <p class="mt-4 font-mono text-[11px] font-bold uppercase tracking-[0.3em] text-saffron-deep">Sikhi University</p>
            <p class="mt-1 font-sans text-[0.7rem] uppercase tracking-[0.24em] text-saffron-deep" data-i18n="cert.label.completion">Certificate of Completion</p>
            <div class="mx-auto mt-6 h-px w-14 bg-saffron"></div>
            <p class="mt-6 font-mono text-[11px] uppercase tracking-[0.2em] text-muted" data-i18n="cert.label.certifies">This certifies that</p>
            <p class="mx-auto mt-3 font-sans text-[42px] font-bold leading-[1.12] tracking-[-0.03em] text-navy">${esc(name || '________________')}</p>
            <p class="mx-auto mt-4 max-w-[44ch] font-sans text-[15px] leading-relaxed text-muted" data-i18n="cert.label.completedcourse">has completed the course</p>
            <p class="mt-2 font-serif text-2xl font-bold leading-snug text-navy">${esc(c.title)}</p>
            <p class="mt-3 font-mono text-[11px] uppercase tracking-[0.18em] text-saffron-deep">${esc(tn(c.topic))} &middot; Level ${c.level} &middot; Score ${score}%</p>
            <div class="mt-11 flex items-end justify-between gap-4 border-t border-line pt-6 text-left">
              <div class="font-mono text-navy">
                <div class="text-[9.5px] uppercase tracking-[0.16em] text-muted" data-i18n="cert.label.conferred">Conferred</div>
                <div class="mt-1 text-[13px]">${issued}</div>
              </div>
              ${sealMark()}
              <div id="cert-vid" class="text-right font-mono text-[13px] text-navy"></div>
            </div>
            <p class="mx-auto mt-6 max-w-[56ch] font-sans text-[11.5px] leading-relaxed text-muted" data-i18n="cert.aidisclosure">Course content created by AI and reviewed for accuracy. Verify authenticity at sikhiuni.com/verify</p>
          </div>
        </div>
        <div class="noprint mt-6 flex flex-wrap justify-center gap-3"><button id="dl-pdf" class="btn btn-primary">${iconSvg('download', 'h-4 w-4')} <span data-i18n="cert.btn.downloadpdf">Download PDF</span></button><button id="print" class="btn">${iconSvg('printer', 'h-4 w-4')} <span data-i18n="cert.btn.print">Print</span></button></div>`;
      // Decorative only, fired after the real certificate is already fully rendered -
      // the overlay self-removes long before a PDF/print capture could happen, and the
      // render surface itself stays solid (html2canvas cannot rasterize blur).
      const certCard = document.getElementById('cert-card');
      if (certCard) sealReveal(certCard);
      document.getElementById('print')?.addEventListener('click', () => window.print());
      document.getElementById('dl-pdf')?.addEventListener('click', async () => {
        const card = document.getElementById('cert-card'); const btn = document.getElementById('dl-pdf');
        if (!card) return; const old = btn.innerHTML; btn.disabled = true; btn.textContent = 'Preparing…';
        try {
          const [{ default: html2canvas }, { jsPDF }] = await Promise.all([import('html2canvas'), import('jspdf')]);
          const canvas = await html2canvas(card, { scale: 2, backgroundColor: '#fffdf8', useCORS: true });
          const pdf = new jsPDF({ orientation: 'landscape', unit: 'pt', format: 'a4' });
          const pw = pdf.internal.pageSize.getWidth(), ph = pdf.internal.pageSize.getHeight();
          const ratio = Math.min(pw / canvas.width, ph / canvas.height) * 0.92;
          const w = canvas.width * ratio, h = canvas.height * ratio;
          pdf.addImage(canvas.toDataURL('image/png'), 'PNG', (pw - w) / 2, (ph - h) / 2, w, h);
          pdf.save('sikh-university-' + (c.id || 'certificate') + '.pdf');
        } catch (e) { window.suToast('Could not generate the PDF, please use Print instead.', 'error'); }
        btn.disabled = false; btn.innerHTML = old;
      });
      // Issue a verifiable certificate ID (needs sign-in; validates the synced pass server-side).
      fetch('/api/certificates', { method: 'POST', credentials: 'same-origin', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ courseId: c.id, name }) })
        .then((r) => r.json().then((d) => ({ ok: r.ok, d }))).then(({ ok, d }) => {
          const v = document.getElementById('cert-vid'); if (!v) return;
          if (ok && d.id) v.innerHTML = '<span data-i18n="cert.vid.prefix">Verification ID:</span> <strong>' + esc(d.id) + '</strong> <span data-i18n="cert.vid.middle">· verify at</span> <span>sikhiuni.com/verify?id=' + esc(d.id) + '</span>';
          else v.innerHTML = '<span class="noprint" data-i18n="cert.vid.signin">Sign in (and let your progress sync) to get a verifiable certificate ID.</span>';
        }).catch(() => {});
    }).catch(() => { app.innerHTML = '<p class="text-muted" data-i18n="cert.loaderror">Could not load.</p>'; });
  </script>
</Base>
