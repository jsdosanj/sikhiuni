---
import Base from '../layouts/Base.astro';
---
<Base title="My Learning — Sikhi University" description="Your progress, certificates, streak and badges at Sikhi University." ambient="study" noindex={true}>
  <section class="wrap py-10 sm:py-12">
    <div id="bar"></div>
    <!--
      Static skeleton (isdashboard, prototype lines 385-427). `#dash` is
      wholesale-replaced by the account/progress script below the instant it
      resolves (unchanged behaviour — see the script's `root.innerHTML =`
      assignments); this is what a visitor or crawler sees before/without
      that JS. Nothing here is invented data (Decision 12 / task 15
      acceptance): the three stat labels below ("Points", "Day streak",
      "Courses complete") are the exact literal labels the script itself
      renders in `renderStudent()`'s `stat(...)` calls — grep either file for
      them and they match — every numeral is the placeholder "—" this file
      already uses elsewhere for missing data (see `fmtRel`), and the
      "Continue where you stopped" band and "Enrolled" ledger are shimmer
      placeholders for the real "Continue where you stopped"/"Enrolled"
      sections the script renders in their place (same rename, same data).
    -->
    <div id="dash">
      <div class="flex flex-wrap items-end justify-between gap-6 rule-navy pb-5">
        <div class="min-w-0">
          <p class="eyebrow text-saffron-deep" data-i18n="dash.eyebrow">Sat Sri Akal</p>
          <h1 class="text-display-sm mt-3 text-navy" data-i18n="dash.loading">Loading your learning…</h1>
        </div>
        <div class="flex flex-none gap-8 pb-1" aria-hidden="true">
          <div class="stat-mono"><span>—</span><span>Points</span></div>
          <div class="stat-mono"><span>—</span><span>Day streak</span></div>
          <div class="stat-mono"><span>—</span><span>Courses complete</span></div>
        </div>
      </div>

      <div class="band-navy mt-6 flex flex-wrap items-center justify-between gap-6 rounded-[3px] p-6" aria-hidden="true">
        <div class="min-w-0 flex-1">
          <p class="font-mono text-[10.5px] uppercase tracking-[.2em] text-saffron" data-i18n="dash.resume.eyebrow">Continue where you stopped</p>
          <div class="skeleton mt-3 h-4 w-56 max-w-full"></div>
        </div>
        <span class="btn btn-primary flex-none opacity-60" data-i18n="dash.resume.cta">Resume</span>
      </div>

      <div class="mt-9">
        <p class="eyebrow text-saffron-deep" data-i18n="dash.enrolled.eyebrow">Enrolled</p>
        <div class="rule-navy mt-1" aria-hidden="true">
          <div class="row-ruled"><span class="skeleton h-4 w-48"></span><span class="skeleton ml-auto h-[3px] w-24"></span></div>
          <div class="row-ruled"><span class="skeleton h-4 w-36"></span><span class="skeleton ml-auto h-[3px] w-24"></span></div>
        </div>
      </div>
    </div>

    <!--
      "Today's ang" (task 15 spec): dashboard.astro has no existing
      daily-shabad/ang-of-the-day hook to reuse (grepped — none of
      `#daily-shabad`/`#ds-line`/`#ds-cite`/`#ds-link` exist in this file),
      so per spec this links straight into the reader rather than adding a
      new corpus fetch. Lives outside `#dash` — it needs no account data, so
      it isn't wiped when the script above replaces `#dash`'s contents.
    -->
    <div class="mt-10 max-w-lg">
      <p class="eyebrow text-saffron-deep" data-i18n="dash.ang.eyebrow">Today's ang</p>
      <div class="rule-navy mt-1 pt-4">
        <p class="font-sans text-sm text-muted" data-i18n="dash.ang.body">Read along, ang by ang, with Santhya audio.</p>
        <a class="mt-3 inline-block font-mono text-[11px] tracking-[.06em] text-saffron-deep underline" href="/santhiya" data-i18n="dash.ang.cta">Open in the reader →</a>
      </div>
    </div>
  </section>
  <script>
    import { iconSvg } from '../lib/icons';
    import { initRings } from '../lib/motion';
    import { support as pushSupport, serverKey as pushServerKey, isSubscribed as pushIsSubscribed, enable as pushEnable, disable as pushDisable } from '../lib/push';
    const esc = (s) => String(s == null ? '' : s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    const get = (k, d) => { try { const v = localStorage.getItem('su_v1_' + k); return v == null ? d : JSON.parse(v); } catch { return d; } };
    const set = (k, v) => { try { localStorage.setItem('su_v1_' + k, JSON.stringify(v)); } catch {} };
    const passed = (id) => !!get('passed_' + id, false);
    function progress(c) { if (!c.nLessons) return 0; const d = get('done_' + c.id, {}); let n = 0; for (const k in d) if (d[k]) n++; return Math.round((n / c.nLessons) * 100); }
    function streak() { const a = get('activity', []); if (!a.length) return 0; const s = {}; a.forEach((d) => (s[d] = 1)); const key = (dt) => dt.getFullYear() + '-' + (dt.getMonth() + 1) + '-' + dt.getDate(); let d = new Date(); if (!s[key(d)]) { d.setDate(d.getDate() - 1); if (!s[key(d)]) return 0; } let n = 0; while (s[key(d)]) { n++; d.setDate(d.getDate() - 1); } return n; }

    const fmtRel = (ts) => { if (!ts) return '—'; const s = (Date.now() - ts) / 1000; if (s < 86400) return 'today'; const d = Math.floor(s / 86400); if (d < 7) return d + 'd ago'; if (d < 30) return Math.floor(d / 7) + 'w ago'; return Math.floor(d / 30) + 'mo ago'; };
    const grade = (s) => s >= 90 ? 'A' : s >= 80 ? 'B' : s >= 70 ? 'C' : s >= 60 ? 'D' : 'F';
    const api = (p, o) => fetch(p, { credentials: 'same-origin', headers: o ? { 'content-type': 'application/json' } : undefined, ...(o || {}) }).then((r) => (r.ok ? r.json() : { user: null, error: true })).catch(() => ({ user: null, error: true }));
    // Profile allowlists — keep in sync with functions/api/_profile-options.js.
    const COUNTRIES = ['Afghanistan','Albania','Algeria','Argentina','Armenia','Australia','Austria','Azerbaijan','Bahrain','Bangladesh','Belgium','Bhutan','Bolivia','Bosnia and Herzegovina','Brazil','Brunei','Bulgaria','Cambodia','Cameroon','Canada','Chile','China','Colombia','Croatia','Cyprus','Czechia','Denmark','Ecuador','Egypt','Estonia','Ethiopia','Fiji','Finland','France','Georgia','Germany','Ghana','Greece','Guatemala','Hong Kong','Hungary','Iceland','India','Indonesia','Iran','Iraq','Ireland','Israel','Italy','Jamaica','Japan','Jordan','Kazakhstan','Kenya','Kuwait','Kyrgyzstan','Laos','Latvia','Lebanon','Libya','Lithuania','Luxembourg','Malaysia','Maldives','Malta','Mauritius','Mexico','Moldova','Mongolia','Morocco','Myanmar','Nepal','Netherlands','New Zealand','Nigeria','North Macedonia','Norway','Oman','Pakistan','Panama','Paraguay','Peru','Philippines','Poland','Portugal','Qatar','Romania','Russia','Rwanda','Saudi Arabia','Serbia','Singapore','Slovakia','Slovenia','South Africa','South Korea','Spain','Sri Lanka','Sweden','Switzerland','Syria','Taiwan','Tanzania','Thailand','Tunisia','Turkey','Turkmenistan','Uganda','Ukraine','United Arab Emirates','United Kingdom','United States','Uruguay','Uzbekistan','Venezuela','Vietnam','Yemen','Zambia','Zimbabwe','Other'];
    const LANGUAGES = ['Punjabi','English','Hindi','Urdu','Gurmukhi','Shahmukhi','Bengali','Tamil','Telugu','Marathi','Gujarati','Kannada','Malayalam','Sindhi','Pashto','Farsi','Arabic','Spanish','French','German','Portuguese','Italian','Dutch','Russian','Mandarin','Cantonese','Japanese','Korean','Thai','Vietnamese','Indonesian','Malay','Swahili','Turkish','Other'];
    Promise.all([api('/api/me'), fetch('/data/index.json').then((r) => r.json()), api('/api/progress'), api('/api/enrollments')]).then(([me, data, prog, enrollRes]) => {
      // Server is the source of truth for grades: merge it into the local cache before rendering.
      if (prog && prog.progress) prog.progress.forEach((row) => {
        if (row.passed_score != null) { set('score_' + row.course_id, row.passed_score); if (row.passed_score >= 80) set('passed_' + row.course_id, row.passed_score); }
        try { const arr = JSON.parse(row.done || '[]'); if (arr.length) { const d = get('done_' + row.course_id, {}); arr.forEach((i) => { d[i] = true; }); set('done_' + row.course_id, d); } } catch (e) {}
      });
      const user = me && me.user;
      // Explicit registrations (server is source of truth for signed-in users).
      const enr = (enrollRes && enrollRes.enrollments) || [];
      const enrolledCourses = new Set(enr.filter((e) => e.kind === 'course').map((e) => e.target_id));
      const registeredPrograms = new Set(enr.filter((e) => e.kind === 'program').map((e) => e.target_id));
      const isAdmin = !!(user && user.role === 'admin');
      // isTeacher covers role==='teacher' AND a course_teachers assignment held by a
      // user of any other role (an admin, or even a learner given co-teacher access) —
      // see functions/api/_lib.js's isCourseTeacher. Either one gets the real (non-demo)
      // Student/Teacher switch below, not just admins.
      const isTeacherReal = !!(user && user.isTeacher);
      const qs = new URLSearchParams(location.search);
      const demo = qs.get('demo'); // ?demo=student|teacher — a sample dashboard with illustrative data
      const viewParam = qs.get('view'); // ?view=student|teacher — this account's OWN real data, rendered as that role
      const viewAs = (isAdmin && (demo === 'student' || demo === 'teacher')) ? demo
        : ((isAdmin || isTeacherReal) && (viewParam === 'student' || viewParam === 'teacher')) ? viewParam
        : (user && user.role === 'teacher' ? 'teacher' : 'student');
      const root = document.getElementById('dash');
      const bar = document.getElementById('bar');

      if (isAdmin || isTeacherReal) {
        const link = (label, v, on) => `<a href="/dashboard${v ? '?view=' + v : ''}" class="rounded-lg px-3 py-1.5 font-sans text-sm ${on ? 'bg-brand text-white' : 'border border-line hover:border-saffron'}">${label}</a>`;
        bar.innerHTML = `<div class="mb-6 flex flex-wrap items-center gap-2 rounded-xl2 border border-line bg-surface p-3">
          <span class="font-sans text-sm font-semibold text-navy">View as:</span>
          ${link('Student', 'student', !demo && viewAs === 'student')}
          ${link('Teacher', 'teacher', !demo && viewAs === 'teacher')}
          ${isAdmin ? '<a href="/admin" class="ml-auto rounded-lg px-3 py-1.5 font-sans text-sm border border-line hover:border-saffron">← Admin dashboard</a>' : ''}
        </div>` + (demo ? `<div class="mb-6 rounded-xl2 border-l-4 border-saffron bg-saffron-soft/40 p-3 font-sans text-sm">Demo mode — a sample <strong>${esc(demo)}</strong> dashboard for testing. The figures shown are illustrative.</div>` : '');
      }

      const tn = (t) => (data.topics.find((x) => x.id === t) || {}).name || t;
      const pub = data.courses.filter((c) => c.status === 'published');

      // Tabs: My Learning | Profile. Any signed-in user can edit their account.
      function renderLearning() { if (viewAs === 'teacher') renderTeacher(); else renderStudent(); }
      let view = (user && location.hash === '#profile') ? 'profile' : 'learning';
      function drawView() {
        const nav = document.getElementById('dash-tabs');
        if (nav) Array.from(nav.children).forEach((b) => { const on = b.dataset.v === view; b.className = 'px-4 py-2 font-sans text-sm border-b-2 ' + (on ? 'border-saffron text-navy font-semibold' : 'border-transparent text-muted'); });
        if (view === 'profile') renderProfile(); else renderLearning();
      }
      if (user) {
        const nav = document.createElement('div');
        nav.id = 'dash-tabs';
        nav.className = 'mb-6 flex gap-1 border-b border-line';
        nav.innerHTML = [['learning', 'My Learning'], ['profile', 'Profile']].map(([k, l]) => `<button data-v="${k}" class="px-4 py-2 font-sans text-sm border-b-2 border-transparent text-muted">${l}</button>`).join('');
        bar.appendChild(nav);
        nav.querySelectorAll('button').forEach((b) => b.addEventListener('click', () => { view = b.dataset.v; location.hash = view === 'profile' ? '#profile' : ''; drawView(); }));
      }
      drawView();
      return;

      function renderProfile() {
        const cur = user || {};
        const curLangs = new Set(((cur.languages || '') + '').split(',').map((s) => s.trim()).filter(Boolean));
        const countryOpts = ['<option value="">— Select country —</option>'].concat(COUNTRIES.map((c) => `<option value="${esc(c)}" ${cur.country === c ? 'selected' : ''}>${esc(c)}</option>`)).join('');
        const langChecks = LANGUAGES.map((l) => `<label class="inline-flex cursor-pointer items-center gap-1.5 rounded-lg border border-line bg-paper px-2.5 py-1 font-sans text-xs has-[:checked]:border-saffron has-[:checked]:bg-saffron-soft/40"><input type="checkbox" value="${esc(l)}" ${curLangs.has(l) ? 'checked' : ''} class="pf-lang" /> ${esc(l)}</label>`).join('');
        root.innerHTML = `
          <h1 class="text-3xl font-bold">Profile</h1>
          <p class="mt-2 font-sans text-sm text-muted">Update your account details. Please don't include sensitive personal information — see our <a class="underline" href="/legal">Terms &amp; Privacy</a>.</p>
          <div id="pf-msg" class="mt-4"></div>
          <div class="mt-6 max-w-xl space-y-5">
            <label class="block"><span class="font-sans text-sm font-semibold">Sign-in email</span>
              <input type="email" value="${esc(cur.email || '')}" disabled class="mt-1 w-full rounded-xl border border-line bg-paper px-4 py-2.5 font-sans text-muted" />
              <span class="font-sans text-xs text-muted">Your magic-link sign-in address — it can't be changed here.</span>
            </label>
            <label class="block"><span class="font-sans text-sm font-semibold">Full name</span>
              <input id="pf-name" type="text" maxlength="80" value="${esc(cur.name || '')}" placeholder="Your full name" class="mt-1 w-full rounded-xl border border-line bg-surface px-4 py-2.5 font-sans focus:border-saffron focus:outline-none" />
              <span class="font-sans text-xs text-muted">Shown on your certificates and to your teachers.</span>
            </label>
            <label class="block"><span class="font-sans text-sm font-semibold">Country</span>
              <select id="pf-country" class="mt-1 w-full rounded-xl border border-line bg-surface px-4 py-2.5 font-sans focus:border-saffron focus:outline-none">${countryOpts}</select>
            </label>
            <div><span class="font-sans text-sm font-semibold">Languages</span>
              <div class="mt-2 flex flex-wrap gap-2">${langChecks}</div>
            </div>
            <button id="pf-save" class="btn btn-primary">Save profile</button>
          </div>
          ${(cur.role === 'teacher' || cur.role === 'admin') ? `
          <div class="mt-10 max-w-xl border-t border-line pt-6">
            <h2 class="text-xl font-bold">Teacher profile</h2>
            <p class="mt-1 font-sans text-sm text-muted">Your public page at sikhiuni.com/teacher/&lt;slug&gt; once an admin approves it.</p>
            <div id="tp-mfa" class="mt-3"></div>
            <div id="tp-body" class="mt-4 space-y-4"><p class="text-muted font-sans text-sm">Loading…</p></div>
          </div>` : ''}
          <div class="mt-10 max-w-xl border-t border-line pt-6">
            <h2 class="text-xl font-bold">Your data</h2>
            <p class="mt-1 font-sans text-sm text-muted">Download everything we hold for your account, or permanently delete it.</p>
            <div class="mt-4 flex flex-wrap gap-3">
              <button id="pf-export" class="btn">${iconSvg('download', 'h-4 w-4')} Export my data (.json)</button>
              <button id="pf-delete" class="btn border border-danger/40 text-danger hover:bg-danger/10">Delete my account…</button>
            </div>
            <div id="pf-del-confirm" class="mt-4 hidden rounded-xl2 border-l-4 border-danger bg-surface p-4">
              <p class="font-sans text-sm">This permanently erases your profile, progress, enrolments, certificates, ratings and posts. <strong>It cannot be undone.</strong> Type <strong>DELETE</strong> to confirm.</p>
              <div class="mt-3 flex flex-wrap items-center gap-2">
                <input id="pf-del-input" type="text" placeholder="DELETE" class="rounded-lg border border-line bg-surface px-3 py-2 font-sans" />
                <button id="pf-del-go" class="btn border border-danger/40 text-danger hover:bg-danger/10">Permanently delete</button>
                <button id="pf-del-cancel" class="btn">Cancel</button>
              </div>
            </div>
          </div>`;
        document.getElementById('pf-export').addEventListener('click', () => { window.location.href = '/api/account/export'; });
        const delConfirm = document.getElementById('pf-del-confirm');
        document.getElementById('pf-delete').addEventListener('click', () => { delConfirm.classList.remove('hidden'); document.getElementById('pf-del-input').focus(); });
        document.getElementById('pf-del-cancel').addEventListener('click', () => { delConfirm.classList.add('hidden'); document.getElementById('pf-del-input').value = ''; });
        document.getElementById('pf-del-go').addEventListener('click', () => {
          const confirm = document.getElementById('pf-del-input').value.trim();
          const btn = document.getElementById('pf-del-go');
          if (confirm !== 'DELETE') { document.getElementById('pf-del-input').focus(); return; }
          btn.disabled = true; btn.textContent = 'Deleting…';
          api('/api/account/delete', { method: 'POST', body: JSON.stringify({ confirm: 'DELETE' }) }).then((res) => {
            if (res && res.ok) { try { Object.keys(localStorage).filter((k) => k.indexOf('su_v1_') === 0).forEach((k) => localStorage.removeItem(k)); } catch (e) {} location.href = '/?deleted=1'; }
            else { btn.disabled = false; btn.textContent = 'Permanently delete'; }
          });
        });
        document.getElementById('pf-save').addEventListener('click', () => {
          const btn = document.getElementById('pf-save'); btn.disabled = true; btn.textContent = 'Saving…';
          const name = document.getElementById('pf-name').value.trim();
          const country = document.getElementById('pf-country').value;
          const languages = Array.from(document.querySelectorAll('.pf-lang:checked')).map((c) => c.value);
          api('/api/me', { method: 'POST', body: JSON.stringify({ name, country, languages }) }).then((res) => {
            btn.disabled = false; btn.textContent = 'Save profile';
            const msg = document.getElementById('pf-msg');
            if (res && res.user) {
              user.name = res.user.name; user.country = res.user.country; user.languages = res.user.languages;
              const p = get('profile', {}); p.name = res.user.name || ''; set('profile', p); // keep cert.astro in sync
              if (msg) msg.innerHTML = '<div class="rounded-xl border-l-4 border-ok bg-surface p-3 font-sans text-sm"><strong>Saved.</strong> Your profile is up to date.</div>';
            } else if (msg) {
              msg.innerHTML = '<div class="rounded-xl border-l-4 border-saffron bg-surface p-3 font-sans text-sm">Could not save your profile. Please try again.</div>';
            }
          });
        });

        if (cur.role === 'teacher' || cur.role === 'admin') loadTeacherProfile();
      }

      function loadTeacherProfile() {
        api('/api/teacher/profile').then((d) => {
          const mfaBox = document.getElementById('tp-mfa');
          if (mfaBox) {
            mfaBox.innerHTML = d.mfaEnrolled
              ? '<span class="pill bg-saffron-soft text-saffron-deep">Two-factor authentication enabled</span>'
              : '<div class="rounded-xl border-l-4 border-saffron bg-surface p-3 font-sans text-sm">Two-factor authentication is required before you can request publish. <a class="underline font-semibold" href="/mfa">Set it up →</a></div>';
          }
          const p = d.profile || {};
          const areas = (d.options && d.options.areas) || [];
          const languages = (d.options && d.options.languages) || [];
          const curAreas = new Set((p.areas || '').split(',').filter(Boolean));
          const curLangs = new Set((p.languages_taught || '').split(',').filter(Boolean));
          let links = []; try { links = p.links ? JSON.parse(p.links) : []; } catch (e) {}
          const body = document.getElementById('tp-body');
          if (!body) return;
          body.innerHTML = `
            ${p.is_public ? `<a class="pill bg-ok/20 text-ok" href="/teacher/${esc(p.slug)}" target="_blank">Live at /teacher/${esc(p.slug)} →</a>` : p.publish_requested_at ? '<span class="pill bg-paper text-muted">Publish requested — awaiting admin approval</span>' : ''}
            <label class="block"><span class="font-sans text-sm font-semibold">Display name</span><input id="tp-name" value="${esc(p.display_name || cur.name || '')}" class="mt-1 w-full rounded-xl border border-line bg-surface px-4 py-2.5 font-sans" /></label>
            <label class="block"><span class="font-sans text-sm font-semibold">Bio</span><textarea id="tp-bio" rows="4" class="mt-1 w-full rounded-xl border border-line bg-surface px-4 py-2.5 font-sans">${esc(p.bio || '')}</textarea></label>
            <label class="block"><span class="font-sans text-sm font-semibold">Credentials</span><textarea id="tp-credentials" rows="2" class="mt-1 w-full rounded-xl border border-line bg-surface px-4 py-2.5 font-sans">${esc(p.credentials || '')}</textarea></label>
            <div><span class="font-sans text-sm font-semibold">Teaching areas</span><div class="mt-2 flex flex-wrap gap-2">${areas.map((a) => `<label class="inline-flex cursor-pointer items-center gap-1.5 rounded-lg border border-line bg-paper px-2.5 py-1 font-sans text-xs has-[:checked]:border-saffron has-[:checked]:bg-saffron-soft/40"><input type="checkbox" value="${esc(a)}" ${curAreas.has(a) ? 'checked' : ''} class="tp-area" /> ${esc(a)}</label>`).join('')}</div></div>
            <div><span class="font-sans text-sm font-semibold">Languages you teach in</span><div class="mt-2 flex flex-wrap gap-2">${languages.map((l) => `<label class="inline-flex cursor-pointer items-center gap-1.5 rounded-lg border border-line bg-paper px-2.5 py-1 font-sans text-xs has-[:checked]:border-saffron has-[:checked]:bg-saffron-soft/40"><input type="checkbox" value="${esc(l)}" ${curLangs.has(l) ? 'checked' : ''} class="tp-lang" /> ${esc(l)}</label>`).join('')}</div></div>
            <label class="block"><span class="font-sans text-sm font-semibold">Photo</span><input id="tp-photo" type="file" accept="image/jpeg,image/png,image/webp" class="mt-1 block font-sans text-sm" /><span class="font-sans text-xs text-muted">Uploads for admin review before it appears publicly.</span></label>
            <div id="tp-msg"></div>
            <div class="flex flex-wrap gap-2">
              <button id="tp-save" class="btn btn-primary">Save</button>
              <button id="tp-publish" class="btn">${p.is_public ? 'Update' : 'Request publish'}</button>
            </div>`;

          const collect = () => ({
            displayName: document.getElementById('tp-name').value,
            bio: document.getElementById('tp-bio').value,
            credentials: document.getElementById('tp-credentials').value,
            areas: Array.from(document.querySelectorAll('.tp-area:checked')).map((c) => c.value),
            languagesTaught: Array.from(document.querySelectorAll('.tp-lang:checked')).map((c) => c.value),
            links,
          });
          document.getElementById('tp-save').addEventListener('click', () => {
            api('/api/teacher/profile', { method: 'POST', body: JSON.stringify(collect()) }).then((r) => {
              document.getElementById('tp-msg').innerHTML = r && r.profile ? '<div class="rounded-xl border-l-4 border-ok bg-surface p-3 font-sans text-sm mt-2">Saved.</div>' : '<div class="rounded-xl border-l-4 border-saffron bg-surface p-3 font-sans text-sm mt-2">Could not save.</div>';
            });
          });
          document.getElementById('tp-publish').addEventListener('click', () => {
            api('/api/teacher/profile', { method: 'POST', body: JSON.stringify({ ...collect(), requestPublish: true }) }).then((r) => {
              const msg = document.getElementById('tp-msg');
              if (r && r.error === 'mfa_enrollment_required_to_publish') msg.innerHTML = '<div class="rounded-xl border-l-4 border-saffron bg-surface p-3 font-sans text-sm mt-2">Set up two-factor authentication before requesting publish. <a class="underline" href="/mfa">Set it up →</a></div>';
              else if (r && r.profile) { msg.innerHTML = '<div class="rounded-xl border-l-4 border-ok bg-surface p-3 font-sans text-sm mt-2">Publish requested — an admin will review it.</div>'; loadTeacherProfile(); }
              else msg.innerHTML = '<div class="rounded-xl border-l-4 border-saffron bg-surface p-3 font-sans text-sm mt-2">Could not submit.</div>';
            });
          });
          const photoInput = document.getElementById('tp-photo');
          photoInput.addEventListener('change', () => {
            const file = photoInput.files[0]; if (!file) return;
            fetch('/api/upload', { method: 'POST', credentials: 'same-origin', headers: { 'x-upload-kind': 'photo', 'x-upload-context': 'profile', 'content-type': file.type }, body: file })
              .then((r) => r.json().then((dd) => ({ ok: r.ok, d: dd })))
              .then((r) => { document.getElementById('tp-msg').innerHTML = r.ok ? '<div class="rounded-xl border-l-4 border-ok bg-surface p-3 font-sans text-sm mt-2">Photo uploaded — awaiting admin approval.</div>' : `<div class="rounded-xl border-l-4 border-saffron bg-surface p-3 font-sans text-sm mt-2">${esc((r.d && r.d.error) || 'Upload failed.')}</div>`; });
          });
        });
      }

      function renderStudent() {
        const completed = [], started = [], fresh = [];
        pub.forEach((c) => { if (passed(c.id)) completed.push(c); else if (progress(c) > 0 || enrolledCourses.has(c.id)) started.push(c); else fresh.push(c); });
        let lessonsDone = 0; pub.forEach((c) => { const d = get('done_' + c.id, {}); for (const k in d) if (d[k]) lessonsDone++; });
        const name = (user && user.name) || (get('profile', {}) || {}).name || '';
        const points = lessonsDone * 10 + completed.length * 100;
        const st = streak();
        let topicMaster = false;
        data.topics.forEach((t) => { const inT = pub.filter((c) => c.topic === t.id); if (inT.length && inT.every((c) => passed(c.id))) topicMaster = true; });
        // Academic standing badges — based on completing all courses at each level tier
        const lvl = (min, max) => pub.filter((c) => c.level >= min && c.level < max);
        const lvl1 = lvl(100, 200), lvl2 = lvl(200, 300), lvl3 = lvl(300, 400), lvl4 = lvl(400, 500), lvl5 = lvl(500, 600);
        const allPassed = (cs) => cs.length > 0 && cs.every((c) => passed(c.id));
        const levelProg = (cs) => `${cs.filter((c) => passed(c.id)).length}/${cs.length}`;
        const badges = [
          ['First Step', 'sprout', lessonsDone >= 1, 'Complete your first lesson'],
          ['Freshman', 'backpack', allPassed(lvl1), 'Pass all 100-level courses'],
          ['Sophomore', 'book', allPassed(lvl2), 'Pass all 200-level courses'],
          ['Junior', 'microscope', allPassed(lvl3), 'Pass all 300-level courses'],
          ['Senior', 'medal', allPassed(lvl4), 'Pass all 400-level courses'],
          ['Graduate', 'pillar', allPassed(lvl5), 'Pass all 500-level courses'],
          ['Dedicated', 'books', completed.length >= 25, 'Pass 25 courses'],
          ['Scholar', 'medal', completed.length >= 100, 'Pass 100 courses'],
          ['Vidhvaan', 'crown', completed.length >= 250, 'Pass 250 courses'],
          ['Steady', 'fire', st >= 7, '7-day streak'],
          ['Topic Master', 'star-filled', topicMaster, 'Finish an entire topic'],
        ];
        const stat = (n, l, opts) => {
          const o = opts || {};
          if (o.ring != null) {
            const pct = Math.max(0, Math.min(100, o.ring));
            return `<div class="rounded-[3px] border border-line bg-surface p-4 text-center"><div class="relative mx-auto grid h-20 w-20 place-items-center"><svg viewBox="0 0 80 80" class="h-20 w-20 -rotate-90" aria-hidden="true"><circle class="ring-track" cx="40" cy="40" r="34" fill="none" stroke-width="8"></circle><circle class="ring-value" cx="40" cy="40" r="34" fill="none" stroke-width="8" data-ring-pct="${pct}"></circle></svg><span class="absolute font-mono text-xl font-bold text-navy">${pct}<span class="text-sm">%</span></span></div><div class="mt-2 font-mono text-xs uppercase tracking-[.1em] text-muted">${l}</div></div>`;
          }
          return `<div class="rounded-[3px] border border-line bg-surface p-4 text-center"><div class="flex items-center justify-center gap-2 font-mono text-3xl font-bold text-navy">${o.icon ? '<span class="text-saffron-deep">' + iconSvg(o.icon, 'h-7 w-7') + '</span>' : ''}<span>${n}</span></div><div class="mt-1 font-mono text-xs uppercase tracking-[.1em] text-muted">${l}</div></div>`;
        };
        function section(title, list, mode) {
          if (!list.length) return '';
          if (mode === 'started') {
            // "Continue where you stopped" resume band (isdashboard, prototype
            // lines 399-406) mapped onto the real in-progress courses this
            // page already computes — no new "which lesson is next" logic
            // invented, just the existing `started`/`progress()` data
            // re-templated as flat navy resume cards.
            return `<div class="mt-10"><p class="eyebrow text-saffron-deep">${esc(title)}</p><div class="mt-4 flex flex-col gap-4 sm:flex-row sm:overflow-x-auto sm:snap-x sm:pb-2">${list.map((c) => {
              const p = progress(c);
              return `<a href="/course/${c.id}" class="band-navy relative block rounded-[3px] p-5 transition hover:-translate-y-1 sm:w-72 sm:shrink-0 sm:snap-start"><div class="flex flex-wrap gap-2 font-mono text-[10px] uppercase tracking-[.12em] text-white/70"><span>${esc(tn(c.topic))}</span><span>· ${c.level} level</span></div><h3 class="mt-2 text-lg font-bold text-white">${esc(c.title)}</h3><div class="mt-4 flex items-center gap-2"><span class="h-[3px] flex-1 bg-white/25"><span class="block h-[3px] bg-saffron" style="width:${p}%"></span></span><span class="font-mono text-[11px] text-white/70">${p}%</span></div></a>`;
            }).join('')}</div></div>`;
          }
          return `<h3 class="mt-10 text-xl font-bold">${title}</h3><div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 xl:grid-cols-4">${list.map((c) => {
            const p = progress(c);
            const extra = mode === 'completed' ? `<a class="btn btn-primary mt-3" href="/cert?course=${c.id}">View certificate →</a>`
              : mode === 'started' ? `<div class="mt-3 h-2 w-full overflow-hidden rounded-full bg-paper"><div class="h-full bg-saffron" style="width:${p}%"></div></div><div class="font-sans text-xs text-muted mt-1">${p}% complete</div>` : '';
            return `<a href="/course/${c.id}" class="card"><div class="flex flex-wrap gap-2 font-sans text-xs text-muted"><span class="pill bg-paper text-navy">${esc(tn(c.topic))}</span><span class="pill bg-paper text-muted">${c.level} level</span></div><h3 class="mt-1 text-lg font-bold text-navy">${esc(c.title)}</h3>${extra}</a>`;
          }).join('')}</div>`;
        }
        const graded = pub.filter((c) => passed(c.id) || progress(c) > 0 || get('score_' + c.id, null) != null);
        // "Enrolled" ledger (isdashboard, prototype lines 410-415): the same
        // graded-courses data the old "My grades" <table> showed (title,
        // progress %, test score, status) — re-templated as ruled rows per
        // task 15 spec, nothing added or dropped.
        const gradesHtml = graded.length ? `<div class="mt-10"><p class="eyebrow text-saffron-deep">Enrolled</p><div class="rule-navy mt-1">${graded.map((c) => { const sc = get('score_' + c.id, null); const p = progress(c); const ok = passed(c.id); const statusLabel = ok ? 'Passed' : (p > 0 || sc != null ? 'In progress' : '—'); const statusCls = ok ? 'text-ok border-ok' : 'text-muted border-line'; return `<a href="/course/${c.id}" class="row-ruled hover:bg-surface"><span class="min-w-0 flex-1 truncate font-semibold text-navy">${esc(c.title)}</span><span class="flex w-36 flex-none items-center gap-2"><span class="h-[3px] flex-1 bg-line"><span class="block h-[3px] bg-saffron" style="width:${p}%"></span></span><span class="w-9 shrink-0 text-right font-mono text-[11px] text-muted">${p}%</span></span><span class="w-12 shrink-0 text-right font-mono text-[11px] text-muted">${sc != null ? sc + '%' : '—'}</span><span class="chip-status flex-none ${statusCls}">${statusLabel}</span></a>`; }).join('')}</div></div>` : '';
        let applyCta = '';
        if (user && user.role === 'learner' && get('signup_intent', '') === 'teacher') applyCta = `<div class="mt-4 rounded-xl2 border-l-4 border-saffron bg-saffron-soft/40 p-4 font-sans text-sm">You signed up to teach. <a class="underline font-semibold" href="/teach">Complete your teacher application →</a></div>`;
        root.innerHTML = `
          <p class="eyebrow text-saffron-deep">Sat Sri Akal</p>
          <h1 class="text-display-sm mt-3 text-navy">${name ? 'Welcome back, ' + esc(name) : 'My Learning'}</h1>
          ${applyCta}
          <div id="ann-feed"></div>
          ${user ? `<p class="mt-3 font-sans text-sm text-muted">Set your name, country and languages in the <a class="underline" href="#profile" id="go-profile">Profile</a> tab — your name appears on certificates.</p>` : ''}
          <div class="mt-6 grid grid-cols-2 gap-3 lg:grid-cols-4">${stat(points, 'Points')}${stat(st, 'Day streak', { icon: 'fire' })}${stat(completed.length, 'Courses complete', { ring: pub.length ? Math.round(completed.length / pub.length * 100) : 0 })}${stat(lessonsDone, 'Lessons done', { ring: (() => { const tot = pub.reduce((a, c) => a + (c.nLessons || 0), 0); return tot ? Math.round(lessonsDone / tot * 100) : 0; })() })}</div>
          <a href="/baal-updesh#flashcards" class="mt-6 flex items-center gap-4 rounded-xl2 border border-line bg-surface p-4 shadow-card transition hover:border-saffron"><span class="text-saffron-deep">${iconSvg('cards', 'h-8 w-8')}</span><span><span class="block font-bold text-navy">Review flashcards</span><span class="block font-sans text-sm text-muted">Lock in Gurmukhi terms and the most-used words of Gurbani with spaced repetition.</span></span><span class="ml-auto font-sans text-sm text-saffron-deep">Study →</span></a>
          <div id="remind-card" hidden class="rounded-[3px] border border-line bg-surface mt-3 flex flex-wrap items-center gap-4 p-4"><span class="text-saffron-deep">${iconSvg('clock', 'h-8 w-8')}</span><span class="min-w-0 flex-1"><span class="block font-bold text-navy">Remind me to keep learning</span><span id="remind-body" class="block font-sans text-sm text-muted">One gentle notification a day — a few minutes of seva to yourself.</span></span><button id="remind-btn" class="btn shrink-0">Enable</button></div>
          <h3 class="mt-10 text-xl font-bold">Milestone seals</h3>
          <div class="mt-4 grid grid-cols-2 gap-3 lg:grid-cols-4">${badges.map((b) => {
            let prog = '';
            if (b[0] === 'Freshman') prog = `<div class="mt-1 font-sans text-xs text-muted/70">${levelProg(lvl1)} courses</div>`;
            else if (b[0] === 'Sophomore') prog = `<div class="mt-1 font-sans text-xs text-muted/70">${levelProg(lvl2)} courses</div>`;
            else if (b[0] === 'Junior') prog = `<div class="mt-1 font-sans text-xs text-muted/70">${levelProg(lvl3)} courses</div>`;
            else if (b[0] === 'Senior') prog = `<div class="mt-1 font-sans text-xs text-muted/70">${levelProg(lvl4)} courses</div>`;
            else if (b[0] === 'Graduate') prog = lvl5.length ? `<div class="mt-1 font-sans text-xs text-muted/70">${levelProg(lvl5)} courses</div>` : `<div class="mt-1 font-sans text-xs text-muted/70">Coming soon</div>`;
            else if (b[0] === 'Dedicated') prog = `<div class="mt-1 font-sans text-xs text-muted/70">${Math.min(completed.length,25)}/25</div>`;
            else if (b[0] === 'Scholar') prog = `<div class="mt-1 font-sans text-xs text-muted/70">${Math.min(completed.length,100)}/100</div>`;
            else if (b[0] === 'Vidhvaan') prog = `<div class="mt-1 font-sans text-xs text-muted/70">${Math.min(completed.length,250)}/250</div>`;
            else if (b[0] === 'Steady') prog = `<div class="mt-1 font-sans text-xs text-muted/70">${Math.min(st,7)}/7 days</div>`;
            return `<div class="rounded-[3px] border border-line bg-surface p-4 text-center ${b[2] ? '' : 'opacity-50'}"><div class="mx-auto grid h-14 w-14 place-items-center rounded-full border-2 ${b[2] ? 'border-saffron text-saffron-deep' : 'border-line text-muted'}">${iconSvg(b[1], 'h-7 w-7')}</div><div class="mt-2 font-sans text-sm font-bold text-navy">${b[0]}</div><div class="font-sans text-xs text-muted">${b[3]}</div>${b[2] ? '<div class="mt-1 flex items-center justify-center gap-1 font-sans text-xs text-saffron-deep font-semibold">' + iconSvg('check', 'h-3.5 w-3.5') + ' Earned</div>' : prog}</div>`;
          }).join('')}</div>
          ${gradesHtml}
          <div id="assign-summary-section"></div>
          <div id="prog-summary-section"></div>
          <div class="mt-6"><button id="exp" class="btn">${iconSvg('download', 'h-4 w-4')} Export my notes (.md)</button></div>
          ${!completed.length && !started.length ? `<div class="rounded-[3px] border border-line bg-surface mt-8 p-6 text-center"><div class="mx-auto flex h-12 w-12 items-center justify-center text-saffron-deep">${iconSvg('sprout', 'h-8 w-8')}</div><p class="mt-3 font-serif text-lg text-navy">Your journey begins here.</p><p class="mt-1 font-sans text-sm text-muted">Start a course and your progress, streak and certificates will appear on this page.</p><div class="mt-4 flex flex-wrap justify-center gap-3"><a class="btn btn-primary" href="/catalog">Browse the catalogue</a>${!user ? '<a class="btn" href="/login">Sign in to save progress</a>' : ''}</div></div>` : ''}
          ${section('Continue where you stopped', started, 'started')}
          ${section('Completed — certificates earned', completed, 'completed')}
          ${section('Start something new', fresh.slice(0, 6), 'fresh')}`;
        initRings(root); // rings render after this async-fetched content is injected
        // Coursework reminder opt-in (Web Push). Card stays hidden unless the
        // server has VAPID configured AND this browser can subscribe; iOS in
        // Safari-the-browser gets install guidance instead of a dead button.
        (async () => {
          const card = document.getElementById('remind-card'); if (!card) return;
          const sup = pushSupport();
          if (sup === 'unsupported') return;
          const key = await pushServerKey(); if (!key) return;
          const body = document.getElementById('remind-body');
          const btn = document.getElementById('remind-btn');
          if (sup === 'needs-install') {
            body.textContent = 'On iPhone or iPad, first add Sikhi University to your Home Screen (Share → Add to Home Screen), then enable reminders from the installed app.';
            btn.remove();
            card.hidden = false;
            return;
          }
          let on = await pushIsSubscribed();
          const draw = () => {
            btn.textContent = on ? 'Turn off' : 'Enable';
            body.textContent = on
              ? 'Reminders are on — one notification a day, around 4pm UTC. Turn off any time.'
              : 'One gentle notification a day — a few minutes of seva to yourself.';
          };
          draw();
          card.hidden = false;
          btn.addEventListener('click', async () => {
            btn.disabled = true;
            if (on) { await pushDisable(); on = false; draw(); }
            else {
              const r = await pushEnable();
              if (r === 'on') { on = true; draw(); }
              else if (r === 'denied') body.textContent = 'Notifications are blocked for this site — allow them in your browser settings, then try again.';
              else body.textContent = 'Could not enable reminders right now — please try again later.';
            }
            btn.disabled = false;
          });
        })();
        // Announcements from teachers of the courses this student is taking.
        const enrolled = new Set(pub.filter((c) => passed(c.id) || progress(c) > 0).map((c) => c.id));
        if (enrolled.size) api('/api/announcements').then((d) => {
          const list = ((d && d.announcements) || []).filter((a) => enrolled.has(a.course_id)).slice(0, 5);
          const fe = document.getElementById('ann-feed'); if (!fe || !list.length) return;
          fe.innerHTML = `<h3 class="mt-8 text-xl font-bold">Announcements</h3><div class="mt-4 space-y-3">${list.map((a) => { const c = pub.find((x) => x.id === a.course_id); return `<div class="rounded-xl2 border-l-4 border-saffron bg-surface p-4"><div class="font-sans text-xs text-muted">${esc(c ? c.title : a.course_id)} · ${esc(a.author_name || '')} · ${fmtRel(a.created_at)}</div>${a.title ? `<div class="mt-1 font-bold text-navy">${esc(a.title)}</div>` : ''}<p class="mt-1 text-sm">${esc(a.body)}</p></div>`; }).join('')}</div>`;
        });
        // My assignments — across every explicitly-enrolled course, due-soon first.
        if (enrolledCourses.size) {
          Promise.all([...enrolledCourses].map((cid) => api('/api/assignments?courseId=' + encodeURIComponent(cid)))).then((results) => {
            const items = [];
            results.forEach((d, i) => {
              const cid = [...enrolledCourses][i];
              ((d && d.assignments) || []).forEach((a) => items.push({ ...a, course_id: cid }));
            });
            const el = document.getElementById('assign-summary-section'); if (!el || !items.length) return;
            items.sort((a, b) => (a.due_at || Infinity) - (b.due_at || Infinity));
            el.innerHTML = `<h3 class="mt-10 text-xl font-bold">My assignments</h3><div class="mt-4 grid gap-3 sm:grid-cols-2">${items.map((a) => {
              const c = pub.find((x) => x.id === a.course_id);
              const statusPill = a.my_status === 'graded' ? `<span class="pill bg-saffron-soft text-saffron-deep">Graded: ${esc(a.my_grade)}/${a.points}</span>`
                : a.my_status === 'submitted' ? '<span class="pill bg-paper text-muted">Submitted</span>'
                : '<span class="pill bg-paper text-muted">Not submitted</span>';
              return `<a href="/course/${esc(a.course_id)}#assignments" class="card"><div class="font-sans text-xs text-muted">${esc(c ? c.title : a.course_id)}${a.due_at ? ' · due ' + esc(new Date(a.due_at).toLocaleDateString()) : ''}</div><div class="mt-1 font-bold text-navy">${esc(a.title)}</div><div class="mt-2">${statusPill}</div>${a.my_feedback ? `<p class="mt-2 text-sm text-muted">"${esc(a.my_feedback)}"</p>` : ''}</a>`;
            }).join('')}</div>`;
          });
        }
        // Program progress summary
        fetch('/assets/data/programs.json').then(r => r.json()).then(pd => {
          const el = document.getElementById('prog-summary-section'); if (!el) return;
          const active = pd.programs.filter(p => {
            const done = p.courseIds.filter(id => passed(id)).length;
            return done > 0 || registeredPrograms.has(p.id);
          });
          if (!active.length) return;
          el.innerHTML = `<h3 class="mt-10 text-xl font-bold">My Degree Programs</h3>
          <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          ${active.map(p => {
            const done = p.courseIds.filter(id => passed(id)).length;
            const total = p.courseIds.length;
            const pct = Math.round((done/total)*100);
            const cumDone = get('cum_passed_' + p.id, false);
            const reg = registeredPrograms.has(p.id);
            return `<a href="/program/${p.id}" class="card hover:border-saffron transition">
              <div class="flex items-center gap-2"><span class="text-saffron-deep">${iconSvg(p.icon, 'h-6 w-6')}</span><div><div class="font-sans text-xs text-muted font-bold">${esc(p.abbreviation)}${reg ? ' · <span class="text-saffron-deep">Registered</span>' : ''}</div><div class="font-semibold text-navy text-sm leading-tight">${esc(p.title)}</div></div></div>
              <div class="mt-3 h-2 w-full overflow-hidden rounded-full bg-paper border border-line"><div class="h-full bg-saffron" style="width:${pct}%"></div></div>
              <div class="mt-1 font-sans text-xs text-muted">${done}/${total} courses ${cumDone ? '· <span class="inline-flex items-center gap-1 align-[-0.15em] text-saffron-deep font-semibold">' + iconSvg('check', 'h-3.5 w-3.5') + ' Credential earned</span>' : ''}</div>
            </a>`;
          }).join('')}</div>
          <a href="/programs" class="mt-3 inline-block font-sans text-sm text-saffron-deep underline">Browse all degree programs →</a>`;
        }).catch(() => {});
        const goP = document.getElementById('go-profile');
        if (goP) goP.addEventListener('click', (e) => { e.preventDefault(); view = 'profile'; location.hash = '#profile'; drawView(); });
        document.getElementById('exp').addEventListener('click', () => {
          const lines = ['# My Sikhi University notes', ''];
          data.courses.forEach((c) => (c.lessons || []).forEach((ls, i) => { const n = get('note_' + c.id + '_' + i, ''); if (n && n.trim()) lines.push('## ' + c.title + ' — ' + ls.title, '', n.trim(), ''); }));
          if (lines.length <= 2) lines.push('_No notes yet._');
          const a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([lines.join('\n')], { type: 'text/markdown' })); a.download = 'sikhi-university-notes.md'; a.click();
        });
      }

      function renderTeacher() {
        const stat = (n, l) => `<div class="rounded-xl2 border border-line border-t-4 border-t-saffron bg-surface p-4 text-center shadow-card"><div class="text-3xl font-bold text-navy">${n}</div><div class="font-sans text-xs text-muted">${l}</div></div>`;
        const lessonCount = (id) => { const c = pub.find((x) => x.id === id); return (c && c.lessons) ? c.lessons.length : 0; };
        const slugTitle = (id) => String(id || '').replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
        const ctitle = (id) => { const c = pub.find((x) => x.id === id); return c ? c.title : slugTitle(id); };

        if (demo) { renderTeacherDemo(stat); return; }

        root.innerHTML = '<h1 class="text-3xl font-bold">Teacher dashboard</h1><p class="mt-6 text-muted">Loading your gradebook…</p>';
        api('/api/gradebook').then((g) => {
          const tcourses = g.courses || [];
          const rows = g.rows || [];
          if (!tcourses.length) {
            root.innerHTML = `<h1 class="text-3xl font-bold">Teacher dashboard</h1>
              <a href="/studio" class="mt-6 flex items-center gap-4 rounded-xl2 border border-line bg-surface p-4 shadow-card transition hover:border-saffron"><span class="min-w-0 flex-1"><span class="block font-bold text-navy">Course Studio</span><span class="block font-sans text-sm text-muted">Draft a new course and submit it for scholar review.</span></span><span class="font-sans text-sm text-saffron-deep">Open →</span></a>
              <div class="mt-6 rounded-xl2 border border-line bg-surface p-6 text-muted">You are not assigned to any courses yet. An admin assigns teachers to courses.</div>
              <div class="mt-6"><a class="btn" href="/dashboard?demo=teacher">Preview a sample teacher dashboard →</a></div>`;
            return;
          }
          const students = new Set(rows.map((r) => r.user_id));
          const completions = rows.filter((r) => r.score != null && r.score >= 80).length;
          const scored = rows.filter((r) => r.score != null);
          const avg = scored.length ? Math.round(scored.reduce((a, r) => a + r.score, 0) / scored.length) : 0;

          root.innerHTML = `<h1 class="text-3xl font-bold">Teacher dashboard</h1>
            <p class="mt-1 font-sans text-sm text-muted">Real grades and progress for your students.</p>
            <a href="/studio" class="mt-6 flex items-center gap-4 rounded-xl2 border border-line bg-surface p-4 shadow-card transition hover:border-saffron"><span class="min-w-0 flex-1"><span class="block font-bold text-navy">Course Studio</span><span class="block font-sans text-sm text-muted">Draft a new course and submit it for scholar review.</span></span><span class="font-sans text-sm text-saffron-deep">Open →</span></a>
            <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">${stat(tcourses.length, 'Courses you teach')}${stat(students.size, 'Students')}${stat(completions, 'Completions')}${stat(avg ? avg + '%' : '—', 'Avg. score')}</div>
            <div class="mt-6 flex flex-wrap gap-2 items-end">
              <input id="t-search" type="search" placeholder="Search students…" class="rounded-lg border border-line bg-paper px-3 py-1.5 font-sans text-sm w-48" />
              <select id="t-status" class="rounded-lg border border-line bg-paper px-2 py-1.5 font-sans text-sm">
                <option value="">All statuses</option><option value="passed">Passed</option><option value="inprogress">In progress</option><option value="notstarted">Not started</option>
              </select>
              <select id="t-sort" class="rounded-lg border border-line bg-paper px-2 py-1.5 font-sans text-sm">
                <option value="score">Sort: Score ↓</option><option value="progress">Sort: Progress ↓</option><option value="name">Sort: Name A→Z</option><option value="active">Sort: Recently active</option>
              </select>
              <button id="t-exp-all" class="btn font-sans text-xs px-3 py-1.5">Expand all</button>
              <button id="t-col-all" class="btn font-sans text-xs px-3 py-1.5">Collapse all</button>
            </div>
            <div id="t-body" class="mt-2"></div>
            <div class="mt-10"><a class="btn" href="/dashboard?demo=student">View the student experience →</a></div>`;

          function renderCourses() {
            const q = (document.getElementById('t-search').value || '').toLowerCase();
            const statusF = document.getElementById('t-status').value;
            const sortF = document.getElementById('t-sort').value;
            const tbody = document.getElementById('t-body');
            if (!tbody) return;

            tbody.innerHTML = tcourses.map((cid) => {
              let cr = rows.filter((r) => r.course_id === cid);
              if (q) cr = cr.filter((r) => (r.name || r.email || '').toLowerCase().includes(q));
              if (statusF === 'passed') cr = cr.filter((r) => r.score != null && r.score >= 80);
              else if (statusF === 'inprogress') cr = cr.filter((r) => r.done > 0 && !(r.score != null && r.score >= 80));
              else if (statusF === 'notstarted') cr = cr.filter((r) => r.done === 0);
              const lc = lessonCount(cid);
              if (sortF === 'score') cr.sort((a, b) => (b.score == null ? -1 : b.score) - (a.score == null ? -1 : a.score));
              else if (sortF === 'progress') cr.sort((a, b) => b.done - a.done);
              else if (sortF === 'name') cr.sort((a, b) => (a.name || a.email || '').localeCompare(b.name || b.email || ''));
              else if (sortF === 'active') cr.sort((a, b) => (b.last_active || 0) - (a.last_active || 0));
              const cs = cr.filter((r) => r.score != null);
              const cavg = cs.length ? Math.round(cs.reduce((a, r) => a + r.score, 0) / cs.length) : 0;
              const passRate = cr.length ? Math.round(cr.filter((r) => r.score != null && r.score >= 80).length / cr.length * 100) : 0;
              const rows_html = cr.map((r, i) => {
                const pct = lc ? Math.round(r.done / lc * 100) : 0;
                const st = (r.score != null && r.score >= 80) ? '<span class="pill bg-saffron-soft text-saffron-deep">Passed</span>' : (r.done > 0 ? '<span class="pill bg-paper text-muted">In progress</span>' : '—');
                return `<tr class="${i % 2 ? 'bg-paper' : ''}" data-u="${esc(r.user_id)}" data-c="${esc(cid)}"><td class="px-3 py-2 font-semibold text-navy">${esc(r.name || r.email)}${r.override ? ' <span title="Grade overridden" class="inline-flex align-[-0.15em] text-saffron-deep">' + iconSvg('edit', 'h-3.5 w-3.5') + '</span>' : ''}</td><td>${pct}%</td><td>${r.score != null ? r.score + '%' : '—'}</td><td>${r.score != null ? grade(r.score) : '—'}</td><td>${st}</td><td class="whitespace-nowrap text-muted">${fmtRel(r.last_active)}</td><td><button class="rounded-lg border border-line px-2 py-1 hover:border-saffron font-sans text-xs" data-ovr>Override</button></td></tr>`;
              }).join('');
              return `<details class="mt-4 rounded-xl2 border border-line bg-surface" open>
                <summary class="cursor-pointer select-none px-4 py-3 flex flex-wrap items-baseline gap-2">
                  <span class="font-bold text-navy">${esc(ctitle(cid))}</span>
                  <span class="font-sans text-xs text-muted">${cr.length} enrolled · avg ${cavg}% · ${passRate}% passed</span>
                  <span class="ml-auto flex gap-2 font-sans text-xs"><button class="underline" data-ann="${esc(cid)}">Announce</button> <button class="underline" data-csv="${esc(cid)}">Export CSV</button> <a class="underline" href="/cohorts?course=${esc(cid)}">Create cohort</a> <button class="underline text-danger" data-request-archive="${esc(cid)}">Request archive</button></span>
                </summary>
                ${!cr.length ? '<div class="px-4 pb-4 text-muted font-sans text-sm">No students match the current filter.</div>' : `<div class="overflow-x-auto"><table class="w-full font-sans text-sm"><thead><tr class="bg-brand text-left text-white"><th class="px-3 py-2">Student</th><th>Progress</th><th>Score</th><th>Grade</th><th>Status</th><th>Last active</th><th></th></tr></thead><tbody>${rows_html}</tbody></table></div>`}
                <div class="border-t border-line px-4 py-3">
                  <div class="flex items-center gap-2"><span class="font-sans text-xs font-bold uppercase tracking-wide text-muted">Assignments</span><button class="ml-auto btn font-sans text-xs px-3 py-1.5" data-new-assign="${esc(cid)}">+ New assignment</button></div>
                  <div id="assign-${esc(cid)}" class="mt-2 font-sans text-sm text-muted">Loading…</div>
                </div>
              </details>`;
            }).join('');

            root.querySelectorAll('[data-csv]').forEach((b) => b.addEventListener('click', (e) => { e.preventDefault(); window.location = '/api/gradebook?format=csv&course=' + encodeURIComponent(b.dataset.csv); }));
            root.querySelectorAll('[data-request-archive]').forEach((b) => b.addEventListener('click', async () => {
              const cid = b.dataset.requestArchive;
              const v = await window.suModalForm({ title: 'Request to archive this course', submitLabel: 'Submit request', fields: [{ name: 'reason', label: 'Why should this course be retired? (an admin reviews every request before it takes effect)', type: 'textarea', optional: true }] });
              if (!v) return;
              const d = await api('/api/teacher/archive-request', { method: 'POST', body: JSON.stringify({ courseId: cid, reason: v.reason }) });
              window.suToast(d && !d.error ? 'Archive request submitted — an admin will review it.' : (d && d.error) || 'Could not submit request.', d && !d.error ? 'ok' : 'error');
            }));
            root.querySelectorAll('[data-ann]').forEach((b) => b.addEventListener('click', async (e) => {
              e.preventDefault();
              const cid = b.dataset.ann;
              const v = await window.suModalForm({ title: 'Post an announcement', submitLabel: 'Post', fields: [{ name: 'title', label: 'Title', optional: true }, { name: 'body', label: 'Message to your students', type: 'textarea' }] });
              if (!v || !v.body.trim()) return;
              const d = await api('/api/announcements', { method: 'POST', body: JSON.stringify({ courseId: cid, title: v.title, body: v.body }) });
              window.suToast(d && !d.error ? 'Announcement posted.' : 'Could not post.', d && !d.error ? 'ok' : 'error');
            }));
            root.querySelectorAll('[data-ovr]').forEach((b) => b.addEventListener('click', async () => {
              const tr = b.closest('[data-u]');
              const v = await window.suModalForm({ title: 'Override final score', submitLabel: 'Save', fields: [{ name: 'score', label: 'Final score 0–100 (blank clears it)', type: 'number', optional: true }, { name: 'reason', label: 'Reason', optional: true }] });
              if (!v) return;
              const blank = v.score.trim() === '';
              const d = await api('/api/gradebook', { method: 'POST', body: JSON.stringify({ courseId: tr.dataset.c, userId: tr.dataset.u, score: blank ? null : Number(v.score), reason: v.reason || '' }) });
              if (d && !d.error) renderCourses(); else window.suToast('Could not save.', 'error');
            }));

            tcourses.forEach(loadAssignments);
          }

          function loadAssignments(cid) {
            const box = document.getElementById('assign-' + cid);
            if (!box) return;
            api('/api/assignments?courseId=' + encodeURIComponent(cid)).then((d) => {
              const list = (d && d.assignments) || [];
              box.innerHTML = list.length ? list.map((a) => `
                <div class="mt-2 flex flex-wrap items-center gap-2 rounded-lg border border-line bg-paper px-3 py-2" data-a="${esc(a.id)}">
                  <span class="font-semibold text-navy">${esc(a.title)}</span>
                  <span class="pill bg-surface text-muted">${a.status}</span>
                  ${a.due_at ? `<span class="text-xs text-muted">due ${esc(new Date(a.due_at).toLocaleDateString())}</span>` : ''}
                  <span class="text-xs text-muted">${a.graded_count}/${a.submitted_count} graded</span>
                  <span class="ml-auto flex gap-2 text-xs">
                    <button class="underline" data-view-assign="${esc(a.id)}">View &amp; grade</button>
                    <button class="underline" data-toggle-assign="${esc(a.id)}" data-status="${a.status}">${a.status === 'closed' ? 'Reopen' : 'Close'}</button>
                  </span>
                </div>
                <div id="roster-${esc(a.id)}" class="hidden mt-2"></div>
              `).join('') : '<p class="mt-2">No assignments yet for this course.</p>';

              box.querySelectorAll('[data-toggle-assign]').forEach((b) => b.addEventListener('click', () => {
                api('/api/assignments', { method: 'POST', body: JSON.stringify({ id: b.dataset.toggleAssign, action: b.dataset.status === 'closed' ? 'reopen' : 'close' }) })
                  .then((r) => { if (r && !r.error) loadAssignments(cid); });
              }));
              box.querySelectorAll('[data-view-assign]').forEach((b) => b.addEventListener('click', () => loadRoster(b.dataset.viewAssign)));
            });
          }

          function loadRoster(assignmentId) {
            const el = document.getElementById('roster-' + assignmentId);
            if (!el) return;
            if (!el.classList.contains('hidden')) { el.classList.add('hidden'); return; }
            el.classList.remove('hidden');
            el.innerHTML = 'Loading roster…';
            api('/api/submissions?assignmentId=' + encodeURIComponent(assignmentId)).then((d) => {
              const subs = (d && d.submissions) || [];
              el.innerHTML = subs.length ? `<div class="overflow-x-auto"><table class="w-full font-sans text-xs"><thead><tr class="text-left text-muted"><th class="px-2 py-1">Student</th><th>Submitted</th><th>Text</th><th>File</th><th>Grade</th><th></th></tr></thead><tbody>${subs.map((s) => `
                <tr class="border-t border-line" data-sub="${esc(s.id)}">
                  <td class="px-2 py-1 font-semibold text-navy">${esc(s.name || s.email)}</td>
                  <td class="whitespace-nowrap">${fmtRel(s.submitted_at)}${s.late ? ' <span class="pill bg-saffron-soft text-saffron-deep">Late</span>' : ''}</td>
                  <td class="max-w-xs truncate" title="${esc(s.text_content || '')}">${esc((s.text_content || '').slice(0, 60))}</td>
                  <td>${s.file_key ? `<a class="underline" href="/api/asset?key=${encodeURIComponent(s.file_key)}" target="_blank" rel="noopener">Open</a>` : '—'}</td>
                  <td>${s.grade != null ? esc(s.grade) + (s.status === 'graded' ? '' : ' (draft)') : '—'}</td>
                  <td><button class="underline" data-grade="${esc(s.id)}">${s.grade != null ? 'Edit grade' : 'Grade'}</button></td>
                </tr>`).join('')}</tbody></table></div>` : '<p class="text-muted">No submissions yet.</p>';
              el.querySelectorAll('[data-grade]').forEach((b) => b.addEventListener('click', async () => {
                const v = await window.suModalForm({ title: 'Grade submission', submitLabel: 'Save', fields: [{ name: 'grade', label: `Score (0–${d.points})`, type: 'number' }, { name: 'feedback', label: 'Feedback', type: 'textarea', optional: true }] });
                if (!v) return;
                const r = await api('/api/submissions/grade', { method: 'POST', body: JSON.stringify({ submissionId: b.dataset.grade, grade: Number(v.grade), feedback: v.feedback }) });
                if (r && !r.error) { window.suToast('Grade saved.', 'ok'); loadRoster(assignmentId); } else window.suToast('Could not save grade.', 'error');
              }));
            });
          }

          root.addEventListener('click', async (e) => {
            const btn = e.target.closest('[data-new-assign]');
            if (!btn) return;
            const cid = btn.dataset.newAssign;
            const v = await window.suModalForm({ title: 'New assignment', submitLabel: 'Create', fields: [
              { name: 'title', label: 'Title' },
              { name: 'instructions', label: 'Instructions for students', type: 'textarea' },
              { name: 'dueAt', label: 'Due date', type: 'date', optional: true },
              { name: 'points', label: 'Points (default 100)', type: 'number', optional: true },
            ] });
            if (!v || !v.title.trim() || !v.instructions.trim()) return;
            const dueAt = v.dueAt ? new Date(v.dueAt).getTime() : undefined;
            const r = await api('/api/assignments', { method: 'POST', body: JSON.stringify({ courseId: cid, title: v.title, instructions: v.instructions, dueAt, points: v.points ? Number(v.points) : undefined, allowFile: true }) });
            if (r && !r.error) { window.suToast('Assignment created.', 'ok'); loadAssignments(cid); } else window.suToast('Could not create assignment.', 'error');
          });

          renderCourses();
          ['t-search', 't-status', 't-sort'].forEach((id) => { const el = document.getElementById(id); if (el) { el.addEventListener('input', renderCourses); el.addEventListener('change', renderCourses); } });
          document.getElementById('t-exp-all').addEventListener('click', () => { document.querySelectorAll('#t-body details').forEach((d) => d.open = true); });
          document.getElementById('t-col-all').addEventListener('click', () => { document.querySelectorAll('#t-body details').forEach((d) => d.open = false); });
        });
      }

      function renderTeacherDemo(stat) {
        const taught = pub.slice(0, 4);
        const names = ['Harpreet Kaur', 'Gurmeet Singh', 'Simran Kaur', 'Arjan Singh', 'Manvir Kaur', 'Jasdeep Singh', 'Noor Kaur', 'Ravi Singh'];
        const dscore = (i, j) => 60 + ((i * 7 + j * 13) % 41);
        const roster = names.map((nm, i) => ({ name: nm, email: nm.toLowerCase().replace(/[^a-z]+/g, '.') + '@example.com', active: ['today', '2d ago', '1w ago', 'today', '3d ago', '5d ago', '1d ago', '2w ago'][i] }));
        const cell = (v) => `<td class="border-t border-line px-2 py-1.5">${v}</td>`;
        const gradebook = `<div class="mt-4 overflow-x-auto rounded-xl2 border border-line"><table class="w-full font-sans text-sm"><thead><tr class="bg-brand text-left text-white"><th class="px-2 py-2">Student</th>${taught.map((c) => `<th class="px-2 py-2" title="${esc(c.title)}">${esc(c.title.split(/[:—]/)[0].slice(0, 14))}…</th>`).join('')}<th class="px-2 py-2">Avg</th></tr></thead><tbody>${roster.map((st, i) => { const scores = taught.map((c, j) => dscore(i, j)); const avg = Math.round(scores.reduce((a, b) => a + b, 0) / scores.length); return `<tr class="${i % 2 ? 'bg-paper' : ''}">${cell('<strong>' + esc(st.name) + '</strong>')}${scores.map((s) => `<td class="border-t border-line px-2 py-1.5">${s}% <span class="text-muted">(${grade(s)})</span></td>`).join('')}${cell('<strong>' + avg + '%</strong>')}</tr>`; }).join('')}</tbody></table></div>`;
        const analytics = `<h3 class="mt-10 text-xl font-bold">Course analytics <span class="rounded-full bg-saffron-soft text-saffron-deep font-sans text-xs px-2.5 py-0.5">Demo preview</span></h3><div class="mt-4 space-y-3">${taught.map((c, j) => { const comp = 35 + ((j * 17) % 55); const avg = 70 + ((j * 9) % 25); return `<div class="rounded-xl2 border border-line bg-surface p-4"><div class="flex flex-wrap items-baseline justify-between gap-2"><span class="font-semibold text-navy">${esc(c.title)}</span><span class="font-sans text-xs text-muted">${(j + 1) * 9} enrolled · avg score ${avg}%</span></div><div class="mt-2 h-2 w-full overflow-hidden rounded-full bg-paper"><div class="h-full bg-saffron" style="width:${comp}%"></div></div><div class="mt-1 font-sans text-xs text-muted">${comp}% completion</div></div>`; }).join('')}</div>`;
        root.innerHTML = `
          <h1 class="text-3xl font-bold">Teacher dashboard</h1>
          <p class="mt-1 font-sans text-sm text-muted">Sample view for testing — figures and students are illustrative.</p>
          <p class="mt-1 font-sans text-sm text-muted">Illustrative preview — real teacher analytics arrive with cohort enrolment.</p>
          <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">${stat(taught.length, 'Courses you teach')}${stat(96, 'Students')}${stat(38, 'Completions')}${stat('4.8' + iconSvg('star-filled', 'inline-block h-5 w-5 align-[-0.1em] text-saffron'), 'Avg. rating')}</div>
          <h3 class="mt-10 text-xl font-bold">Gradebook <span class="rounded-full bg-saffron-soft text-saffron-deep font-sans text-xs px-2.5 py-0.5">Demo preview</span></h3>
          <p class="font-sans text-sm text-muted">Each student's test score per course, with a letter grade and class average.</p>
          ${gradebook}
          ${analytics}
          <h3 class="mt-10 text-xl font-bold">Class roster <span class="rounded-full bg-saffron-soft text-saffron-deep font-sans text-xs px-2.5 py-0.5">Demo preview</span></h3><div class="mt-4 overflow-x-auto rounded-xl2 border border-line"><table class="w-full font-sans text-sm"><thead><tr class="text-left text-muted"><th class="px-3 py-2">Student</th><th>Email</th><th>Last active</th></tr></thead><tbody>${roster.map((st) => `<tr class="border-t border-line"><td class="px-3 py-2 font-semibold text-navy">${esc(st.name)}</td><td>${esc(st.email)}</td><td class="text-muted">${esc(st.active)}</td></tr>`).join('')}</tbody></table></div>
          <div class="mt-8"><a class="btn" href="/dashboard?demo=student">View the student experience →</a></div>`;
      }
    }).catch(() => { document.getElementById('dash').innerHTML = '<p class="text-muted">Could not load.</p>'; });
  </script>
</Base>
