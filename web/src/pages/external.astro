---
import Base from '../layouts/Base.astro';
// CONTENT MISMATCH FLAG (plan task 13): the prototype's `isexternal` block
// (source lines 1465-1481) designs a "leaving Sikhi University" interstitial
// for a single outbound link. The real page here is not an interstitial at
// all — it is a static "Recommended external courses" list (verified from
// this page's own <Base> title below, unchanged from before this task). The
// visual vocabulary (midnight/hall header treatment, ruled rows, mono
// destination labels, outbound-link framing copy) is applied to that real
// content instead of building the interstitial the prototype shows.
const courses = [
  {
    name: 'Sikhism Through Its Scriptures', provider: 'HarvardX (edX) · Prof. Harpreet Singh',
    cost: 'Free to audit (optional $149 certificate) · 4 weeks · self-paced',
    desc: "A scholarly examination of Sikh scripture from doctrinal and historical angles — the Japji, the role of Sri Guru Granth Sahib Ji, the musical traditions, and the scripture's influence on Sikh communities.",
    href: 'https://pll.harvard.edu/course/sikhism-through-its-scriptures-0',
  },
  {
    name: 'SikhRI Online Courses', provider: 'Sikh Research Institute',
    cost: 'Free & paid courses',
    desc: 'University-style courses on Gurbani, Sikh history, Gurmat and Kirtan from a respected non-profit research institute.',
    href: 'https://sikhri.org/courses',
  },
  {
    name: 'Sikh Dharma 101', provider: 'Sikh Dharma International',
    cost: 'Free · self-paced',
    desc: 'An introductory self-study overview of the Sikh path for beginners and interfaith learners.',
    href: 'https://www.sikhdharma.org/sd-101/',
  },
  {
    name: 'Study Sikhi', provider: 'Study Sikhi',
    cost: 'Free & paid',
    desc: 'University-level study of Sikh history, Gurbani, poetics and grammar.',
    href: 'https://www.studysikhi.com/',
  },
  {
    name: 'The Sikh Archive', provider: 'Sikh Archive (our partner)',
    cost: 'Free',
    desc: 'A growing digital library of Sikh sources, history and free courses — Sikhi University works alongside it.',
    href: 'https://sikharchive.net',
  },
];
// Mono "destination" label per row (prototype 1465-1481 shows the real
// linked host in mono, e.g. banidb.com/ang/1) — derived from each course's
// real href, never invented.
const withHost = courses.map((c) => ({ ...c, host: new URL(c.href).hostname.replace(/^www\./, '') }));
---
<Base title="Recommended external courses — Sikhi University" description="Reputable free and university Sikhi courses elsewhere — including Harvard's 'Sikhism Through Its Scriptures' — to study alongside Sikhi University." ambient="hall">
  <section class="wrap py-12">
    <!-- Hall ambient: real content floats on a light bordered panel, same
         pattern as teachers.astro (also ambient="hall"). -->
    <div class="border border-line bg-paper px-6 py-9 sm:px-8 sm:py-11">
      <p class="eyebrow flex items-center gap-2.5 text-saffron-deep">
        <span aria-hidden="true" class="inline-block h-px w-6 bg-current opacity-50"></span>
        <span data-i18n="external.eyebrow">Beyond Sikhi University</span>
      </p>
      <h1 class="text-display-sm mt-3 text-navy" data-i18n="external.h1">Study further, elsewhere</h1>
      <p class="mt-4 max-w-[66ch] font-sans text-lg leading-relaxed text-muted" data-i18n="external.sub">Sikhi University is one part of a wider world of Sikhi learning. These are reputable courses hosted by other institutions — we link to them so you can keep going. Their content stays on their own sites; we don't rehost it.</p>

      <div class="mt-8 rule-navy"></div>
      {withHost.map((c) => (
        <a href={c.href} target="_blank" rel="noopener" class="row-ruled hover:bg-surface" data-no-i18n>
          <span class="min-w-0 flex-1 basis-[260px]">
            <span class="block text-[16.5px] font-semibold text-navy">{c.name}</span>
            <span class="mt-0.5 block font-sans text-xs text-muted">{c.provider}</span>
          </span>
          <span class="flex-none font-sans text-xs font-semibold text-saffron-deep">{c.cost}</span>
          <span class="min-w-[180px] flex-1 basis-[220px] font-sans text-[13.5px] leading-[1.55] text-muted">{c.desc}</span>
          <span class="flex-none font-mono text-[11px] text-muted">{c.host}</span>
          <span class="flex-none whitespace-nowrap font-sans text-sm font-semibold text-navy" data-i18n="external.open">Open on their site</span>
        </a>
      ))}

      <p class="mt-8 font-sans text-sm text-muted">
        <span data-i18n="external.footer.prefix">A reputable free Sikhi course we should add here? Tell us via</span>{' '}
        <a class="underline text-navy" href="/feedback" data-i18n="footer.feedback">Feedback</a>.
      </p>
    </div>
  </section>
</Base>
