---
import Base from '../../layouts/Base.astro';
import { professorList, profBio, profSlug, professorPhotos, profInitials, avatarColor, topicName, published } from '../../lib/data';
import { isVerified } from '../../lib/verification';
export function getStaticPaths() {
  return professorList().map(({ name, courses }) => ({ params: { slug: profSlug(name) }, props: { name, courses } }));
}
const { name, courses } = Astro.props;
const bio = profBio(name);
const photo = professorPhotos[name];
const sorted = [...courses].sort((a, b) => a.level - b.level);

// Real date range parsed out of the bio's own text ("(1892-1977)"/"(c.1551-1636)")
// — never a separate, invented field. Absent for living/undated scholars.
const dateMatch = bio.match(/\((c\.\s*)?\d{3,4}[-–][\d]{2,4}\)/);
const dateRange = dateMatch ? dateMatch[0].replace(/[()]/g, '') : '';

function specialtyFor(list: { topic: string }[]): string[] {
  const seen = new Set<string>();
  const names: string[] = [];
  for (const c of list) {
    const n = topicName(c.topic);
    if (seen.has(n)) continue;
    seen.add(n);
    names.push(n);
    if (names.length >= 2) break;
  }
  return names;
}
const specialty = specialtyFor(courses);

// "Source works" rail: the real primary texts these courses draw on
// (course.sourceText), not the academic bibliography (course.references) —
// deduplicated by work title. Many professors have none; the rail is omitted
// rather than padded.
const works = new Map<string, string | undefined>();
let hasExternalOnly = false;
for (const c of sorted) {
  const s = (c as any).sourceText;
  if (s && s.work && !works.has(s.work)) {
    works.set(s.work, s.sikhArchiveUrl || s.url);
    if (!s.sikhArchiveUrl && s.url) hasExternalOnly = true;
  }
}

import { SITE, ldJson } from '../../lib/site';
// ProfilePage + Person structured data so professor pages are eligible for
// rich results. Kept honest: no invented affiliations or job titles — many
// professors are historical figures whose writings the courses are built from.
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    name,
    url: `${SITE}/professor/${profSlug(name)}`,
    ...(bio ? { description: bio } : {}),
    // JSON-LD consumers need an absolute URL (photo.img is a bare relative path).
    ...(photo && photo.img ? { image: `${SITE}/${photo.img}` } : {}),
  },
};
---
<Base title={`${name} — Sikhi University`} description={bio || `${name} teaches courses at Sikhi University.`} ogType="profile" ambient="study">
  <script type="application/ld+json" set:html={ldJson(personLd)} slot="head" />

  <div class="band-navy">
    <div class="wrap py-8 sm:pb-9 sm:pt-10">
      <p class="flex flex-wrap items-center gap-2.5 font-mono text-[10.5px] uppercase tracking-[.16em] text-white/72">
        <a href="/professors" class="hover:text-white" data-i18n="profs.breadcrumb">Faculty</a>
        <span aria-hidden="true">›</span>
        <span class="text-saffron" data-no-i18n>{name}</span>
      </p>
      <div class="mt-5 flex flex-wrap items-center gap-5">
        {photo && photo.img ? (
          <img src={`/${photo.img}`} width="96" height="96" alt="" style="object-position:center top"
            class="h-24 w-24 shrink-0 rounded-full border border-white/20 bg-line object-cover" />
        ) : (
          <span aria-hidden="true" class="flex h-24 w-24 shrink-0 items-center justify-center rounded-full font-mono text-2xl text-paper" style={`background:${avatarColor(name)}`}>{profInitials(name)}</span>
        )}
        <div class="min-w-0 flex-1 basis-[300px]">
          <h1 class="text-display-sm leading-[1.06] text-white" data-no-i18n>{name}</h1>
          <p class="mt-3 flex flex-wrap gap-x-[22px] gap-y-2.5 font-mono text-[11px] uppercase tracking-[.12em] text-white/78">
            {specialty.map((s) => <span data-no-i18n>{s}</span>)}
            {dateRange && <span class="text-saffron">{dateRange}</span>}
          </p>
        </div>
      </div>
    </div>
  </div>

  <section class="wrap py-10 sm:py-12">
    <div class="flex flex-wrap gap-10">
      <div class="min-w-0 flex-1 basis-[400px]">
        {bio && <p class="max-w-[70ch] text-[17.5px] leading-[1.68] text-ink" data-no-i18n>{bio}</p>}
        <p class="mt-4 max-w-[70ch] text-[17.5px] leading-[1.68] text-ink" data-i18n="profs.attributionNote">Courses attributed to a historical scholar draw on their written work. Attribution means the course is built from that scholarship — it does not mean the text was written in their voice.</p>

        <div id="teacher-bridge" data-professor={name}></div>

        <div class="mt-8 flex items-baseline gap-3 rule-navy pb-2">
          <h2 class="text-[23px] font-bold leading-[1.15] tracking-[-.026em] text-navy" data-i18n="profs.courses">Courses</h2>
          <span class="font-mono text-[11px] text-muted">{sorted.length} <span data-i18n="profs.published">published</span></span>
        </div>
        {sorted.map((c) => {
          const verified = isVerified(c.id);
          const lessons = (c.lessons || []).length;
          return (
            <div class="row-ruled">
              <span class="w-[72px] shrink-0 font-mono text-[11.5px] text-saffron-deep">LVL {c.level}</span>
              <a href={`/course/${c.id}`} class="min-w-0 flex-1 text-[16.5px] font-semibold text-navy hover:text-saffron-deep" data-no-i18n>{c.title}</a>
              <span class="shrink-0 font-mono text-[11px] text-muted">{lessons} <span data-i18n="profs.lessons">lessons</span></span>
              {verified ? (
                <span class="chip-status text-ok border-ok" data-i18n="profs.verified">Verified</span>
              ) : c.aiCreated ? (
                <span class="chip-status text-saffron-deep border-saffron-deep" data-i18n="profs.aiDrafted">AI-drafted</span>
              ) : null}
            </div>
          );
        })}
      </div>

      <div class="min-w-0 flex-1 basis-[240px]">
        {works.size > 0 && (
          <div>
            <p class="eyebrow mb-1 text-[10.5px] tracking-[.2em] text-saffron-deep" data-i18n="profs.sourceWorks">Source works</p>
            <div class="border-t-2 border-navy">
              {[...works.entries()].map(([work, href]) => (
                <div class="border-b border-line py-3">
                  {href ? (
                    <a href={href} target="_blank" rel="noopener" class="text-[15.5px] font-semibold leading-[1.4] text-navy hover:text-saffron-deep" data-no-i18n>{work}</a>
                  ) : (
                    <div class="text-[15.5px] font-semibold leading-[1.4] text-navy" data-no-i18n>{work}</div>
                  )}
                </div>
              ))}
            </div>
            {hasExternalOnly && <p class="mt-4 font-mono text-[11px] leading-[1.75] text-muted" data-i18n="profs.sourceHosted">Some source texts are held by SikhLibrary and gated there. We link out rather than mirror them.</p>}
          </div>
        )}
        {photo && photo.img && (
          <p class="mt-3 font-mono text-[11px] leading-[1.75] text-muted">
            <span data-i18n="profs.portraitCredit">Portrait:</span>{' '}
            {photo.source ? <a class="underline hover:text-navy" href={photo.source} target="_blank" rel="noopener">{photo.credit || 'Wikimedia Commons'}</a> : (photo.credit || 'Wikimedia Commons')}.
          </p>
        )}
      </div>
    </div>
  </section>

  <script>
    import { iconSvg } from '../../lib/icons';
    const esc = (s: unknown) => String(s == null ? '' : s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));
    function badge(level: string) {
      if (level === 'scholar') return `<span class="chip-status text-saffron-deep border-saffron-deep gap-1">${iconSvg('shield', 'h-3 w-3')} Verified Scholar</span>`;
      if (level === 'identity') return `<span class="chip-status text-ok border-ok gap-1">${iconSvg('check', 'h-3 w-3')} Verified</span>`;
      return '';
    }
    // Bridges the static (historical/authorial) professor identity to a live
    // teacher account, if one has an admin-approved claim on this exact name.
    const el = document.getElementById('teacher-bridge');
    if (el) {
      fetch('/api/teachers?professor=' + encodeURIComponent(el.dataset.professor || '')).then((r) => r.json()).then(({ teacher }) => {
        if (!teacher) return;
        el.innerHTML = `<div class="mt-5 flex flex-wrap items-center gap-3 rounded-xl2 border-l-4 border-saffron bg-surface p-4">
          <span class="font-sans text-sm">${esc(teacher.displayName)} teaches live on Sikhi University</span>
          ${badge(teacher.verificationLevel)}
          <a href="/teacher/${esc(teacher.slug)}" class="btn btn-primary ml-auto">View teacher profile</a>
        </div>`;
      }).catch(() => {});
    }
  </script>
</Base>
