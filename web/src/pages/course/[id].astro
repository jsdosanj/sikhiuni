        return '<div class="' + (isReply ? 'ml-8 mt-2 ' : '') + 'rounded-lg border border-line bg-surface p-3" data-msg-id="' + esc(x.id) + '">' +
          '<div class="flex flex-wrap items-center gap-2"><span class="h-7 w-7 shrink-0 rounded-full bg-navy text-white grid place-items-center font-sans text-xs" aria-hidden="true">' + esc(initial) + '</span>' +
          '<div class="font-sans text-xs text-muted">' + esc(name) + (x.created_at ? ' · ' + esc(timeAgo(x.created_at)) : '') + '</div>' +
          (x.pinned ? '<span class="rounded-full bg-saffron-soft px-2 py-0.5 font-sans text-[0.65rem] font-semibold text-saffron">Pinned</span>' : '') +
          badges(x) + '</div>' +
          '<div class="mt-0.5 text-sm">' + esc(x.message) + '</div>' +
          '<div class="mt-1 flex gap-3 font-sans text-xs text-muted">' +
          (!isReply && !x.locked ? '<button type="button" data-reply="' + esc(x.id) + '" class="hover:text-navy hover:underline">Reply</button>' : '') +
          (!isReply && x.locked ? '<span>Locked</span>' : '') +
          '<button type="button" data-report="' + esc(x.id) + '" class="hover:text-navy hover:underline">Report</button>' +
          '</div>' +
          '<div data-reply-box="' + esc(x.id) + '" class="mt-2 hidden"><textarea rows="2" class="w-full rounded-lg border border-line p-2 font-sans text-sm focus:border-saffron" placeholder="Write a reply…"></textarea><button type="button" class="btn mt-1" data-reply-submit="' + esc(x.id) + '">Post reply</button></div>' +
          '</div>';
      }
      function wireRowActions() {
        document.querySelectorAll('[data-reply]').forEach(function (b) {
          b.onclick = function () { var box = document.querySelector('[data-reply-box="' + b.dataset.reply + '"]'); if (box) box.classList.toggle('hidden'); };
        });
        document.querySelectorAll('[data-reply-submit]').forEach(function (b) {
          b.onclick = function () {
            var box = document.querySelector('[data-reply-box="' + b.dataset.replySubmit + '"]');
            var ta = box && box.querySelector('textarea');
            var msg = ta && ta.value.trim(); if (!msg) return;
            api('/api/discussions', { method: 'POST', body: JSON.stringify({ courseId: id, message: msg, parentId: b.dataset.replySubmit }) }).then(function (r) {
              if (r.ok) loadDisc(); else document.getElementById('disc-note').textContent = (r.d && r.d.error) || 'Could not post that reply.';
            });
