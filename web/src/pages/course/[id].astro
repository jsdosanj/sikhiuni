                  .then(function (r3) { return r3.json().then(function (d3) { return { ok: r3.ok, d: d3 }; }); })
                  .then(function (r3) { if (!r3.ok) { btn.disabled = false; note.textContent = (r3.d && r3.d.error) || 'File upload failed.'; return; } uploadThen(r3.d.key); });
              } else uploadThen(undefined);
            });
          });
        });
      }
      loadAssignments();

      // Discussion — depth-1 threading: each root can carry replies[]. Instructor
      // and scholar/verified badges come pre-computed from the server (author_role,
      // verified); pinned roots sort first (server-side), locked roots hide the
      // reply affordance.
      function badges(x) {
        var out = '';
        if (x.author_role === 'instructor') out += '<span class="rounded-full bg-navy px-2 py-0.5 font-sans text-[0.65rem] font-semibold text-white">Instructor</span>';
        if (x.verified === 'scholar') out += '<span class="ml-1 inline-flex items-center gap-1 rounded-full bg-saffron-soft px-2 py-0.5 font-sans text-[0.65rem] font-semibold text-saffron">' + iconSvg('shield', 'h-3 w-3') + ' Scholar</span>';
        else if (x.verified === 'identity') out += '<span class="ml-1 inline-flex items-center gap-1 rounded-full bg-surface px-2 py-0.5 font-sans text-[0.65rem] font-semibold text-muted">' + iconSvg('check', 'h-3 w-3') + ' Verified</span>';
