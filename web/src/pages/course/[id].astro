        });
        document.querySelectorAll('[data-report]').forEach(function (b) {
          b.onclick = function () {
            b.disabled = true; b.textContent = 'Reported';
            api('/api/discussions/report', { method: 'POST', body: JSON.stringify({ id: b.dataset.report }) });
          };
        });
      }
      function loadDisc() {
        api('/api/discussions?courseId=' + encodeURIComponent(id)).then(function (r) {
          var m = (r.d && r.d.messages) || [];
          document.getElementById('disc-list').innerHTML = m.length ? m.map(function (x) {
            return messageHtml(x, false) + (x.replies || []).map(function (rep) { return messageHtml(rep, true); }).join('');
          }).join('') : '<p class="text-sm text-muted">No messages yet — start the conversation.</p>';
          wireRowActions();
        });
      }
      loadDisc();
      document.getElementById('disc-submit').onclick = function () {
        var msg = document.getElementById('disc-msg').value.trim(); if (!msg) return;
        api('/api/discussions', { method: 'POST', body: JSON.stringify({ courseId: id, message: msg }) }).then(function (r) {
