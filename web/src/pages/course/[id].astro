      });
      var starsGroup = document.getElementById('rate-stars');
      if (starsGroup) starsGroup.addEventListener('mouseleave', function () { paint(stars); });
      function loadRating() { api('/api/ratings?courseId=' + encodeURIComponent(id)).then(function (r) { if (r.ok) document.getElementById('rate-summary').innerHTML = r.d.count ? (iconSvg('star-filled', 'inline-block h-4 w-4 align-[-0.15em] text-saffron') + ' ' + r.d.avg + ' · ' + r.d.count + ' rating' + (r.d.count == 1 ? '' : 's')) : 'No ratings yet — be the first.'; }); }
      loadRating();
      document.getElementById('rate-submit').onclick = function () {
        if (!stars) { document.getElementById('rate-msg').textContent = 'Pick a star rating.'; return; }
        paint(stars); // optimistic: show the submitted rating filled immediately
        api('/api/ratings', { method: 'POST', body: JSON.stringify({ courseId: id, stars: stars, review: document.getElementById('rate-review').value }) }).then(function (r) {
          document.getElementById('rate-msg').innerHTML = r.ok ? '<span class="text-ok">Thank you for rating.</span>' : esc((r.d && r.d.error) || 'Please sign in to rate.');
