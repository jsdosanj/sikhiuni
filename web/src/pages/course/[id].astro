  <script>
    import { iconSvg } from '../../lib/icons';
    (function () {
      var id = JSON.parse(document.getElementById('course-data').textContent).id;
      var esc = function (s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); };
      var api = function (p, o) { return fetch(p, Object.assign({ credentials: 'same-origin', headers: { 'content-type': 'application/json' } }, o || {})).then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }).catch(function () { return { ok: r.ok, d: {} }; }); }); };
      // Relative-time helper for discussion post timestamps (falls back to the raw value on parse failure).
      function timeAgo(ts) {
        var d = new Date(ts);
        if (isNaN(d.getTime())) return String(ts);
        var s = Math.floor((Date.now() - d.getTime()) / 1000);
        if (s < 60) return 'just now';
        var m = Math.floor(s / 60); if (m < 60) return m + (m === 1 ? ' minute ago' : ' minutes ago');
        var h = Math.floor(m / 60); if (h < 24) return h + (h === 1 ? ' hour ago' : ' hours ago');
        var days = Math.floor(h / 24); if (days < 30) return days + (days === 1 ? ' day ago' : ' days ago');
        var mo = Math.floor(days / 30); if (mo < 12) return mo + (mo === 1 ? ' month ago' : ' months ago');
        var y = Math.floor(mo / 12); return y + (y === 1 ? ' year ago' : ' years ago');
      }
      // Ratings
      var stars = 0;
      function paint(n) { document.querySelectorAll('#rate-stars button').forEach(function (x, i) { x.innerHTML = iconSvg(i < n ? 'star-filled' : 'star', 'h-7 w-7'); }); }
      document.querySelectorAll('#rate-stars button').forEach(function (b) {
        b.onclick = function () { stars = +b.dataset.s; paint(stars); };
