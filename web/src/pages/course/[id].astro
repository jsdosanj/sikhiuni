---
import Base from '../../layouts/Base.astro';
import Avatar from '../../components/Avatar.astro';
import Icon from '../../components/Icon.astro';
import { published, courses, topicName, profSlug, profBio } from '../../lib/data';
import { expandYoutubeEmbeds } from '../../lib/lesson-embeds';
export function getStaticPaths() { return published.map((c) => ({ params: { id: c.id }, props: { c } })); }
const { c } = Astro.props;
// Build-time verification status (from web/scripts/verify-gurbani.mjs, which runs
// before astro build). A course is "quotes verified" only if every quoted tuk matched
// canonical text with nothing mismatched or uncovered.
import { readFileSync, existsSync } from 'node:fs';
let quotesVerified = false;
try {
  if (existsSync('./public/data/verification.json')) {
    const vj = JSON.parse(readFileSync('./public/data/verification.json', 'utf-8'));
    const cv = vj.courses && vj.courses[c.id];
    quotesVerified = !!(cv && cv.verified > 0 && !cv.mismatch && !cv.uncovered);
  }
} catch (e) { /* verification data absent (e.g. astro dev) — no badge */ }
const profCourseCount = courses.filter((x) => x.professor === c.professor && x.status === 'published').length;
const bio = profBio(c.professor);
const bioShort = bio ? (bio.split('. ').slice(0, 2).join('. ').replace(/\.?$/, '.')) : '';
import { SITE, ldJson } from '../../lib/site';
const archive = c.topic === 'modern-skills'
  ? { url: 'https://sikharchive.net/courses', label: 'Free AI courses on Sikh Archive' }
  : { url: 'https://sikharchive.net', label: 'Dig deeper in the Sikh Archive' };
const lessons = c.lessons || [];
const quiz = c.quiz || [];
const ld = {
  '@context': 'https://schema.org', '@type': 'Course', name: c.title, description: c.summary,
  url: `${SITE}/course/${c.id}`,
  inLanguage: 'en', isAccessibleForFree: true, educationalLevel: c.level,
  provider: { '@type': 'EducationalOrganization', name: 'Sikhi University', sameAs: SITE + '/' },
  author: { '@type': 'Person', name: c.professor },
  offers: { '@type': 'Offer', price: 0, priceCurrency: 'USD', category: 'Free', availability: 'https://schema.org/InStock' },
  hasCourseInstance: {
    '@type': 'CourseInstance', courseMode: 'online',
    courseWorkload: `PT${Math.max(1, lessons.length) * 15}M`,
    instructor: { '@type': 'Person', name: c.professor },
  },
  hasPart: lessons.map((l) => ({
    '@type': 'LearningResource', name: l.title, learningResourceType: 'Lesson',
    inLanguage: 'en', isAccessibleForFree: true,
  })),
};
const breadcrumb = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Sikhi University', item: SITE + '/' },
    { '@type': 'ListItem', position: 2, name: 'Catalogue', item: SITE + '/catalog' },
    { '@type': 'ListItem', position: 3, name: topicName(c.topic), item: `${SITE}/catalog#${c.topic}` },
    { '@type': 'ListItem', position: 4, name: c.title, item: `${SITE}/course/${c.id}` },
  ],
};
---
<Base title={`${c.title} — Sikhi University`} description={c.summary} ogType="article" autoTranslate={false} ambient="study">
  <script type="application/ld+json" set:html={ldJson(ld)} slot="head" />
  <script type="application/ld+json" set:html={ldJson(breadcrumb)} slot="head" />

  <div id="read-progress" aria-hidden="true" class="fixed left-0 z-30 h-[3px] bg-saffron" style="top:0;width:0"></div>

  <div class="band-navy">
    <div class="wrap py-8 sm:pb-9 sm:pt-10">
      <p class="flex flex-wrap items-center gap-2.5 font-mono text-[10.5px] uppercase tracking-[.16em] text-white/72">
        <a href="/catalog" class="hover:text-white" data-i18n="course.breadcrumb">Catalogue</a>
        <span aria-hidden="true">›</span>
        <span data-no-i18n>{topicName(c.topic)}</span>
        <span aria-hidden="true">›</span>
        <span class="text-saffron" data-no-i18n>{c.title}</span>
      </p>
      <h1 class="mt-4 max-w-3xl text-display-sm text-white">{c.title}</h1>
      <p class="mt-2.5 max-w-2xl font-sans text-[15.5px] leading-relaxed text-white/88">{c.summary}</p>
      <div class="mt-4 flex flex-wrap items-center gap-x-7 gap-y-2.5 font-mono text-[11px] uppercase tracking-[.12em] text-white/78">
        <span><span class="text-white/58" data-i18n="course.professorlabel">Professor:</span> <a class="text-saffron normal-case tracking-normal hover:text-white" href={`/professor/${profSlug(c.professor)}`} data-no-i18n>{c.professor}</a></span>
        <span data-no-i18n>{lessons.length} lesson{lessons.length === 1 ? '' : 's'}</span>
        <span data-no-i18n>Level {c.level}</span>
        {c.aiCreated && <span class="chip-status border-saffron text-saffron" data-i18n="course.aibadge">Created by AI</span>}
        {quotesVerified && <a href="/integrity" class="chip-status border-ok text-ok hover:text-white" title="Every quoted shabad matches the canonical text of Sri Guru Granth Sahib Ji" data-i18n="course.verified">Quotes verified</a>}
      </div>
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <a href={c.gated ? '#gated-access' : '#lesson-0'} class="btn btn-primary" data-i18n="course.begin">Begin course</a>
        <button id="enroll-btn" class="btn border border-white/30 bg-white/10 text-white hover:bg-white/20">Enroll</button>
        {!c.gated && <button id="offline-btn" class="btn border border-white/30 bg-white/10 text-white hover:bg-white/20"><Icon name="download" class="h-4 w-4" /><span id="offline-lbl">Save offline</span></button>}
        <span class="font-mono text-[11px] uppercase tracking-[.12em] text-white/70">{c.gated ? 'Institutional course · full content requires cohort access' : `${lessons.length} lessons · ${quiz.length}-question test · 80% to pass`}</span>
      </div>
    </div>
  </div>

  <div class="wrap grid gap-10 py-12 lg:grid-cols-[262px_1fr]">
    <aside id="lesson-rail" class="lg:sticky lg:top-20 lg:self-start lg:max-h-[calc(100vh-6rem)] lg:overflow-y-auto lg:overscroll-contain lg:pr-1">
      <p class="font-mono text-[10px] uppercase tracking-[.18em] text-muted" data-i18n="course.lessons.h">Lessons</p>
      <div class="mt-3 border-t border-line">
        {!c.gated && lessons.map((ls, i) => (
          <a href={`#lesson-${i}`} data-rail-row={i} class="flex items-center gap-3 border-l-2 border-transparent py-[11px] pl-3 pr-1 hover:bg-paper">
            <span class="rail-idx shrink-0 font-mono text-[11px] text-muted" data-no-i18n>{String(i + 1).padStart(2, '0')}</span>
            <span class="rail-title min-w-0 flex-1 text-[14.5px] leading-snug text-muted" data-no-i18n>{ls.title}</span>
          </a>
        ))}
      </div>
      <div class="mt-[18px] border-t border-line pt-4">
        <div class="flex items-center gap-4">
          <svg width="60" height="60" viewBox="0 0 80 80" class="shrink-0 -rotate-90" aria-hidden="true">
            <circle class="ring-track" cx="40" cy="40" r="34" fill="none" stroke-width="8"></circle>
            <circle id="prog-ring" class="ring-value" cx="40" cy="40" r="34" fill="none" stroke-width="8" style="stroke-dasharray:213.63;stroke-dashoffset:213.63"></circle>
          </svg>
          <div class="min-w-0">
            <div class="font-mono text-[10px] uppercase tracking-[.16em] text-muted" data-i18n="course.progress.eyebrow">Your progress</div>
            <div id="prog-text" class="mt-1 font-sans text-sm font-semibold text-navy">0% complete</div>
          </div>
        </div>
        <div class="mt-3 h-[3px] bg-line"><div id="prog-bar" class="h-[3px] bg-saffron" style="width:0%"></div></div>
      </div>
      <div class="mt-[18px] border-t border-line pt-4">
        <p class="font-mono text-[10px] uppercase tracking-[.18em] text-muted" data-i18n="course.prof.eyebrow">Your professor</p>
        <div class="mt-2.5 flex items-center gap-3">
          <a href={`/professor/${profSlug(c.professor)}`} class="shrink-0"><Avatar name={c.professor} size={44} /></a>
          <div class="min-w-0">
            <a href={`/professor/${profSlug(c.professor)}`} class="block truncate font-bold text-navy hover:text-saffron-deep" data-no-i18n>{c.professor}</a>
            <div class="font-mono text-[10px] uppercase tracking-[.13em] text-muted" data-no-i18n>{profCourseCount} course{profCourseCount === 1 ? '' : 's'}</div>
          </div>
        </div>
        {bioShort && <p class="mt-2.5 text-[0.85rem] leading-relaxed text-muted">{bioShort}</p>}
        <a href={`/professor/${profSlug(c.professor)}`} class="mt-2.5 inline-block font-sans text-xs font-semibold text-saffron-deep hover:underline" data-i18n="course.prof.viewprofile">View profile →</a>
      </div>
    </aside>

    <div class="min-w-0">
      {c.aiCreated && (
        <div class="mb-6 rounded-xl2 border border-line bg-saffron-soft/50 p-4 font-sans text-sm">
          <strong data-i18n="course.ai.badge">Created by AI.</strong> <span data-i18n="course.ai.desc">Drafted with AI and reviewed for accuracy. Spotted an error?</span> <a class="underline" href="/feedback" data-i18n="course.ai.link">Tell us</a>.
        </div>
      )}

      {c.level >= 200 && (
        <div class="mb-6 rounded-xl2 border border-line bg-surface p-4 font-sans text-sm text-muted">
          <strong class="text-navy" data-i18n="course.prereq.badge">Prerequisite recommended.</strong>{' '}
          {c.level === 200 && <>This is a 200-level course. To get the most out of it, we recommend completing the <a class="underline text-navy" href="/catalog">100-level courses</a> first.</>}
          {c.level === 300 && <>This is a 300-level course. We recommend completing <a class="underline text-navy" href="/catalog">200-level courses</a> before diving in — they build the foundation this course assumes.</>}
          {c.level === 400 && <>This is a 400-level course. You'll get the most from it after completing <a class="underline text-navy" href="/catalog">300-level courses</a>, which cover the concepts this course builds on.</>}
          {c.level >= 500 && <>This is a graduate-level (500-level) course. It assumes a solid background in the subject — we recommend working through <a class="underline text-navy" href="/catalog">400-level courses</a> (or equivalent 200–300 level courses in this topic) before starting.</>}
        </div>
      )}

      {c.outcomes && c.outcomes.length > 0 && (
        <section class="mb-8">
          <h2 class="border-b-2 border-saffron-soft pb-1 text-xl font-bold" data-i18n="course.outcomes.h">What you'll learn</h2>
          <ul class="mt-3 grid gap-3 sm:grid-cols-2">
            {c.outcomes.map((o) => <li class="card-lift flex items-start gap-2.5 p-4"><Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-ok" /><span set:html={o} /></li>)}
          </ul>
        </section>
      )}

      {c.terms && c.terms.length > 0 && (
        <section class="mb-8">
          <h2 class="border-b-2 border-saffron-soft pb-1 text-xl font-bold"><span data-i18n="course.terms.h">Key terms —</span> <span lang="pa">ਸ਼ਬਦਾਵਲੀ</span></h2>
          <div class="mt-3 grid gap-3 sm:grid-cols-2">
            {c.terms.map((t) => (
              <div class="card-lift p-4">
                <div class="gur font-semibold text-navy" lang="pa" set:html={t.t} />
                <p class="mt-1 text-muted break-words">{t.m}</p>
              </div>
            ))}
          </div>
        </section>
      )}

      <div id="course-ann" class="mb-8 empty:mb-0"></div>

      <section class="mb-8">
        <div class="flex flex-wrap items-end justify-between gap-3 border-b-2 border-saffron-soft pb-1">
          <h2 class="text-xl font-bold" data-i18n="course.lessons.h">Lessons</h2>
          <div class="relative" id="tts-settings-wrap" hidden>
            <button id="tts-settings" class="inline-flex items-center gap-1.5 rounded-lg border border-line px-2.5 py-1 font-sans text-xs text-muted hover:border-saffron hover:text-navy" aria-expanded="false" aria-controls="tts-panel"><Icon name="volume" class="h-3.5 w-3.5" /><span data-i18n="course.tts.settings">Voice &amp; speed</span></button>
            <div id="tts-panel" class="absolute right-0 z-20 mt-2 hidden w-64 rounded-xl2 border border-line bg-surface p-3 shadow-lift">
              <label class="block font-sans text-xs font-semibold text-muted" for="tts-voice"><span data-i18n="course.tts.voice">Reading voice</span></label>
              <select id="tts-voice" class="mt-1 w-full rounded-lg border border-line bg-paper px-2 py-1.5 font-sans text-sm"></select>
              <label class="mt-3 block font-sans text-xs font-semibold text-muted" for="tts-rate"><span data-i18n="course.tts.speed">Speed</span> · <span id="tts-rate-val">1×</span></label>
              <input id="tts-rate" type="range" min="0.6" max="1.4" step="0.05" class="mt-1 w-full accent-saffron" />
            </div>
          </div>
        </div>
        <div class="mt-4">
          {c.gated ? (
            <div id="gated-access">
              <div id="gated-teaser" class="card-lift p-5 text-center">
                <p class="font-semibold text-navy">This course is offered through a partner institution.</p>
                <p class="mt-1 text-sm text-muted">Full lessons are available to enrolled cohort members. Have an invite code? <a class="underline text-navy" href="/cohorts">Join at /cohorts →</a></p>
              </div>
              <div id="gated-lessons" class="mt-2"></div>
            </div>
          ) : lessons.map((ls, i) => (
            <article id={`lesson-${i}`} class="border-t-2 border-line pt-8 pb-2 first:border-t-0 first:pt-0">
              <div class="flex flex-wrap items-start justify-between gap-3">
                <div class="min-w-0">
                  <p class="font-mono text-[10.5px] uppercase tracking-[.2em] text-saffron-deep" data-no-i18n>{`Lesson ${String(i + 1).padStart(2, '0')}`}</p>
                  <h3 class="mt-1 text-2xl font-bold leading-tight text-navy">{ls.title}</h3>
                </div>
                <button data-listen={i} class="btn shrink-0 min-h-[44px] px-3 font-sans text-sm" aria-label={`Listen to lesson ${i + 1}`}><Icon name="volume" class="h-4 w-4" /><span class="listen-lbl" data-i18n="course.listen">Listen</span></button>
              </div>
              <div class="lesson-prose mt-4 max-w-[68ch] leading-relaxed" set:html={expandYoutubeEmbeds(ls.html)} />
              <div class="mt-5 border-t border-dashed border-line pt-4">
                <label class="inline-flex items-center gap-1.5 font-sans text-xs text-muted"><Icon name="note" class="h-3.5 w-3.5" /><span data-i18n="course.notes.label">Your notes — saved on this device</span></label>
                <textarea data-note={i} aria-label={`Your notes for lesson ${i + 1}`} rows="3" class="mt-1 w-full rounded-lg border border-line bg-paper p-2 text-[0.95rem]" placeholder="Write your notes…" data-i18n-ph="course.notes.ph"></textarea>
                <div class="mt-3 flex flex-wrap gap-2.5">
                  <button data-done={i} class="btn border-navy bg-navy text-white hover:bg-navy-strong">Mark complete</button>
                  {i < lessons.length - 1
                    ? <a href={`#lesson-${i + 1}`} class="btn" data-i18n="course.nextlesson">Next lesson →</a>
                    : quiz.length > 0 && <a href="#test" class="btn" data-i18n="course.gotest">Take the test →</a>}
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section id="gurbani-refs" class="mb-8 hidden">
        <h2 class="border-b-2 border-saffron-soft pb-1 text-xl font-bold"><span data-i18n="course.gurbani.h">Gurbani Verses —</span> <span class="gur text-saffron-deep" lang="pa">ਗੁਰਬਾਣੀ</span></h2>
        <p class="mt-1 font-sans text-sm text-muted"><span data-i18n="course.gurbani.sub">Lines from Sri Guru Granth Sahib Ji referenced in this course.</span>{quotesVerified ? <> Every quoted shabad here is <a class="underline" href="/integrity">machine-verified</a> against the canonical text.</> : null}</p>
        <div id="gurbani-refs-list" class="mt-4 space-y-3"></div>
      </section>

      {c.granthRef && (
        <section id="granth-panel" class="mb-8" data-granth-src={c.granthRef.src} data-granth-start={c.granthRef.start} data-granth-end={c.granthRef.end}>
          <h2 class="border-b-2 border-saffron-soft pb-1 text-xl font-bold"><span>From the Granth —</span> <span class="gur text-saffron-deep" lang="pa">{c.granthRef.label.split('·')[0].trim()}</span></h2>
          <p class="mt-1 font-sans text-sm text-muted">
            {c.granthRef.label} · Ang {c.granthRef.start}{c.granthRef.end > c.granthRef.start ? `–${c.granthRef.end}` : ''}, rendered verbatim from the reader corpus. Tap any line for its published translation and ਅਰਥ.
            <a class="ml-1 font-semibold text-navy underline" href={`/santhiya?src=${c.granthRef.src}&ang=${c.granthRef.start}`}>Read with Santhya audio →</a>
          </p>
          <div class="card-lift mt-4">
            <div class="flex items-center justify-between gap-3 font-sans text-sm">
              <button id="gp-prev" class="rounded-lg border border-line px-3 py-1.5 hover:border-saffron" aria-label="Previous Ang">←</button>
              <span id="gp-ang" class="font-semibold text-navy"></span>
              <button id="gp-next" class="rounded-lg border border-line px-3 py-1.5 hover:border-saffron" aria-label="Next Ang">→</button>
            </div>
            <div id="gp-lines" lang="pa" class="gur mt-4 space-y-2 text-xl leading-loose"></div>
          </div>
        </section>
      )}

      <section id="parallel-panel" class="mb-8 hidden">
        <h2 class="border-b-2 border-saffron-soft pb-1 text-xl font-bold"><span>Parallel text —</span> <span class="gur text-saffron-deep" lang="pa">ਪਾਠ ਤੇ ਅਰਥ</span></h2>
        <p class="mt-1 font-sans text-sm text-muted">The work page by page: the author's original Gurmukhi beside its published English translation (OCR — refer to the original for an authoritative reading).</p>
        <div class="card-lift mt-4">
          <div class="flex items-center justify-between gap-3 font-sans text-sm">
            <button id="pp-prev" class="rounded-lg border border-line px-3 py-1.5 hover:border-saffron" aria-label="Previous page">←</button>
            <span id="pp-page" class="font-semibold text-navy"></span>
            <button id="pp-next" class="rounded-lg border border-line px-3 py-1.5 hover:border-saffron" aria-label="Next page">→</button>
          </div>
          <div class="mt-4 grid gap-5 md:grid-cols-2">
            <div id="pp-gur" lang="pa" class="gur whitespace-pre-line text-lg leading-loose"></div>
            <div id="pp-en" class="whitespace-pre-line font-sans text-sm leading-relaxed text-muted"></div>
          </div>
        </div>
      </section>

      {c.references && c.references.length > 0 && (
        <section class="mb-8">
          <h2 class="border-b-2 border-saffron-soft pb-1 text-xl font-bold" data-i18n="course.refs.h">References &amp; further reading</h2>
          <ol class="mt-3 list-decimal space-y-2 pl-5 font-sans text-sm text-muted">{c.references.map((r) => <li>{r}</li>)}</ol>
        </section>
      )}

      {c.sourceText && (
        <section class="mb-8">
          <h2 class="border-b-2 border-saffron-soft pb-1 text-xl font-bold" data-i18n="course.sourcetext.h">From the source text</h2>
          <figure class="mt-3 rounded-xl2 border border-line bg-paper p-5">
            {c.sourceText.gurmukhi && (
              <blockquote lang="pa" class="border-l-4 border-saffron pl-4 text-lg leading-loose text-navy">{c.sourceText.gurmukhi}</blockquote>
            )}
            {c.sourceText.english && (
              <blockquote class={`pl-4 text-[0.97rem] italic leading-relaxed text-muted ${c.sourceText.gurmukhi ? 'mt-3 border-l-4 border-line' : 'border-l-4 border-saffron text-navy'}`}>{c.sourceText.english}</blockquote>
            )}
            <figcaption class="mt-3 font-sans text-xs text-muted">
              — from <strong>{c.sourceText.work}</strong>.
              {c.sourceText.gurmukhi && c.sourceText.english
                ? " Gurmukhi is the author's original text (OCR); the English is a machine translation. Both are short study excerpts — refer to the original for an authoritative reading."
                : c.sourceText.gurmukhi
                  ? " This is the author's original Gurmukhi text (OCR), shown as a study excerpt — OCR may contain errors."
                  : ' Shown as a short study excerpt — refer to the original for an authoritative reading.'}
              {c.sourceText.sikhArchiveUrl
                ? <a class="ml-1 font-semibold text-navy underline" href={c.sourceText.sikhArchiveUrl} target="_blank" rel="noopener" data-i18n="course.sourcetext.readarchive">Read the full work on Sikh Archive ↗</a>
                : <a class="ml-1 font-semibold text-navy underline" href={c.sourceText.url} target="_blank" rel="noopener" data-i18n="course.sourcetext.readsikhlibrary">Read the full work on SikhLibrary ↗</a>}
              {c.sourceText.sikhArchiveUrl && (
                <a class="ml-1 text-muted underline" href={c.sourceText.url} target="_blank" rel="noopener" data-i18n="course.sourcetext.orsikhlibrary">(or on SikhLibrary ↗)</a>
              )}
            </figcaption>
          </figure>
        </section>
      )}

    </div>
  </div>

  <section class="wrap pb-14">
    <div class="grid gap-6 lg:grid-cols-2">
      {c.terms && c.terms.length > 0 && (
        <section id="flashcards" class="card-lift p-5">
          <h2 class="border-b-2 border-saffron-soft pb-1 text-xl font-bold"><span data-i18n="course.flashcards.h">Flashcards —</span> <span lang="pa">ਕਾਰਡ ਅਭਿਆਸ</span></h2>
          <p class="mt-1 font-sans text-sm text-muted" data-i18n="course.flashcards.sub">Click a card to flip it and reveal the definition.</p>
          <div class="mt-4 relative">
            <!-- Card display -->
            <div id="fc-card" class="cursor-pointer select-none rounded-xl2 border border-line bg-surface shadow-card min-h-[160px] flex flex-col items-center justify-center p-8 text-center transition-all hover:border-saffron" role="button" aria-label="Flip card" data-i18n-aria="course.flashcards.flipAria" tabindex="0">
              <div id="fc-front" class="text-lg font-bold text-navy"></div>
              <div id="fc-back" class="hidden mt-3 text-[0.95rem] text-muted leading-relaxed"></div>
              <div id="fc-hint" class="mt-4 font-sans text-xs text-muted/60">Click to reveal</div>
            </div>
            <!-- Navigation -->
            <div class="mt-4 flex items-center justify-between gap-3">
              <button id="fc-prev" class="btn font-sans text-sm px-4 py-1.5" data-i18n="course.flashcards.prev">← Prev</button>
              <div class="flex items-center gap-3">
                <span id="fc-counter" class="font-sans text-sm text-muted"></span>
                <button id="fc-known" class="btn btn-primary font-sans text-sm px-4 py-1.5"><span data-i18n="course.flashcards.marklearned">Mark learned</span> <Icon name="check" class="h-4 w-4" /></button>
              </div>
              <button id="fc-next" class="btn font-sans text-sm px-4 py-1.5" data-i18n="course.flashcards.next">Next →</button>
            </div>
            <div class="mt-3 flex items-center justify-between">
              <div id="fc-progress" class="font-sans text-xs text-muted"></div>
              <button id="fc-reset" class="font-sans text-xs text-muted hover:text-saffron-deep underline" data-i18n="course.flashcards.reset">Reset progress</button>
            </div>
          </div>
        </section>
      )}

      {(quiz.length > 0 || c.gated) && (
        <section id="test" class="card-lift p-6">
          <h2 class="text-xl font-bold" data-i18n="course.quiz.h">Course test</h2>
          <p class="font-sans text-sm text-muted" data-i18n="course.quiz.sub">Pass with 80% or higher to complete the course and unlock the next one.</p>
          <form id="quiz" class="mt-4 space-y-5">
            {!c.gated && quiz.map((qq, i) => (
              <fieldset><legend class="font-semibold">{i + 1}. {qq.q}</legend>
                {qq.options.map((o, oi) => (
                  <label class="mt-1 block cursor-pointer"><input type="radio" name={`q${i}`} value={oi} class="mr-2" />{o}</label>
                ))}
              </fieldset>
            ))}
          </form>
          <button id="quiz-submit" class="btn btn-primary mt-4" data-i18n="course.quiz.submit">Submit test</button>
          <div id="quiz-result" class="mt-4"></div>
        </section>
      )}

      <section class="card-lift p-6">
        <h2 class="text-xl font-bold" data-i18n="course.readsource.h">Read the source texts</h2>
        <p class="mt-1" data-i18n="course.readsource.sub">Read the primary sources for yourself — the Gurbani in our read-along reader, and the original works in the source library.</p>
        <div class="mt-3 flex flex-wrap gap-3">
          <a class="btn" href="/santhiya?src=sggs"><Icon name="book" class="h-4 w-4" /><span data-i18n="course.readsource.readgurbani">Read Gurbani (reader)</span></a>
          {c.sourceText?.sikhArchiveUrl && (
            <a class="btn" href={c.sourceText.sikhArchiveUrl} target="_blank" rel="noopener"><Icon name="books" class="h-4 w-4" /><span data-i18n="course.readsource.readarchive">Read this work on Sikh Archive ↗</span></a>
          )}
          {c.sourceText && c.sourceText.url && (
            <a class="btn" href={c.sourceText.url} target="_blank" rel="noopener" data-i18n="course.readsource.thiswork">This work on SikhLibrary ↗</a>
          )}
          {(c.sourceText || (c.source && c.source.indexOf('SikhLibrary') !== -1)) && (
            <a class="btn" href="https://huggingface.co/datasets/jsdosanj/SikhLibrary" target="_blank" rel="noopener" data-i18n="course.readsource.dataset">SikhLibrary dataset ↗</a>
          )}
          <a class="btn" href={archive.url} target="_blank" rel="noopener">{archive.label} →</a>
        </div>
      </section>

      <section class="card-lift p-6">
        <h2 class="text-xl font-bold" data-i18n="course.rate.h">Rate this course</h2>
        <div id="rate-summary" class="mt-1 font-sans text-sm text-muted">…</div>
        <div id="rate-stars" role="group" aria-label="Rate this course from 1 to 5 stars" data-i18n-aria="course.rate.groupAria" class="mt-2 flex gap-1 text-3xl text-saffron">
          <button type="button" data-s="1" aria-label="1 star" data-i18n-aria="course.rate.star1"><Icon name="star" class="h-7 w-7" /></button><button type="button" data-s="2" aria-label="2 stars" data-i18n-aria="course.rate.star2"><Icon name="star" class="h-7 w-7" /></button><button type="button" data-s="3" aria-label="3 stars" data-i18n-aria="course.rate.star3"><Icon name="star" class="h-7 w-7" /></button><button type="button" data-s="4" aria-label="4 stars" data-i18n-aria="course.rate.star4"><Icon name="star" class="h-7 w-7" /></button><button type="button" data-s="5" aria-label="5 stars" data-i18n-aria="course.rate.star5"><Icon name="star" class="h-7 w-7" /></button>
        </div>
        <textarea id="rate-review" rows="2" aria-label="Optional written review" data-i18n-aria="course.rate.reviewAria" placeholder="Optional review…" data-i18n-ph="course.rate.reviewPh" class="mt-2 w-full rounded-lg border border-line p-2 font-sans text-sm transition-colors focus:border-saffron"></textarea>
        <button id="rate-submit" class="btn btn-primary mt-2" data-i18n="course.rate.submit">Submit rating</button>
        <div id="rate-msg" class="mt-2 font-sans text-sm"></div>
        <div id="assignments" class="mt-6 hidden border-t border-line pt-6">
          <h2 class="text-xl font-bold">Assignments</h2>
          <div id="assign-list" class="mt-3 space-y-3"></div>
        </div>
        <div class="mt-6 border-t border-line pt-6">
          <h2 class="text-xl font-bold" data-i18n="course.discussion.h">Discussion &amp; Q&amp;A</h2>
          <div id="disc-list" class="mt-3 space-y-2"></div>
          <textarea id="disc-msg" rows="2" aria-label="Your question or comment" data-i18n-aria="course.discussion.msgAria" placeholder="Ask a question or share a thought…" data-i18n-ph="course.discussion.msgPh" class="mt-3 w-full rounded-lg border border-line p-2 font-sans text-sm transition-colors focus:border-saffron"></textarea>
          <button id="disc-submit" class="btn mt-2" data-i18n="course.discussion.post">Post</button>
          <div id="disc-note" class="mt-1 font-sans text-xs text-muted" data-i18n="course.discussion.signinnote">Sign in to post.</div>
        </div>
      </section>
    </div>
  </section>

  <div id="pass-celebrate" class="fixed inset-0 z-50 hidden items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="pass-celebrate-h">
    <div class="pass-backdrop absolute inset-0 bg-navy-strong/70"></div>
    <div id="pass-celebrate-panel" class="card-lift relative z-10 w-full max-w-sm p-8 text-center">
      <div class="mx-auto grid h-16 w-16 place-items-center rounded-full bg-saffron-soft text-saffron-deep"><Icon name="medal" class="h-9 w-9" /></div>
      <h2 id="pass-celebrate-h" class="mt-4 text-xl font-bold text-navy">Course complete</h2>
      <p id="pass-celebrate-score" class="mt-1 font-sans text-sm text-muted"></p>
      <div class="mt-5 flex flex-col gap-2">
        <a id="pass-celebrate-cert" class="btn btn-primary" href="/login">View certificate</a>
        <button id="pass-celebrate-close" type="button" class="btn">Keep learning</button>
      </div>
    </div>
  </div>

  <style>
    #pass-celebrate-panel.pop { animation: pass-pop .5s var(--ease-spring) both; }
    @keyframes pass-pop { from { transform: scale(.85); opacity: 0; } to { transform: scale(1); opacity: 1; } }
    @media (prefers-reduced-motion: reduce) { #pass-celebrate-panel.pop { animation: none; } }
  </style>

  <script type="application/json" id="course-data" set:html={JSON.stringify({ id: c.id, nLessons: lessons.length, nQuiz: quiz.length, gated: !!c.gated, terms: (c.terms || []).map((t) => ({ t: t.t, m: t.m })) })}></script>
  <script>
    import { iconSvg } from '../../lib/icons';
    const __d = JSON.parse(document.getElementById('course-data').textContent);
    const id = __d.id, nLessons = __d.nLessons, nQuiz = __d.nQuiz;
    const P = 'su_v1_';
    const get = (k, d) => { try { const v = localStorage.getItem(P + k); return v == null ? d : JSON.parse(v); } catch { return d; } };
    const set = (k, v) => { try { localStorage.setItem(P + k, JSON.stringify(v)); } catch {} };
    const doneKey = 'done_' + id, scoreKey = 'score_' + id; let done = get(doneKey, {});
    // Write progress + grade to the server (the source of truth); localStorage is a cache.
    function push() {
      return fetch('/api/progress', { method: 'POST', credentials: 'same-origin', headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ courseId: id, done: Object.keys(done).filter((k) => done[k]).map(Number) }) }).catch(() => {});
    }
    // Cross-device pull: the server's record wins, so grades survive a cleared device.
    fetch('/api/progress', { credentials: 'same-origin' }).then((r) => (r.ok ? r.json() : null)).then((d) => {
      if (!d || !d.progress) return;
      const row = d.progress.filter((p) => p.course_id === id)[0]; if (!row) return;
      try { JSON.parse(row.done || '[]').forEach((i) => { done[i] = true; }); set(doneKey, done); } catch {}
      if (row.passed_score != null) { set(scoreKey, row.passed_score); if (row.passed_score >= 80) set('passed_' + id, row.passed_score); }
      refresh();
    }).catch(() => {});
    // Announcements posted by this course's teacher(s).
    fetch('/api/announcements?course=' + encodeURIComponent(id), { credentials: 'same-origin' }).then((r) => (r.ok ? r.json() : null)).then((d) => {
      const list = (d && d.announcements) || []; const el = document.getElementById('course-ann'); if (!el || !list.length) return;
      const esc = (s) => String(s == null ? '' : s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
      el.innerHTML = `<h2 class="border-b-2 border-saffron-soft pb-1 text-xl font-bold">Announcements</h2><div class="mt-3 space-y-3">${list.slice(0, 5).map((a) => `<div class="rounded-xl2 border-l-4 border-saffron bg-surface p-4"><div class="font-sans text-xs text-muted">${esc(a.author_name || '')}</div>${a.title ? `<div class="mt-1 font-bold text-navy">${esc(a.title)}</div>` : ''}<p class="mt-1 text-[0.97rem]">${esc(a.body)}</p></div>`).join('')}</div>`;
    }).catch(() => {});
    // Explicit enrollment toggle — server is the source of truth; localStorage mirrors it for instant UI.
    (function () {
      const btn = document.getElementById('enroll-btn'); if (!btn) return;
      const ek = 'enrolled_course_' + id;
      let enrolled = get(ek, false);
      function paint() { btn.innerHTML = enrolled ? iconSvg('check', 'h-4 w-4') + ' Enrolled' : 'Enroll'; btn.classList.toggle('bg-saffron', enrolled); btn.classList.toggle('text-black', enrolled); btn.classList.toggle('bg-white/10', !enrolled); btn.classList.toggle('text-white', !enrolled); }
      paint();
      fetch('/api/enrollments', { credentials: 'same-origin' }).then((r) => (r.ok ? r.json() : null)).then((d) => {
        if (!d || !d.enrollments) return;
        enrolled = d.enrollments.some((e) => e.kind === 'course' && e.target_id === id);
        set(ek, enrolled); paint();
      }).catch(() => {});
      btn.addEventListener('click', () => {
        const next = !enrolled; btn.disabled = true;
        fetch('/api/enrollments', { method: 'POST', credentials: 'same-origin', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ kind: 'course', targetId: id, action: next ? 'enroll' : 'unenroll' }) })
          .then((r) => { if (r.status === 401) { location.href = '/login'; return null; } return r.ok ? r.json() : null; })
          .then((res) => { btn.disabled = false; if (res) { enrolled = !!res.enrolled; set(ek, enrolled); paint(); } })
          .catch(() => { btn.disabled = false; });
      });
    })();
    // Offline course pack (E1): cache this course's page + same-origin images via the
    // service worker so the lessons read without a connection.
    (function () {
      const btn = document.getElementById('offline-btn'); const lbl = document.getElementById('offline-lbl'); if (!btn || !lbl) return;
      const savedKey = 'offline_' + id;
      if (get(savedKey, false)) lbl.textContent = 'Saved offline';
      btn.addEventListener('click', () => {
        if (!('serviceWorker' in navigator) || !navigator.serviceWorker.controller) { window.suToast && window.suToast('Offline saving needs a supported browser.', 'error'); return; }
        const urls = [location.pathname];
        document.querySelectorAll('img[src]').forEach((img) => { try { const u = new URL(img.src, location.href); if (u.origin === location.origin) urls.push(u.pathname); } catch (e) {} });
        btn.disabled = true; lbl.textContent = 'Saving…';
        const onMsg = (ev) => {
          if (!ev.data || ev.data.type !== 'pack-cached' || ev.data.id !== id) return;
          navigator.serviceWorker.removeEventListener('message', onMsg); btn.disabled = false;
          if (ev.data.ok) { set(savedKey, true); lbl.textContent = 'Saved offline'; window.suToast && window.suToast('Saved for offline — text and images work without a connection.', 'ok'); }
          else { lbl.textContent = 'Save offline'; window.suToast && window.suToast('Could not save offline — please try again.', 'error'); }
        };
        navigator.serviceWorker.addEventListener('message', onMsg);
        navigator.serviceWorker.controller.postMessage({ type: 'cache-pack', id: id, urls: Array.from(new Set(urls)) });
      });
    })();
    // Lesson audio narration (E8), via the shared TTS engine (lib/tts): smart
    // voice picking + tuned rate/pitch + natural sentence pauses. Gurmukhi
    // (.gur/.shabad/gurbani blockquotes) is stripped so a voice never
    // mispronounces Gurbani; the English translations that follow are read.
    (async function () {
      const tts = await import('../../lib/tts');
      const buttons = Array.from(document.querySelectorAll('[data-listen]'));
      if (!buttons.length) return;
      if (!tts.supported()) { buttons.forEach((b) => b.remove()); return; }
      let playing = null;
      const label = (b, t) => { const l = b.querySelector('.listen-lbl'); if (l) l.textContent = t; b.setAttribute('aria-label', (t === 'Stop' ? 'Stop reading lesson ' : 'Listen to lesson ') + (Number(b.getAttribute('data-listen')) + 1)); };
      const stopAll = () => { tts.stop(); buttons.forEach((b) => label(b, 'Listen')); playing = null; };
      const readable = (art) => {
        const p = art && art.querySelector('.lesson-prose'); if (!p) return '';
        const clone = p.cloneNode(true);
        clone.querySelectorAll('.gur, .shabad, blockquote.gurbani, [lang="pa"]').forEach((n) => n.remove());
        return (clone.innerText || '').replace(/\s+/g, ' ').trim();
      };
      const uiLang = () => (document.documentElement.getAttribute('lang') === 'pa' ? 'pa-IN' : 'en-US');
      buttons.forEach((btn) => {
        const i = btn.getAttribute('data-listen');
        btn.addEventListener('click', () => {
          if (playing === i) { stopAll(); return; }
          stopAll();
          const text = readable(document.getElementById('lesson-' + i));
          if (!text) { window.suToast && window.suToast('This lesson has nothing to read aloud.', 'error'); return; }
          playing = i; label(btn, 'Stop');
          tts.speak(text, { lang: uiLang(), onend: () => { if (playing === i) stopAll(); } });
        });
      });

      // Voice & speed popover (persisted via the shared engine's su_v1_tts prefs).
      const wrap = document.getElementById('tts-settings-wrap');
      const toggle = document.getElementById('tts-settings');
      const panel = document.getElementById('tts-panel');
      const voiceSel = document.getElementById('tts-voice');
      const rate = document.getElementById('tts-rate');
      const rateVal = document.getElementById('tts-rate-val');
      if (wrap && toggle && panel && voiceSel && rate) {
        wrap.hidden = false;
        rate.value = String(tts.getRate());
        rateVal.textContent = tts.getRate().toFixed(2).replace(/0+$/, '').replace(/\.$/, '') + '×';
        toggle.addEventListener('click', async () => {
          const open = panel.classList.toggle('hidden');
          toggle.setAttribute('aria-expanded', String(!open));
          if (!open && !voiceSel.options.length) {
            const voices = await tts.listVoices(uiLang());
            if (!voices.length) { voiceSel.innerHTML = '<option value="">System default</option>'; return; }
            voiceSel.innerHTML = '<option value="">Automatic (best available)</option>' +
              voices.map((v) => `<option value="${v.voiceURI.replace(/"/g, '&quot;')}">${v.name} (${v.lang})</option>`).join('');
          }
        });
        voiceSel.addEventListener('change', () => { if (voiceSel.value) tts.setPreferredVoice(uiLang(), voiceSel.value); });
        rate.addEventListener('input', () => {
          tts.setRate(parseFloat(rate.value));
          rateVal.textContent = parseFloat(rate.value).toFixed(2).replace(/0+$/, '').replace(/\.$/, '') + '×';
        });
        document.addEventListener('click', (e) => {
          if (!wrap.contains(e.target) && !panel.classList.contains('hidden')) { panel.classList.add('hidden'); toggle.setAttribute('aria-expanded', 'false'); }
        });
      }
    })();
    function recordActivity() { set('last_course', id); const a = get('activity', []); const d = new Date(); const t = d.getFullYear() + '-' + (d.getMonth() + 1) + '-' + d.getDate(); if (a[a.length - 1] !== t) { a.push(t); set('activity', a); } }
    function refresh() {
      let n = 0; for (let i = 0; i < nLessons; i++) if (done[i]) n++;
      const pct = nLessons ? Math.round((n / nLessons) * 100) : 0;
      document.getElementById('prog-bar').style.width = pct + '%';
      document.getElementById('prog-text').textContent = pct + '% complete';
      const ring = document.getElementById('prog-ring');
      if (ring) { const circ = 2 * Math.PI * 34; ring.style.strokeDasharray = String(circ); ring.style.strokeDashoffset = String(circ * (1 - pct / 100)); }
      document.querySelectorAll('[data-done]').forEach((b) => { const i = b.dataset.done; b.innerHTML = done[i] ? iconSvg('check', 'inline-block h-4 w-4 align-[-0.15em]') + ' Completed' : 'Mark complete'; b.classList.toggle('border-saffron', !!done[i]); });
      // Lesson rail: highlight the next not-yet-completed lesson (decorative
      // nav only — every lesson's real content is already server-rendered
      // above, unaffected by this state).
      const railRows = document.querySelectorAll('[data-rail-row]');
      let nextIdx = -1;
      railRows.forEach((row) => { const i = Number(row.dataset.railRow); if (!done[i] && nextIdx === -1) nextIdx = i; });
      railRows.forEach((row) => {
        const active = Number(row.dataset.railRow) === nextIdx;
        row.classList.toggle('border-saffron', active);
        row.classList.toggle('border-transparent', !active);
        row.classList.toggle('bg-saffron-soft/60', active);
        const idx = row.querySelector('.rail-idx'), title = row.querySelector('.rail-title');
        if (idx) { idx.classList.toggle('text-saffron-deep', active); idx.classList.toggle('text-muted', !active); }
        if (title) { title.classList.toggle('text-navy', active); title.classList.toggle('font-semibold', active); title.classList.toggle('text-muted', !active); }
      });
    }
    document.querySelectorAll('[data-note]').forEach((t) => { const k = 'note_' + id + '_' + t.dataset.note; t.value = get(k, ''); t.addEventListener('input', () => set(k, t.value)); });
    document.querySelectorAll('[data-done]').forEach((b) => b.addEventListener('click', () => { const i = b.dataset.done; done[i] = !done[i]; if (!done[i]) delete done[i]; else recordActivity(); set(doneKey, done); refresh(); push(); }));
    const submit = document.getElementById('quiz-submit');
    // Gated courses own their own quiz-submit wiring (see the gated-content
    // script below) — the real question count isn't known until it loads.
    if (submit && !__d.gated) submit.addEventListener('click', async () => {
      // Collect the chosen option index per question; the SERVER grades it.
      const answers = [];
      for (let i = 0; i < nQuiz; i++) { const s = document.querySelector(`input[name="q${i}"]:checked`); answers.push(s ? +s.value : -1); }
      const r = document.getElementById('quiz-result');
      submit.disabled = true; submit.textContent = 'Submitting…';
      let res;
      try { res = await fetch('/api/quiz', { method: 'POST', credentials: 'same-origin', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ courseId: id, answers }) }).then((x) => x.json()); } catch (e) { res = null; }
      submit.disabled = false; submit.textContent = 'Submit test';
      if (!res || typeof res.score !== 'number') { r.innerHTML = '<div class="rounded-xl border-l-4 border-saffron bg-surface p-3 font-sans text-sm">Could not submit your test — please try again.</div>'; return; }
      const score = res.score, correct = res.correct, total = res.total;
      const wasPassed = get('passed_' + id, 0) >= 80;
      set(scoreKey, Math.max(score, get(scoreKey, 0)));
      if (res.passed) set('passed_' + id, score);
      recordActivity();
      if (res.passed) {
        const cert = res.signedIn ? ` <a class="underline" href="/cert?course=${id}">View your certificate →</a>` : ' <a class="underline" href="/login">Sign in</a> to save this and earn a certificate.';
        r.innerHTML = `<div class="rounded-xl border-l-4 border-ok bg-surface p-3 font-sans text-sm"><strong>Passed — ${score}% (${correct}/${total}).</strong> Course complete.${cert}</div>`;
        if (!wasPassed) celebratePass(score, !!res.signedIn);
      } else r.innerHTML = `<div class="rounded-xl border-l-4 border-saffron bg-surface p-3 font-sans text-sm"><strong>Not yet — ${score}% (${correct}/${total}).</strong> You need 80%. Review the lessons and try again.</div>`;
      r.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
    // Pass celebration overlay — only fires on a NEW pass (never on page load).
    function celebratePass(score, signedIn) {
      const ov = document.getElementById('pass-celebrate'); if (!ov) return;
      const scoreEl = document.getElementById('pass-celebrate-score');
      if (scoreEl) scoreEl.textContent = 'You passed with ' + score + '%.';
      const cert = document.getElementById('pass-celebrate-cert');
      if (cert) { cert.href = signedIn ? '/cert?course=' + id : '/login'; cert.textContent = signedIn ? 'View certificate' : 'Sign in for your certificate'; }
      ov.classList.remove('hidden'); ov.classList.add('flex');
      const panel = document.getElementById('pass-celebrate-panel');
      if (panel) { panel.classList.remove('pop'); void panel.offsetWidth; panel.classList.add('pop'); }
      const close = () => { ov.classList.add('hidden'); ov.classList.remove('flex'); };
      const closeBtn = document.getElementById('pass-celebrate-close');
      if (closeBtn) closeBtn.onclick = close;
      ov.onclick = (e) => { if (e.target === ov || (e.target instanceof Element && e.target.classList.contains('pass-backdrop'))) close(); };
    }
    refresh();

    // --- Flashcards ---
    (function () {
      const __fc = JSON.parse(document.getElementById('course-data').textContent);
      const terms = __fc.terms || [];
      if (!terms.length) return;
      const fcKey = P + 'fc_known_' + id;
      let idx = 0, flipped = false;
      let known = get(fcKey, {});
      const card = document.getElementById('fc-card');
      const front = document.getElementById('fc-front');
      const back = document.getElementById('fc-back');
      const hint = document.getElementById('fc-hint');
      const counter = document.getElementById('fc-counter');
      const progress = document.getElementById('fc-progress');
      if (!card) return;
      function stripHtml(s) { const d = document.createElement('div'); d.innerHTML = s; return d.textContent || d.innerText || s; }
      function renderCard() {
        flipped = false;
        const t = terms[idx];
        front.textContent = stripHtml(t.t);
        back.textContent = t.m;
        back.classList.add('hidden');
        hint.innerHTML = known[idx] ? iconSvg('check', 'inline-block h-3.5 w-3.5 align-[-0.15em]') + ' Learned — click to review' : 'Click to reveal';
        hint.className = known[idx] ? 'mt-4 font-sans text-xs text-ok' : 'mt-4 font-sans text-xs text-muted/60';
        card.classList.toggle('border-ok', !!known[idx]);
        card.classList.toggle('bg-ok/5', !!known[idx]);
        counter.textContent = `${idx + 1} / ${terms.length}`;
        progress.textContent = `${Object.keys(known).length} / ${terms.length} learned`;
      }
      function flip() {
        flipped = !flipped;
        back.classList.toggle('hidden', !flipped);
        hint.innerHTML = flipped ? '' : (known[idx] ? iconSvg('check', 'inline-block h-3.5 w-3.5 align-[-0.15em]') + ' Learned' : 'Click to reveal');
      }
      card.addEventListener('click', flip);
      card.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); flip(); } });
      document.getElementById('fc-prev')?.addEventListener('click', () => { idx = (idx - 1 + terms.length) % terms.length; renderCard(); });
      document.getElementById('fc-next')?.addEventListener('click', () => { idx = (idx + 1) % terms.length; renderCard(); });
      document.getElementById('fc-known')?.addEventListener('click', () => {
        if (known[idx]) { delete known[idx]; } else { known[idx] = true; }
        set(fcKey, known); renderCard();
      });
      document.getElementById('fc-reset')?.addEventListener('click', () => { known = {}; set(fcKey, known); idx = 0; renderCard(); });
      renderCard();
    })();
  </script>

  {c.gated && (
    <script>
