          if (!r.ok || r.d.scope !== 'student') return;
          var section = document.getElementById('assignments');
          var list = r.d.assignments || [];
          if (!list.length) return;
          section.classList.remove('hidden');
          document.getElementById('assign-list').innerHTML = list.map(function (a) {
            var statusLine = a.my_status === 'graded' ? '<span class="pill bg-saffron-soft text-saffron-deep">Graded: ' + esc(a.my_grade) + '/' + esc(a.points) + '</span>'
              : a.my_status === 'submitted' ? '<span class="pill bg-paper text-muted">Submitted' + (a.my_late ? ' (late)' : '') + '</span>'
              : a.status === 'closed' ? '<span class="pill bg-paper text-muted">Closed — no submission</span>'
              : '';
          return '<div class="rounded-lg border border-line bg-surface p-3" data-assignment="' + esc(a.id) + '" data-allow-file="' + (a.allow_file ? '1' : '0') + '" data-closed="' + (a.status === 'closed' ? '1' : '0') + '">' +
              '<div class="flex flex-wrap items-center gap-2"><span class="font-bold text-navy">' + esc(a.title) + '</span>' + (a.due_at ? '<span class="font-sans text-xs text-muted">due ' + esc(new Date(a.due_at).toLocaleDateString()) + '</span>' : '') + statusLine + '</div>' +
              '<p class="mt-1 text-sm text-muted">' + esc(a.instructions) + '</p>' +
              (a.my_status !== 'graded' && a.status !== 'closed' ? (
