    })();

    // Gurbani verse viewer — scan lessons for "Ang N" refs, fetch from banidb, display verified tuks
    (function () {
      var CACHE_KEY = 'su_gbcache_';
      var seen = {}, angs = [];
      document.querySelectorAll('.lesson-prose').forEach(function (el) {
        var text = el.textContent || '';
        var m;
        var re = /\bAng\s+(\d{1,4})/g;
        while ((m = re.exec(text)) !== null) {
          var n = parseInt(m[1]);
          if (n >= 1 && n <= 1430 && !seen[n]) { seen[n] = true; angs.push(n); }
        }
      });
      if (!angs.length) return;
      var section = document.getElementById('gurbani-refs');
      var list = document.getElementById('gurbani-refs-list');
      if (!section || !list) return;
      section.classList.remove('hidden');
      angs.sort(function (a, b) { return a - b; });

      function esc(s) { return String(s || '').replace(/[&<>"]/g, function (c) { return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); }

      function showVerse(ang, container) {
        var cached = sessionStorage.getItem(CACHE_KEY + ang);
        if (cached) { container.innerHTML = cached; return; }
        container.innerHTML = '<span class="font-sans text-xs text-muted">Fetching…</span>';
        fetch('https://api.banidb.com/v2/angs/' + ang + '/SGGS')
          .then(function (r) { return r.ok ? r.json() : null; })
          .then(function (data) {
            if (!data || !data.page || !data.page.length) { container.innerHTML = '<span class="font-sans text-xs text-muted">Verse unavailable.</span>'; return; }
            var html = data.page.slice(0, 3).map(function (v) {
              var gurmukhi = (v.verse && v.verse.unicode) || '';
              var en = (v.translation && v.translation.en && v.translation.en.bdb) || '';
              if (!gurmukhi) return '';
              return '<div class="py-2 border-b border-line last:border-0">'
                + '<p class="gur text-base leading-relaxed text-navy">' + esc(gurmukhi) + '</p>'
                + (en ? '<p class="mt-1 font-sans text-xs italic text-muted leading-snug">' + esc(en) + '</p>' : '')
                + '</div>';
            }).filter(Boolean).join('');
            if (!html) { container.innerHTML = '<span class="font-sans text-xs text-muted">No verses found for this Ang.</span>'; return; }
            sessionStorage.setItem(CACHE_KEY + ang, html);
            container.innerHTML = html;
          })
          .catch(function () { container.innerHTML = '<span class="font-sans text-xs text-muted">Could not load verse.</span>'; });
      }

      angs.forEach(function (ang) {
        var card = document.createElement('div');
        card.className = 'rounded-xl2 border border-line bg-surface p-4';
        var verseDiv = document.createElement('div');
        card.innerHTML = '<div class="flex items-center justify-between gap-2 mb-2">'
          + '<span class="font-sans text-xs font-semibold text-saffron-deep uppercase tracking-wide">Sri Guru Granth Sahib Ji · Ang ' + ang + '</span>'
          + '<button class="btn font-sans text-xs px-3 py-1 show-verse-btn">Show verse</button></div>';
        card.appendChild(verseDiv);
        list.appendChild(card);
        card.querySelector('.show-verse-btn').addEventListener('click', function () {
          this.style.display = 'none';
          showVerse(ang, verseDiv);
        });
      });
    })();

    // Wire each lesson's TOC items to the h4/h3 headings within that same lesson
    document.querySelectorAll('article[id^="lesson-"]').forEach(function (article, lessonIdx) {
      var toc = article.querySelector('.toc ol, .toc ul');
      if (!toc) return;
      var prose = article.querySelector('.lesson-prose');
      if (!prose) return;
      // Collect all block headings inside the lesson prose, excluding any inside .toc itself
      var headings = Array.from(prose.querySelectorAll('h2,h3,h4,h5')).filter(function (h) {
        return !h.closest('.toc');
      });
      var items = toc.querySelectorAll('li');
      items.forEach(function (li, i) {
        var heading = headings[i];
        var id, href;
        if (heading) {
          id = 'l' + lessonIdx + '-s' + i;
          heading.id = id;
          href = '#' + id;
        } else {
          href = '#lesson-' + lessonIdx;
        }
        var a = document.createElement('a');
        a.href = href;
        a.style.cssText = 'color:inherit;text-decoration:underline;cursor:pointer;';
        a.innerHTML = li.innerHTML;
        li.innerHTML = '';
        li.appendChild(a);
      });
    });
  </script>

  <script>
    // "From the Granth" panel: pages through the course's granthRef ang range,
    // verbatim from the local corpus; each line opens the line-study drawer
    // (published BaniDB translations + ਅਰਥ — see lib/line-study).
    import { openLineStudy } from '../../lib/line-study';
    (function () {
      var panel = document.getElementById('granth-panel');
      if (!panel) return;
      var src = panel.dataset.granthSrc;
      var start = parseInt(panel.dataset.granthStart, 10), end = parseInt(panel.dataset.granthEnd, 10);
      var linesEl = document.getElementById('gp-lines'), angEl = document.getElementById('gp-ang');
      var prev = document.getElementById('gp-prev'), next = document.getElementById('gp-next');
      var ang = start;
      function draw() {
        angEl.textContent = 'Ang ' + ang;
        prev.disabled = ang <= start; next.disabled = ang >= end;
        prev.style.opacity = prev.disabled ? '.4' : ''; next.style.opacity = next.disabled ? '.4' : '';
        linesEl.innerHTML = '<p class="font-sans text-sm text-muted">Loading…</p>';
        fetch('/assets/gurbani/' + src + '/' + ang + '.json')
          .then(function (r) { return r.json(); })
          .then(function (d) {
            linesEl.innerHTML = '';
            (d.lines || []).forEach(function (line) {
              var b = document.createElement('button');
              b.type = 'button';
              b.className = 'block w-full rounded-lg px-2 py-1 text-left hover:bg-saffron-soft/40';
              b.textContent = line;
              b.addEventListener('click', function () { openLineStudy(src, ang, line); });
              linesEl.appendChild(b);
            });
            if (!linesEl.children.length) linesEl.innerHTML = '<p class="font-sans text-sm text-muted">This Ang could not be loaded.</p>';
          })
          .catch(function () { linesEl.innerHTML = '<p class="font-sans text-sm text-muted">This Ang could not be loaded.</p>'; });
      }
      prev.addEventListener('click', function () { if (ang > start) { ang--; draw(); } });
      next.addEventListener('click', function () { if (ang < end) { ang++; draw(); } });
      draw();
    })();

    // Parallel-text panel (Panj Granthavali study courses): page-aligned
    // Gurmukhi ⇄ English exported from the SikhLibrary dataset by
    // scripts/export_parallel_texts.py. Hidden until the export is committed.
    (function () {
      var panel = document.getElementById('parallel-panel');
      if (!panel) return;
      var cd = document.getElementById('course-data');
      var courseId; try { courseId = JSON.parse(cd.textContent).id; } catch (e) { return; }
      fetch('/assets/parallel/' + courseId + '.json')
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (d) {
          if (!d || !d.pages || !d.pages.length) return;
          panel.classList.remove('hidden');
          var i = 0, gur = document.getElementById('pp-gur'), en = document.getElementById('pp-en');
          var pageEl = document.getElementById('pp-page'), prev = document.getElementById('pp-prev'), next = document.getElementById('pp-next');
          function draw() {
            var p = d.pages[i];
            pageEl.textContent = 'Page ' + p.n + ' · ' + (i + 1) + '/' + d.pages.length;
            gur.textContent = p.gur || '';
            en.textContent = p.en || '';
            prev.disabled = i === 0; next.disabled = i === d.pages.length - 1;
            prev.style.opacity = prev.disabled ? '.4' : ''; next.style.opacity = next.disabled ? '.4' : '';
          }
          prev.addEventListener('click', function () { if (i > 0) { i--; draw(); } });
          next.addEventListener('click', function () { if (i < d.pages.length - 1) { i++; draw(); } });
          draw();
        })
        .catch(function () {});
    })();
  </script>

  <script>
    // Reading-progress indicator: a slim saffron bar under the nav that tracks
    // scroll depth. rAF-throttled; no CSS transition, so it stays exact under
    // prefers-reduced-motion (a progress indicator may update, per the brief).
    (function () {
      var bar = document.getElementById('read-progress');
      if (!bar) return;
      // Re-home the bar on <body>: it renders inside <main>, whose entry
      // animation transforms it into a containing block, which would briefly
      // mis-anchor a fixed descendant.
      document.body.appendChild(bar);
      var nav = document.querySelector('nav');
      var place = function () { bar.style.top = (nav ? nav.offsetHeight : 0) + 'px'; };
      var ticking = false;
      var update = function () {
        var max = document.documentElement.scrollHeight - window.innerHeight;
        var pct = max > 0 ? (window.scrollY / max) * 100 : 0;
        bar.style.width = Math.max(0, Math.min(100, pct)) + '%';
        ticking = false;
      };
      window.addEventListener('scroll', function () { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
      window.addEventListener('resize', function () { place(); update(); });
      place(); update();
    })();
  </script>
</Base>
