---
import Base from '../layouts/Base.astro';
import { professorList, profBio, profSlug, professorPhotos, profInitials, avatarColor, topicName } from '../lib/data';
const list = professorList().sort((a, b) => a.name.localeCompare(b.name));

// Real specialty tag line, derived from the topics of the professor's own
// published courses — never invented. Capped at 3 so a prolific scholar
// (dozens of courses) doesn't produce a run-on label.
function specialtyFor(courses: { topic: string }[]): string {
  const seen = new Set<string>();
  const names: string[] = [];
  for (const c of courses) {
    const n = topicName(c.topic);
    if (seen.has(n)) continue;
    seen.add(n);
    names.push(n);
    if (names.length >= 3) break;
  }
  return names.join(' · ');
}

// The footnote is only shown if the real data actually carries a photo
// credit — never invent an attribution the source file doesn't have.
const anyCredited = list.some(({ name }) => professorPhotos[name]?.credit);
const anyUncredited = list.some(({ name }) => !professorPhotos[name]?.img);
---
<Base title="Our professors — Sikhi University" description="The Sikh scholars and writers whose works anchor Sikhi University's courses." ambient="study">
  <section class="wrap py-12">
    <div class="border border-line bg-paper px-6 py-9 sm:px-8 sm:py-11">
      <div class="flex flex-wrap items-end justify-between gap-6 rule-navy pb-4">
        <div class="min-w-0 flex-1 basis-[380px]">
          <p class="eyebrow flex items-center gap-2.5 text-saffron-deep">
            <span aria-hidden="true" class="inline-block h-px w-6 bg-current opacity-50"></span>
            <span data-i18n="profs.eyebrow">Faculty · Sikhi University</span>
          </p>
          <h1 class="text-display-sm mt-3 text-navy" data-i18n="profs.h1">Our professors</h1>
        </div>
        <div class="stat-mono shrink-0 pb-1">
          <span>{list.length}</span>
          <span data-i18n="profs.stat">Scholars</span>
        </div>
      </div>
      <p class="mt-4 max-w-2xl text-lg text-muted" data-i18n="profs.sub">Sikhi University courses are built on the works of leading Sikh scholars and writers. Each course is taught in the voice of, or drawn from, its author.</p>

      <div class="mt-6 columns-1 gap-x-11 md:columns-2">
        {list.map(({ name, courses }) => {
          const photo = professorPhotos[name];
          const specialty = specialtyFor(courses);
          return (
            <a href={`/professor/${profSlug(name)}`} class="row-ruled block [break-inside:avoid-column] hover:bg-surface">
              {photo && photo.img ? (
                <img src={`/${photo.img}`} width="52" height="52" loading="lazy" alt="" style="object-position:center top"
                  class="h-[52px] w-[52px] shrink-0 rounded-full border border-line bg-line object-cover" />
              ) : (
                <span aria-hidden="true" class="flex h-[52px] w-[52px] shrink-0 items-center justify-center rounded-full font-mono text-sm text-paper" style={`background:${avatarColor(name)}`}>{profInitials(name)}</span>
              )}
              <span class="min-w-0">
                <span class="block text-base font-semibold leading-tight text-navy" data-no-i18n>{name}</span>
                {specialty && <span class="mt-0.5 block font-mono text-[10.5px] uppercase tracking-[.1em] text-muted" data-no-i18n>{specialty}</span>}
              </span>
            </a>
          );
        })}
      </div>

      {(anyCredited || anyUncredited) && (
        <p class="mt-6 max-w-[86ch] font-mono text-[11px] leading-[1.75] text-muted" data-i18n="profs.creditNote">Portraits: Wikimedia Commons, public domain unless credited otherwise on the scholar's page. Scholars with no archived portrait show initials instead.</p>
      )}
    </div>
  </section>
</Base>
