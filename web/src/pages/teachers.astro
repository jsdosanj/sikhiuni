---
import Base from '../layouts/Base.astro';
import { professorList } from '../lib/data';
// Real count — never hardcoded — of the historical/authorial scholars listed
// on the faculty page, referenced honestly in section II below.
const scholarCount = professorList().length;
---
<Base title="Our teachers — Sikhi University" description="Meet the living teachers of Sikhi University — verified educators sharing Gurbani, Gurmat, history and more." ambient="hall">
  <section class="wrap py-12">
    <div class="border border-line bg-paper px-6 py-9 sm:px-8 sm:py-11">
      <p class="eyebrow flex items-center gap-2.5 text-saffron-deep">
        <span aria-hidden="true" class="inline-block h-px w-6 bg-current opacity-50"></span>
        <span data-i18n="teachers.eyebrow">Teaching</span>
      </p>
      <h1 class="text-display-sm mt-3 text-navy" data-i18n="teachers.h1">Who teaches here</h1>
      <p class="mt-4 max-w-[66ch] text-lg leading-[1.62] text-muted" data-i18n="teachers.intro">Two different things wear the word "teacher" on this site. Historical scholars are attributed — their published work is the source of a course. Contemporary teachers are people who actually teach, review and answer.</p>

      <div class="mt-8 flex items-baseline gap-3 rule-navy pb-2">
        <span class="font-mono text-[11px] text-saffron-deep">I</span>
        <h2 class="text-[22px] font-bold leading-[1.15] tracking-[-.026em] text-navy" data-i18n="teachers.sectionLiving">Contemporary teachers</h2>
      </div>
      <div id="teachers-grid" class="mt-1">
        <p class="row-ruled font-sans text-sm text-muted" data-i18n="teachers.empty">No public teacher profiles yet.</p>
      </div>

      <div class="mt-8 flex items-baseline gap-3 rule-navy pb-2">
        <span class="font-mono text-[11px] text-saffron-deep">II</span>
        <h2 class="text-[22px] font-bold leading-[1.15] tracking-[-.026em] text-navy" data-i18n="teachers.sectionAttributed">Attributed scholars</h2>
      </div>
      <p class="mt-3.5 max-w-[74ch] text-base leading-[1.65] text-ink">
        <span data-no-i18n>{scholarCount}</span>{' '}<span data-i18n="teachers.attributedIntro">historical scholars are listed on the</span>{' '}
        <a href="/professors" class="underline hover:text-saffron-deep" data-i18n="teachers.attributedFacultyLink">faculty page</a>.{' '}
        <span data-i18n="teachers.attributedNote">Their work is the source of the courses attributed to them; they are not living instructors.</span>
      </p>

      <div class="mt-6 max-w-[78ch] border border-line border-l-[3px] border-l-saffron-deep bg-surface px-6 py-5">
        <p class="eyebrow text-saffron-deep" data-i18n="teachers.partnerLabel">Partner</p>
        <p class="mt-2.5 text-[15.5px] leading-[1.62] text-muted" data-i18n="teachers.partnerNote">The Sikh Archive (sikharchive.net) is a digital library and educational partner. Its free foundational and AI courses are shared here, credited to it rather than to an individual.</p>
      </div>
    </div>
  </section>
  <script>
    import { iconSvg } from '../lib/icons';
    const esc = (s: unknown) => String(s == null ? '' : s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));
    function badge(level: string) {
      if (level === 'scholar') return `<span class="chip-status text-saffron-deep border-saffron-deep gap-1">${iconSvg('shield', 'h-3 w-3')} Scholar</span>`;
      if (level === 'identity') return `<span class="chip-status text-ok border-ok gap-1">${iconSvg('check', 'h-3 w-3')} Verified</span>`;
      return '';
    }
    fetch('/api/teachers').then((r) => r.json()).then(({ teachers }) => {
      const grid = document.getElementById('teachers-grid')!;
      if (!teachers || !teachers.length) return; // real static empty-state already in the markup
      grid.innerHTML = teachers.map((t: any) => `
        <a href="/teacher/${esc(t.slug)}" class="row-ruled block hover:bg-surface">
          ${t.photoUrl ? `<img src="${esc(t.photoUrl)}" width="52" height="52" loading="lazy" alt="" class="h-[52px] w-[52px] shrink-0 rounded-full border border-line object-cover" />` : ''}
          <span class="min-w-0 flex-1 text-[16.5px] font-semibold leading-tight text-navy">${esc(t.displayName)}</span>
          ${badge(t.verificationLevel)}
          ${t.areas && t.areas.length ? `<span class="flex-1 basis-[250px] text-[14.5px] leading-[1.55] text-muted">${esc(t.areas.slice(0, 3).join(', '))}</span>` : ''}
        </a>`).join('');
    }).catch(() => {
      // real static empty-state stays in place — an honest "nothing to show"
      // beats a fabricated error banner most visitors will never see anyway.
    });
  </script>
</Base>
