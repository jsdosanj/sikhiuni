---
import Base from '../layouts/Base.astro';
---
<!-- Redesign task 17 (isadmin, prototype lines 695-737 + 880-905). This is
     the REAL admin.astro (12-tab admin dashboard, cluster D). Restyled to
     the ledger system: rule-navy/eyebrow header, `.stat-mono` overview
     tiles fed by the real /api/admin/stats totals, `.chip-status` in
     place of the old `.pill`, and mono-labelled ruled table headers
     (matching review.astro's task-16 precedent) across every tab. The
     prototype's "Blocking publication — Gurbani gate" card and its
     "Build gates" ledger (Gurbani corpus verification, font-licence
     audit, etc, each PASS/WARN/FAIL) describe a CI/deploy-time gate
     report this app has no API for -- there is no live "build failing"
     count or per-gate PASS/FAIL feed anywhere in this admin surface
     (course_drafts has no build-status column; those checks run as CI
     scripts at build time, not exposed to this dashboard) -- so, per
     this same task's "every row from real
     data/API, none from the prototype's examples" rule, that card and
     ledger are NOT added. The prototype's real-data-backed "Roles"
     ledger IS added to the Teachers tab, computed live from the same
     /api/admin/users response that tab already fetches (real counts,
     ACTIVE/NONE chip on whether each role is populated -- never the
     prototype's invented headcounts). This page had zero data-i18n
     keys before this pass (internal admin tool) -- none added.
     Protected hooks (untouched): #admin, #tabs, #panel, and every
     #au-*/#c-*/#gb-*/#t-*/#user-*/#users-body/#users-table id plus every
     data-approve-profile/data-archive-*/data-c/data-claim*/data-d/
     data-decide/data-draft/data-id/data-key/data-mark-*/data-mfa-reset/
     data-msg/data-profile/data-report-action/data-reviewer-toggle/
     data-set/data-u/data-unassign/data-user/data-verify attribute. -->
<Base title="Admin — Sikhi University" description="Sikhi University admin dashboard." ambient="none" noindex={true}>
  <section class="wrap py-12">
    <div class="rule-navy pb-4">
      <p class="eyebrow text-saffron-deep">Administration</p>
      <h1 class="text-display-sm mt-2.5 font-bold text-navy">Admin dashboard</h1>
    </div>
    <div id="admin" class="mt-6"><p class="text-muted">Loading…</p></div>
  </section>
  <script>
    import { iconSvg } from '../lib/icons';
    import { PROF_BIOS } from '../lib/prof-bios';
    const esc = (s) => String(s == null ? '' : s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    const slugToTitle = (id) => String(id || '').replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
    const ctitle = (id, courses) => { const c = (courses || []).find((x) => x.id === id); return c ? c.title : slugToTitle(id); };
    const api = (p, o = {}) => fetch(p, { credentials: 'same-origin', headers: { 'content-type': 'application/json' }, ...o }).then((r) => r.json().then((d) => ({ ok: r.ok, d })).catch(() => ({ ok: r.ok, d: {} })));
    const fmt = (ts) => { try { return new Date(ts).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' }); } catch { return ''; } };
    const grade = (s) => s >= 90 ? 'A' : s >= 80 ? 'B' : s >= 70 ? 'C' : s >= 60 ? 'D' : 'F';
    const root = document.getElementById('admin');
    let courses = [], topics = [], programs = [];

    api('/api/me').then(({ ok, d }) => {
      const u = ok && d.user;
      if (!u || u.role !== 'admin') { root.innerHTML = '<div class="rounded-xl border-l-4 border-saffron bg-surface p-4">Admins only. <a class="underline" href="/login">Sign in</a> with an admin account.</div>'; return; }
      if (u.mfa && u.mfa.required && !u.mfa.enrolled) {
        root.innerHTML = '<div class="rounded-xl border-l-4 border-saffron bg-surface p-4">Two-factor authentication is required for admin accounts. <a class="underline font-semibold" href="/mfa">Set it up now →</a></div>';
        return;
      }
      if (u.mfa && u.mfa.enrolled && u.mfa_ok !== 1) {
        root.innerHTML = '<div class="rounded-xl border-l-4 border-saffron bg-surface p-4">This session hasn\'t verified your two-factor code yet. <a class="underline font-semibold" href="/mfa">Verify now →</a></div>';
        return;
      }
      root.innerHTML = `<p class="font-sans text-sm text-muted">Signed in as ${esc(u.email)}</p>
        <div id="tabs" class="mt-4 flex flex-wrap gap-1 border-b border-line"></div><div id="panel" class="mt-6"></div>`;
      const tabs = [['overview', 'Overview'], ['users', 'Users'], ['gradebook', 'Gradebook'], ['teachers', 'Teachers'], ['profiles', 'Profiles'], ['review', 'Review'], ['uploads', 'Uploads'], ['moderation', 'Moderation'], ['courses', 'Courses'], ['applications', 'Applications'], ['feedback', 'Feedback'], ['audit', 'Audit log']];
      let cur = 'overview';
      const tabsEl = document.getElementById('tabs'); const panel = document.getElementById('panel');
      tabs.forEach(([k, label]) => { const b = document.createElement('button'); b.textContent = label; b.dataset.k = k; b.className = 'px-4 py-2 font-sans text-sm border-b-2 border-transparent text-muted'; b.onclick = () => { cur = k; draw(); }; tabsEl.appendChild(b); });
      function setActive() { Array.from(tabsEl.children).forEach((b) => { const on = b.dataset.k === cur; b.classList.toggle('border-saffron', on); b.classList.toggle('text-navy', on); b.classList.toggle('font-semibold', on); }); }
      function draw() { setActive(); panel.innerHTML = '<p class="text-muted">Loading…</p>'; ({ overview, users, gradebook, teachers, profiles, review, uploads, moderation, courses: coursesTab, applications, feedback, audit })[cur](); }

      // ── Gradebook ──────────────────────────────────────────────────────────
      function gradebook() {
        Promise.all([api('/api/gradebook'), Promise.resolve(programs)]).then(([{ ok, d }]) => {
          if (!ok) { panel.innerHTML = '<div class="rounded-xl bg-surface p-4">Could not load the gradebook.</div>'; return; }
          const rows = d.rows || [], cids = d.courses || [];
          const lc = (id) => { const c = courses.find((x) => x.id === id); return c ? (c.nLessons || 0) : 0; };
          if (!rows.length) { panel.innerHTML = '<div class="rounded-xl bg-surface p-4 text-muted">No enrolments yet.</div>'; return; }

          // Build program options
          const progOpts = programs.map((p) => `<option value="${esc(p.id)}">${esc(p.abbreviation || p.title)}</option>`).join('');

          let html = `<div class="mb-4 flex flex-wrap items-end gap-3">
            <p class="font-sans text-sm text-muted grow">${rows.length} enrolment record(s) across ${cids.length} course(s).</p>
            <div class="flex flex-wrap gap-2">
              <input id="gb-search" type="search" placeholder="Filter by student…" class="rounded-lg border border-line bg-paper px-3 py-1.5 font-sans text-xs w-44" />
              <select id="gb-prog" class="rounded-lg border border-line bg-paper px-2 py-1.5 font-sans text-xs">
                <option value="">All programs</option>${progOpts}
              </select>
              <select id="gb-sort" class="rounded-lg border border-line bg-paper px-2 py-1.5 font-sans text-xs">
                <option value="name">Sort: Course A→Z</option>
                <option value="learners">Sort: Learners ↓</option>
                <option value="avg">Sort: Avg score ↓</option>
                <option value="pass">Sort: Pass rate ↓</option>
              </select>
              <a class="btn font-sans text-xs px-3 py-1.5" href="/api/gradebook?format=csv">${iconSvg('download', 'h-3.5 w-3.5')} Export CSV</a>
            </div>
          </div><div id="gb-body"></div>`;
          panel.innerHTML = html;

          function renderGradebook() {
            const search = (document.getElementById('gb-search') || {}).value || '';
            const progId = (document.getElementById('gb-prog') || {}).value || '';
            const sortBy = (document.getElementById('gb-sort') || {}).value || 'name';
            const q = search.toLowerCase();

            let filteredCids = cids;
            if (progId) {
              const prog = programs.find((p) => p.id === progId);
              if (prog) filteredCids = filteredCids.filter((cid) => prog.courseIds.includes(cid));
            }

            let courseData = filteredCids.map((cid) => {
              const cr = rows.filter((r) => r.course_id === cid);
              const filtered = q ? cr.filter((r) => (r.name || r.email || '').toLowerCase().includes(q)) : cr;
              const cs = cr.filter((r) => r.score != null);
              const cavg = cs.length ? Math.round(cs.reduce((a, r) => a + r.score, 0) / cs.length) : 0;
              const pass = cr.length ? Math.round(cr.filter((r) => r.score != null && r.score >= 80).length / cr.length * 100) : 0;
              return { cid, cr, filtered, cavg, pass };
            }).filter((x) => x.filtered.length > 0 || !q);

            if (sortBy === 'learners') courseData.sort((a, b) => b.cr.length - a.cr.length);
            else if (sortBy === 'avg') courseData.sort((a, b) => b.cavg - a.cavg);
            else if (sortBy === 'pass') courseData.sort((a, b) => b.pass - a.pass);
            else courseData.sort((a, b) => ctitle(a.cid, courses).localeCompare(ctitle(b.cid, courses)));

            const body = document.getElementById('gb-body');
            if (!body) return;
            body.innerHTML = courseData.map(({ cid, cr, filtered, cavg, pass }) => {
              const l = lc(cid);
              const displayRows = q ? filtered : cr;
              const rows_html = displayRows.sort((a, b) => (b.score == null ? -1 : b.score) - (a.score == null ? -1 : a.score)).map((r) => {
                const pct = l ? Math.round(r.done / l * 100) : 0;
                return `<tr class="border-t border-line"><td class="py-1">${esc(r.name || r.email)}${r.override ? ' <span title="Overridden" class="inline-flex align-[-0.15em] text-saffron-deep">' + iconSvg('edit', 'h-3.5 w-3.5') + '</span>' : ''}</td><td>${pct}%</td><td>${r.score != null ? r.score + '%' : '—'}</td><td>${r.score != null ? grade(r.score) : '—'}</td></tr>`;
              }).join('');
              return `<details class="mt-3 rounded-xl2 border border-line bg-surface p-3">
                <summary class="cursor-pointer font-semibold text-navy select-none">${esc(ctitle(cid, courses))} <span class="font-sans text-xs font-normal text-muted">· ${cr.length} learners · avg ${cavg}% · ${pass}% passed</span></summary>
                <div class="mt-3 overflow-x-auto"><table class="w-full font-sans text-sm"><thead><tr class="thead-ledger"><th class="py-1">Student</th><th>Progress</th><th>Score</th><th>Grade</th></tr></thead><tbody>${rows_html}</tbody></table></div>
              </details>`;
            }).join('');
          }

          renderGradebook();
          ['gb-search', 'gb-prog', 'gb-sort'].forEach((id) => {
            const el = document.getElementById(id);
            if (el) el.addEventListener('input', renderGradebook);
            if (el) el.addEventListener('change', renderGradebook);
          });
        });
      }

      // ── Teachers ───────────────────────────────────────────────────────────
      function teachers() {
        Promise.all([api('/api/admin/course-teachers'), api('/api/admin/users'), api('/api/admin/teacher-profiles')]).then(([a, u, tp]) => {
          const assigns = (a.ok && a.d.assignments) || [], usersList = (u.ok && u.d.users) || [];
          const profilesByUser = {}; ((tp.ok && tp.d.all) || []).forEach((p) => { profilesByUser[p.user_id] = p; });
          const courseOpts = courses.filter((c) => c.status === 'published').slice().sort((x, y) => x.title.localeCompare(y.title)).map((c) => `<option value="${esc(c.id)}">${esc(c.title)}</option>`).join('');
          const userOpts = usersList.map((x) => `<option value="${esc(x.id)}">${esc(x.email)} (${esc(x.role)})</option>`).join('');

          // Roles ledger -- real counts from the same /api/admin/users
          // response above, never the prototype's invented headcounts.
          const roleCount = (r) => usersList.filter((x) => x.role === r).length;
          const roleChip = (n) => `<span class="chip-status ${n > 0 ? 'border-ok text-ok' : 'border-muted text-muted'}">${n > 0 ? 'ACTIVE' : 'NONE'}</span>`;
          const roleRow = (label, n) => `<div class="row-ruled"><span class="min-w-0 flex-1 text-sm text-ink">${label}</span><span class="font-mono text-xs text-navy">${n}</span><span class="w-20 shrink-0 text-right">${roleChip(n)}</span></div>`;
          let html = `<p class="eyebrow text-saffron-deep">Roles</p>
            <div class="rule-navy">${roleRow('Administrators', roleCount('admin'))}${roleRow('Teachers', roleCount('teacher'))}</div>
            <p class="mt-8 font-sans text-sm text-muted">Assign a teacher to a course.</p>
            <div class="mt-4 flex flex-wrap items-end gap-3 rounded-xl2 border border-line bg-surface p-4">
              <label class="font-sans text-sm">Teacher<br><select id="t-user" class="mt-1 rounded-lg border border-line bg-paper px-2 py-1.5">${userOpts || '<option value="">No eligible users</option>'}</select></label>
              <label class="font-sans text-sm">Course<br><select id="t-course" class="mt-1 rounded-lg border border-line bg-paper px-2 py-1.5">${courseOpts}</select></label>
              <button id="t-assign" class="btn btn-primary">Assign</button>
            </div>
            <h3 class="mt-8 text-lg font-bold">Current assignments (${assigns.length})</h3>`;
          if (!assigns.length) html += '<div class="mt-2 rounded-xl bg-surface p-4 text-muted">No teachers assigned yet.</div>';
          else {
            const byTeacher = {};
            assigns.forEach((x) => { if (!byTeacher[x.email]) byTeacher[x.email] = []; byTeacher[x.email].push(x); });
            html += `<div class="mt-3 grid gap-4 sm:grid-cols-2">${Object.entries(byTeacher).map(([email, ass]) => `<div class="rounded-xl2 border border-line bg-surface p-4"><div class="font-semibold text-navy">${esc(email)}</div><div class="font-sans text-xs text-muted mt-0.5">${ass.length} course${ass.length !== 1 ? 's' : ''} assigned</div><ul class="mt-2 divide-y divide-line">${ass.map((x) => `<li class="py-1 flex items-center justify-between"><span class="text-sm">${esc(ctitle(x.course_id, courses))}</span><button class="rounded border border-line px-2 py-0.5 font-sans text-xs hover:border-saffron" data-unassign data-c="${esc(x.course_id)}" data-u="${esc(x.user_id)}">Unassign</button></li>`).join('')}</ul></div>`).join('')}</div>`;
          }

          const nonLearners = usersList.filter((x) => x.role !== 'learner');
          html += `<h3 class="mt-10 text-lg font-bold">Teacher &amp; admin controls</h3>
            <p class="font-sans text-sm text-muted">Verification level, MFA reset, and reviewer-flag grants.</p>
            <div class="mt-3 overflow-x-auto"><table class="w-full font-sans text-sm"><thead><tr class="thead-ledger"><th class="py-1">User</th><th>Verification</th><th>Reviewer</th><th>MFA</th></tr></thead><tbody>
            ${nonLearners.map((x) => {
              const p = profilesByUser[x.id];
              const level = (p && p.verification_level) || 'none';
              return `<tr class="border-t border-line align-middle" data-user="${esc(x.id)}">
                <td class="py-2">${esc(x.name || x.email)}<div class="font-sans text-xs text-muted">${esc(x.email)}</div></td>
                <td><select class="rounded-lg border border-line bg-paper px-2 py-1 font-sans text-xs" data-verify>
                  <option value="none" ${level === 'none' ? 'selected' : ''}>None</option>
                  <option value="identity" ${level === 'identity' ? 'selected' : ''}>Identity-verified</option>
                  <option value="scholar" ${level === 'scholar' ? 'selected' : ''}>Scholar-verified</option>
                </select> ${p ? '' : '<div class="font-sans text-xs text-muted">(no profile yet)</div>'}</td>
                <td><button class="rounded border border-line px-2 py-0.5 font-sans text-xs hover:border-saffron" data-reviewer-toggle>Grant/Revoke</button></td>
                <td><button class="rounded border border-line px-2 py-0.5 font-sans text-xs hover:border-saffron" data-mfa-reset>Reset MFA</button></td>
              </tr>`;
            }).join('')}
            </tbody></table></div>`;

          panel.innerHTML = html;
          const ab = document.getElementById('t-assign');
          if (ab) ab.addEventListener('click', () => { const userId = document.getElementById('t-user').value; const courseId = document.getElementById('t-course').value; if (!userId || !courseId) return; api('/api/admin/course-teachers', { method: 'POST', body: JSON.stringify({ userId, courseId, action: 'assign' }) }).then(({ ok }) => { if (ok) draw(); }); });
          panel.querySelectorAll('[data-unassign]').forEach((b) => b.addEventListener('click', () => { api('/api/admin/course-teachers', { method: 'POST', body: JSON.stringify({ courseId: b.dataset.c, userId: b.dataset.u, action: 'unassign' }) }).then(({ ok }) => { if (ok) draw(); }); }));
          panel.querySelectorAll('[data-verify]').forEach((sel) => sel.addEventListener('change', () => {
            const userId = sel.closest('[data-user]').dataset.user;
            api('/api/admin/teacher-profiles', { method: 'POST', body: JSON.stringify({ userId, action: 'set_verification', level: sel.value }) })
              .then(({ ok }) => window.suToast(ok ? 'Verification updated.' : 'Could not update — does this user have a profile yet?', ok ? 'ok' : 'error'));
          }));
          panel.querySelectorAll('[data-reviewer-toggle]').forEach((b) => b.addEventListener('click', async () => {
            const userId = b.closest('[data-user]').dataset.user;
            const action = confirm('OK = grant reviewer, Cancel = revoke reviewer') ? 'grant' : 'revoke';
            const r = await api('/api/admin/users', { method: 'POST', body: JSON.stringify({ id: userId, flag: 'reviewer', action }) });
            window.suToast(!r.ok ? 'Could not update reviewer flag.' : `Reviewer flag ${action}ed.`, !r.ok ? 'error' : 'ok');
          }));
          panel.querySelectorAll('[data-mfa-reset]').forEach((b) => b.addEventListener('click', () => {
            const userId = b.closest('[data-user]').dataset.user;
            if (!confirm('Reset MFA for this user? They will need to re-enroll.')) return;
            api('/api/admin/users', { method: 'POST', body: JSON.stringify({ id: userId, action: 'mfa_reset' }) })
              .then(({ ok }) => window.suToast(ok ? 'MFA reset.' : 'Could not reset MFA.', ok ? 'ok' : 'error'));
          }));
        });
      }

      // ── Profiles ───────────────────────────────────────────────────────────
      function profiles() {
        Promise.all([
          api('/api/admin/teacher-profiles'),
          api('/api/admin/claims'),
          api('/api/admin/events?action=teacher_profile_update&sort=ts_desc&limit=10'),
        ]).then(([tp, cl, ev]) => {
          const pending = (tp.ok && tp.d.pending) || [];
          const claims = (cl.ok && cl.d.claims) || [];
          const edits = (ev.ok && ev.d.events) || [];
          panel.innerHTML = `
            <h3 class="text-lg font-bold">Publish-approval queue (${pending.length})</h3>
            ${pending.length ? pending.map((p) => `<div class="mt-3 rounded-xl2 border border-line bg-surface p-4" data-profile="${esc(p.user_id)}"><div class="font-semibold text-navy">${esc(p.display_name)}</div><div class="font-sans text-xs text-muted">${esc(p.email)} · slug: ${esc(p.slug)}</div><p class="mt-1 text-sm">${esc(p.bio || '')}</p><button class="btn btn-primary mt-2 font-sans text-xs" data-approve-profile>Approve &amp; publish</button></div>`).join('') : '<div class="mt-2 rounded-xl bg-surface p-4 text-muted">No pending profile-publish requests.</div>'}
            <h3 class="mt-8 text-lg font-bold">Pending professor claims (${claims.length})</h3>
            ${claims.length ? claims.map((c) => {
              const bio = PROF_BIOS[c.professor_name] || '';
              return `<div class="mt-3 rounded-xl2 border border-line bg-surface p-4" data-claim="${esc(c.id)}">
                <div class="font-semibold text-navy">${esc(c.professor_name)}</div>
                <div class="font-sans text-xs text-muted">claimed by ${esc(c.name || c.email)}</div>
                <div class="mt-2 grid gap-3 sm:grid-cols-2">
                  <div class="rounded-xl border border-line bg-paper p-3"><div class="font-sans text-xs font-semibold text-muted">Claimant's statement</div><p class="mt-1 text-sm">${esc(c.statement || '')}</p></div>
                  <div class="rounded-xl border border-line bg-paper p-3"><div class="font-sans text-xs font-semibold text-muted">Existing PROF_BIOS entry</div><p class="mt-1 text-sm">${bio ? esc(bio) : '<span class="text-muted">No existing bio on file for this exact professor string — check for a name mismatch.</span>'}</p></div>
                </div>
                <div class="mt-2 flex gap-2"><button class="btn btn-primary font-sans text-xs" data-claim-decide="approve">Approve</button><button class="btn font-sans text-xs" data-claim-decide="deny">Deny</button></div>
              </div>`;
            }).join('') : '<div class="mt-2 rounded-xl bg-surface p-4 text-muted">No pending claims.</div>'}
            <h3 class="mt-8 text-lg font-bold">Recent profile edits</h3>
            ${edits.length ? `<div class="mt-2 overflow-x-auto"><table class="w-full font-sans text-sm"><thead><tr class="thead-ledger"><th class="py-1">When</th><th>Teacher</th><th>Detail</th></tr></thead><tbody>${edits.map((e) => `<tr class="border-t border-line"><td class="py-1 whitespace-nowrap">${fmt(e.ts)}</td><td>${esc(e.email || e.user_id || '—')}</td><td>${esc(e.detail || '')}</td></tr>`).join('')}</tbody></table></div>` : '<div class="mt-2 rounded-xl bg-surface p-4 text-muted">No profile edits yet.</div>'}`;

          panel.querySelectorAll('[data-approve-profile]').forEach((b) => b.addEventListener('click', () => {
            const userId = b.closest('[data-profile]').dataset.profile;
            api('/api/admin/teacher-profiles', { method: 'POST', body: JSON.stringify({ userId, action: 'approve_publish' }) }).then(({ ok }) => { if (ok) draw(); else window.suToast('Could not publish.', 'error'); });
          }));
          panel.querySelectorAll('[data-claim-decide]').forEach((b) => b.addEventListener('click', () => {
            const id = b.closest('[data-claim]').dataset.claim;
            api('/api/admin/claims', { method: 'POST', body: JSON.stringify({ id, decision: b.dataset.claimDecide }) }).then(({ ok, d }) => { if (ok) draw(); else window.suToast(d.error || 'Could not decide claim.', 'error'); });
          }));
        });
      }

      // ── Review ─────────────────────────────────────────────────────────────
      function review() {
        Promise.all([
          api('/api/review/queue'),
          api('/api/admin/drafts-export?status=approved&limit=200'),
          api('/api/review/queue?history=1'),
          api('/api/admin/archive-requests'),
          api('/api/admin/archive-requests?status=approved'),
        ]).then(([q, ap, hist, arPending, arApproved]) => {
          const queue = (q.ok && q.d.drafts) || [];
          const approved = (ap.ok && ap.d.courses) || [];
          const history = (hist.ok && hist.d.drafts) || [];
          const archivePending = (arPending.ok && arPending.d.requests) || [];
          const archiveApproved = (arApproved.ok && arApproved.d.requests) || [];
          const statusPill = (s) => `<span class="chip-status ${s === 'approved' || s === 'published' ? 'border-ok text-ok' : 'border-navy text-navy'}">${esc(s.replace('_', ' '))}</span>`;
          panel.innerHTML = `
            <h3 class="text-lg font-bold">Submitted for review (${queue.length})</h3>
            ${queue.length ? `<div class="mt-3 grid gap-3">${queue.map((dr) => `<div class="rounded-[3px] border border-line bg-surface p-4"><div class="flex items-center gap-2"><span class="font-semibold text-navy">${esc(dr.title)}</span><span class="chip-status border-navy text-navy">${esc(dr.status.replace('_', ' '))}</span></div><div class="font-sans text-xs text-muted">by ${esc(dr.author_name || dr.author_email)} · ${esc(dr.topic)}</div><a class="btn mt-2 font-sans text-xs" href="/review#${esc(dr.id)}" target="_blank">Open in Review workspace →</a></div>`).join('')}</div>` : '<div class="mt-2 rounded-[3px] bg-surface p-4 text-muted">Nothing waiting for review.</div>'}
            <h3 class="mt-8 text-lg font-bold">Approved — ready to import (${approved.length})</h3>
            ${approved.length ? `<div class="mt-3 grid gap-2">${approved.map((c) => `<div class="flex items-center gap-2 rounded-xl border border-line bg-surface p-3" data-draft="${esc(c._draftId)}"><span class="font-semibold">${esc(c.title)}</span><span class="font-sans text-xs text-muted">${esc(c.professor)}</span><button class="btn ml-auto font-sans text-xs" data-mark-published>Mark published</button></div>`).join('')}</div>
               <div class="mt-3 rounded-xl border-l-4 border-saffron bg-surface p-3 font-sans text-sm">Run the import: <code>gh workflow run import-drafts.yml</code> (needs the EXPORT_TOKEN repo secret). Once its PR merges to master and deploys, come back and click "Mark published" on each course above.</div>`
              : '<div class="mt-2 rounded-xl bg-surface p-4 text-muted">Nothing approved yet.</div>'}
            <h3 class="mt-8 text-lg font-bold">Course archive requests (${archivePending.length})</h3>
            ${archivePending.length ? `<div class="mt-3 grid gap-2">${archivePending.map((r) => `<div class="rounded-xl border border-line bg-surface p-3" data-archive-req="${esc(r.id)}"><div class="flex flex-wrap items-center gap-2"><span class="font-semibold">${esc(ctitle(r.course_id, courses))}</span><span class="font-sans text-xs text-muted">requested by ${esc(r.name || r.email)} · ${fmt(r.requested_at)}</span></div>${r.reason ? `<p class="mt-1 text-sm">${esc(r.reason)}</p>` : ''}<div class="mt-2 flex gap-2"><button class="btn btn-primary font-sans text-xs" data-archive-decide="approve">Approve</button><button class="btn font-sans text-xs" data-archive-decide="deny">Deny</button></div></div>`).join('')}</div>` : '<div class="mt-2 rounded-xl bg-surface p-4 text-muted">No pending archive requests.</div>'}
            ${archiveApproved.length ? `<h3 class="mt-8 text-lg font-bold">Approved — ready to archive (${archiveApproved.length})</h3>
              <div class="mt-3 grid gap-2">${archiveApproved.map((r) => `<div class="flex items-center gap-2 rounded-xl border border-line bg-surface p-3" data-archive-id="${esc(r.id)}"><span class="font-semibold">${esc(ctitle(r.course_id, courses))}</span><button class="btn ml-auto font-sans text-xs" data-mark-archived>Mark archived</button></div>`).join('')}</div>
              <div class="mt-3 rounded-xl border-l-4 border-saffron bg-surface p-3 font-sans text-sm">Run the import: <code>gh workflow run import-drafts.yml</code> — the same run also archives these courses. Once its PR merges and deploys, come back and click "Mark archived" on each course above.</div>` : ''}
            <h3 class="mt-8 text-lg font-bold">Decision history (${history.length})</h3>
            ${history.length ? `<div class="mt-3 grid gap-2">${history.map((dr) => `<div class="rounded-xl border border-line bg-surface p-3"><div class="flex flex-wrap items-center gap-2"><span class="font-semibold">${esc(dr.title)}</span>${statusPill(dr.status)}<span class="font-sans text-xs text-muted">${fmt(dr.reviewed_at)} · by ${esc(dr.reviewer_name || dr.reviewer_email || '—')}</span></div><div class="font-sans text-xs text-muted mt-0.5">author: ${esc(dr.author_name || dr.author_email)} · ${esc(dr.topic)}</div>${dr.review_notes ? `<p class="mt-1 text-sm">${esc(dr.review_notes)}</p>` : ''}</div>`).join('')}</div>` : '<div class="mt-2 rounded-xl bg-surface p-4 text-muted">No decisions recorded yet.</div>'}`;
          panel.querySelectorAll('[data-mark-published]').forEach((b) => b.addEventListener('click', () => {
            const draftId = b.closest('[data-draft]').dataset.draft;
            api('/api/admin/drafts-mark-published', { method: 'POST', body: JSON.stringify({ draftId }) }).then(({ ok }) => { if (ok) draw(); else window.suToast('Could not mark published.', 'error'); });
          }));
          panel.querySelectorAll('[data-archive-decide]').forEach((b) => b.addEventListener('click', () => {
            const id = b.closest('[data-archive-req]').dataset.archiveReq;
            api('/api/admin/archive-requests', { method: 'POST', body: JSON.stringify({ id, decision: b.dataset.archiveDecide }) }).then(({ ok, d }) => { if (ok) draw(); else window.suToast(d.error || 'Could not decide request.', 'error'); });
          }));
          panel.querySelectorAll('[data-mark-archived]').forEach((b) => b.addEventListener('click', () => {
            const id = b.closest('[data-archive-id]').dataset.archiveId;
            api('/api/admin/archive-requests', { method: 'POST', body: JSON.stringify({ id, decision: 'mark_archived' }) }).then(({ ok, d }) => { if (ok) draw(); else window.suToast(d.error || 'Could not mark archived.', 'error'); });
          }));
        });
      }

      // ── Uploads ────────────────────────────────────────────────────────────
      function uploads() {
        api('/api/admin/uploads').then(({ ok, d }) => {
          if (!ok) { panel.innerHTML = '<div class="rounded-xl bg-surface p-4">Could not load.</div>'; return; }
          const pending = d.pending || [];
          panel.innerHTML = pending.length ? `<div class="grid gap-3">${pending.map((m) => `
            <div class="rounded-xl2 border border-line bg-surface p-4" data-key="${esc(m.key)}">
              <div class="flex flex-wrap items-center gap-2"><span class="font-semibold">${esc(m.kind)}</span><span class="font-sans text-xs text-muted">${esc(m.email)} · ${(m.size / 1024).toFixed(0)} KB · ${esc(m.content_type)}</span>${m.rights ? `<span class="chip-status border-navy text-navy">rights: ${esc(m.rights)}</span>` : ''}</div>
              ${m.rights_note ? `<p class="mt-1 text-sm text-muted">${esc(m.rights_note)}</p>` : ''}
              ${m.content_type && m.content_type.startsWith('image/') ? `<img src="/api/asset?key=${encodeURIComponent(m.key)}" class="mt-2 max-h-40 rounded-lg border border-line" />` : `<a class="mt-2 inline-block underline text-sm" href="/api/asset?key=${encodeURIComponent(m.key)}" target="_blank" rel="noopener">Preview →</a>`}
              <div class="mt-2 flex gap-2"><button class="btn btn-primary font-sans text-xs" data-decide="approve">Approve</button><button class="btn font-sans text-xs" data-decide="reject">Reject</button></div>
            </div>`).join('')}</div>` : '<div class="rounded-xl bg-surface p-4 text-muted">Nothing waiting for moderation.</div>';
          panel.querySelectorAll('[data-decide]').forEach((b) => b.addEventListener('click', () => {
            const key = b.closest('[data-key]').dataset.key;
            api('/api/admin/uploads', { method: 'POST', body: JSON.stringify({ key, action: b.dataset.decide }) }).then(({ ok }) => { if (ok) draw(); else window.suToast('Could not decide.', 'error'); });
          }));
        });
      }

      // ── Moderation ─────────────────────────────────────────────────────────
      function moderation() {
        api('/api/discussions/moderate').then(({ ok, d }) => {
          if (!ok) { panel.innerHTML = '<div class="rounded-xl bg-surface p-4">Could not load reports.</div>'; return; }
          const reports = d.reports || [];
          panel.innerHTML = reports.length ? `<div class="grid gap-3">${reports.map((r) => `
            <div class="rounded-xl2 border border-line bg-surface p-4" data-msg="${esc(r.message_id)}">
              <div class="font-sans text-xs text-muted">${esc(ctitle(r.course_id, courses))} · reported: ${esc(r.reason || 'no reason given')}</div>
              <p class="mt-1 text-sm">${esc(r.message)}</p>
              <div class="mt-2 flex gap-2"><button class="btn font-sans text-xs" data-report-action="hide">Hide message</button><button class="btn font-sans text-xs" data-report-action="resolve_report">Resolve (keep visible)</button></div>
            </div>`).join('')}</div>` : '<div class="rounded-xl bg-surface p-4 text-muted">No open reports.</div>';
          panel.querySelectorAll('[data-report-action]').forEach((b) => b.addEventListener('click', () => {
            const id = b.closest('[data-msg]').dataset.msg;
            api('/api/discussions/moderate', { method: 'POST', body: JSON.stringify({ id, action: b.dataset.reportAction }) }).then(({ ok }) => { if (ok) draw(); else window.suToast('Could not update.', 'error'); });
          }));
        });
      }

      // ── Audit ──────────────────────────────────────────────────────────────
      function audit() {
        const state = { offset: 0, rows: [], actions: [], total: 0, barbuilt: false };
        const fmtT = (ts) => { try { return new Date(ts).toLocaleString(); } catch { return ''; } };
        const val = (id) => { const el = document.getElementById(id); return el ? el.value : ''; };
        panel.innerHTML = '<p class="text-muted">Loading…</p>';

        function params(reset) {
          const sp = new URLSearchParams();
          if (val('au-action')) sp.set('action', val('au-action'));
          if (val('au-role')) sp.set('role', val('au-role'));
          if (val('au-q').trim()) sp.set('q', val('au-q').trim());
          if (val('au-from')) { const t = Date.parse(val('au-from')); if (!isNaN(t)) sp.set('from', String(t)); }
          if (val('au-to')) { const t = Date.parse(val('au-to')); if (!isNaN(t)) sp.set('to', String(t + 86399999)); } // inclusive end-of-day
          sp.set('sort', val('au-sort') || 'ts_desc');
          sp.set('limit', '100');
          sp.set('offset', String(reset ? 0 : state.offset));
          return sp.toString();
        }
        function renderBody() {
          const body = document.getElementById('au-body'); if (!body) return;
          if (!state.rows.length) { body.innerHTML = '<div class="rounded-xl bg-surface p-4 text-muted">No events match these filters.</div>'; return; }
          body.innerHTML = `<p class="font-sans text-sm text-muted">Showing ${state.rows.length} of ${state.total} event(s).</p><div class="mt-3 overflow-x-auto"><table class="w-full font-sans text-sm"><thead><tr class="thead-ledger"><th class="py-1">When</th><th>Who</th><th>Role</th><th>Action</th><th>Target</th><th>Detail</th></tr></thead><tbody>${state.rows.map((e) => `<tr class="border-t border-line align-top"><td class="py-1 whitespace-nowrap">${fmtT(e.ts)}</td><td>${esc(e.email || e.user_id || '—')}</td><td>${esc(e.role || '—')}</td><td><span class="chip-status border-navy text-navy">${esc(e.action)}</span></td><td>${esc(e.target || '—')}</td><td>${esc(e.detail || '')}</td></tr>`).join('')}</tbody></table></div>${state.rows.length < state.total ? '<button id="au-more" class="btn mt-3 font-sans text-xs px-3 py-1.5">Load more</button>' : ''}`;
          const more = document.getElementById('au-more'); if (more) more.addEventListener('click', () => load(false));
        }
        function buildBar() {
          const actionOpts = ['<option value="">All actions</option>'].concat(state.actions.map((a) => `<option value="${esc(a)}">${esc(a)}</option>`)).join('');
          panel.innerHTML = `<div class="mb-4 flex flex-wrap items-end gap-2">
            <input id="au-q" type="search" placeholder="Search email / target / detail…" class="rounded-lg border border-line bg-paper px-3 py-1.5 font-sans text-xs w-52" />
            <select id="au-action" class="rounded-lg border border-line bg-paper px-2 py-1.5 font-sans text-xs">${actionOpts}</select>
            <select id="au-role" class="rounded-lg border border-line bg-paper px-2 py-1.5 font-sans text-xs"><option value="">All roles</option><option value="learner">learner</option><option value="teacher">teacher</option><option value="admin">admin</option></select>
            <label class="font-sans text-xs text-muted">From <input id="au-from" type="date" class="rounded-lg border border-line bg-paper px-2 py-1 font-sans text-xs" /></label>
            <label class="font-sans text-xs text-muted">To <input id="au-to" type="date" class="rounded-lg border border-line bg-paper px-2 py-1 font-sans text-xs" /></label>
            <select id="au-sort" class="rounded-lg border border-line bg-paper px-2 py-1.5 font-sans text-xs"><option value="ts_desc">Newest first</option><option value="ts_asc">Oldest first</option></select>
          </div><div id="au-body"></div>`;
          let t;
          const qEl = document.getElementById('au-q');
          if (qEl) qEl.addEventListener('input', () => { clearTimeout(t); t = setTimeout(() => load(true), 300); });
          ['au-action', 'au-role', 'au-from', 'au-to', 'au-sort'].forEach((id) => { const el = document.getElementById(id); if (el) el.addEventListener('change', () => load(true)); });
          state.barbuilt = true;
        }
        function load(reset) {
          api('/api/admin/events?' + params(reset)).then(({ ok, d }) => {
            if (!ok) { panel.innerHTML = '<div class="rounded-xl bg-surface p-4">Could not load the audit log.</div>'; return; }
            if (reset) { state.rows = d.events || []; } else { state.rows = state.rows.concat(d.events || []); }
            state.offset = state.rows.length;
            state.total = d.total || 0;
            if (!state.barbuilt) { state.actions = d.actions || []; buildBar(); }
            renderBody();
          });
        }
        load(true);
      }

      // ── Users ──────────────────────────────────────────────────────────────
      function users() {
        Promise.all([api('/api/admin/users'), api('/api/gradebook')]).then(([u, g]) => {
          if (!u.ok) { panel.innerHTML = '<div class="rounded-xl bg-surface p-4">Could not load users.</div>'; return; }
          const list = u.d.users || [];
          const gbRows = (g.ok && g.d.rows) || [];
          const userCourses = {}; gbRows.forEach((r) => { userCourses[r.user_id] = (userCourses[r.user_id] || 0) + 1; });
          const userPassed = {}; gbRows.forEach((r) => { if (r.score != null && r.score >= 80) userPassed[r.user_id] = (userPassed[r.user_id] || 0) + 1; });
          const badge = (r) => `<span class="chip-status ${r === 'admin' ? 'border-saffron-deep text-saffron-deep' : r === 'teacher' ? 'border-navy text-navy' : 'border-muted text-muted'}">${esc(r)}</span>`;
          const renderList = (items) => items.map((u2) => {
            const passed2 = userPassed[u2.id] || 0; const enrolled = userCourses[u2.id] || 0;
            return `<tr class="border-t border-line align-middle" data-id="${esc(u2.id)}">
              <td class="py-2"><div class="font-semibold">${esc(u2.name || '—')}</div><div class="font-sans text-xs text-muted">${esc(u2.email)}</div></td>
              <td>${badge(u2.role)}</td>
              <td class="whitespace-nowrap text-muted font-sans text-xs">${fmt(u2.created_at)}</td>
              <td class="font-sans text-xs">${enrolled ? `${passed2}/${enrolled} passed` : '—'}</td>
              <td>${u2.role === 'admin' ? '<span class="text-muted">—</span>' : `<button class="rounded-lg border border-line px-2 py-1 font-sans text-xs ${u2.role === 'learner' ? 'opacity-40' : 'hover:border-saffron'}" data-set="learner" ${u2.role === 'learner' ? 'disabled' : ''}>Learner</button> <button class="rounded-lg border border-line px-2 py-1 font-sans text-xs ${u2.role === 'teacher' ? 'opacity-40' : 'hover:border-saffron'}" data-set="teacher" ${u2.role === 'teacher' ? 'disabled' : ''}>Teacher</button>`}</td>
            </tr>`;
          }).join('');
          const wireRoleButtons = () => panel.querySelectorAll('[data-set]').forEach((b) => b.addEventListener('click', () => { const row = b.closest('[data-id]'); api('/api/admin/users', { method: 'POST', body: JSON.stringify({ id: row.dataset.id, role: b.dataset.set }) }).then(({ ok }) => { if (ok) draw(); }); }));
          panel.innerHTML = `
            <div class="flex flex-wrap items-center gap-3 justify-between">
              <p class="font-sans text-sm text-muted">${list.length} user(s).</p>
              <div class="flex flex-wrap gap-2">
                <input id="user-search" type="search" placeholder="Filter by name or email…" class="rounded-lg border border-line bg-paper px-3 py-1.5 font-sans text-sm w-full sm:w-64" />
                <select id="user-role" class="rounded-lg border border-line bg-paper px-2 py-1.5 font-sans text-sm">
                  <option value="">All roles</option><option value="admin">Admin</option><option value="teacher">Teacher</option><option value="learner">Learner</option>
                </select>
                <select id="user-sort" class="rounded-lg border border-line bg-paper px-2 py-1.5 font-sans text-sm">
                  <option value="joined">Sort: Newest first</option><option value="name">Sort: Name A→Z</option><option value="passed">Sort: Most passed</option>
                </select>
              </div>
            </div>
            <div class="mt-4 overflow-x-auto"><table class="w-full font-sans text-sm" id="users-table">
              <thead><tr class="thead-ledger"><th class="py-1">Name / Email</th><th>Role</th><th>Joined</th><th>Progress</th><th>Set role</th></tr></thead>
              <tbody id="users-body">${renderList(list)}</tbody>
            </table></div>`;
          wireRoleButtons();
          const rerender = () => {
            const q = (document.getElementById('user-search').value || '').toLowerCase();
            const roleF = document.getElementById('user-role').value;
            const sortF = document.getElementById('user-sort').value;
            let filtered = q ? list.filter((u2) => (u2.email || '').toLowerCase().includes(q) || (u2.name || '').toLowerCase().includes(q)) : [...list];
            if (roleF) filtered = filtered.filter((u2) => u2.role === roleF);
            if (sortF === 'name') filtered.sort((a, b) => (a.name || a.email || '').localeCompare(b.name || b.email || ''));
            else if (sortF === 'passed') filtered.sort((a, b) => (userPassed[b.id] || 0) - (userPassed[a.id] || 0));
            else filtered.sort((a, b) => (b.created_at || '').localeCompare(a.created_at || ''));
            document.getElementById('users-body').innerHTML = renderList(filtered);
            wireRoleButtons();
          };
          ['user-search', 'user-role', 'user-sort'].forEach((id) => { const el = document.getElementById(id); if (el) { el.addEventListener('input', rerender); el.addEventListener('change', rerender); } });
        });
      }

      // ── Overview ───────────────────────────────────────────────────────────
      function overview() {
        Promise.all([api('/api/admin/stats'), api('/api/gradebook')]).then(([s, g]) => {
          if (!s.ok) { panel.innerHTML = '<div class="rounded-xl bg-surface p-4">Could not load stats.</div>'; return; }
          const t = s.d.totals || {};
          const stat = (n, l) => `<div class="rounded-[3px] border border-line bg-surface p-4 text-center"><div class="stat-mono items-center"><span>${n || 0}</span><span>${l}</span></div></div>`;
          let html = `<div class="grid grid-cols-2 gap-3 sm:grid-cols-4">${stat(t.users, 'Total users')}${stat(t.enrollments, 'Enrollments')}${stat(t.completions, 'Completions')}${stat(t.activeSessions, 'Active sessions')}${stat(t.teachers, 'Teachers')}${stat(t.pendingApplications, 'Pending apps')}${stat(t.newFeedback, 'New feedback')}${stat(t.admins, 'Admins')}</div>`;
          html += `<div class="mt-6 rounded-xl2 border border-line bg-surface p-4"><h3 class="text-lg font-bold">Preview dashboards</h3><p class="font-sans text-sm text-muted">See exactly what a student and a teacher see.</p><div class="mt-3 flex flex-wrap gap-2"><a class="btn" href="/dashboard?demo=student">View student dashboard →</a><a class="btn" href="/dashboard?demo=teacher">View teacher dashboard →</a></div></div>`;
          if (g.ok) {
            const rows = g.d.rows || [];
            const byUser = {}; rows.forEach((r) => { if (r.score != null && r.score >= 80) byUser[r.user_id] = (byUser[r.user_id] || 0) + 1; });
            const counts = Object.values(byUser);
            const badgeCounts = { 'Graduate (1+)': counts.filter((n) => n >= 1).length, 'Dedicated (25+)': counts.filter((n) => n >= 25).length, 'Scholar (100+)': counts.filter((n) => n >= 100).length, 'Vidhvaan (250+)': counts.filter((n) => n >= 250).length };
            html += `<h3 class="mt-8 text-xl font-bold">Badge distribution</h3><div class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-4">${Object.entries(badgeCounts).map(([name, count]) => stat(count, name)).join('')}</div>`;
          }
          const pop = s.d.popular || [];
          if (pop.length) { const max = pop[0].learners || 1; html += `<h3 class="mt-8 text-xl font-bold">Most popular courses</h3><table class="mt-3 w-full font-sans text-sm"><thead><tr class="thead-ledger"><th class="py-1">Course</th><th>Learners</th><th>Completions</th><th></th></tr></thead><tbody>${pop.map((p) => `<tr class="border-t border-line"><td class="py-1">${esc(ctitle(p.course_id, courses))}</td><td>${p.learners}</td><td>${p.completions}</td><td class="w-1/3"><div class="h-2 rounded bg-saffron" style="width:${Math.max(6, Math.round((p.learners / max) * 100))}%"></div></td></tr>`).join('')}</tbody></table>`; }
          else html += '<div class="mt-6 rounded-xl bg-surface p-4 text-muted">No enrollments yet.</div>';
          panel.innerHTML = html;
        });
      }

      // ── Courses ────────────────────────────────────────────────────────────
      function coursesTab() {
        const pub = courses.filter((c) => c.status === 'published');
        const topicCounts = {};
        topics.forEach((tp) => { topicCounts[tp.id] = courses.filter((c) => c.topic === tp.id).length; });

        panel.innerHTML = `
          <div class="mb-4 flex flex-wrap items-end gap-3">
            <p class="font-sans text-sm text-muted grow">${courses.length} courses · ${pub.length} published · ${topics.length} topics</p>
            <div class="flex flex-wrap gap-2">
              <input id="c-search" type="search" placeholder="Search courses…" class="rounded-lg border border-line bg-paper px-3 py-1.5 font-sans text-xs w-48" />
              <select id="c-topic" class="rounded-lg border border-line bg-paper px-2 py-1.5 font-sans text-xs">
                <option value="">All topics</option>${topics.map((tp) => `<option value="${esc(tp.id)}">${esc(tp.name)} (${topicCounts[tp.id] || 0})</option>`).join('')}
              </select>
              <select id="c-level" class="rounded-lg border border-line bg-paper px-2 py-1.5 font-sans text-xs">
                <option value="">All levels</option>
                <option value="100">100</option><option value="150">150</option><option value="200">200</option>
                <option value="250">250</option><option value="300">300</option><option value="400">400</option><option value="500">500+</option>
              </select>
              <select id="c-sort" class="rounded-lg border border-line bg-paper px-2 py-1.5 font-sans text-xs">
                <option value="topic">Group: By topic</option>
                <option value="level">Sort: Level ↑</option>
                <option value="name">Sort: Name A→Z</option>
                <option value="prof">Sort: Professor A→Z</option>
              </select>
              <button id="c-expand-all" class="btn font-sans text-xs px-3 py-1.5">Expand all</button>
              <button id="c-collapse-all" class="btn font-sans text-xs px-3 py-1.5">Collapse all</button>
            </div>
          </div>
          <div id="c-body"></div>`;

        function renderCourses() {
          const q = (document.getElementById('c-search').value || '').toLowerCase();
          const topicF = document.getElementById('c-topic').value;
          const levelF = document.getElementById('c-level').value;
          const sortF = document.getElementById('c-sort').value;
          let filtered = courses.filter((c) => {
            if (topicF && c.topic !== topicF) return false;
            if (levelF) { if (levelF === '500') { if (c.level < 500) return false; } else if (String(c.level) !== levelF) return false; }
            if (q && !(c.title || '').toLowerCase().includes(q) && !(c.professor || '').toLowerCase().includes(q) && !(c.id || '').toLowerCase().includes(q)) return false;
            return true;
          });

          const body = document.getElementById('c-body');
          if (!body) return;

          if (sortF === 'topic') {
            body.innerHTML = topics.map((tp) => {
              const list = filtered.filter((c) => c.topic === tp.id).sort((a, b) => a.level - b.level);
              if (!list.length) return '';
              return `<details class="mt-4 rounded-xl2 border border-line bg-surface">
                <summary class="cursor-pointer select-none px-4 py-3 font-bold text-navy">${esc(tp.name)} <span class="font-sans text-xs font-normal text-muted">(${list.length})</span></summary>
                <ul class="divide-y divide-line px-4 pb-3">${list.map((c) => courseRow(c)).join('')}</ul>
              </details>`;
            }).join('');
          } else {
            if (sortF === 'level') filtered.sort((a, b) => a.level - b.level);
            else if (sortF === 'name') filtered.sort((a, b) => (a.title || '').localeCompare(b.title || ''));
            else if (sortF === 'prof') filtered.sort((a, b) => (a.professor || '').localeCompare(b.professor || ''));
            body.innerHTML = filtered.length ? `<ul class="divide-y divide-line rounded-xl2 border border-line bg-surface px-4 pb-3">${filtered.map((c) => courseRow(c)).join('')}</ul>` : '<div class="rounded-xl bg-surface p-4 text-muted">No courses match.</div>';
          }
        }

        function courseRow(c) {
          return `<li class="py-2"><details><summary class="cursor-pointer select-none font-semibold text-navy">${esc(c.title)} <span class="font-sans text-xs font-normal text-muted">· L${c.level} · ${esc(c.professor)} · ${c.status}${c.aiCreated ? ' · AI' : ''}</span></summary>
            <div class="mt-2 rounded-xl border border-line bg-paper p-3"><p class="text-sm">${esc(c.summary)}</p>
            <div class="mt-2 flex flex-wrap gap-2">
              <a class="btn font-sans text-xs px-2 py-1" href="/course/${esc(c.id)}" target="_blank">View course →</a>
            </div>
            <div class="mt-2 font-sans text-xs text-muted">${c.nLessons || 0} lessons${c.nQuiz ? ' · ' + c.nQuiz + ' quiz questions' : ''}</div>
            </div></details></li>`;
        }

        renderCourses();
        ['c-search', 'c-topic', 'c-level', 'c-sort'].forEach((id) => {
          const el = document.getElementById(id);
          if (el) { el.addEventListener('input', renderCourses); el.addEventListener('change', renderCourses); }
        });
        document.getElementById('c-expand-all').addEventListener('click', () => { document.querySelectorAll('#c-body details').forEach((d) => d.open = true); });
        document.getElementById('c-collapse-all').addEventListener('click', () => { document.querySelectorAll('#c-body details').forEach((d) => d.open = false); });
      }

      // ── Applications ───────────────────────────────────────────────────────
      function applications() {
        api('/api/admin/applications').then(({ ok, d }) => {
          if (!ok) { panel.innerHTML = '<div class="rounded-xl bg-surface p-4">Could not load.</div>'; return; }
          const apps = d.applications || [];
          if (!apps.length) { panel.innerHTML = '<div class="rounded-xl bg-surface p-4 text-muted">No pending applications.</div>'; return; }
          panel.innerHTML = apps.map((a) => `<div class="mb-4 rounded-xl2 border border-line bg-surface p-4" data-id="${a.id}"><h3 class="font-bold">${esc(a.name || a.email)}</h3><div class="font-sans text-xs text-muted">${esc(a.email)} · ${fmt(a.created_at)}</div><p class="mt-2 text-sm"><strong>Background:</strong> ${esc(a.background || '')}</p>${a.courses ? `<p class="text-sm"><strong>Wants to teach:</strong> ${esc(a.courses)}</p>` : ''}<div class="mt-3 flex gap-2"><button class="btn btn-primary" data-d="approve">Approve</button><button class="btn" data-d="deny">Deny</button></div></div>`).join('');
          panel.querySelectorAll('[data-d]').forEach((b) => b.addEventListener('click', () => { const card = b.closest('[data-id]'); api('/api/admin/applications', { method: 'POST', body: JSON.stringify({ id: card.dataset.id, decision: b.dataset.d }) }).then(({ ok }) => { if (ok) card.innerHTML = `<div class="rounded-xl border-l-4 border-ok p-3">Application ${b.dataset.d}d.</div>`; }); }));
        });
      }

      // ── Feedback ───────────────────────────────────────────────────────────
      function feedback() {
        api('/api/admin/feedback').then(({ ok, d }) => {
          if (!ok) { panel.innerHTML = '<div class="rounded-xl bg-surface p-4">Could not load.</div>'; return; }
          const fb = d.feedback || [];
          if (!fb.length) { panel.innerHTML = '<div class="rounded-xl bg-surface p-4 text-muted">No feedback yet.</div>'; return; }
          panel.innerHTML = `<table class="w-full font-sans text-sm"><thead><tr class="thead-ledger"><th class="py-1">Date</th><th>Type</th><th>From</th><th>Course</th><th>Message</th></tr></thead><tbody>${fb.map((f) => `<tr class="border-t border-line align-top"><td class="py-1 whitespace-nowrap">${fmt(f.created_at)}</td><td>${esc(f.category || '')}</td><td>${esc(f.email || '—')}</td><td>${esc(ctitle(f.course_id, courses))}</td><td>${esc(f.message || '')}</td></tr>`).join('')}</tbody></table>`;
        });
      }

      // ── Bootstrap: load courses, topics, programs then draw ────────────────
      Promise.all([
        fetch('/data/index.json').then((r) => r.json()),
        fetch('/assets/data/programs.json').then((r) => r.json()).catch(() => ({ programs: [] })),
      ]).then(([data, pd]) => {
        courses = data.courses || [];
        topics = data.topics || [];
        programs = (pd && pd.programs) || [];
        draw();
      }).catch(draw);
    });
  </script>
</Base>
