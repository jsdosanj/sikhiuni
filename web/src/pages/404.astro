---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Page not found — Sikhi University" description="This page could not be found." autoTranslate={false} ambient="hall" noindex={true}>
  <div class="hero-midnight">
    <div class="wrap relative flex min-h-[420px] items-center py-16 sm:py-20">
      <div class="relative max-w-[60ch]">
        <p class="eyebrow text-saffron">Error 404</p>
        <h1 class="text-display-sm mt-4 text-white" data-i18n="notfound.h1">This page wandered off the path.</h1>
        <p class="mt-4 max-w-[52ch] font-sans text-lg leading-[1.62] text-white/78" data-i18n="notfound.sub">We couldn't find what you were looking for. Search the catalogue or start with the basics.</p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href="/catalog" class="btn btn-primary" data-i18n="notfound.cta.catalog">Browse the catalogue</a>
          <a href="/search" class="btn btn-ghost" data-i18n="notfound.search.btn">Search</a>
        </div>
      </div>
    </div>
  </div>

  <section class="wrap max-w-2xl py-12 text-center">
    <div class="border border-line bg-surface p-6 sm:p-8">
    <form id="s404" action="/search" method="get" role="search" class="mx-auto flex max-w-md gap-2">
      <div class="relative flex-1">
        <svg aria-hidden="true" class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>
        </svg>
        <input id="q404" name="q" type="search" aria-label="Search courses" data-i18n-aria="catalog.search.aria" placeholder="Search 558 courses…" data-i18n-ph="notfound.search.ph" autocomplete="off" class="w-full rounded-full border border-line bg-paper py-2.5 pl-9 pr-4 font-sans text-sm outline-none focus:border-saffron" />
      </div>
      <button class="btn btn-primary shrink-0" data-i18n="notfound.search.btn">Search</button>
    </form>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <a href="/catalog" class="card-lift text-center" data-tilt>
        <Icon name="books" class="mx-auto h-7 w-7 text-saffron-deep" />
        <span class="mt-2 block font-sans text-sm font-semibold text-navy" data-i18n="catalog.eyebrow">Catalogue</span>
      </a>
      <a href="/santhiya" class="card-lift text-center" data-tilt>
        <Icon name="compass" class="mx-auto h-7 w-7 text-saffron-deep" />
        <span class="mt-2 block font-sans text-sm font-semibold text-navy" data-i18n="nav.santhya">Santhya</span>
      </a>
      <a href="/about" class="card-lift text-center" data-tilt>
        <Icon name="globe" class="mx-auto h-7 w-7 text-saffron-deep" />
        <span class="mt-2 block font-sans text-sm font-semibold text-navy" data-i18n="nav.about">About</span>
      </a>
      <a href="/professors" class="card-lift text-center" data-tilt>
        <Icon name="cap" class="mx-auto h-7 w-7 text-saffron-deep" />
        <span class="mt-2 block font-sans text-sm font-semibold text-navy" data-i18n="nav.professors">Professors</span>
      </a>
    </div>
    </div>
  </section>
  <script>
    document.getElementById('s404').addEventListener('submit', (e) => {
      e.preventDefault();
      const q = document.getElementById('q404').value.trim();
      location.href = '/search' + (q ? '?q=' + encodeURIComponent(q) : '');
    });
  </script>
</Base>
