---
import Base from '../layouts/Base.astro';
// Redesign task 18 (isverify, prototype lines 763-788). The "What this does
// and does not attest" note below ships as a STATIC block in raw markup
// (never only inside the JS-built #out card) so it holds with JS disabled,
// per DESIGN.md Principle 3. Its wording is grounded in what
// /api/certificates actually does (see functions/api/certificates.js) --
// there is no revocation field anywhere in that table, so the note does not
// claim a "not revoked" check the way the prototype's mock implies. It
// confirms a matching record exists and nothing more, per Principle 4
// (trust is earned, not claimed).
---
<Base title="Verify a certificate — Sikhi University" description="Verify the authenticity of a Sikhi University certificate of completion." autoTranslate={false} ambient="study">
  <section class="wrap max-w-xl py-14">
    <p class="eyebrow text-saffron-deep" data-i18n="verify.eyebrow">Credential check</p>
    <h1 class="text-display-sm mt-3 text-navy" data-i18n="verify.h1">Verify a certificate</h1>
    <p class="mt-4 font-sans text-[15.5px] leading-relaxed text-muted"><span data-i18n="verify.hint1">Enter a certificate ID (e.g.</span> <code class="font-mono">SU-XXXXXXXXXX</code><span data-i18n="verify.hint2">) to confirm it was issued by Sikhi University.</span></p>
    <form id="vf" class="mt-6 flex flex-wrap gap-2">
      <input id="vid" type="text" aria-label="Certificate ID" data-i18n-aria="verify.aria.certid" placeholder="SU-…" data-i18n-ph="verify.ph.certid" class="min-w-[240px] flex-1 rounded-xl2 border border-navy bg-surface px-4 py-3 font-mono text-[15px] text-navy outline-none placeholder:text-muted" />
      <button class="btn btn-primary" data-i18n="verify.submit">Verify</button>
    </form>
    <div id="out" class="mt-6" aria-live="polite"></div>

    <div class="mt-9 max-w-[74ch] border border-line border-l-[3px] border-l-saffron-deep bg-surface px-5 py-4">
      <p class="font-mono text-[10.5px] uppercase tracking-[.18em] text-saffron-deep" data-i18n="verify.attest.label">What this does and does not attest</p>
      <p class="mt-2.5 font-sans text-[15px] leading-relaxed text-muted" data-i18n="verify.attest.body">This check confirms that a matching credential exists in our records, issued to this name, for this course, with this score. It does not attest to accreditation by any external body, and it is not a degree. Sikhi University is not an accredited institution, and course content is reviewed by our own scholar board before publication.</p>
    </div>
  </section>
  <script>
    import { iconSvg, sealMark } from '../lib/icons';
    const esc = (s) => String(s == null ? '' : s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    const out = document.getElementById('out');
    let titles = {};
    fetch('/data/index.json').then((r) => r.json()).then((d) => { d.courses.forEach((c) => (titles[c.id] = c.title)); }).catch(() => {});
    const btn = document.querySelector('#vf button');
    function verify(id) {
      if (!id) return;
      out.innerHTML = '<p class="text-muted" data-i18n="verify.checking">Checking…</p>';
      if (btn) btn.disabled = true;
      fetch('/api/certificates?id=' + encodeURIComponent(id)).then(async (r) => {
        const d = await r.json().catch(() => ({}));
        // A non-OK response (e.g. 503 cannot_check during a DB outage) must not be
        // read as "not found" — a real certificate could be declared fake otherwise.
        if (!r.ok || (d && d.error)) {
          out.innerHTML = `<div class="rounded-xl2 border-l-4 border-saffron bg-surface p-5 font-sans text-sm"><strong data-i18n="verify.error.title">Couldn't check right now.</strong> <span data-i18n="verify.error.detail">This is a temporary problem on our side, not a verdict on the certificate. Please try again in a moment.</span></div>`;
          return;
        }
        if (d && d.valid) {
          const dt = d.issuedAt ? new Date(d.issuedAt).toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' }) : '';
          out.innerHTML = `<div class="rounded-xl2 border border-ok bg-surface p-6">
            <div class="flex flex-wrap items-center justify-between gap-4">
              <p class="flex items-center gap-2 font-mono text-[11px] font-bold uppercase tracking-[.18em] text-ok">${iconSvg('check', 'h-4 w-4 shrink-0')} <span data-i18n="verify.valid">Valid certificate</span></p>
              ${sealMark()}
            </div>
            <div class="mt-5 grid grid-cols-[130px_minmax(0,1fr)] gap-x-4 gap-y-2.5 text-[15px]">
              <span class="pt-0.5 font-mono text-[11px] uppercase tracking-[.12em] text-muted" data-i18n="verify.field.holder">Holder</span><span class="font-semibold text-navy">${esc(d.name || '—')}</span>
              <span class="pt-0.5 font-mono text-[11px] uppercase tracking-[.12em] text-muted" data-i18n="verify.field.programme">Programme</span><span class="text-ink">${esc(titles[d.courseId] || d.courseId)}</span>
              <span class="pt-0.5 font-mono text-[11px] uppercase tracking-[.12em] text-muted" data-i18n="verify.field.conferred">Conferred</span><span class="text-ink">${dt}</span>
              <span class="pt-0.5 font-mono text-[11px] uppercase tracking-[.12em] text-muted" data-i18n="verify.field.score">Score</span><span class="text-ink">${d.score}%</span>
            </div>
          </div>`;
        } else {
          out.innerHTML = `<div class="rounded-xl2 border-l-4 border-saffron bg-surface p-5 font-sans text-sm"><strong data-i18n="verify.notfound.title">Not found.</strong> <span data-i18n="verify.notfound.detail">No certificate matches that ID.</span></div>`;
        }
      }).catch(() => { out.innerHTML = `<div class="rounded-xl2 border-l-4 border-saffron bg-surface p-5 font-sans text-sm"><strong data-i18n="verify.error.title">Couldn't check right now.</strong> <span data-i18n="verify.error.detail2">Please try again in a moment.</span></div>`; })
        .finally(() => { if (btn) btn.disabled = false; });
    }
    document.getElementById('vf').addEventListener('submit', (e) => { e.preventDefault(); verify(document.getElementById('vid').value.trim()); });
    const pre = new URLSearchParams(location.search).get('id');
    if (pre) { document.getElementById('vid').value = pre; verify(pre); }
  </script>
</Base>
