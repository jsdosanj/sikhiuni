---
import Base from '../layouts/Base.astro';
---
<!-- Redesign task 17 (isstudio, prototype lines 634-693 + 859-878 -- both
     blocks are views of ONE real tool). This is the REAL studio.astro (the
     teacher's course-drafting workbench, cluster D). Restyled to the ledger
     system: rule-navy/eyebrow header (matching review.astro's precedent,
     task 16), a ruled-row drafts list with real stat-mono counts bucketed
     from the drafts' own live `status` field (draft/changes_requested ->
     Drafting; submitted/in_review -> In review; approved/published ->
     Ready -- no fabricated taxonomy), chip-status in place of the old
     `.pill`, and the former frosted-blur surfaces replaced with flat
     ledger cards. The prototype's per-lesson "Gurbani verified /
     citation mismatch" callouts and its right-hand "Gate status" rail
     describe a per-line citation-check UI that does NOT exist in this
     app's schema or API (draft_lessons has no per-quote verification
     state; /api/studio/validate returns a flat string[] of readiness
     errors, checked at build/import time against the corpus, not per
     bani line in the studio) -- so, matching the "no invented course
     codes" precedent set in catalog.astro/review.astro, that rail is NOT
     added. Its visual language (navy mono console block, danger/ok
     accents) is instead applied to the real readiness/submit output,
     which is the actual citation-check UI this tool has. The prototype's
     "MY DRAFTS / ALL / RETURNED" filter chips are also not added -- this
     endpoint returns only the signed-in author's own drafts and has no
     "all drafts" or "returned" filter to back them. This page had zero
     data-i18n keys before this pass (internal teacher tool, same
     untranslated posture as its cluster-D siblings) -- none added.
     Protected hooks (untouched): #app, #back, #new-draft, data-open,
     data-delete-draft, data-draft-title, #studio-tabs, #studio-panel,
     #f-summary/#f-ai/#f-visibility/#save-meta, #delete-draft-btn,
     #lessons/#add-lesson, data-lesson/data-l-title/data-l-html/
     data-l-preview/data-l-media/data-media-list/data-media-note/
     data-media-progress-wrap/data-media-progress-bar/data-save-lesson/
     data-delete-lesson/data-insert-youtube/data-upload-doc/
     data-upload-video/data-remove-media, #quiz-editor/#add-q/#save-quiz/
     data-q/data-q-option/data-q-answer/data-q-options/data-add-option/
     data-delete-q, #validate/#validate-out/#submit-draft. -->
<Base title="Course Studio — Sikhi University" description="Draft, validate, and submit a course for scholar review." ambient="none" noindex={true}>
  <section class="wrap max-w-4xl py-12">
    <div class="rule-navy pb-4">
      <p class="eyebrow text-saffron-deep">Studio</p>
      <h1 class="text-display-sm mt-2.5 font-bold text-navy">Course Studio</h1>
      <p class="mt-2 max-w-[68ch] text-muted">Draft a course, then submit it for scholar review. Nothing here is public until an admin approves it and it's merged into the live catalogue.</p>
    </div>
    <div id="app" class="mt-8"><p class="text-muted">Loading…</p></div>
  </section>
  <script>
    import { iconSvg } from '../lib/icons';
    import { expandYoutubeEmbeds, extractYoutubeId } from '../lib/lesson-embeds';
    const esc = (s: unknown) => String(s == null ? '' : s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));
    const app = document.getElementById('app')!;
    let topics: any[] = [];
    const api = (p: string, o?: RequestInit) => fetch(p, { credentials: 'same-origin', headers: { 'content-type': 'application/json' }, ...(o || {}) })
      .then((r) => r.json().then((d) => ({ ok: r.ok, d })));

    async function loadTopics() {
      if (topics.length) return topics;
      try { const data = await fetch('/data/index.json').then((r) => r.json()); topics = data.topics || []; } catch (e) {}
      return topics;
    }

    // Shared status→chip styling, used on both the drafts list and the editor header.
    const STATUS_STYLE: Record<string, string> = {
      draft: 'border-muted text-muted',
      submitted: 'border-navy text-navy',
      in_review: 'border-navy text-navy',
      changes_requested: 'border-saffron-deep text-saffron-deep',
      approved: 'border-ok text-ok',
      published: 'border-ok text-ok',
    };
    const statusPill = (status: string) => `<span class="chip-status ${STATUS_STYLE[status] || 'border-muted text-muted'}">${esc(status.replace('_', ' '))}</span>`;

    // Real-data bucketing for the drafts-list stat row (draft.status is the
    // only source of truth -- no fabricated "validating" build state exists).
    const BUCKET: Record<string, 'drafting' | 'inReview' | 'ready'> = {
      draft: 'drafting', changes_requested: 'drafting',
      submitted: 'inReview', in_review: 'inReview',
      approved: 'ready', published: 'ready',
    };

    // Why is this draft read-only right now? Shown instead of silently disabling every field.
    const LOCKED_REASON: Record<string, string> = {
      submitted: 'This draft has been submitted and is waiting for a reviewer to pick it up. It will unlock again if changes are requested.',
      in_review: 'A reviewer is currently looking at this draft. It will unlock again if changes are requested.',
      approved: 'This draft has been approved and is queued for import into the live catalogue. An admin will mark it published once the import PR merges.',
      published: 'This course is live on the catalogue. Editing here no longer changes the published course.',
    };

    function draftListItem(d: any) {
      // A ruled ledger row (DESIGN.md's "list-like data renders as ruled
      // rows" law), not a card grid -- one row per draft, mirroring
      // review.astro's queue-row layout for this same cluster D tool.
      return `<div data-draft-card="${esc(d.id)}" class="row-ruled">
        <a href="#" data-open="${esc(d.id)}" class="flex min-w-0 flex-1 flex-wrap items-baseline gap-x-4 gap-y-1">
          <span class="w-24 shrink-0">${statusPill(d.status)}</span>
          <span class="w-20 shrink-0 font-mono text-[11.5px] text-saffron-deep">${esc(d.course_id)}</span>
          <span class="min-w-0 flex-1 truncate font-bold text-navy">${esc(d.title)}</span>
          <span class="min-w-0 flex-[2] truncate text-sm text-muted">${esc(d.topic)} · level ${esc(d.level)}</span>
        </a>
        ${d.status === 'published' ? `<a class="w-full font-sans text-xs underline" href="/cohorts?course=${esc(d.course_id)}">Course is live — create a cohort for it →</a>` : ''}
        <button type="button" data-delete-draft="${esc(d.id)}" data-draft-title="${esc(d.title)}" aria-label="Delete draft" title="Delete draft" class="shrink-0 rounded-lg p-1 text-muted hover:bg-danger/10 hover:text-danger">${iconSvg('close', 'h-4 w-4')}</button>
      </div>`;
    }

    async function deleteDraft(id: string, title: string, onDone: () => void) {
      if (!confirm(`Delete "${title}"? This permanently removes the draft, its lessons, and its quiz. This cannot be undone.`)) return;
      const r = await api('/api/studio/draft', { method: 'POST', body: JSON.stringify({ id, action: 'delete' }) });
      if (r.ok) { (window as any).suToast('Draft deleted.', 'ok'); onDone(); }
      else (window as any).suToast(r.d.error || 'Could not delete draft.', 'error');
    }

    // ── URL state: /studio (list) <-> /studio?draft=<id> (editor) ────────────
    function goToList(push = true) {
      if (push) history.pushState(null, '', location.pathname);
      renderList();
    }
    function goToEditor(id: string, push = true) {
      if (push) history.pushState(null, '', `${location.pathname}?draft=${encodeURIComponent(id)}`);
      renderEditor(id);
    }
    addEventListener('popstate', () => {
      const id = new URLSearchParams(location.search).get('draft');
      if (id) renderEditor(id); else renderList();
    });

    async function renderList() {
      const me = await api('/api/me');
      const u = me.ok && me.d.user;
      if (u && u.mfa && u.mfa.enrolled && u.mfa_ok !== 1) {
        app.innerHTML = '<p class="text-muted">This session hasn\'t verified your two-factor code yet. <a class="underline" href="/mfa">Verify now →</a></p>';
        return;
      }
      const { ok, d } = await api('/api/studio/drafts');
      if (!ok) { app.innerHTML = '<p class="text-muted">Sign in as a teacher to use the studio.</p>'; return; }
      const drafts = d.drafts || [];
      const counts = { drafting: 0, inReview: 0, ready: 0 };
      drafts.forEach((dr: any) => { const b = BUCKET[dr.status]; if (b) counts[b]++; });
      app.innerHTML = `
        <div class="flex flex-wrap items-end justify-between gap-4">
          <button id="new-draft" class="btn btn-primary">${iconSvg('pen', 'h-4 w-4')} New draft</button>
          <div class="flex gap-6">
            <div class="stat-mono"><span class="text-muted">${counts.drafting}</span><span>Drafting</span></div>
            <div class="stat-mono"><span class="text-saffron-deep">${counts.inReview}</span><span>In review</span></div>
            <div class="stat-mono"><span class="text-ok">${counts.ready}</span><span>Ready</span></div>
          </div>
        </div>
        <div class="mt-6">${drafts.length ? drafts.map(draftListItem).join('') : `
          <div class="rounded-[3px] border border-dashed border-line bg-surface/50 p-8 text-center">
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-paper text-muted">${iconSvg('note', 'h-6 w-6')}</div>
            <p class="mt-3 font-sans text-sm text-muted">No drafts yet. Start your first course — it stays private until you submit it.</p>
          </div>`}</div>`;
      document.querySelectorAll('[data-open]').forEach((a) => a.addEventListener('click', (e) => { e.preventDefault(); goToEditor((a as HTMLElement).dataset.open!); }));
      document.querySelectorAll('[data-delete-draft]').forEach((b) => b.addEventListener('click', (e) => {
        e.preventDefault(); e.stopPropagation();
        const btn = e.currentTarget as HTMLElement;
        deleteDraft(btn.dataset.deleteDraft!, btn.dataset.draftTitle || 'this draft', () => goToList(false));
      }));
      document.getElementById('new-draft')!.addEventListener('click', async () => {
        await loadTopics();
        const v = await (window as any).suModalForm({ title: 'New draft', submitLabel: 'Create', fields: [
          { name: 'courseId', label: 'Course id (url-safe slug)' },
          { name: 'title', label: 'Title' },
          { name: 'topic', label: `Topic (one of: ${topics.map((t) => t.id).join(', ')})` },
          { name: 'level', label: 'Level (100, 200, 300…)', type: 'number' },
          { name: 'summary', label: 'Summary (min 40 characters)', type: 'textarea' },
        ] });
        if (!v) return;
        const r = await api('/api/studio/drafts', { method: 'POST', body: JSON.stringify({ courseId: v.courseId, title: v.title, topic: v.topic, level: Number(v.level), summary: v.summary }) });
        if (r.ok) goToEditor(r.d.id); else (window as any).suToast(r.d.error || 'Could not create draft.', 'error');
      });
    }

    async function renderEditor(id: string) {
      const { ok, d } = await api('/api/studio/draft?id=' + encodeURIComponent(id));
      if (!ok) { (window as any).suToast('Could not load draft.', 'error'); goToList(false); return; }
      const { draft, lessons, quiz } = d;
      let meta: any = {}; try { meta = JSON.parse(draft.meta); } catch (e) {}
      const editable = draft.status === 'draft' || draft.status === 'changes_requested';
      const lockedReason = LOCKED_REASON[draft.status];

      let tab: 'overview' | 'lessons' | 'quiz' | 'submit' = 'overview';
      const TABS: Array<[typeof tab, string]> = [['overview', 'Overview'], ['lessons', `Lessons (${lessons.length})`], ['quiz', `Quiz (${quiz.length})`], ['submit', 'Review & submit']];

      app.innerHTML = `
        <button id="back" class="font-sans text-sm text-muted underline">&larr; All drafts</button>
        <div class="mt-4 rounded-[3px] border border-line bg-surface p-6">
          <div class="flex flex-wrap items-center gap-2"><h2 class="text-2xl font-bold text-navy">${esc(draft.title)}</h2>${statusPill(draft.status)}</div>
          <p class="mt-1 font-mono text-xs text-muted">${esc(draft.course_id)} · ${esc(draft.topic)} · level ${esc(draft.level)}</p>
          ${draft.review_notes ? `<div class="mt-3 rounded-[3px] border-l-4 border-saffron-deep bg-saffron-soft p-3 text-sm"><strong>Reviewer notes:</strong> ${esc(draft.review_notes)}</div>` : ''}
          ${lockedReason ? `<div class="mt-3 flex items-start gap-2 rounded-[3px] border-l-4 border-line bg-paper p-3 text-sm text-muted"><span class="mt-0.5 shrink-0">${iconSvg('lock', 'h-4 w-4')}</span><span>${lockedReason}</span></div>` : ''}
          <div id="studio-tabs" class="mt-5 flex flex-wrap gap-1 border-b border-line"></div>
          <div id="studio-panel" class="mt-5"></div>
        </div>`;

      document.getElementById('back')!.addEventListener('click', (e) => { e.preventDefault(); goToList(); });

      const tabsEl = document.getElementById('studio-tabs')!;
      const panel = document.getElementById('studio-panel')!;
      TABS.forEach(([key, label]) => {
        const b = document.createElement('button');
        b.textContent = label;
        b.dataset.k = key;
        b.className = 'px-4 py-2 font-sans text-sm border-b-2 border-transparent text-muted';
        b.addEventListener('click', () => { tab = key; drawTabs(); drawPanel(); });
        tabsEl.appendChild(b);
      });
      function drawTabs() {
        Array.from(tabsEl.children).forEach((b) => {
          const el = b as HTMLElement;
          const on = el.dataset.k === tab;
          el.classList.toggle('border-saffron', on); el.classList.toggle('text-navy', on); el.classList.toggle('font-semibold', on);
        });
      }
      function drawPanel() {
        panel.innerHTML = '';
        if (tab === 'overview') renderOverview();
        else if (tab === 'lessons') renderLessons();
        else if (tab === 'quiz') renderQuiz();
        else renderSubmitTab();
      }

      // ── Overview tab: summary/AI declaration + danger zone ──────────────────
      function renderOverview() {
        panel.innerHTML = `
          <div class="grid gap-2">
            <label class="block font-sans text-sm font-semibold">Summary<textarea id="f-summary" rows="3" class="mt-1 w-full rounded-xl border border-line bg-surface px-3 py-2 font-sans" ${editable ? '' : 'disabled'}>${esc(meta.summary || '')}</textarea></label>
            <label class="block font-sans text-sm font-semibold">Created with AI assistance?
              <select id="f-ai" class="mt-1 rounded-xl border border-line bg-surface px-3 py-2 font-sans" ${editable ? '' : 'disabled'}>
                <option value="true" ${meta.aiAssisted ? 'selected' : ''}>Yes</option>
                <option value="false" ${meta.aiAssisted === false ? 'selected' : ''}>No</option>
              </select>
            </label>
            <label class="block font-sans text-sm font-semibold">Visibility
              <select id="f-visibility" class="mt-1 rounded-xl border border-line bg-surface px-3 py-2 font-sans" ${editable ? '' : 'disabled'}>
                <option value="public" ${draft.visibility !== 'gated' ? 'selected' : ''}>Public — free, fully listed</option>
                <option value="gated" ${draft.visibility === 'gated' ? 'selected' : ''}>Institutional — title &amp; summary public, full content requires cohort access</option>
              </select>
            </label>
            ${editable ? '<button id="save-meta" class="btn justify-self-start">Save summary/declaration</button>' : ''}
          </div>
          ${editable ? `
          <div class="mt-8 rounded-[3px] border border-danger bg-danger-soft p-4">
            <p class="eyebrow text-danger">Danger zone</p>
            <p class="mt-1 font-sans text-xs text-muted">Permanently delete this draft, its lessons, and its quiz. This cannot be undone.</p>
            <button id="delete-draft-btn" class="btn mt-3 border-danger text-danger hover:bg-danger/10">Delete this draft</button>
          </div>` : ''}`;
        if (editable) {
          document.getElementById('save-meta')!.addEventListener('click', async () => {
            const summary = (document.getElementById('f-summary') as HTMLTextAreaElement).value;
            const aiAssisted = (document.getElementById('f-ai') as HTMLSelectElement).value === 'true';
            const visibility = (document.getElementById('f-visibility') as HTMLSelectElement).value;
            const r = await api('/api/studio/draft', { method: 'POST', body: JSON.stringify({ id, action: 'update_meta', summary, aiAssisted, visibility }) });
            (window as any).suToast(r.ok ? 'Saved.' : (r.d.error || 'Could not save.'), r.ok ? 'ok' : 'error');
          });
          document.getElementById('delete-draft-btn')!.addEventListener('click', () => deleteDraft(id, draft.title, () => goToList(false)));
        }
      }

      // ── Lessons tab ───────────────────────────────────────────────────────
      function lessonMedia(ls: any): any[] {
        try { return Array.isArray(ls.media) ? ls.media : JSON.parse(ls.media || '[]'); } catch (e) { return []; }
      }

      const MEDIA_ICON: Record<string, string> = { photo: 'palette', pdf: 'note', video: 'download' };

      function renderLessons() {
        panel.innerHTML = `<div id="lessons"></div>${editable ? '<button id="add-lesson" class="btn mt-3">+ Add lesson</button>' : ''}`;
        const box = document.getElementById('lessons')!;

        const paint = () => {
          box.innerHTML = lessons.length ? lessons.map((ls: any, i: number) => {
            const media = lessonMedia(ls);
            return `
            <div class="mt-3 rounded-xl2 border border-line bg-surface p-4" data-lesson="${i}">
              <div class="flex items-center gap-2"><span class="font-mono text-xs uppercase tracking-wide text-muted">Lesson ${i + 1}</span></div>
              <input class="mt-1 w-full rounded-lg border border-line bg-paper px-2 py-1 font-sans text-sm font-semibold" data-l-title value="${esc(ls.title)}" ${editable ? '' : 'disabled'} />
              <textarea rows="6" class="mt-2 w-full rounded-lg border border-line bg-paper px-2 py-1 font-mono text-xs" data-l-html ${editable ? '' : 'disabled'}>${esc(ls.html)}</textarea>
              <div class="mt-2"><p class="font-mono text-xs uppercase tracking-wide text-muted">Live preview</p><div class="lesson-prose mt-1 rounded-lg border border-line bg-paper p-3 text-sm" data-l-preview>${expandYoutubeEmbeds(ls.html)}</div></div>
              <div class="mt-3 rounded-lg border border-line bg-paper p-3" data-l-media>
                <p class="font-mono text-xs uppercase tracking-wide text-muted">Attached media</p>
                <div class="mt-2 grid gap-2 sm:grid-cols-2" data-media-list>${media.length ? media.map((m: any, mi: number) => `
                  <div class="flex items-center gap-2 rounded-lg border border-line bg-surface px-2 py-1.5 font-sans text-xs">
                    <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded bg-paper text-muted">${iconSvg(MEDIA_ICON[m.kind] || 'note', 'h-3.5 w-3.5')}</span>
                    <span class="truncate">${esc(m.caption || m.key)}</span>
                    ${editable ? `<button class="ml-auto shrink-0 underline" data-remove-media="${mi}">Remove</button>` : ''}
                  </div>`).join('') : '<p class="font-sans text-xs text-muted">None yet.</p>'}</div>
                ${editable ? `
                <div class="mt-2 flex flex-wrap items-center gap-2">
                  <label class="font-sans text-xs">Photo/PDF <input type="file" accept="image/jpeg,image/png,image/webp,application/pdf" data-upload-doc class="block text-xs" /></label>
                  <label class="font-sans text-xs">Video <input type="file" accept="video/mp4,video/webm" data-upload-video class="block text-xs" /></label>
                  <button type="button" class="btn font-sans text-xs" data-insert-youtube>+ YouTube embed</button>
                </div>
                <div class="mt-2 hidden" data-media-progress-wrap><div class="h-1.5 w-full overflow-hidden rounded-full bg-paper"><div class="h-full w-0 bg-saffron transition-all" data-media-progress-bar></div></div></div>
                <div class="mt-1 font-sans text-xs text-muted" data-media-note></div>` : ''}
              </div>
              ${editable ? `<div class="mt-2 flex gap-2"><button class="btn font-sans text-xs" data-save-lesson>${iconSvg('check', 'h-3.5 w-3.5')} Save lesson</button><button class="btn font-sans text-xs border-danger/40 text-danger hover:bg-danger/10" data-delete-lesson>Delete</button></div>` : ''}
            </div>`;
          }).join('') : `<div class="rounded-xl2 border border-dashed border-line bg-surface/50 p-6 text-center font-sans text-sm text-muted">No lessons yet.${editable ? ' Add your first one below.' : ''}</div>`;
          wire();
        };

        function wire() {
          box.querySelectorAll('[data-l-html]').forEach((ta) => ta.addEventListener('input', (e) => {
            const card = (e.target as HTMLElement).closest('[data-lesson]')!;
            (card.querySelector('[data-l-preview]') as HTMLElement).innerHTML = expandYoutubeEmbeds((e.target as HTMLTextAreaElement).value);
          }));
          box.querySelectorAll('[data-save-lesson]').forEach((btn, i) => btn.addEventListener('click', async () => {
            const card = box.querySelectorAll('[data-lesson]')[i];
            const title = (card.querySelector('[data-l-title]') as HTMLInputElement).value;
            const html = (card.querySelector('[data-l-html]') as HTMLTextAreaElement).value;
            const media = lessonMedia(lessons[i]);
            const r = await api('/api/studio/lesson', { method: 'POST', body: JSON.stringify({ draftId: id, idx: i, title, html, media }) });
            (window as any).suToast(r.ok ? 'Lesson saved.' : (r.d.error || 'Could not save lesson.'), r.ok ? 'ok' : 'error');
            if (r.ok) { lessons[i] = { ...lessons[i], title, html }; }
          }));
          box.querySelectorAll('[data-delete-lesson]').forEach((btn, i) => btn.addEventListener('click', async () => {
            if (!confirm(`Delete lesson ${i + 1}? This cannot be undone.`)) return;
            lessons.splice(i, 1);
            await api('/api/studio/draft', { method: 'POST', body: JSON.stringify({ id, action: 'reorder_lessons', order: lessons.map((_: any, j: number) => j) }) });
            paint();
          }));

          box.querySelectorAll('[data-insert-youtube]').forEach((btn, i) => btn.addEventListener('click', async () => {
            const v = await (window as any).suModalForm({ title: 'Insert a YouTube video', submitLabel: 'Insert', fields: [
              { name: 'url', label: 'YouTube URL or video id' },
            ] });
            if (!v || !v.url.trim()) return;
            const videoId = extractYoutubeId(v.url.trim());
            if (!videoId) { (window as any).suToast('Could not recognize a YouTube video id in that.', 'error'); return; }
            const card = box.querySelectorAll('[data-lesson]')[i];
            const ta = card.querySelector('[data-l-html]') as HTMLTextAreaElement;
            ta.value = ta.value + (ta.value.endsWith('\n') ? '' : '\n\n') + `[[youtube:${videoId}]]`;
            (card.querySelector('[data-l-preview]') as HTMLElement).innerHTML = expandYoutubeEmbeds(ta.value);
          }));

          box.querySelectorAll('[data-upload-doc]').forEach((input, i) => input.addEventListener('change', async (e) => {
            const file = (e.target as HTMLInputElement).files?.[0]; if (!file) return;
            const card = box.querySelectorAll('[data-lesson]')[i];
            const note = card.querySelector('[data-media-note]') as HTMLElement;
            const kind = file.type.startsWith('image/') ? 'photo' : 'pdf';
            note.textContent = 'Uploading…';
            const rightsHeaders: Record<string, string> = kind === 'pdf' ? { 'x-upload-rights': 'own', 'x-upload-rights-note': 'Teacher-authored course material' } : {};
            const res = await fetch('/api/upload', { method: 'POST', credentials: 'same-origin', headers: { 'x-upload-kind': kind, 'x-upload-context': `draft:${id}`, 'content-type': file.type, ...rightsHeaders }, body: file })
              .then((r) => r.json().then((d) => ({ ok: r.ok, d })));
            if (!res.ok) { note.textContent = res.d.error || 'Upload failed.'; return; }
            note.textContent = kind === 'pdf' ? 'Uploaded — awaiting admin rights approval before it can be attached to a submitted draft.' : 'Uploaded.';
            const media = lessonMedia(lessons[i]);
            media.push({ key: res.d.key, kind, caption: file.name });
            lessons[i] = { ...lessons[i], media: JSON.stringify(media) };
            paint();
          }));

          box.querySelectorAll('[data-upload-video]').forEach((input, i) => input.addEventListener('change', async (e) => {
            const file = (e.target as HTMLInputElement).files?.[0]; if (!file) return;
            const card = box.querySelectorAll('[data-lesson]')[i];
            const note = card.querySelector('[data-media-note]') as HTMLElement;
            const progressWrap = card.querySelector('[data-media-progress-wrap]') as HTMLElement;
            const progressBar = card.querySelector('[data-media-progress-bar]') as HTMLElement;
            const rights = confirm('Confirm: you own the rights to this video (or it is openly licensed / you have permission to use it)?\nOK = yes, Cancel = do not upload.');
            if (!rights) return;
            note.textContent = 'Starting upload…';
            const create = await api('/api/upload/create', { method: 'POST', body: JSON.stringify({ kind: 'video', context: `draft:${id}`, filename: file.name, size: file.size, contentType: file.type, rights: 'own', rightsNote: 'Teacher-authored lecture video' }) });
            if (!create.ok) { note.textContent = create.d.error || 'Could not start upload.'; return; }
            const { key, uploadId, partSize } = create.d;
            const parts: { partNumber: number; etag: string }[] = [];
            progressWrap.classList.remove('hidden');
            try {
              let partNumber = 1;
              for (let offset = 0; offset < file.size; offset += partSize, partNumber++) {
                const chunk = file.slice(offset, offset + partSize);
                const pct = Math.min(100, Math.round((offset / file.size) * 100));
                note.textContent = `Uploading part ${partNumber} (${pct}%)…`;
                progressBar.style.width = pct + '%';
                const partRes = await fetch(`/api/upload/part?key=${encodeURIComponent(key)}&uploadId=${uploadId}&partNumber=${partNumber}`, { method: 'PUT', credentials: 'same-origin', body: chunk })
                  .then((r) => r.json().then((d) => ({ ok: r.ok, d })));
                if (!partRes.ok) throw new Error(partRes.d.error || 'part upload failed');
                parts.push({ partNumber, etag: partRes.d.etag });
              }
              progressBar.style.width = '100%';
              const complete = await api('/api/upload/complete', { method: 'POST', body: JSON.stringify({ key, uploadId, parts }) });
              if (!complete.ok) throw new Error(complete.d.error || 'could not finalize upload');
              note.textContent = 'Video uploaded — awaiting admin rights approval before it can be attached to a submitted draft.';
              const media = lessonMedia(lessons[i]);
              media.push({ key, kind: 'video', caption: file.name });
              lessons[i] = { ...lessons[i], media: JSON.stringify(media) };
              paint();
            } catch (err: any) {
              note.textContent = err.message || 'Video upload failed.';
              progressWrap.classList.add('hidden');
              await api('/api/upload/abort', { method: 'POST', body: JSON.stringify({ key, uploadId }) });
            }
          }));

          box.querySelectorAll('[data-remove-media]').forEach((btn) => btn.addEventListener('click', (e) => {
            const card = (e.target as HTMLElement).closest('[data-lesson]')!;
            const i = Number(card.getAttribute('data-lesson'));
            const mi = Number((e.target as HTMLElement).getAttribute('data-remove-media'));
            const media = lessonMedia(lessons[i]);
            media.splice(mi, 1);
            lessons[i] = { ...lessons[i], media: JSON.stringify(media) };
            paint();
          }));
        }
        paint();

        if (editable) document.getElementById('add-lesson')!.addEventListener('click', () => {
          lessons.push({ idx: lessons.length, title: 'New lesson', summary: '', html: '<p>Write your lesson here.</p>', media: null });
          paint();
        });
      }

      // ── Quiz tab ──────────────────────────────────────────────────────────
      function renderQuiz() {
        panel.innerHTML = `<div id="quiz-editor"></div>`;
        const box = document.getElementById('quiz-editor')!;
        const paint = () => {
          box.innerHTML = (quiz.length ? quiz.map((q: any, i: number) => {
            const options = Array.isArray(q.options) ? q.options : JSON.parse(q.options || '[]');
            return `<div class="mt-3 rounded-xl2 border border-line bg-surface p-4" data-q="${i}">
              <div class="font-mono text-xs uppercase tracking-wide text-muted">Question ${i + 1}</div>
              <input class="mt-1 w-full rounded-lg border border-line bg-paper px-2 py-1 font-sans text-sm" data-q-text value="${esc(q.q)}" ${editable ? '' : 'disabled'} />
              <div class="mt-2 grid gap-1" data-q-options>${options.map((o: string, oi: number) => `<div class="flex items-center gap-2"><input type="radio" name="ans-${i}" data-q-answer value="${oi}" ${q.answer === oi ? 'checked' : ''} ${editable ? '' : 'disabled'} /><input class="flex-1 rounded-lg border border-line bg-paper px-2 py-1 font-sans text-sm" data-q-option value="${esc(o)}" ${editable ? '' : 'disabled'} /></div>`).join('')}</div>
              ${editable ? '<button class="mt-1 font-sans text-xs underline" data-add-option>+ option</button> <button class="mt-1 font-sans text-xs text-danger underline" data-delete-q>Delete question</button>' : ''}
            </div>` ;
          }).join('') : '<div class="rounded-xl2 border border-dashed border-line bg-surface/50 p-6 text-center font-sans text-sm text-muted">No questions yet.</div>')
            + (editable ? `<div class="mt-4 flex gap-2"><button id="add-q" class="btn font-sans text-xs">+ Add question</button><button id="save-quiz" class="btn btn-primary font-sans text-xs">Save quiz</button></div>` : '');

          box.querySelectorAll('[data-add-option]').forEach((btn, i) => btn.addEventListener('click', () => { const o = Array.isArray(quiz[i].options) ? quiz[i].options : JSON.parse(quiz[i].options || '[]'); o.push('New option'); quiz[i].options = o; paint(); }));
          box.querySelectorAll('[data-delete-q]').forEach((btn, i) => btn.addEventListener('click', () => { quiz.splice(i, 1); paint(); }));
          const addQ = document.getElementById('add-q'); if (addQ) addQ.addEventListener('click', () => { quiz.push({ q: 'New question', options: ['Option A', 'Option B'], answer: 0 }); paint(); });
          const saveQ = document.getElementById('save-quiz'); if (saveQ) saveQ.addEventListener('click', async () => {
            const questions = [...box.querySelectorAll('[data-q]')].map((card) => ({
              q: (card.querySelector('[data-q-text]') as HTMLInputElement).value,
              options: [...card.querySelectorAll('[data-q-option]')].map((i) => (i as HTMLInputElement).value),
              answer: Number((card.querySelector('[data-q-answer]:checked') as HTMLInputElement)?.value ?? 0),
            }));
            const r = await api('/api/studio/quiz', { method: 'POST', body: JSON.stringify({ draftId: id, questions }) });
            (window as any).suToast(r.ok ? 'Quiz saved.' : (r.d.error || 'Could not save quiz.'), r.ok ? 'ok' : 'error');
          });
        };
        paint();
      }

      // ── Review & submit tab ──────────────────────────────────────────────
      // The prototype's "blocked" card -- a danger-bordered box with a navy
      // mono console block -- applied to the REAL readiness errors this
      // endpoint returns (a flat string[]; there is no per-line Gurbani
      // citation state to render, see the file-header note above).
      function errorConsole(errors: string[]): string {
        return `<div class="rounded-[3px] border border-danger bg-surface p-5">
          <p class="eyebrow text-danger">Not ready to submit</p>
          <div class="mt-3 rounded-[2px] bg-brand p-4 font-mono text-xs leading-7 text-white">${errors.map((e) => esc(e)).join('<br>')}</div>
        </div>`;
      }

      function renderSubmitTab() {
        panel.innerHTML = `
          <button id="validate" class="btn">${iconSvg('check', 'h-4 w-4')} Check readiness</button>
          <div id="validate-out" class="mt-3 font-sans text-sm"></div>
          ${editable ? '<button id="submit-draft" class="btn btn-primary mt-6">Submit for review</button>' : ''}`;
        document.getElementById('validate')!.addEventListener('click', async () => {
          const r = await api('/api/studio/validate?id=' + encodeURIComponent(id));
          const out = document.getElementById('validate-out')!;
          out.innerHTML = r.ok && r.d.valid
            ? `<p class="flex items-center gap-2 text-ok font-semibold">${iconSvg('check', 'h-4 w-4')} Ready to submit.</p>`
            : errorConsole(r.d.errors || []);
        });
        if (editable) document.getElementById('submit-draft')!.addEventListener('click', async () => {
          const r = await api('/api/studio/submit', { method: 'POST', body: JSON.stringify({ id }) });
          if (r.ok) { (window as any).suToast('Submitted for review.', 'ok'); goToList(); }
          else {
            const out = document.getElementById('validate-out')!;
            out.innerHTML = errorConsole(r.d.errors || [r.d.error]);
          }
        });
      }

      drawTabs();
      drawPanel();
    }

    const initialDraft = new URLSearchParams(location.search).get('draft');
    if (initialDraft) renderEditor(initialDraft); else renderList();
  </script>
</Base>
