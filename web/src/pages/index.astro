---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import '../styles/home.css';
import { topics, published } from '../lib/data';
import { SITE, ldJson } from '../lib/site';
import { departments, departmentEntryLabel, schoolCountWord } from '../lib/departments';

// The portal grid ("Schools & departments" section): one card per real
// department, feeding {portals.map(...)} below.
const short = (name: string) => name.replace(/^Department(s)? of (the )?/, '').replace(/ Department$/, '').replace(/^School of /, '');
const portals = [
  ...departments.map((d) => ({
    href: `/departments/${d.slug}`,
    name: short(d.name),
    full: d.name,
    tagline: d.tagline,
    accent: d.accent,
    meta: departmentEntryLabel(d),
  })),
];

const ld = {
  '@context': 'https://schema.org', '@type': 'CollegeOrUniversity',
  '@id': SITE + '/#org', // merges with the Organization node Base.astro emits site-wide
  name: 'Sikhi University', url: SITE + '/', description: 'A free, open online university for Sikhi and modern skills.', logo: SITE + '/assets/brand/icon-512.png', image: SITE + '/assets/brand/share-2026.png',
  sameAs: ['https://sikharchive.net'],
};
// WebSite (with the sitelinks SearchAction) is now emitted site-wide by Base.astro.
---
<Base title="Sikhi University, free, open Sikhi & modern-skills courses" ambient="hall" bodyClass="su-home">
  <script type="application/ld+json" set:html={ldJson(ld)} slot="head" />
  <script type="module" src="/scripts/model-viewer.min.js" slot="head" />


  <header class="home-hero">
    <div class="wrap">
      <div class="home-masthead"><span class="eyebrow" data-i18n="home.eyebrow">Free · Open · Worldwide</span><span class="eyebrow home-motto">An open door to a deeper understanding</span></div>
      <div class="home-hero-grid">
        <div class="home-intro">
          <p class="eyebrow text-saffron-deep">Sikhi University</p>
          <h1 class="text-display-xl">A lifetime of learning.<br /><span>Rooted in Sikhi.</span></h1>
          <p class="home-description">Explore Sikh history, Gurbani, philosophy, language and the arts. Begin with your first question. Follow it somewhere meaningful.</p>
          <div class="home-actions">
            <a class="btn home-primary" href="/catalog"><span data-i18n="home.cta.browse">Browse courses</span><span aria-hidden="true">↗</span></a>
            <a class="home-text-link" href="https://sikhi.io/">Visit Sikhi.io <span aria-hidden="true">↗</span></a>
          </div>
          <p class="home-note">Learn at your own pace. Open to everyone.</p>
        </div>
        <div class="crest-study">
          <div class="crest-stage">
            <img class="crest-fallback" src="/assets/brand/crest-2026.webp" alt="Sikhi University coat of arms" width="1254" height="1254" fetchpriority="high" />
            <model-viewer id="su-crest-model" data-src="/assets/brand/crest-3d-detail-2026.glb" alt="Sikhi University crest in 3D. Drag to explore." camera-orbit="0deg 90deg 100%" field-of-view="30deg" camera-controls disable-zoom interaction-prompt="none" exposure="1" shadow-intensity="0.5" environment-image="neutral" loading="eager"><span slot="progress-bar" hidden aria-hidden="true"></span></model-viewer>
          </div>
          <p class="crest-caption">Learn · Reflect · Serve</p>
          <button id="replay-intro" type="button" class="home-text-link mx-auto block mt-3 px-3 py-2 text-sm">Replay intro</button>
        </div>
      </div>
      <div class="home-facts">
        <div><strong>{published.length}</strong><span data-i18n="home.stat.courses">courses</span></div>
        <div><strong>{topics.length}</strong><span data-i18n="home.stat.subjects">subjects</span></div>
        <div><strong>5 stages</strong><span data-i18n="home.stats2.levels">Learning journey</span></div>
        <a href="/about"><span>One shared purpose.</span><strong>Learning for life <span aria-hidden="true">↗</span></strong></a>
      </div>
    </div>
  </header>
  <script>
    const crest = document.getElementById('su-crest-model');
    function loadCrest() {
      if (crest && !crest.hasAttribute('src')) crest.setAttribute('src', crest.dataset.src!);
    }
    if (document.documentElement.dataset.introReady === 'true') loadCrest();
    else window.addEventListener('su:intro-ready', loadCrest, { once:true });
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    let frame = 0;
    let played = false;
    let waiting: MutationObserver | undefined;
    function stopWobble() {
      cancelAnimationFrame(frame);
      waiting?.disconnect();
    }
    function wobble() {
      if (!crest || played || reducedMotion.matches) return;
      played = true;
      const start = performance.now();
      function tick(now: number) {
        const progress = Math.min((now - start) / 1800, 1);
        const angle = Math.sin(progress * Math.PI * 4) * 5 * (1 - progress) ** 2;
        crest!.setAttribute('camera-orbit', `${angle.toFixed(3)}deg 90deg 100%`);
        if (progress < 1) frame = requestAnimationFrame(tick);
      }
      frame = requestAnimationFrame(tick);
    }
    crest?.addEventListener('load', () => {
      crest.parentElement?.classList.add('crest-loaded');
      const intro = document.getElementById('university-intro');
      if (intro && !intro.hidden) {
        waiting = new MutationObserver(() => { if (intro.hidden) { waiting?.disconnect(); wobble(); } });
        waiting.observe(intro, { attributes:true, attributeFilter:['hidden'] });
      } else wobble();
    });
    // Hand control to the visitor immediately if they drag or use the keyboard.
    crest?.addEventListener('pointerdown', stopWobble, { once:true });
    crest?.addEventListener('keydown', stopWobble, { once:true });
    reducedMotion.addEventListener('change', () => {
      if (reducedMotion.matches) { stopWobble(); crest?.setAttribute('camera-orbit','0deg 90deg 100%'); }
    });
    window.addEventListener('pagehide', stopWobble, { once:true });
    crest?.addEventListener('error', () => crest.parentElement?.classList.remove('crest-loaded'));
  </script>

  <section id="start-learning" class="home-start">
    <div class="wrap">
      <div class="home-section-heading"><div><p class="eyebrow text-saffron-deep">Your next chapter</p><h2 class="text-display-sm">Where would you like to begin?</h2></div><a class="home-text-link" href="/catalog#paths">All learning paths <span aria-hidden="true">↗</span></a></div>
      <div class="start-options">
        {[
          { n: '01', icon: 'diya', title: 'Begin with the foundations', text: 'New to Sikhi? Build an understanding, one question and one lesson at a time.', href: '/catalog#foundations', label: 'Explore the foundations' },
          { n: '02', icon: 'book', title: 'Make time for Gurbani', text: 'Read, listen and practise pronunciation with the Santhya reader.', href: '/santhiya', label: 'Open the reader' },
          { n: '03', icon: 'robot', title: 'Build something meaningful', text: 'Study software and AI engineering. Put your learning to work for the sangat.', href: '/technology', label: 'Enter the institute' },
        ].map(item => <a class="start-option" href={item.href}><div class="start-option-top"><Icon name={item.icon} class="h-6 w-6" /><span class="font-mono">{item.n}</span></div><h3>{item.title}</h3><p>{item.text}</p><span class="start-option-link">{item.label}<span aria-hidden="true">↗</span></span></a>)}
      </div>
    </div>
  </section>

  <section id="daily-shabad" hidden class="home-shabad">
    <div class="wrap home-shabad-inner">
      <div><p class="eyebrow text-saffron">Pause. Read. Reflect.</p><a id="ds-link" href="/santhiya?src=sggs" class="home-text-link">Read this Ang <span aria-hidden="true">↗</span></a></div>
      <div><p id="ds-line" lang="pa" class="shabad text-white"></p><p id="ds-cite" lang="pa" class="eyebrow mt-4 text-saffron"></p></div>
    </div>
  </section>

  <!-- Continue-learning resume card (E5): shown only if the visitor has a course in
       progress. Reads localStorage (no network for the anonymous case); resolves the
       title from the slim index. Hidden by default so it never flashes empty. -->
  <div id="su-resume" hidden class="wrap pt-6">
    <a id="su-resume-link" href="#" class="flex items-center justify-between gap-4 rounded-xl2 border border-saffron bg-saffron-soft px-5 py-4 transition hover:-translate-y-0.5 hover:shadow-lift">
      <span>
        <span class="block font-sans text-xs font-bold uppercase tracking-wider text-saffron-deep" data-i18n="home.resume.label">Continue learning</span>
        <span id="su-resume-title" class="block font-serif text-lg font-bold text-navy"></span>
      </span>
      <span class="shrink-0 font-sans text-sm font-semibold text-navy" data-i18n="home.resume.cta">Resume &rarr;</span>
    </a>
  </div>
  <script>
    (function () {
      var get = function (k, d) { try { var v = localStorage.getItem(k); return v === null ? d : JSON.parse(v); } catch (e) { return d; } };
      // Prefer the explicit last-opened course; else the in-progress course with the
      // most completed lessons.
      var id = get('last_course', null);
      if (!id) {
        var best = null, bestN = 0;
        for (var i = 0; i < localStorage.length; i++) {
          var key = localStorage.key(i); if (key.indexOf('done_') !== 0) continue;
          var d = get(key, {}); var n = 0; for (var k in d) if (d[k]) n++;
          if (n > bestN) { bestN = n; best = key.slice(5); }
        }
        id = best;
      }
      if (!id) return;
      fetch('/data/index.json').then(function (r) { return r.json(); }).then(function (data) {
        var c = (data.courses || []).find(function (x) { return x.id === id; });
        if (!c) return;
        document.getElementById('su-resume-title').textContent = c.title;
        document.getElementById('su-resume-link').href = '/course/' + id;
        document.getElementById('su-resume').hidden = false;
      }).catch(function () {});
    })();
  </script>

  <script>
    import { initDailyShabad } from '../lib/daily-shabad';
    initDailyShabad();
  </script>

  <!-- The portal: every department, each previewing its own world -->
  <section id="home-portal">
    <div class="wrap">
      <div class="portal-head">
        <p class="eyebrow text-saffron-deep">Schools &amp; departments</p>
        <h2 class="text-display-sm mt-3 font-bold text-navy">{schoolCountWord} schools. One university.</h2>
        <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">Every course belongs to a department, each with its own faculty, its own signature courses, its own front door. Step through the one that fits your question.</p>
      </div>
      <div class="portal-grid">
        {portals.map((d, i) => (
          <a href={d.href} class="portal-card" data-school={d.href.split('/').pop()}>
            <span class="portal-media">
              <span class="portal-veil" aria-hidden="true"></span>
              <span class="portal-cover-label">Sikhi University</span>
              <span class="portal-cover-title">{d.name}</span>
              <span class="portal-number font-mono">{String(i + 1).padStart(2, '0')}</span>
            </span>
            <span class="portal-body">
              <span class="portal-tag">{d.tagline}</span>
              <span class="portal-meta">{d.meta}<span class="portal-arrow" aria-hidden="true">&rarr;</span></span>
            </span>
          </a>
        ))}
      </div>
      <p class="portal-foot">
        <a class="btn" href="/departments">Walk the full directory &rarr;</a>
      </p>
    </div>
  </section>

  <!-- Mission -->
  <section id="mission-section" class="text-white">
    <div class="wrap py-20">
      <p class="eyebrow text-center text-saffron" data-i18n="home.mission.eyebrow">Our mission</p>
      <h2 class="text-display-sm mx-auto mt-4 max-w-4xl xl:max-w-5xl text-center font-bold text-white" data-i18n="home.mission.heading">From the wisdom of our ancestors to a living bond with Waheguru</h2>
      <p class="mx-auto mt-5 max-w-4xl xl:max-w-5xl text-center text-lg text-white/90">We learn from those who came before us, the Gurus, the scholars, the saints and the soldiers, and carry their light forward. We begin with the basics of Sikhi and keep going into its depths, until one truth becomes unmistakable: that <strong>Sri Guru Granth Sahib Ji</strong> is the living Guru and the one universal Truth. And the real aim of all of it is simple, to build an intimate, personal relationship with <strong>Waheguru</strong>.</p>
      <div class="mt-12 grid gap-4 sm:grid-cols-2">
        {[
          ['diya', 'Learn from our ancestors', 'The Gurus, scholars, saints and soldiers whose lives and writings light the way, taught from authentic sources.'],
          ['waves', 'From the basics to the depths', 'Start with the simplest questions and follow them as far as you dare. The deeper you go, the more there is.'],
          ['book', 'Sri Guru Granth Sahib Ji', 'The living Guru and the universal Truth. Every path here leads back to the Shabad, read it for yourself in our reader.'],
          ['lotus', 'A relationship with Waheguru', 'Not just knowledge, but Naam, Simran and seva, a living, personal bond with the Divine.'],
        ].map((m, i) => (
          <div class="card-lift">
            <Icon name={m[0]} class="h-8 w-8 text-saffron-deep" />
            <h3 class="mt-2 text-lg font-bold text-navy">{m[1]}</h3>
            <p class="mt-1 text-ink/80">{m[2]}</p>
          </div>
        ))}
      </div>
      <div class="mt-12 flex flex-wrap justify-center gap-3">
        <a class="btn btn-primary" href="/santhiya?src=sggs">Read Sri Guru Granth Sahib Ji</a>
        <a class="btn btn-ghost" href="/catalog#paths">Start a learning path</a>
        <a class="btn btn-ghost" href="/about">Why we built this</a>
      </div>
    </div>
  </section>

  <!-- Built for current and future generations -->
  <section id="built-for-future" class="text-white">
    <div class="wrap py-20">
      <div class="mx-auto max-w-5xl xl:max-w-6xl">
        <div class="grid gap-10 lg:grid-cols-2 items-center">
          <div>
            <p class="eyebrow text-saffron" data-i18n="home.future.eyebrow">For every generation</p>
            <h2 class="text-display-sm mt-4 font-bold text-white" data-i18n="home.future.heading">Built for Sikhs of today and tomorrow.</h2>
            <p class="mt-5 text-lg text-white/85 leading-relaxed" data-i18n="home.future.sub1">The Sikh diaspora spans every continent. Our children grow up in Toronto, London, Nairobi, Sydney, and São Paulo. They have questions that deserve real answers, not surface-level summaries, but deep, honest, scholarly engagement with Sikhi.</p>
            <p class="mt-4 text-white/80 leading-relaxed" data-i18n="home.future.sub2">Sikhi University was built so that the next generation never has to choose between their heritage and their intellectual rigour. They can have both. They deserve both.</p>
            <div class="mt-8 flex flex-wrap gap-3">
              <a class="btn btn-primary" href="/catalog" data-i18n="home.future.cta1">Start learning free</a>
              <a class="btn btn-ghost" href="/about" data-i18n="home.future.cta2">Our story →</a>
            </div>
          </div>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            {[
              ['sprout', 'Discover', 'Complete beginners, no background needed'],
              ['book', 'Explore & practise', 'Growing students ready to go deeper'],
              ['microscope', 'Deepen', 'Advanced learners in serious study'],
              ['cap', 'Research', 'Graduate seminars for scholars'],
              ['pen', 'Languages change', 'Gurbani was written in Punjabi, Braj Bhasha, Sant Bhasha, and Persian. Every course here bridges the Guru\'s depth to the language you live in today.'],
              ['diya', 'ਸਿੱਖ means learner', 'Gurbani\'s call to forever seek is written into our name. This university exists to honour that call, for every generation, everywhere on Earth.'],
            ].map((t, i) => (
              <div class="card-lift p-4">
                <Icon name={t[0]} class="h-7 w-7 text-saffron-deep" />
                <div class="mt-2 font-bold text-navy text-sm">{t[1] === 'ਸਿੱਖ means learner' ? (<><span lang="pa" class="gur">ਸਿੱਖ</span> means learner</>) : t[1]}</div>
                <div class="mt-1 text-xs text-ink/70">{t[2]}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Institute of Technology, the engineering wing -->
  <section id="technology-wing" class="text-white">
    <div class="wrap py-20">
      <div class="mx-auto max-w-5xl xl:max-w-6xl">
        <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
          <div>
            <p class="eyebrow text-saffron">Institute of Technology</p>
            <h2 class="text-display-sm mt-4 font-bold text-white">Learn to build, and build for the Panth.</h2>
            <p class="mt-5 text-lg text-white/85 leading-relaxed">Sikhi University's engineering wing teaches software and AI engineering from first principles, in a code lab that runs in your browser. Every phase is framed around what you could build for the sangat, Gurbani search, archive digitisation, Gurmukhi tools, gurdwara systems.</p>
            <p class="mt-4 text-white/80 leading-relaxed">Twenty phases from setup to autonomous agents, a from-scratch coding dojo, the Claude Code guide, and a &ldquo;Build for the Panth&rdquo; capstone. Finish a phase, pass its server-graded exam, earn a verifiable certificate.</p>
            <div class="mt-8 flex flex-wrap gap-3">
              <a class="btn btn-primary" href="/technology">Enter the Institute of Technology &rarr;</a>
              <a class="btn btn-ghost" href="/technology/atlas">Open Source Atlas &rarr;</a>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-4">
            {[
              ['20', 'phases', 'Setup, math, ML, deep learning, transformers, LLMs, agents, infra, safety'],
              ['500+', 'lessons', 'Adapted from AI Engineering from Scratch (MIT), reframed for seva'],
              ['In-browser', 'code lab', 'Python, JavaScript and HTML run right on the page, nothing to install'],
              ['Verifiable', 'certificates', 'Server-graded phase exams, each certificate checkable at /verify'],
            ].map((t, i) => (
              <div class="border border-line bg-surface rounded-xl2 p-5">
                <div class="text-2xl font-bold text-navy">{t[0]}</div>
                <div class="mt-0.5 font-sans text-sm font-semibold text-navy">{t[1]}</div>
                <div class="mt-2 text-xs text-ink/70 leading-relaxed">{t[2]}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Call to action -->
  <section class="text-white">
    <div class="wrap py-24 text-center">
      <img src="/assets/brand/closing-crest-final-2026.webp" width="1254" height="1254" alt="Sikhi University crest" class="home-closing-crest mx-auto w-auto" />
      <p class="eyebrow text-saffron mt-6" data-i18n="home.cta2.eyebrow">Begin today</p>
      <h2 class="text-display-sm mt-4 font-bold text-white" data-i18n="home.cta2.heading">Start your journey today.</h2>
      <p class="mx-auto mt-4 max-w-xl text-lg text-white/85" data-i18n="home.cta2.sub">It takes thirty seconds to begin. No sign-up required. Pick a course, start a lesson, and see how deep Sikhi really goes.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a class="btn btn-primary" href="/catalog" data-i18n="home.cta2.browseall">Browse all courses</a>
        <a class="btn btn-ghost" href="/catalog#paths" data-i18n="home.cta2.path">Follow a learning path</a>
        <a class="btn btn-ghost" href="/santhiya?src=sggs" data-i18n="home.cta2.read">Read the Guru Granth Sahib Ji</a>
      </div>
    </div>
  </section>

</Base>
