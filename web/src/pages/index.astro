---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { topics, published, paths, TOPIC_ICONS } from '../lib/data';
import { SITE, ldJson } from '../lib/site';

// "The schools" ruled panel below the hero (prototype 327–341) numbers its
// entries with roman numerals generated by index — never hardcoded — since
// the real subject list (23) is longer than the prototype's 10-school sample.
function toRoman(n: number): string {
  const table: [number, string][] = [
    [1000, 'M'], [900, 'CM'], [500, 'D'], [400, 'CD'], [100, 'C'], [90, 'XC'],
    [50, 'L'], [40, 'XL'], [10, 'X'], [9, 'IX'], [5, 'V'], [4, 'IV'], [1, 'I'],
  ];
  let out = '';
  for (const [v, s] of table) { while (n >= v) { out += s; n -= v; } }
  return out;
}
const ld = {
  '@context': 'https://schema.org', '@type': 'CollegeOrUniversity',
  '@id': SITE + '/#org', // merges with the Organization node Base.astro emits site-wide
  name: 'Sikhi University', url: SITE + '/', description: 'A free, open online university for Sikhi and modern skills.', logo: SITE + '/assets/icon-512.png', image: SITE + '/assets/og-image.png',
  sameAs: ['https://sikharchive.net'],
};
// WebSite (with the sitelinks SearchAction) is now emitted site-wide by Base.astro.
---
<Base title="Sikhi University — free, open Sikhi & modern-skills courses" ambient="hall" bodyClass="su-home">
  <script type="application/ld+json" set:html={ldJson(ld)} slot="head" />
  <!-- self-hosted (not the unpkg CDN — CSP script-src is 'self' only) -->
  <script type="module" src="/scripts/model-viewer.min.js" slot="head" />

  <!-- Editorial hero (redesign task 5 / Decision 7): the prototype's compact
       dark hero (`ishome`, prototype lines 309–326) replaces the cinematic
       scroll-scrubbed film opener. The old CinematicHero.astro component was
       deleted in the redesign's whole-branch review pass (task 21 follow-up)
       after sitting unmounted and unimported since this task — its git
       history (see `git log --follow` on this path) is the record if it's
       ever wanted back. -->
  <header class="hero-midnight">
    <div class="wrap relative py-14 sm:py-20">
      <div class="grid items-center gap-12 lg:grid-cols-[minmax(0,1fr)_auto]">
        <div class="relative">
          <!-- Daily Shabad leading verse (prototype's ਸੋਚੈ tuk + ਅੰਗ ੧ citation
               row, lines 316–317): server-rendered hidden shell; daily-shabad.ts
               fills the verse VERBATIM from the local corpus and unhides it —
               never hardcoded here. The hairline below the citation lives
               inside this shell so it only appears alongside a real verse. -->
          <div id="daily-shabad" hidden class="max-w-2xl">
            <p id="ds-line" lang="pa" class="shabad text-2xl leading-relaxed text-white sm:text-3xl" style="text-wrap:balance"></p>
            <p id="ds-cite" lang="pa" class="eyebrow mt-4 text-saffron"></p>
            <a id="ds-link" href="/santhiya?src=sggs" class="mt-3 inline-block font-sans text-sm font-semibold text-saffron hover:underline">Read this Ang →</a>
            <div aria-hidden="true" class="mt-8 h-px bg-white/15"></div>
          </div>

          <p class="eyebrow mt-8 text-saffron" data-i18n="home.eyebrow">Free · Open · Worldwide</p>
          <h1 class="text-display mt-4 max-w-3xl font-bold text-white">Dive into the depths of <span class="text-saffron">Sikhi</span>.</h1>
          <p class="mt-5 max-w-2xl text-lg text-white/85" data-i18n="home.herosub">A free, open university anyone, anywhere can attend. Start at the surface and keep going — Sikh history, theology, philosophy, language, music and the arts, taught from authentic sources. The deeper you go, the more there is.</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a class="btn btn-primary" href="/catalog" data-i18n="home.cta.browse">Browse courses</a>
            <a class="btn btn-ghost" href="https://sikharchive.net" target="_blank" rel="noopener noreferrer" data-i18n="home.cta.archive">Visit Sikh Archive →</a>
          </div>

          <div class="mt-12 flex flex-wrap gap-x-12 gap-y-6">
            <div class="stat-mono">
              <span class="text-saffron" data-countup={published.length} data-countup-suffix="+">{published.length}+</span>
              <span class="text-white/70" data-i18n="home.stat.courses">courses</span>
            </div>
            <div class="stat-mono">
              <span class="text-saffron" data-countup={topics.length}>{topics.length}</span>
              <span class="text-white/70" data-i18n="home.stat.subjects">subjects</span>
            </div>
            <div class="stat-mono">
              <span class="text-saffron" data-countup="100" data-countup-suffix="%">100%</span>
              <span class="text-white/70" data-i18n="home.stat.free">free</span>
            </div>
            <div class="stat-mono">
              <span class="text-saffron" data-i18n="home.stat.open">Open</span>
              <span class="text-white/70" data-i18n="home.stat.worldwide">to all, worldwide</span>
            </div>
          </div>
        </div>
        <div class="relative hidden justify-self-center lg:block">
          <div aria-hidden="true" class="glow-saffron pointer-events-none absolute -inset-12"></div>
          <model-viewer
            src="/assets/sikh-uni-crest-v2.glb"
            poster="/assets/su-crest-ivory.png"
            alt="A rotating 3D model of the Sikhi University crest"
            auto-rotate
            auto-rotate-delay="0"
            rotation-per-second="18deg"
            camera-controls
            disable-zoom
            interaction-prompt="none"
            exposure="1.1"
            shadow-intensity="0.8"
            environment-image="neutral"
            loading="lazy"
            class="relative block"
            style="height: clamp(24rem, 32vw, 45rem); width: clamp(24rem, 32vw, 45rem); background:transparent; --poster-color:transparent;">
          </model-viewer>
        </div>
      </div>

      <!-- "The schools" ruled panel (prototype 327–341): fed by the real
           `topics` list, not the prototype's 10-school sample — roman
           numerals generated from each entry's real index via toRoman(). -->
      <div class="relative mt-16 border-t border-white/15 pt-6 sm:mt-20">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <p class="eyebrow text-white/70" data-i18n="home.schools.eyebrow">The schools</p>
          <img src="/assets/su-crest-ivory.png" alt="" class="h-[52px] w-auto opacity-90" />
        </div>
        <div class="mt-5 grid gap-x-6 gap-y-5" style="grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));">
          {topics.map((t, i) => (
            <a href={`/catalog#${t.id}`} class="border-t border-white/15 pt-2.5 transition hover:border-saffron">
              <span class="font-mono text-[10px] text-saffron">{toRoman(i + 1)}</span>
              <div class="mt-1 text-[15px] text-white">{t.name}</div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </header>

  <!-- Continue-learning resume card (E5): shown only if the visitor has a course in
       progress. Reads localStorage (no network for the anonymous case); resolves the
       title from the slim index. Hidden by default so it never flashes empty. -->
  <div id="su-resume" hidden class="wrap pt-6">
    <a id="su-resume-link" href="#" class="flex items-center justify-between gap-4 rounded-xl2 border border-saffron bg-saffron-soft px-5 py-4 transition hover:-translate-y-0.5 hover:shadow-lift">
      <span>
        <span class="block font-sans text-xs font-bold uppercase tracking-wider text-saffron-deep" data-i18n="home.resume.label">Continue learning</span>
        <span id="su-resume-title" class="block font-serif text-lg font-bold text-navy"></span>
      </span>
      <span class="shrink-0 font-sans text-sm font-semibold text-navy" data-i18n="home.resume.cta">Resume &rarr;</span>
    </a>
  </div>
  <script>
    (function () {
      var get = function (k, d) { try { var v = localStorage.getItem(k); return v === null ? d : JSON.parse(v); } catch (e) { return d; } };
      // Prefer the explicit last-opened course; else the in-progress course with the
      // most completed lessons.
      var id = get('last_course', null);
      if (!id) {
        var best = null, bestN = 0;
        for (var i = 0; i < localStorage.length; i++) {
          var key = localStorage.key(i); if (key.indexOf('done_') !== 0) continue;
          var d = get(key, {}); var n = 0; for (var k in d) if (d[k]) n++;
          if (n > bestN) { bestN = n; best = key.slice(5); }
        }
        id = best;
      }
      if (!id) return;
      fetch('/data/index.json').then(function (r) { return r.json(); }).then(function (data) {
        var c = (data.courses || []).find(function (x) { return x.id === id; });
        if (!c) return;
        document.getElementById('su-resume-title').textContent = c.title;
        document.getElementById('su-resume-link').href = '/course/' + id;
        document.getElementById('su-resume').hidden = false;
      }).catch(function () {});
    })();
  </script>

  <script>
    import { initDailyShabad } from '../lib/daily-shabad';
    initDailyShabad();
  </script>

  <!-- Subjects marquee: every subject drifts past, linking into the catalog -->
  <section class="border-y border-line bg-surface texture-manuscript">
    <div class="py-5">
      <div class="marquee" aria-label="Subjects taught at Sikhi University">
        <div>
          {topics.map((t) => (
            <a href={`/catalog#${t.id}`} class="inline-flex items-center gap-2 rounded-full border border-line bg-paper px-4 py-2 text-sm font-medium text-navy transition hover:-translate-y-0.5 hover:border-saffron hover:text-saffron-deep">
              <Icon name={TOPIC_ICONS[t.id] ?? 'book'} class="h-4 w-4 shrink-0 text-saffron-deep" />
              <span>{t.name}</span>
            </a>
          ))}
          {/* Second copy exists only to make the -50% loop seamless — hidden
              from the accessibility tree and tab order. */}
          {topics.map((t) => (
            <a href={`/catalog#${t.id}`} aria-hidden="true" tabindex="-1" class="inline-flex items-center gap-2 rounded-full border border-line bg-paper px-4 py-2 text-sm font-medium text-navy transition hover:-translate-y-0.5 hover:border-saffron hover:text-saffron-deep">
              <Icon name={TOPIC_ICONS[t.id] ?? 'book'} class="h-4 w-4 shrink-0 text-saffron-deep" />
              <span>{t.name}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Mission -->
  <section id="mission-section" class="text-white">
    <div class="wrap py-20">
      <p class="eyebrow text-center text-saffron" data-i18n="home.mission.eyebrow">Our mission</p>
      <h2 class="text-display-sm mx-auto mt-4 max-w-4xl xl:max-w-5xl text-center font-bold text-white" data-i18n="home.mission.heading">From the wisdom of our ancestors to a living bond with Waheguru</h2>
      <p class="mx-auto mt-5 max-w-4xl xl:max-w-5xl text-center text-lg text-white/90">We learn from those who came before us — the Gurus, the scholars, the saints and the soldiers — and carry their light forward. We begin with the basics of Sikhi and keep going into its depths, until one truth becomes unmistakable: that <strong>Sri Guru Granth Sahib Ji</strong> is the living Guru and the one universal Truth. And the real aim of all of it is simple — to build an intimate, personal relationship with <strong>Waheguru</strong>.</p>
      <div class="mt-12 grid gap-4 sm:grid-cols-2">
        {[
          ['diya', 'Learn from our ancestors', 'The Gurus, scholars, saints and soldiers whose lives and writings light the way — taught from authentic sources.'],
          ['waves', 'From the basics to the depths', 'Start with the simplest questions and follow them as far as you dare. The deeper you go, the more there is.'],
          ['book', 'Sri Guru Granth Sahib Ji', 'The living Guru and the universal Truth. Every path here leads back to the Shabad — read it for yourself in our reader.'],
          ['lotus', 'A relationship with Waheguru', 'Not just knowledge, but Naam, Simran and seva — a living, personal bond with the Divine.'],
        ].map((m, i) => (
          <div class="reveal card-lift" data-tilt data-reveal-delay={i * 90}>
            <Icon name={m[0]} class="h-8 w-8 text-saffron-deep" />
            <h3 class="mt-2 text-lg font-bold text-navy">{m[1]}</h3>
            <p class="mt-1 text-ink/80">{m[2]}</p>
          </div>
        ))}
      </div>
      <div class="mt-12 flex flex-wrap justify-center gap-3">
        <a class="btn btn-primary" href="/santhiya?src=sggs">Read Sri Guru Granth Sahib Ji</a>
        <a class="btn btn-ghost" href="/catalog#paths">Start a learning path</a>
        <a class="btn btn-ghost" href="/about">Why we built this</a>
      </div>
    </div>
  </section>

  <!-- First of its kind -->
  <section id="first-of-kind">
    <div class="wrap py-20">
      <div class="rounded-xl2 border border-line bg-surface p-8 sm:p-12">
      <div class="mx-auto max-w-4xl xl:max-w-5xl text-center">
        <p class="eyebrow text-saffron-deep" data-i18n="home.first.eyebrow">First of its kind</p>
        <h2 class="text-display-sm mt-4 font-bold" data-i18n="home.first.heading">Nothing like this has ever existed for Sikhi.</h2>
        <p class="mt-5 text-lg text-muted" data-i18n="home.first.sub">For generations, serious study of Sikhi required access to rare books, a living scholar, or years of searching. Sikhi University changes that — permanently. Every course, every seminar, every lesson is here, free, for anyone on Earth.</p>
      </div>

      <div class="mt-14 grid gap-6 sm:grid-cols-2">
        {[
          {
            img: 'ladder',
            title: 'A complete academic ladder',
            body: '100-level introductions to 500-level graduate seminars — the only Sikh learning platform with a full university-style curriculum, from your first question to doctoral depth.',
          },
          {
            img: 'quill',
            title: 'Scholar-attributed courses',
            body: 'Every course is taught by a named scholar — Prof. Sahib Singh, Kavi Santokh Singh, Bhai Randhir Singh, Bhai Kahn Singh Nabha, Bhai Vir Singh and more — grounding each lesson in authentic, authoritative scholarship.',
          },
          {
            img: 'globe',
            title: 'Open to the whole world',
            body: 'No fees. No visa. No Gurdwara nearby required. A Sikh in Kenya, Canada, Chile, or Australia gets the same world-class education as one sitting in Amritsar.',
          },
          {
            img: 'books',
            title: `${published.length}+ courses across 23 subjects`,
            body: 'Theology, philosophy, history, language, music, the arts, economics, science, health, parenting — Sikhi touches every dimension of life, and we cover all of it.',
          },
          {
            img: 'magnifier',
            title: 'Graduate seminars that go all the way',
            body: 'Sikh hermeneutics. Manuscript paleography. Gurmat metaphysics. Comparative mysticism. For students who refuse to stop at the surface — we go as deep as there is to go.',
          },
          {
            img: 'lotus',
            title: 'Rooted in authentic sources',
            body: 'Every course draws from the Sri Guru Granth Sahib Ji, authenticated scholarly works, and the SikhLibrary dataset — not Wikipedia summaries or secondhand summaries.',
          },
        ].map((f, i) => (
          <div class="reveal card-lift p-6" data-reveal-delay={(i % 3) * 90}>
            <img src={`/assets/cards/${f.img}.jpg`} alt="" class="h-14 w-14 rounded-full object-cover shadow-lift" />
            <h3 class="mt-3 text-lg font-bold text-navy">{f.title}</h3>
            <p class="mt-2 text-muted leading-relaxed">{f.body}</p>
          </div>
        ))}
      </div>
      </div>
    </div>
  </section>

  <!-- Built for current and future generations -->
  <section id="built-for-future" class="text-white">
    <div class="wrap py-20">
      <div class="mx-auto max-w-5xl xl:max-w-6xl">
        <div class="grid gap-10 lg:grid-cols-2 items-center">
          <div>
            <p class="eyebrow text-saffron" data-i18n="home.future.eyebrow">For every generation</p>
            <h2 class="text-display-sm mt-4 font-bold text-white" data-i18n="home.future.heading">Built for Sikhs of today and tomorrow.</h2>
            <p class="mt-5 text-lg text-white/85 leading-relaxed" data-i18n="home.future.sub1">The Sikh diaspora spans every continent. Our children grow up in Toronto, London, Nairobi, Sydney, and São Paulo. They have questions that deserve real answers — not surface-level summaries, but deep, honest, scholarly engagement with Sikhi.</p>
            <p class="mt-4 text-white/80 leading-relaxed" data-i18n="home.future.sub2">Sikhi University was built so that the next generation never has to choose between their heritage and their intellectual rigour. They can have both. They deserve both.</p>
            <div class="mt-8 flex flex-wrap gap-3">
              <a class="btn btn-primary" href="/catalog" data-i18n="home.future.cta1">Start learning free</a>
              <a class="btn btn-ghost" href="/about" data-i18n="home.future.cta2">Our story →</a>
            </div>
          </div>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            {[
              ['sprout', '100-level', 'Complete beginners — no background needed'],
              ['book', '200–300 level', 'Growing students ready to go deeper'],
              ['microscope', '400-level', 'Advanced learners in serious study'],
              ['cap', '500-level', 'Graduate seminars for scholars'],
              ['pen', 'Languages change', 'Gurbani was written in Punjabi, Braj Bhasha, Sant Bhasha, and Persian. Every course here bridges the Guru\'s depth to the language you live in today.'],
              ['diya', 'ਸਿੱਖ means learner', 'Gurbani\'s call to forever seek is written into our name. This university exists to honour that call — for every generation, everywhere on Earth.'],
            ].map((t, i) => (
              <div class="reveal card-lift p-4" data-reveal-delay={(i % 2) * 90}>
                <Icon name={t[0]} class="h-7 w-7 text-saffron-deep" />
                <div class="mt-2 font-bold text-navy text-sm">{t[1] === 'ਸਿੱਖ means learner' ? (<><span lang="pa" class="gur">ਸਿੱਖ</span> means learner</>) : t[1]}</div>
                <div class="mt-1 text-xs text-ink/70">{t[2]}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Proof points / differentiators -->
  <section>
    <div class="wrap py-16">
      <div class="rounded-xl2 border border-line bg-surface p-8 sm:p-10">
      <p class="eyebrow text-center text-saffron-deep" data-i18n="home.stats2.eyebrow">By the numbers</p>
      <div class="mt-8 grid gap-6 text-center sm:grid-cols-2 lg:grid-cols-4">
        <div class="reveal card-lift p-6" data-reveal-delay="0">
          <div class="stat-mono items-center"><span class="text-2xl" data-countup={published.length} data-countup-suffix="+">{published.length}+</span><span data-i18n="home.stats2.courses">Courses published</span></div>
        </div>
        <div class="reveal card-lift p-6" data-reveal-delay="90">
          <div class="stat-mono items-center"><span class="text-2xl" data-countup="23">23</span><span data-i18n="home.stats2.subjects">Academic subjects</span></div>
        </div>
        <div class="reveal card-lift p-6" data-reveal-delay="180">
          <div class="stat-mono items-center"><span class="text-2xl">100–500</span><span data-i18n="home.stats2.levels">Course levels</span></div>
        </div>
        <div class="reveal card-lift p-6" data-reveal-delay="270">
          <div class="stat-mono items-center"><span class="text-2xl" data-countup="100" data-countup-suffix="%">100%</span><span data-i18n="home.stats2.free">Free, forever</span></div>
        </div>
      </div>
      </div>
    </div>
  </section>

  <!-- Call to action -->
  <section class="text-white">
    <div class="wrap py-24 text-center">
      <img src="/assets/su-crest-full.png" alt="Sikhi University crest" class="mx-auto h-32 w-auto" />
      <p class="eyebrow text-saffron mt-6" data-i18n="home.cta2.eyebrow">Begin today</p>
      <h2 class="text-display-sm mt-4 font-bold text-white" data-i18n="home.cta2.heading">Start your journey today.</h2>
      <p class="mx-auto mt-4 max-w-xl text-lg text-white/85" data-i18n="home.cta2.sub">It takes thirty seconds to begin. No sign-up required. Pick a course, start a lesson — and see how deep Sikhi really goes.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a class="btn btn-primary" href="/catalog" data-i18n="home.cta2.browseall">Browse all courses</a>
        <a class="btn btn-ghost" href="/catalog#paths" data-i18n="home.cta2.path">Follow a learning path</a>
        <a class="btn btn-ghost" href="/santhiya?src=sggs" data-i18n="home.cta2.read">Read the Guru Granth Sahib Ji</a>
      </div>
    </div>
  </section>

</Base>

<style>
  /* Font/weight/size for .text-display/.text-display-sm now live at the
     source in global.css (applies to all ~10 pages using these classes, not
     just this one). Only the h1's container width still needs a per-page
     override: Tailwind's max-w-3xl class on the h1 element (not the class
     this stylesheet controls) forces an awkward wrap at this font's wider
     letterforms. */
  h1.text-display {
    max-width: 56rem;
  }

  /* Distinct backgrounds per homepage section, instead of all three sharing
     the one page-level ambient image. The image lives ONLY on ::before (not
     the section itself) so its opacity actually dims it -- putting the image
     directly on the section and duplicating it on ::before would show the
     full-brightness base layer underneath, defeating the dim entirely. */
  #mission-section, #first-of-kind, #built-for-future {
    position: relative;
    overflow: hidden;
  }
  #mission-section::before, #first-of-kind::before, #built-for-future::before {
    content: "";
    position: absolute; inset: 0;
    background-size: cover;
    background-position: center;
    opacity: 0.28;
    filter: saturate(0.85);
    z-index: -1;
  }
  #mission-section::before { background-image: url('/assets/backgrounds/home-mission.jpg'); }
  #first-of-kind::before { background-image: url('/assets/backgrounds/home-first.jpg'); }
  #built-for-future::before { background-image: url('/assets/backgrounds/home-future.jpg'); }
</style>
