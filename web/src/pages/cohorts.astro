---
import Base from '../layouts/Base.astro';
---
<Base title="Cohorts — Sikhi University" description="Learn together: join a cohort with an invite code, or (for teachers) create a cohort and track your group's progress." ambient="study">
  <!-- Dept header, same rule-navy/eyebrow/stat-mono skeleton as catalog.astro and
       programs.astro (iscohorts refined block, lines 1416-1436). No invented "N
       open now" stat here (Decision 12) — the real app has no global feed of
       open cohorts to join by browsing; joining is always by invite code. -->
  <section class="wrap pt-10 pb-2">
    <div class="rule-navy flex flex-wrap items-end justify-between gap-6 pb-4">
      <div class="min-w-0 flex-1">
        <p class="eyebrow flex items-center gap-2 text-saffron-deep">
          <span aria-hidden="true" class="inline-block h-px w-6 bg-current opacity-50"></span>
          <span data-i18n="cohorts.eyebrow">Study together</span>
        </p>
        <h1 class="text-display mt-3 text-navy" data-i18n="cohorts.h1">Cohorts</h1>
        <p class="mt-3 max-w-2xl font-sans text-lg leading-relaxed text-muted" data-i18n="cohorts.sub">Learn together. Join a group with an invite code, or — if you teach a course — create a cohort and follow your group's progress. Made for camps, classes, and sangats studying as one.</p>
      </div>
    </div>
  </section>

  <section class="wrap pb-16">
    <div id="app" class="mt-2"><p class="row-ruled font-sans text-sm text-muted" data-i18n="cohorts.loading">Loading…</p></div>
  </section>

  <script>
    // Protected JS hooks (Decision 10): #app, #join-form, #join-code, #join-out,
    // #create-form, #c-course, #c-name, #create-out, #cohort-list,
    // [data-roster], #roster — every id/selector below is unchanged from the
    // pre-redesign version. Only the class strings (glass -> flat ledger
    // surfaces) and the markup shape around them changed.
    const esc = (s) => String(s == null ? '' : s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    const app = document.getElementById('app');
    const titles = {};
    let myCourses = []; // course ids the signed-in teacher actually teaches (from /api/gradebook)

    async function api(path, opts) {
      const r = await fetch(path, Object.assign({ credentials: 'same-origin' }, opts || {}));
      return { ok: r.ok, status: r.status, data: await r.json().catch(() => ({})) };
    }

    function joinBox() {
      return `
        <div class="border border-line bg-surface px-6 py-6 sm:px-7 sm:py-7">
          <h2 class="text-[19px] font-bold leading-tight text-navy" data-i18n="cohorts.join.h2">Join a cohort</h2>
          <p class="mt-1 font-sans text-sm text-muted" data-i18n="cohorts.join.hint">Enter the invite code your teacher shared.</p>
          <form id="join-form" class="mt-4 flex flex-wrap gap-2">
            <input id="join-code" aria-label="Invite code" data-i18n-aria="cohorts.aria.invitecode" placeholder="e.g. 4F9A2C" data-i18n-ph="cohorts.ph.invitecode" maxlength="12"
              class="min-w-[160px] flex-1 rounded-[3px] border border-line bg-paper px-4 py-2.5 font-mono text-sm uppercase tracking-wider outline-none focus:border-saffron" />
            <button class="btn btn-primary" data-i18n="cohorts.join.button">Join</button>
          </form>
          <div id="join-out" class="mt-3 font-sans text-sm" aria-live="polite"></div>
        </div>`;
    }

    function teacherBox() {
      const opts = myCourses.map((id) => `<option value="${esc(id)}">${esc(titles[id] || id)}</option>`).join('');
      return `
        <div class="mt-6 border border-line bg-surface px-6 py-6 sm:px-7 sm:py-7">
          <h2 class="text-[19px] font-bold leading-tight text-navy" data-i18n="cohorts.create.h2">Create a cohort</h2>
          <p class="mt-1 font-sans text-sm text-muted" data-i18n="cohorts.create.hint">Pick a course you teach and name the group. You'll get an invite code to share.</p>
          ${myCourses.length ? `
          <form id="create-form" class="mt-4 grid gap-2 sm:grid-cols-[1fr_1fr_auto]">
            <select id="c-course" aria-label="Course" data-i18n-aria="cohorts.aria.course" class="rounded-[3px] border border-line bg-paper px-3 py-2.5 font-sans outline-none focus:border-saffron">${opts}</select>
            <input id="c-name" aria-label="Cohort name" data-i18n-aria="cohorts.aria.cohortname" placeholder="e.g. Summer Camp 2026" data-i18n-ph="cohorts.ph.cohortname"
              class="rounded-[3px] border border-line bg-paper px-3 py-2.5 font-sans outline-none focus:border-saffron" />
            <button class="btn btn-primary" data-i18n="cohorts.create.button">Create</button>
          </form>` : `<p class="mt-3 rounded-[3px] border border-line bg-paper p-3 font-sans text-sm text-muted" data-i18n="cohorts.nocourses">No courses available to create a cohort for yet.</p>`}
          <div id="create-out" class="mt-3 font-sans text-sm" aria-live="polite"></div>
        </div>
        <div class="mt-8 flex items-baseline gap-3 rule-navy pb-2">
          <h2 class="text-[19px] font-bold leading-tight text-navy" data-i18n="cohorts.yourcohorts.h2">Your cohorts</h2>
        </div>
        <div id="cohort-list" class="mt-1"><p class="row-ruled font-sans text-sm text-muted" data-i18n="cohorts.loading">Loading…</p></div>
        <div id="roster" class="mt-8"></div>`;
    }

    function wireJoin() {
      document.getElementById('join-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const code = document.getElementById('join-code').value.trim();
        const out = document.getElementById('join-out');
        if (!code) return;
        out.textContent = 'Joining…';
        const r = await api('/api/cohorts', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'join', code }) });
        if (r.ok && r.data.ok) {
          out.innerHTML = `<span class="text-ok font-semibold">Joined ${esc(r.data.cohortName || 'the cohort')}.</span> <a class="underline text-navy" href="/course/${esc(r.data.courseId)}" data-i18n="cohorts.opencourse">Open the course →</a>`;
        } else {
          out.innerHTML = `<span class="text-danger">${esc(r.data.error || 'Could not join.')}</span>`;
        }
      });
    }

    async function loadCohorts() {
      const box = document.getElementById('cohort-list');
      const r = await api('/api/cohorts');
      if (!r.ok) { box.innerHTML = '<p class="row-ruled font-sans text-sm text-muted" data-i18n="cohorts.loaderror">Could not load your cohorts.</p>'; return; }
      const cs = r.data.cohorts || [];
      if (!cs.length) { box.innerHTML = '<p class="row-ruled font-sans text-sm text-muted" data-i18n="cohorts.empty">No cohorts yet — create one above.</p>'; return; }
      box.innerHTML = cs.map((c) => `
        <div class="row-ruled">
          <span class="min-w-0 flex-1">
            <span class="block text-[16px] font-semibold text-navy">${esc(c.name)}</span>
            <span class="block font-sans text-xs text-muted">${esc(titles[c.course_id] || c.course_id)} · ${c.members} member${c.members === 1 ? '' : 's'}</span>
          </span>
          <span class="chip-status flex-none tracking-widest text-saffron-deep border-saffron-deep">${esc(c.invite_code)}</span>
          <button class="btn flex-none text-sm" data-roster="${esc(c.id)}" data-i18n="cohorts.roster.button">Roster</button>
        </div>`).join('');
      box.querySelectorAll('[data-roster]').forEach((b) => b.addEventListener('click', () => loadRoster(b.getAttribute('data-roster'))));
    }

    async function loadRoster(id) {
      const box = document.getElementById('roster');
      box.innerHTML = '<p class="row-ruled font-sans text-sm text-muted" data-i18n="cohorts.loadingroster">Loading roster…</p>';
      const r = await api('/api/cohorts?id=' + encodeURIComponent(id));
      if (!r.ok) { box.innerHTML = '<p class="row-ruled font-sans text-sm text-muted" data-i18n="cohorts.rostererror">Could not load the roster.</p>'; return; }
      const roster = r.data.roster || [];
      const rows = roster.map((m) => `
        <tr>
          <td class="border border-line p-2">${esc(m.name)}</td>
          <td class="border border-line p-2 tabular-nums font-mono text-[13px]">${m.lessonsDone}</td>
          <td class="border border-line p-2 tabular-nums font-mono text-[13px]">${m.score == null ? '—' : m.score + '%'}</td>
          <td class="border border-line p-2">${m.passed ? '<span class="chip-status text-ok border-ok" data-i18n="cohorts.status.passed">Passed</span>' : '<span class="chip-status text-muted border-line" data-i18n="cohorts.status.inprogress">In progress</span>'}</td>
        </tr>`).join('');
      box.innerHTML = `
        <div class="border border-line bg-surface px-6 py-6 sm:px-7 sm:py-7">
        <h2 class="text-[19px] font-bold leading-tight text-navy">${esc(r.data.cohort.name)} <span data-i18n="cohorts.roster.title">— roster</span></h2>
        <p class="mt-1 font-sans text-sm text-muted">${roster.length} member${roster.length === 1 ? '' : 's'} · invite code <span class="font-mono tracking-widest text-saffron-deep">${esc(r.data.cohort.inviteCode)}</span></p>
        <div class="mt-4 overflow-x-auto">
          <table class="w-full border-collapse text-sm"><thead><tr class="band-navy font-sans text-xs">
            <th class="p-2 text-left" data-i18n="cohorts.th.member">Member</th><th class="p-2 text-left" data-i18n="cohorts.th.lessons">Lessons done</th><th class="p-2 text-left" data-i18n="cohorts.th.score">Best score</th><th class="p-2 text-left" data-i18n="cohorts.th.status">Status</th>
          </tr></thead><tbody>${rows || '<tr><td colspan="4" class="border border-line p-3 text-muted" data-i18n="cohorts.noroster">No members yet — share the invite code.</td></tr>'}</tbody></table>
        </div>
        </div>`;
    }

    function wireCreate() {
      const form = document.getElementById('create-form');
      if (!form) return; // no courses to teach yet — nothing to wire
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const courseId = document.getElementById('c-course').value;
        const name = document.getElementById('c-name').value.trim();
        const out = document.getElementById('create-out');
        if (!courseId || !name) { out.innerHTML = '<span class="text-danger" data-i18n="cohorts.pickcourse">Pick a course and a name.</span>'; return; }
        out.textContent = 'Creating…';
        const r = await api('/api/cohorts', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'create', courseId, name }) });
        if (r.ok && r.data.ok) {
          out.innerHTML = `<span class="text-ok font-semibold" data-i18n="cohorts.created">Created.</span> <span data-i18n="cohorts.invitecode.label">Invite code:</span> <span class="font-mono tracking-widest text-navy">${esc(r.data.inviteCode)}</span>`;
          document.getElementById('c-name').value = '';
          loadCohorts();
        } else {
          out.innerHTML = `<span class="text-danger">${esc(r.data.error || 'Could not create the cohort.')}</span>`;
        }
      });
      // ?course=<id> preselects the course (e.g. linked from the teacher dashboard
      // or Studio right after publishing) and focuses the name field.
      const presetCourse = new URLSearchParams(location.search).get('course');
      if (presetCourse && myCourses.includes(presetCourse)) {
        document.getElementById('c-course').value = presetCourse;
        document.getElementById('c-name').focus();
      }
    }

    async function init() {
      // Course titles for the picker + list labels (every course, so "Your cohorts"
      // can label a cohort even if this teacher's course_teachers row changed since).
      try { const d = await (await fetch('/data/index.json')).json(); d.courses.forEach((c) => (titles[c.id] = c.title)); } catch (e) {}
      const me = await api('/api/me');
      const user = me.data && me.data.user;
      if (!user) {
        app.innerHTML = `<div class="border border-line border-l-[3px] border-l-saffron-deep bg-surface px-6 py-5"><p class="font-sans text-muted"><span data-i18n="cohorts.please">Please</span> <a class="underline text-navy" href="/login" data-i18n="cohorts.signinlink">sign in</a> <span data-i18n="cohorts.signin.suffix">to join or create a cohort.</span></p></div>`;
        return;
      }
      const isTeacher = user.role === 'admin' || user.isTeacher;
      if (isTeacher) {
        const gb = await api('/api/gradebook');
        myCourses = (gb.ok && gb.data.courses) || [];
      }
      app.innerHTML = joinBox() + (isTeacher ? teacherBox() : '');
      wireJoin();
      if (isTeacher) { wireCreate(); loadCohorts(); }
    }
    init();
  </script>
</Base>
