---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { iconSvg } from '../../lib/icons';
import programsData from '../../../public/assets/data/programs.json';
import coursesData from '../../../public/assets/data/courses.json';

export function getStaticPaths() {
  return programsData.programs.map((p) => ({ params: { id: p.id } }));
}

const { id } = Astro.params;
const prog = programsData.programs.find((p) => p.id === id);
if (!prog) return Astro.redirect('/programs');

const courseMap = Object.fromEntries(coursesData.courses.map((c) => [c.id, c]));
const progCourses = prog.courseIds.map((cid) => courseMap[cid]).filter(Boolean);
const topicSet = [...new Set(progCourses.map((c) => c.topic))].sort();

// --- Registrar's-ledger programme detail (task 7: isprogram, lines 955-1005) ---
// Breadcrumb labels + "entry from" meta are real, derived data (programs.json
// `type` and `prerequisites`); course codes are still a proposal nobody has
// decided (see the "flagged design note" this page deliberately does NOT
// render, per Decision 12) — the level slot beside each course is the real
// `level` field from courses.json, never a fabricated letters-plus-digits code.
const BREADCRUMB_TYPE: Record<string, string> = {
  certificate: 'Certificates',
  associate: 'Associate Degree',
  bachelor: "Bachelor's Degrees",
  master: "Master's Degrees",
  giani: 'Giani',
};

function entryFrom(p: typeof prog): { text: string; none: boolean } {
  if (!p.prerequisites.length) return { text: 'No prerequisites', none: true };
  const abbrs = p.prerequisites.map(
    (pid) => programsData.programs.find((x) => x.id === pid)?.abbreviation ?? pid,
  );
  return { text: abbrs.join(' or '), none: false };
}
const entry = entryFrom(prog);

// Real programme(s) that require this one — computed from programs.json,
// never hand-listed.
const leadsTo = programsData.programs.filter((p) => p.prerequisites.includes(prog.id));
---
<Base title={`${prog.title} — Sikhi University`} description={prog.description} ambient="study">
  <div class="band-navy">
    <div class="wrap py-8 sm:pb-9 sm:pt-10">
      <p class="flex flex-wrap items-center gap-2.5 font-mono text-[10.5px] uppercase tracking-[.16em] text-white/72">
        <a href="/programs" class="hover:text-white" data-i18n="program.breadcrumb.programs">Programmes</a>
        <span aria-hidden="true">›</span>
        <span data-no-i18n>{BREADCRUMB_TYPE[prog.type]}</span>
        <span aria-hidden="true">›</span>
        <span class="text-saffron" data-no-i18n>{prog.abbreviation}</span>
      </p>
      <div class="mt-4 flex flex-wrap items-baseline gap-x-4 gap-y-2">
        <h1 class="text-display-sm max-w-[26ch] text-white" data-no-i18n>{prog.title}</h1>
        <span class="font-mono text-[15px] text-saffron" data-no-i18n>{prog.abbreviation}</span>
      </div>
      <p lang="pa" class="mt-2.5 font-gurmukhi text-xl leading-[1.9] text-white/88" data-no-i18n>{prog.titleGur}</p>
      <div class="mt-4 flex flex-wrap gap-x-7 gap-y-2.5 font-mono text-[11px] uppercase tracking-[.12em] text-white/78">
        <span data-no-i18n>{prog.courseIds.length} courses</span>
        <span data-no-i18n>{prog.duration}</span>
        <span data-no-i18n>{prog.testQuestions}-question exam</span>
        <span data-no-i18n>Pass at {prog.passMark}%</span>
        <span class:list={[entry.none && "text-saffron"]} data-no-i18n>{entry.none ? 'No prerequisites' : `Requires ${entry.text}`}</span>
      </div>
      <div class="mt-6">
        <button id="register-btn" class="btn btn-ghost">Register for this program</button>
      </div>
    </div>
  </div>

  <section class="wrap py-9 md:py-11">
    <p class="max-w-[74ch] font-sans text-lg leading-relaxed text-ink" data-no-i18n>{prog.description}</p>

    <div class="mt-9 flex flex-wrap gap-x-10 gap-y-10">
      <!-- Required courses -->
      <div class="min-w-0 flex-[2] basis-[420px]">
        <p class="font-mono text-[10.5px] uppercase tracking-[.2em] text-saffron-deep" data-i18n="program.required.label">Required courses</p>
        <div id="course-list-progress">
          {topicSet.map((topic) => {
            const tCourses = progCourses.filter((c) => c.topic === topic);
            return (
              <div class="mt-6 first:mt-2">
                <div class="rule-navy pb-1.5">
                  <h3 class="font-mono text-[11px] uppercase tracking-[.1em] text-navy" data-no-i18n>{topic.replace(/-/g, ' ')}</h3>
                </div>
                {tCourses.map((c) => (
                  <a href={`/course/${c.id}`} class="row-ruled hover:bg-paper" data-course-id={c.id} data-no-i18n>
                    <span class="w-10 flex-none font-mono text-[11.5px] text-saffron-deep">{c.level}</span>
                    <span class="min-w-0 flex-1">
                      <span class="block text-[15.5px] font-semibold leading-tight text-navy">{c.title}</span>
                      <span class="mt-0.5 block font-mono text-[10.5px] text-muted">{(c.lessons || []).length} lessons</span>
                    </span>
                    <span class="w-9 flex-none text-right" data-course-check></span>
                  </a>
                ))}
              </div>
            );
          })}
        </div>
      </div>

      <!-- Your standing + Leads to -->
      <div class="min-w-0 flex-1 basis-[240px]">
        <p class="font-mono text-[10.5px] uppercase tracking-[.2em] text-saffron-deep" data-i18n="program.standing.label">Your standing</p>
        <div id="prog-status" class="mt-1 border-t-2 border-navy pt-4">
          <p class="font-sans text-sm text-muted" data-i18n="program.standing.loading">Loading your progress…</p>
        </div>

        <p class="mt-8 font-mono text-[10.5px] uppercase tracking-[.2em] text-saffron-deep" data-i18n="program.leadsto.label">Leads to</p>
        <div class="mt-1 border-t-2 border-navy">
          {leadsTo.length === 0 ? (
            <p class="py-3 font-sans text-sm text-muted" data-i18n="program.leadsto.none">No further programme currently requires this one.</p>
          ) : (
            leadsTo.map((lp) => (
              <a href={`/program/${lp.id}`} class="row-ruled hover:bg-paper" data-no-i18n>
                <span class="text-[15px] font-semibold text-navy">{lp.abbreviation}</span>
                <span class="ml-auto font-mono text-[11px] text-muted">{lp.courseIds.length} courses</span>
              </a>
            ))
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- Cumulative Test Modal -->
  <div id="cum-test-modal" class="hidden fixed inset-0 z-50 flex items-start justify-center overflow-y-auto bg-black/60 py-10">
    <div class="mx-4 w-full max-w-2xl border border-line bg-surface p-8">
      <h2 class="text-2xl font-bold text-navy" id="cum-test-title">Cumulative Examination</h2>
      <p class="mt-1 font-sans text-sm text-muted" id="cum-test-subtitle"></p>
      <div id="cum-test-body" class="mt-6 space-y-6"></div>
      <div id="cum-test-result" class="hidden mt-6 rounded-xl2 border border-line bg-paper p-5 text-center">
        <div id="cum-result-icon"><Icon name="cap" class="mx-auto h-9 w-9 text-saffron-deep" /></div>
        <div class="mt-2 text-2xl font-bold text-navy" id="cum-result-score"></div>
        <div class="mt-1 font-sans text-sm text-muted" id="cum-result-msg"></div>
        <button id="cum-retry" class="btn mt-4 hidden">Retry Exam</button>
        <a id="cum-cert-link" href="#" class="btn btn-primary mt-4 hidden">Download Certificate →</a>
      </div>
      <div class="mt-6 flex justify-between">
        <button id="cum-close" class="btn">Close</button>
        <button id="cum-submit" class="btn btn-primary hidden">Submit Exam</button>
      </div>
    </div>
  </div>

<script define:vars={{ progId: prog.id, progTitle: prog.title, courseIds: prog.courseIds, testQuestions: prog.testQuestions, passMark: prog.passMark, ICONS: { check: iconSvg('check', 'h-4 w-4'), cap: iconSvg('cap', 'mx-auto h-9 w-9 text-saffron-deep'), books: iconSvg('books', 'mx-auto h-9 w-9 text-saffron-deep'), capSmall: iconSvg('cap', 'h-7 w-7 text-saffron-deep'), done: iconSvg('check-square', 'h-5 w-5 text-ok'), todo: iconSvg('square', 'h-5 w-5 text-muted') } }}>
  const get = (k, d) => { try { const v = localStorage.getItem(k); return v === null ? d : JSON.parse(v); } catch { return d; } };
  const set = (k, v) => { try { localStorage.setItem(k, JSON.stringify(v)); } catch {} };
  const esc = (s) => String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');

  const passed = (cid) => {
    const p = get('progress_' + cid, {});
    const lessons = Object.values(p).filter(Boolean).length;
    const score = get('score_' + cid, null);
    if (score !== null) return score >= 70;
    const total = get('lesson_count_' + cid, 6);
    return lessons >= total * 0.8;
  };

  const completedIds = courseIds.filter(passed);
  const total = courseIds.length;
  const done = completedIds.length;
  const pct = Math.round((done / total) * 100);
  const allDone = done === total;

  // Update status panel ("Your standing" rail — ruled ledger treatment)
  const statusEl = document.getElementById('prog-status');
  const cumPassed = get('cum_passed_' + progId, false);
  statusEl.innerHTML = `
    <div class="flex items-baseline justify-between gap-3">
      <span class="font-mono text-[11px] uppercase tracking-[.12em] text-muted">Courses complete</span>
      <span class="font-mono text-[19px] text-navy">${done} / ${total}</span>
    </div>
    <div class="mt-3 h-1 w-full bg-line"><div class="h-full bg-saffron" style="width:${pct}%"></div></div>
    ${allDone
      ? cumPassed
        ? `<div class="mt-4 flex flex-col items-center gap-1.5 text-center"><span>${ICONS.capSmall}</span><span class="font-mono text-xs uppercase tracking-[.1em] text-saffron-deep">Credential earned</span><a href="/cert?program=${progId}" class="btn btn-primary mt-1 w-full">View credential →</a></div>`
        : `<button id="start-cum-test" class="btn btn-primary mt-4 w-full">Take Cumulative Exam →</button>`
      : `<p class="mt-3 font-sans text-[14.5px] leading-relaxed text-muted">The comprehensive examination unlocks when all ${total} courses are complete. ${testQuestions} questions, ${passMark}% to pass.</p><div class="mt-3 border border-line bg-surface px-4 py-3 text-center font-mono text-[11px] font-bold uppercase tracking-[.12em] text-muted">Exam locked</div>`
    }
  `;

  // Update course rows with completion checkmarks
  document.querySelectorAll('[data-course-id]').forEach((card) => {
    const cid = card.getAttribute('data-course-id');
    const icon = card.querySelector('[data-course-check]');
    if (icon) icon.innerHTML = passed(cid) ? ICONS.done : ICONS.todo;
  });

  // Cumulative test logic
  document.getElementById('start-cum-test')?.addEventListener('click', launchTest);
  document.getElementById('cum-close')?.addEventListener('click', () => {
    document.getElementById('cum-test-modal').classList.add('hidden');
  });

  function launchTest() {
    // Pull quiz *questions* from the public catalogue. Answers are NOT present in
    // the browser-served catalogue (stripped by build_public_data.py) — grading is
    // done on the server via /api/program-exam, keyed by (courseId, question-index).
    fetch('/assets/data/courses.json').then(r => r.json()).then(data => {
      const pool = [];
      data.courses.forEach(c => {
        if (!courseIds.includes(c.id)) return;
        (c.quiz || []).forEach((q, qi) => {
          pool.push({ cid: c.id, qi, q: q.q, options: q.options, courseTitle: c.title });
        });
      });
      // Shuffle and pick N questions
      const shuffled = pool.sort(() => Math.random() - 0.5).slice(0, testQuestions);
      if (shuffled.length === 0) {
        window.suToast('No quiz questions found for this program yet.', 'error');
        return;
      }
      renderTest(shuffled);
    });
  }

  function renderTest(questions) {
    const modal = document.getElementById('cum-test-modal');
    const title = document.getElementById('cum-test-title');
    const sub = document.getElementById('cum-test-subtitle');
    const body = document.getElementById('cum-test-body');
    const result = document.getElementById('cum-test-result');
    const submitBtn = document.getElementById('cum-submit');

    title.textContent = progTitle + ' — Cumulative Examination';
    sub.textContent = `${questions.length} questions · ${passMark}% required to pass · Drawn from all courses in this program`;
    result.classList.add('hidden');
    submitBtn.classList.remove('hidden');

    body.innerHTML = questions.map((q, i) => `
      <div class="space-y-2" data-qi="${i}" data-cid="${esc(q.cid)}" data-qidx="${q.qi}">
        <p class="font-semibold text-navy"><span class="text-muted font-normal">${i+1}.</span> ${esc(q.q)}</p>
        <div class="font-sans text-xs text-muted mb-1">— ${esc(q.courseTitle)}</div>
        ${q.options.map((opt, oi) => `
          <label class="flex items-start gap-2 cursor-pointer border border-line rounded-xl2 p-2 hover:bg-paper transition">
            <input type="radio" name="q${i}" value="${oi}" class="mt-0.5 accent-saffron shrink-0" />
            <span class="text-sm">${esc(opt)}</span>
          </label>
        `).join('')}
      </div>
    `).join('');

    submitBtn.onclick = () => gradeTest(questions);
    modal.classList.remove('hidden');
    modal.scrollTop = 0;
  }

  function gradeTest(questions) {
    // Grade on the server: submit (courseId, question-index, chosen-option) tuples.
    // The browser no longer has the answer key, so this is the only path to a score.
    const items = questions.map((q, i) => {
      const sel = document.querySelector(`input[name="q${i}"]:checked`);
      return { cid: q.cid, qi: q.qi, sel: sel ? parseInt(sel.value) : -1 };
    });
    const submitBtn = document.getElementById('cum-submit');
    submitBtn.disabled = true;
    fetch('/api/program-exam', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ items, passMark }),
    })
      .then((r) => (r.ok ? r.json() : Promise.reject(new Error('grade failed'))))
      .then((res) => { submitBtn.disabled = false; showTestResult(res.score, res.correct, res.total, res.passed); })
      .catch(() => { submitBtn.disabled = false; window.suToast('Could not grade the exam right now. Please check your connection and try again.', 'error'); });
  }

  function showTestResult(score, correct, total, passed_exam) {
    const resultEl = document.getElementById('cum-test-result');
    const iconEl = document.getElementById('cum-result-icon');
    const scoreEl = document.getElementById('cum-result-score');
    const msgEl = document.getElementById('cum-result-msg');
    const retryBtn = document.getElementById('cum-retry');
    const certLink = document.getElementById('cum-cert-link');

    iconEl.innerHTML = passed_exam ? ICONS.cap : ICONS.books;
    scoreEl.textContent = `${score}% (${correct} / ${total} correct)`;
    if (passed_exam) {
      msgEl.textContent = `Congratulations — you have passed the ${progTitle} cumulative examination. Your credential is ready.`;
      certLink.href = `/cert?program=${progId}`;
      certLink.classList.remove('hidden');
      retryBtn.classList.add('hidden');
      set('cum_passed_' + progId, true);
      set('cum_score_' + progId, score);
    } else {
      msgEl.textContent = `You scored ${score}% — you need ${passMark}% to pass. Review the material and try again.`;
      retryBtn.classList.remove('hidden');
      certLink.classList.add('hidden');
    }

    document.getElementById('cum-submit').classList.add('hidden');
    resultEl.classList.remove('hidden');
    retryBtn.onclick = launchTest;
  }

  // Explicit program registration — server is the source of truth; localStorage mirrors it.
  (function () {
    const btn = document.getElementById('register-btn'); if (!btn) return;
    const rk = 'su_v1_registered_program_' + progId;
    let reg = get(rk, false);
    function paint() { btn.innerHTML = reg ? ICONS.check + ' Registered for this program' : 'Register for this program'; }
    paint();
    fetch('/api/enrollments', { credentials: 'same-origin' }).then((r) => (r.ok ? r.json() : null)).then((d) => {
      if (!d || !d.enrollments) return;
      reg = d.enrollments.some((e) => e.kind === 'program' && e.target_id === progId);
      set(rk, reg); paint();
    }).catch(() => {});
    btn.addEventListener('click', () => {
      const next = !reg; btn.disabled = true;
      fetch('/api/enrollments', { method: 'POST', credentials: 'same-origin', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ kind: 'program', targetId: progId, action: next ? 'enroll' : 'unenroll' }) })
        .then((r) => { if (r.status === 401) { location.href = '/login'; return null; } return r.ok ? r.json() : null; })
        .then((res) => { btn.disabled = false; if (res) { reg = !!res.enrolled; set(rk, reg); paint(); } })
        .catch(() => { btn.disabled = false; });
    });
  })();
</script>
</Base>
