---
import Base from '../layouts/Base.astro';
---
<Base title="Teacher — Sikhi University" description="A teacher's public profile at Sikhi University." ambient="study">
  <div id="teacher-profile">
    <div class="wrap py-12"><p class="font-sans text-sm text-muted">Loading…</p></div>
  </div>
  <div id="teacher-courses"></div>
  <script>
    import { iconSvg } from '../lib/icons';
    const esc = (s: unknown) => String(s == null ? '' : s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));

    function badge(level: string) {
      if (level === 'scholar') return `<span class="chip-status text-saffron-deep border-saffron-deep gap-1">${iconSvg('shield', 'h-3.5 w-3.5')} Verified Scholar</span>`;
      if (level === 'identity') return `<span class="chip-status text-ok border-ok gap-1">${iconSvg('check', 'h-3.5 w-3.5')} Verified</span>`;
      return '';
    }

    // Extrapolated from the isprofessor pattern (professor/[slug].astro):
    // a band-navy header (breadcrumb, portrait, name, mono badge row) over a
    // flat paper body (bio prose + credentials/areas/links).
    function renderProfile(p: any) {
      const root = document.getElementById('teacher-profile')!;
      const paras = (p.bio || '').split('\n\n').filter(Boolean).map((t: string) => `<p class="mt-3 max-w-[70ch] text-[17.5px] leading-[1.68] text-ink">${esc(t)}</p>`).join('');
      root.innerHTML = `
        <div class="band-navy">
          <div class="wrap py-8 sm:pb-9 sm:pt-10">
            <p class="font-mono text-[10.5px] uppercase tracking-[.16em] text-white/72">Faculty › <span class="text-saffron">${esc(p.displayName)}</span></p>
            <div class="mt-5 flex flex-wrap items-center gap-5">
              ${p.photoUrl ? `<img src="${esc(p.photoUrl)}" width="96" height="96" alt="" class="h-24 w-24 shrink-0 rounded-full border border-white/20 object-cover" />` : ''}
              <div class="min-w-0 flex-1 basis-[300px]">
                <h1 class="text-display-sm leading-[1.06] text-white">${esc(p.displayName)}</h1>
                <div class="mt-3">${badge(p.verificationLevel)}</div>
              </div>
            </div>
          </div>
        </div>
        <div class="wrap py-10 sm:py-12">
          ${paras}
          ${p.credentials ? `<p class="mt-3 font-mono text-[11px] text-muted">${esc(p.credentials)}</p>` : ''}
          ${p.areas && p.areas.length ? `<div class="mt-4 flex flex-wrap gap-2">${p.areas.map((a: string) => `<span class="chip-status text-navy border-line">${esc(a)}</span>`).join('')}</div>` : ''}
          ${p.links && p.links.length ? `<div class="mt-4 flex flex-wrap gap-3 font-sans text-sm">${p.links.map((l: any) => `<a class="underline hover:text-saffron-deep" href="${esc(l.url)}" target="_blank" rel="noopener">${esc(l.kind)}</a>`).join('')}</div>` : ''}
          ${p.claimedProfessor ? `<p class="mt-4 font-mono text-[11px] text-muted">Courses authored as <a class="underline hover:text-navy" href="/professor/${esc(p.claimedProfessor.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, ''))}">${esc(p.claimedProfessor)}</a></p>` : ''}
        </div>
      `;
    }

    async function renderCourses(p: any) {
      const root = document.getElementById('teacher-courses')!;
      try {
        const data = await fetch('/data/index.json').then((r) => r.json());
        const courses = (data.courses || []).filter((c: any) =>
          c.status === 'published' && ((p.claimedProfessor && c.professor === p.claimedProfessor) || (p.assignedCourseIds || []).includes(c.id))
        );
        if (!courses.length) return;
        root.innerHTML = `<div class="wrap pb-12">
          <div class="flex items-baseline gap-3 rule-navy pb-2">
            <h2 class="text-[23px] font-bold leading-[1.15] tracking-[-.026em] text-navy">Courses</h2>
            <span class="font-mono text-[11px] text-muted">${courses.length} published</span>
          </div>
          ${courses.map((c: any) => `
            <a href="/course/${esc(c.id)}" class="row-ruled block hover:bg-surface">
              ${c.level != null ? `<span class="w-[72px] shrink-0 font-mono text-[11.5px] text-saffron-deep">LVL ${esc(String(c.level))}</span>` : ''}
              <span class="min-w-0 flex-1 text-[16.5px] font-semibold text-navy">${esc(c.title)}</span>
              ${c.nLessons != null ? `<span class="shrink-0 font-mono text-[11px] text-muted">${esc(String(c.nLessons))} lessons</span>` : ''}
            </a>`).join('')}
        </div>`;
      } catch (e) { /* course list is an enhancement, not required for the profile itself */ }
    }

    const island = document.getElementById('profile-data');
    if (island) {
      const profile = JSON.parse(island.textContent || '{}');
      renderProfile(profile);
      renderCourses(profile);
    }
  </script>
</Base>
