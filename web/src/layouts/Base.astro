---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import InstallPrompt from '../components/InstallPrompt.astro';
import CommandPalette from '../components/CommandPalette.astro';
import TabBar from '../components/TabBar.astro';
import { readFileSync } from 'node:fs';
import path from 'node:path';
// Inline the @font-face rules instead of linking /fonts/fonts.css: the extra
// render-blocking stylesheet cost ~150ms + a request in the critical chain on
// mobile (PageSpeed). The file stays in public/ for the service worker and any
// external consumers; this just removes it from the critical path.
// (path.resolve, not new URL(import.meta.url): vite rewrites the latter into
// an asset reference and the embedded CSS breaks the compiled module.)
const fontFaceCss = readFileSync(path.resolve(process.cwd(), 'public/fonts/fonts.css'), 'utf-8');

interface Props { title: string; description?: string; canonical?: string; ogType?: string; autoTranslate?: boolean; ambient?: 'hall' | 'study' | 'sanctum' | 'none'; bgImage?: string; noindex?: boolean; bodyClass?: string }
const { title, description = 'A free, open online university for Sikhi and modern skills — open to all, worldwide.', canonical, ogType = 'website', autoTranslate = true, ambient = 'none', bgImage, noindex = false, bodyClass } = Astro.props;
import { SITE, ldJson } from '../lib/site';
// Normalise to the extensionless URLs the site is actually served/linked at
// (e.g. /catalog, not /catalog.html; / for the homepage).
const cleanPath = Astro.url.pathname.replace(/index\.html$/, '').replace(/\.html$/, '');
const canon = canonical || SITE + (cleanPath === '' ? '/' : cleanPath);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <!-- Self-hosted fonts (Gurmukhi is first-class, never left to device chance).
       @font-face rules are inlined (see frontmatter) and the two above-the-fold
       faces are preloaded so text paints without a stylesheet round-trip. -->
  <Fragment set:html={`<style>${fontFaceCss}</style>`} />
  <link rel="preload" href="/fonts/archivo-latin-var.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/notoserifgur-gurmukhi-400.woff2" as="font" type="font/woff2" crossorigin />
  <script is:inline>
    // Set the colour theme before first paint to avoid a flash. Honours a
    // saved choice, else the OS preference.
    (function () {
      try {
        var t = localStorage.getItem('su_v1_theme');
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', t);
        // ?lang= deep link (shareable translated URLs) wins over the saved choice.
        var qlang = new URLSearchParams(location.search).get('lang');
        var LANGS = ['en', 'pa', 'hi', 'ur', 'es', 'ar', 'fr', 'de', 'zh'];
        if (qlang && LANGS.indexOf(qlang) !== -1) { try { localStorage.setItem('su_v1_lang', qlang); } catch (e) {} }
        var lang = localStorage.getItem('su_v1_lang') || 'en';
        document.documentElement.setAttribute('lang', lang);
        document.documentElement.setAttribute('dir', (lang === 'ar' || lang === 'ur') ? 'rtl' : 'ltr');
      } catch (e) {}
    })();
  </script>
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
  <meta name="application-name" content="Sikhi University" />
  <meta name="theme-color" content="#16335c" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0d1016" media="(prefers-color-scheme: dark)" />
  <link rel="canonical" href={canon} />
  <link rel="icon" href="/assets/icon.svg" />
  <link rel="icon" type="image/png" sizes="192x192" href="/assets/icon-192.png" />
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Sikhi University" />
  <script type="application/ld+json" set:html={ldJson({
    "@context": "https://schema.org",
    "@graph": [
      { "@type": "Organization", "@id": SITE + "/#org", "name": "Sikhi University", "url": SITE,
        "description": "A free, open online university for Sikhi — Gurbani, history, philosophy, Rehat, Kirtan, and Gurmukhi/Punjabi — open to all, worldwide.",
        "logo": { "@type": "ImageObject", "url": SITE + "/assets/logo.png", "width": 1200, "height": 1200 } },
      { "@type": "WebSite", "@id": SITE + "/#website", "url": SITE, "name": "Sikhi University",
        "publisher": { "@id": SITE + "/#org" },
        "potentialAction": { "@type": "SearchAction", "target": SITE + "/search?q={search_term_string}", "query-input": "required name=search_term_string" } }
    ]
  })} />
  <meta name="mobile-web-app-capable" content="yes" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="Sikhi University" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canon} />
  <meta property="og:image" content={`${SITE}/assets/og-image.png`} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Sikhi University — free, open learning in Sikhi" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${SITE}/assets/og-image.png`} />
  <slot name="head" />
</head>
<body class={bodyClass}>
  {ambient !== 'none' && (
    <div aria-hidden="true" class={`ambient ambient-${ambient}`}>
      {bgImage && <div class="ambient-painting" style={`background-image:url('${bgImage}')`}></div>}
      {(ambient === 'hall' || ambient === 'sanctum') && <div class="lattice pattern-lattice absolute inset-0"></div>}
      {ambient === 'study' && <div class="texture texture-manuscript absolute inset-0"></div>}
    </div>
  )}
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-[100] focus:rounded-lg focus:bg-brand focus:px-4 focus:py-2 focus:text-white">Skip to content</a>
  <Nav />
  <main id="main" data-autotranslate={autoTranslate ? '1' : '0'}>
    <slot />
  </main>
  <Footer />

  <InstallPrompt />
  <CommandPalette />
  <TabBar />
  <button id="a11y-fab" aria-label="Accessibility options" aria-expanded="false" aria-controls="a11y-panel" class="fixed right-[max(1rem,env(safe-area-inset-right))] bottom-[max(1rem,env(safe-area-inset-bottom))] z-50 inline-flex h-12 w-12 items-center justify-center rounded-full bg-brand text-white shadow-lift hover:bg-brand-strong print:hidden"><Icon name="accessibility" class="h-6 w-6" /></button>
  <div id="a11y-panel" class="fixed right-4 bottom-20 z-50 hidden w-56 flex-col gap-1 rounded-xl2 border border-line bg-surface p-3 shadow-lift print:hidden">
    <strong class="font-sans text-xs uppercase tracking-wide text-muted" data-i18n="a11y.title">Accessibility</strong>
    <button data-a="smaller" class="rounded-lg border border-line px-3 py-2 text-left font-sans text-sm hover:border-saffron">A− <span data-i18n="a11y.smaller">Smaller text</span></button>
    <button data-a="bigger" class="rounded-lg border border-line px-3 py-2 text-left font-sans text-sm hover:border-saffron">A+ <span data-i18n="a11y.bigger">Larger text</span></button>
    <button data-a="contrast" class="rounded-lg border border-line px-3 py-2 text-left font-sans text-sm hover:border-saffron">◐ <span data-i18n="a11y.contrast">High contrast</span></button>
    <button data-a="read" class="inline-flex items-center gap-2 rounded-lg border border-line px-3 py-2 text-left font-sans text-sm hover:border-saffron"><Icon name="volume" class="h-4 w-4 shrink-0" /><span data-i18n="a11y.read">Read this page</span></button>
    <button data-a="stop" class="inline-flex items-center gap-2 rounded-lg border border-line px-3 py-2 text-left font-sans text-sm hover:border-saffron"><Icon name="stop" class="h-4 w-4 shrink-0" /><span data-i18n="a11y.stop">Stop reading</span></button>
    <button data-a="reset" class="rounded-lg border border-line px-3 py-2 text-left font-sans text-sm hover:border-saffron">↺ <span data-i18n="a11y.reset">Reset</span></button>
  </div>
  <script>
    import { initMotion } from '../lib/motion';
    initMotion();
  </script>
  <script>
    import { speak, stop as ttsStop, supported as ttsSupported } from '../lib/tts';
    const P = 'su_v1_a11y';
    const get = () => { try { return JSON.parse(localStorage.getItem(P) || '{}'); } catch { return {}; } };
    const apply = () => { const p = get(); document.documentElement.style.fontSize = (p.scale || 100) + '%'; document.body.classList.toggle('hc', !!p.contrast); };
    apply();
    const fab = document.getElementById('a11y-fab'); const panel = document.getElementById('a11y-panel');
    // Read the page via the shared TTS engine: whole page (no 9000-char cap),
    // best available voice for the current UI language. Gurbani/Gurmukhi is
    // never synthesized — sacred text is stripped, matching the course reader.
    const readableText = () => {
      const m = document.querySelector('main'); if (!m) return '';
      const clone = m.cloneNode(true);
      clone.querySelectorAll('.gur, .shabad, blockquote.gurbani, [lang="pa"], script, style, code, pre, [aria-hidden="true"]').forEach((el) => el.remove());
      return clone.textContent || '';
    };
    if (!ttsSupported()) panel?.querySelectorAll('[data-a="read"],[data-a="stop"]').forEach((b) => b.remove());
    fab?.addEventListener('click', () => { const hidden = panel?.classList.toggle('hidden'); fab.setAttribute('aria-expanded', String(!hidden)); });
    panel?.addEventListener('click', (e) => {
      const t = e.target.closest('button'); if (!t) return; const p = get(); const a = t.dataset.a;
      if (a === 'smaller') p.scale = Math.max(80, (p.scale || 100) - 10);
      else if (a === 'bigger') p.scale = Math.min(170, (p.scale || 100) + 10);
      else if (a === 'contrast') p.contrast = !p.contrast;
      else if (a === 'read') { speak(readableText(), { lang: document.documentElement.lang || 'en' }); return; }
      else if (a === 'stop') { ttsStop(); return; }
      else if (a === 'reset') { localStorage.removeItem(P); apply(); return; }
      localStorage.setItem(P, JSON.stringify(p)); apply();
    });
    if ('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js').catch(() => {});
  </script>
  <script>
    // Lightweight UI i18n: swaps text/placeholders of [data-i18n*] elements from a
    // per-language dictionary in /assets/i18n/<lang>.json. English is the in-markup
    // source (no fetch). Gurbani/Gurmukhi content is never tagged, so it's preserved.
    (function () {
      const RTL = new Set(['ar', 'ur']);
      const orig = new WeakMap();
      let curDict = {};
      // Let JS-driven labels (e.g. the nav auth button toggling Sign in <-> Sign out) opt
      // into i18n: update the element's snapshot fallback + data-i18n key and re-apply the
      // current language, so a later language switch translates the CURRENT state, not the
      // stale original markup. Fixes the auth button reading "Sign in" while logged in.
      window.suRelabel = function (el, key, fallback) {
        if (!el) return;
        const o = orig.get(el) || {}; o.t = fallback; orig.set(el, o);
        el.setAttribute('data-i18n', key);
        el.textContent = curDict[key] != null ? curDict[key] : fallback;
      };
      const nodes = () => document.querySelectorAll('[data-i18n],[data-i18n-ph],[data-i18n-aria]');
      function snapshot() {
        nodes().forEach((el) => {
          if (orig.has(el)) return;
          orig.set(el, {
            t: el.hasAttribute('data-i18n') ? el.textContent : null,
            ph: el.hasAttribute('data-i18n-ph') ? el.getAttribute('placeholder') : null,
            aria: el.hasAttribute('data-i18n-aria') ? el.getAttribute('aria-label') : null,
          });
        });
      }
      async function dict(lang) {
        if (lang === 'en') return {};
        try { const r = await fetch('/assets/i18n/' + lang + '.json'); return r.ok ? await r.json() : {}; } catch (e) { return {}; }
      }
      async function apply(lang) {
        snapshot();
        document.documentElement.setAttribute('lang', lang);
        document.documentElement.setAttribute('dir', RTL.has(lang) ? 'rtl' : 'ltr');
        const d = await dict(lang);
        curDict = d;
        nodes().forEach((el) => {
          const o = orig.get(el) || {};
          const kt = el.getAttribute('data-i18n'); if (kt) el.textContent = d[kt] != null ? d[kt] : o.t;
          const kp = el.getAttribute('data-i18n-ph'); if (kp) el.setAttribute('placeholder', d[kp] != null ? d[kp] : o.ph);
          const ka = el.getAttribute('data-i18n-aria'); if (ka) el.setAttribute('aria-label', d[ka] != null ? d[ka] : o.aria);
        });
        autoApply(lang);
      }

      // ── Auto-translate: machine-translate the rest of the page UI via /api/translate.
      // Captures only English (Latin-script) text in <main>; native scripts (Gurmukhi,
      // Devanagari, Arabic, CJK…) and .gur/[lang=pa]/[data-i18n]/[data-no-i18n] are skipped,
      // so Gurbani and course titles are never sent for translation. Opt out per page with
      // <main data-autotranslate="0">. Results are cached per language in localStorage.
      const main = document.getElementById('main');
      const autoOn = !!main && main.getAttribute('data-autotranslate') !== '0';
      const NATIVE = /[؀-ۿऀ-ॿঀ-৿਀-੿଀-୿஀-௿ఀ-౿ಀ-೿ഀ-ൿ฀-๿぀-ヿ一-鿿가-힯]/;
      const reg = []; let captured = false;
      function capture() {
        if (captured || !main) return; captured = true;
        const w = document.createTreeWalker(main, NodeFilter.SHOW_TEXT, {
          acceptNode(n) {
            const t = n.nodeValue;
            if (!t || !/[A-Za-z]/.test(t) || NATIVE.test(t)) return NodeFilter.FILTER_REJECT;
            let el = n.parentElement;
            while (el && el !== main.parentElement) {
              if (el.matches && el.matches('.gur,[lang="pa"],script,style,code,pre,[data-i18n],[data-no-i18n]')) return NodeFilter.FILTER_REJECT;
              el = el.parentElement;
            }
            return NodeFilter.FILTER_ACCEPT;
          },
        });
        let n; while ((n = w.nextNode())) reg.push({ node: n, en: n.nodeValue });
      }
      const cacheKey = (lang) => 'su_v1_i18n_v2_' + lang;
      const loadCache = (lang) => { try { return JSON.parse(localStorage.getItem(cacheKey(lang)) || '{}'); } catch (e) { return {}; } };
      const saveCache = (lang, c) => { try { localStorage.setItem(cacheKey(lang), JSON.stringify(c)); } catch (e) {} };
      function applyAuto(cache) {
        reg.forEach((r) => {
          const tr = cache[r.en.trim()];
          if (tr) { const lead = (r.en.match(/^\s*/) || [''])[0], trail = (r.en.match(/\s*$/) || [''])[0]; r.node.nodeValue = lead + tr + trail; }
        });
      }
      async function autoApply(lang) {
        if (!autoOn) return;
        capture();
        if (lang === 'en') { reg.forEach((r) => { if (r.node.nodeValue !== r.en) r.node.nodeValue = r.en; }); return; }
        const cache = loadCache(lang);
        applyAuto(cache);
        const need = [], seen = {};
        reg.forEach((r) => { const k = r.en.trim(); if (k && !(k in cache) && !seen[k]) { seen[k] = 1; need.push(k); } });
        for (let i = 0; i < need.length; i += 25) {
          const chunk = need.slice(i, i + 25);
          let res; try { res = await fetch('/api/translate', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ lang, texts: chunk }) }).then((r) => r.json()); } catch (e) { res = null; }
          if (res && res.translations) { chunk.forEach((t, j) => { if (res.translations[j] != null) cache[t] = res.translations[j]; }); saveCache(lang, cache); applyAuto(cache); }
        }
      }

      let lang = 'en';
      try { lang = localStorage.getItem('su_v1_lang') || 'en'; } catch (e) {}
      const switches = document.querySelectorAll('[data-lang-switch]');
      switches.forEach((sel) => {
        sel.value = lang;
        sel.addEventListener('change', () => {
          const v = sel.value;
          try { localStorage.setItem('su_v1_lang', v); } catch (e) {}
          switches.forEach((s) => { s.value = v; });
          apply(v);
        });
      });
      apply(lang);
    })();
  </script>
  <style is:global>
    body.hc { background: #000; color: #fff; }
    body.hc .card, body.hc .card-lift, body.hc .bg-surface, body.hc .bg-paper, body.hc nav, body.hc footer { background: #000 !important; color: #fff !important; border-color: #fff !important; }
    /* High contrast defeats glass entirely: solid black, no blur, white borders. */
    body.hc .glass, body.hc .glass-strong, body.hc .glass-lite, body.hc .glass-card { background: #000 !important; -webkit-backdrop-filter: none !important; backdrop-filter: none !important; border-color: #fff !important; color: #fff !important; }
    body.hc .ambient { display: none !important; }
    body.hc a, body.hc h1, body.hc h2, body.hc h3 { color: #ffd479 !important; }
  </style>

  <!-- Global toast + modal-form helpers (replace native alert()/prompt() dialogs). -->
  <div id="su-toasts" class="fixed bottom-4 left-1/2 z-[60] flex -translate-x-1/2 flex-col items-center gap-2 print:hidden" aria-live="polite"></div>
  <div id="su-modal-root"></div>
  <script>
    window.suToast = function (msg, kind) {
      var box = document.getElementById('su-toasts'); if (!box) return;
      var el = document.createElement('div');
      var tone = kind === 'ok' ? 'border-ok text-ok' : kind === 'error' ? 'border-danger text-danger' : 'border-navy text-ink';
      el.className = 'glass-strong rounded-xl2 border-l-4 ' + tone + ' px-4 py-2.5 font-sans text-sm max-w-sm';
      el.setAttribute('role', 'status'); el.textContent = msg; box.appendChild(el);
      setTimeout(function () { el.style.transition = 'opacity .3s'; el.style.opacity = '0'; setTimeout(function () { el.remove(); }, 300); }, 3400);
    };
    window.suModalForm = function (opts) {
      return new Promise(function (resolve) {
        var root = document.getElementById('su-modal-root');
        var esc = function (s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]); }); };
        var fields = opts.fields || [];
        var inputs = fields.map(function (f, i) {
          var id = 'suf-' + i;
          var ctrl = f.type === 'textarea'
            ? '<textarea id="' + id + '" rows="3" class="w-full rounded-xl border border-line bg-surface px-3 py-2 font-sans"></textarea>'
            : '<input id="' + id + '" type="' + (f.type || 'text') + '" class="w-full rounded-xl border border-line bg-surface px-3 py-2 font-sans" />';
          return '<label class="block"><span class="mb-1 block font-sans text-sm font-semibold text-navy">' + esc(f.label) + (f.optional ? ' <span class="font-normal text-muted">(optional)</span>' : '') + '</span>' + ctrl + '</label>';
        }).join('');
        root.innerHTML = '<div id="su-modal-ov" class="fixed inset-0 z-[70] flex items-center justify-center bg-black/40 p-4 print:hidden"><div role="dialog" aria-modal="true" aria-label="' + esc(opts.title) + '" class="glass-strong w-full max-w-md rounded-xl2 p-6"><h2 class="font-serif text-xl font-bold text-navy">' + esc(opts.title) + '</h2><form id="su-modal-form" class="mt-4 grid gap-3">' + inputs + '<div class="mt-2 flex justify-end gap-2"><button type="button" id="su-modal-cancel" class="btn">Cancel</button><button type="submit" class="btn btn-primary">' + esc(opts.submitLabel || 'Save') + '</button></div></form></div></div>';
        var close = function (val) { root.innerHTML = ''; document.removeEventListener('keydown', onKey); resolve(val); };
        var onKey = function (e) { if (e.key === 'Escape') close(null); };
        document.addEventListener('keydown', onKey);
        document.getElementById('su-modal-cancel').addEventListener('click', function () { close(null); });
        document.getElementById('su-modal-ov').addEventListener('click', function (e) { if (e.target === e.currentTarget) close(null); });
        document.getElementById('su-modal-form').addEventListener('submit', function (e) {
          e.preventDefault(); var vals = {};
          fields.forEach(function (f, i) { vals[f.name] = document.getElementById('suf-' + i).value; });
          close(vals);
        });
        var first = root.querySelector('input,textarea'); if (first) first.focus();
      });
    };
  </script>
</body>
</html>
