# Rendered Tutor config holds secrets — never commit
.tutor/
config.yml
*.env
.DS_Store

# Generated at deploy/CI time by scripts/build_public_data.py (answer-stripped catalogue served to browsers)
site/assets/data/courses.public.json

# Local wrangler dev secrets (copy from .dev.vars.example) — never commit
.dev.vars

# root tooling (wrangler devDep)
/node_modules/

# Generated at build time by web/scripts/build-index.mjs (slim catalogue index)
web/public/data/
.claude/

# local-only dev preview assets (staged for R2, not committed — see r2-upload-staging/)
web/public/media/media/hero/

# local wrangler dev-server state/cache
.wrangler/
.cc/redesign-prototype-source.html

# gstack local artifacts (security reports stay local, never committed)
.gstack/
